# Server
PORT=3000
NODE_ENV=development

# Session — REQUIRED in production, the server refuses to boot without it
SESSION_SECRET=your-super-secret-session-key-change-this

# Ziyaret kayitlarindaki IP ozetinin tuzu.
#
# Tuzsuz bir ozet anonimlestirme degil: tum IPv4 uzayi 4,3 milyar adres, yani
# bir dizustu bilgisayar hepsini saniyeler icinde ozetleyip tabloyla
# eslestirebilir. Tuz bunu imkansiz kiliyor.
#
# Bos birakilirsa SESSION_SECRET kullanilir; o da yoksa IP ozeti hic
# saklanmaz - zayif bir ozeti "anonim" diye tutmaktansa alan bos kalir.
#
# Degistirmek eski kayitlarla yeni kayitlari karsilastirilamaz hale getirir:
# tekil ziyaretci sayisi degisim gununde bir kez sisecektir.
ANALYTICS_SALT=

# Database
DB_PATH=./database/cypilan.db

# First admin account (created on first boot only).
# If ADMIN_PASSWORD is omitted a random one is generated and printed once.
ADMIN_EMAIL=admin@cypilan.com
ADMIN_PASSWORD=

# Google OAuth (optional — "Sign in with Google" is hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Listings
# true routes new listings through the admin approval queue instead of
# publishing them straight away. Default false.
LISTING_REQUIRE_APPROVAL=false
# Days before an active listing is marked expired. Default 90.
LISTING_LIFETIME_DAYS=90

# File Uploads
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=5242880

# Site
SITE_URL=http://localhost:3000
SITE_NAME=CYPILAN.COM
DEFAULT_LANGUAGE=tr

# Email & SMTP (Leave empty for local dev console logging fallback)
APP_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=example@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_SECURE=false
MAIL_FROM="CYPILAN.COM" <example@gmail.com>


# Veritabani yedeklerinin ikinci kopyasi (istege bagli).
# Bir bulut istemcisinin (Google Drive / Dropbox / OneDrive) izledigi klasoru
# gosterirse, saatlik yedekler sunucu disina da cikar. Tanimsiz birakilirsa
# yedekler yalnizca database/backups/ altinda kalir.
#
# Yalnizca bu klasoru senkronla - canli database/cypilan.db dosyasini asla.
BACKUP_MIRROR_DIR=

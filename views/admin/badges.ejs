<div class="mb-4">
    <h1 class="h4 fw-bold mb-1">Rozetler &amp; Unvanlar</h1>
    <p class="text-muted small mb-0">Kimin hangi rozeti taşıdığı ve hangi rozetin kimsede olmadığı.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-3">
                <div class="text-muted small">Geçerli rozet</div>
                <div class="fs-3 fw-bold"><%= stats.total_badges %></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-3">
                <div class="text-muted small">Rozetli üye</div>
                <div class="fs-3 fw-bold"><%= stats.members %></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-3">
                <div class="text-muted small">Katalogdaki rozet</div>
                <div class="fs-3 fw-bold"><%= catalog.length %></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-3">
                <div class="text-muted small">Toplam kayıt</div>
                <div class="fs-3 fw-bold"><%= grants.total %></div>
                <div class="text-muted" style="font-size: 0.72rem;">süresi dolanlar dahil</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h2 class="fs-6 fw-bold mb-3">Rozet Başına Taşıyıcı</h2>
                <div class="d-flex flex-column gap-2">
                    <% catalog.forEach(function (b) { %>
                        <% const count = holderCounts.get(b.key) || 0; %>
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <span class="badge rounded-pill bg-<%= b.variant %>-subtle text-<%= b.variant %>-emphasis border border-<%= b.variant %>-subtle fw-semibold">
                                <i class="fa-solid <%= b.icon %> me-1"></i><%= t('badges.' + b.key) %>
                            </span>
                            <span class="small <%= count ? 'fw-bold' : 'text-muted' %>">
                                <%= count %> kişi<% if (b.defaultDays) { %> <span class="text-muted fw-normal">· <%= b.defaultDays %> gün</span><% } %>
                            </span>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h2 class="fs-6 fw-bold mb-3">Verilen Rozetler</h2>

                <% if (!grants.data.length) { %>
                    <p class="text-muted small mb-0">Henüz kimseye rozet verilmemiş. Kullanıcılar sayfasındaki 🏅 düğmesinden verebilirsiniz.</p>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light small text-muted">
                                <tr>
                                    <th>Üye</th>
                                    <th>Rozet</th>
                                    <th class="d-none d-md-table-cell">Veren</th>
                                    <th>Bitiş</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% grants.data.forEach(function (row) { %>
                                    <% const def = userBadges.describe(row.badge_key); %>
                                    <tr class="<%= row.is_expired ? 'opacity-50' : '' %>">
                                        <td>
                                            <a href="/admin/users/<%= row.user_id %>/rozetler" class="text-decoration-none fw-semibold">
                                                <%= row.company_name || row.full_name %>
                                            </a>
                                            <div class="text-muted" style="font-size: 0.72rem;"><%= row.email %></div>
                                        </td>
                                        <td>
                                            <span class="badge rounded-pill bg-<%= def.variant %>-subtle text-<%= def.variant %>-emphasis border border-<%= def.variant %>-subtle fw-semibold">
                                                <i class="fa-solid <%= def.icon %> me-1"></i><%= t('badges.' + row.badge_key) %>
                                            </span>
                                            <% if (row.note) { %>
                                                <div class="text-muted" style="font-size: 0.72rem;"><%= row.note %></div>
                                            <% } %>
                                        </td>
                                        <td class="small text-muted d-none d-md-table-cell">
                                            <%= row.granted_by_name || '—' %><br>
                                            <%= helpers.timeAgo(row.granted_at, lang) %>
                                        </td>
                                        <td class="small">
                                            <% if (!row.expires_at) { %>
                                                <span class="text-muted">Süresiz</span>
                                            <% } else if (row.is_expired) { %>
                                                <span class="text-danger fw-semibold">Doldu</span>
                                            <% } else { %>
                                                <%= helpers.formatDate(row.expires_at, lang) %>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>

                    <%- include('_pagination', {
                        pagination: { page: grants.page, totalPages: grants.pages, totalItems: grants.total },
                        baseUrl: '/admin/rozetler',
                        query: {}
                    }) %>
                <% } %>
            </div>
        </div>
    </div>
</div>

<div class="d-flex align-items-center gap-3 mb-3">
    <a href="/admin/reports" class="btn btn-light border btn-sm"><i class="fa-solid fa-arrow-left"></i></a>
    <h1 class="fs-4 fw-bold mb-0"><%= t('admin_conversation.title') %></h1>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-3 small">
            <div class="col-md-3">
                <div class="text-muted"><%= t('admin_conversation.reason_label') %></div>
                <div class="fw-bold"><%= t('report_modal.reasons.' + report.reason) !== 'report_modal.reasons.' + report.reason ? t('report_modal.reasons.' + report.reason) : report.reason %></div>
            </div>
            <div class="col-md-3">
                <div class="text-muted"><%= t('admin_conversation.reporter') %></div>
                <div class="fw-bold"><%= report.reporter_name || '-' %></div>
            </div>
            <div class="col-md-3">
                <div class="text-muted"><%= t('admin_conversation.reported') %></div>
                <div class="fw-bold">
                    <a href="/profile/<%= report.reported_user_id %>" target="_blank" rel="noopener"><%= report.reported_user_name || '-' %></a>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-muted"><%= t('admin_conversation.listing') %></div>
                <div class="fw-bold">
                    <% if (report.listing_slug) { %>
                        <a href="/listings/<%= report.listing_slug %>" target="_blank" rel="noopener"><%= report.listing_title %></a>
                    <% } else { %>
                        <span class="text-muted"><%= t('admin_conversation.off_listing') %></span>
                    <% } %>
                </div>
            </div>
        </div>

        <% if (report.description) { %>
            <div class="mt-3 pt-3 border-top">
                <div class="text-muted small"><%= t('admin_conversation.reporter_desc') %></div>
                <div><%= report.description %></div>
            </div>
        <% } %>
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h2 class="fs-6 fw-bold mb-0"><%= t('admin_conversation.full_chat', { count: messages.length }) %></h2>
        <span class="badge bg-secondary bg-opacity-10 text-secondary"><%= t('admin_conversation.review_only') %></span>
    </div>
    <div class="card-body">
        <% if (messages.length === 0) { %>
            <p class="text-muted text-center py-4 mb-0"><%= t('admin_conversation.no_messages') %></p>
        <% } else { %>
            <% messages.forEach(function(m) { %>
                <% const fromReported = m.sender_id === report.reported_user_id; %>
                <div class="d-flex mb-3 <%= fromReported ? 'justify-content-start' : 'justify-content-end' %>">
                    <div class="<%= fromReported ? 'bg-danger bg-opacity-10 border border-danger border-opacity-25' : 'bg-light' %> rounded-3 px-3 py-2"
                         style="max-width: 78%;">
                        <div class="small fw-bold mb-1 <%= fromReported ? 'text-danger' : 'text-muted' %>">
                            <%= m.sender_name %><%= fromReported ? t('admin_conversation.reported_user_tag') : '' %>
                            <% if (report.message_id && m.id === report.message_id) { %>
                                <span class="badge bg-warning text-dark ms-1"><%= t('admin_conversation.last_message_at_report') %></span>
                            <% } %>
                        </div>
                        <div style="white-space: pre-wrap; word-break: break-word;"><%= m.content %></div>
                        <div class="small text-muted text-end mt-1" style="font-size: 0.75rem;">
                            <%= helpers.formatDate(m.created_at, typeof lang !== 'undefined' ? lang : 'tr') %> &middot; <%= helpers.timeAgo(m.created_at, typeof lang !== 'undefined' ? lang : 'tr') %>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } %>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <% if (report.status === 'pending' || report.status === 'reviewed') { %>
            <form action="/admin/reports/<%= report.id %>" method="POST" class="row g-2 align-items-center">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="_method" value="PUT">
                <div class="col-12 col-md-6">
                    <input type="text" name="admin_note" class="form-control form-control-sm" placeholder="<%= t('admin_conversation.note_placeholder') %>">
                </div>
                <div class="col-auto">
                    <button name="status" value="resolved" class="btn btn-sm btn-success"><%= t('admin_conversation.resolve') %></button>
                </div>
                <div class="col-auto">
                    <button name="status" value="dismissed" class="btn btn-sm btn-outline-secondary"><%= t('admin_conversation.dismiss') %></button>
                </div>
            </form>
        <% } else { %>
            <p class="mb-0 text-muted small"><%= t('admin_conversation.closed_status', { status: report.status }) %></p>
        <% } %>

        <% if (Number(report.reported_user_active) !== 0) { %>
            <form action="/admin/users/<%= report.reported_user_id %>/status" method="POST" class="mt-3 pt-3 border-top">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="_method" value="PUT">
                <input type="hidden" name="status" value="suspended">
                <button class="btn btn-sm btn-outline-danger">
                    <i class="fa-solid fa-ban me-1"></i><%= t('admin_conversation.suspend_user') %>
                </button>
            </form>
        <% } %>
    </div>
</div>

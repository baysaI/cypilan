<%
const reasonLabels = {
  wrong_category: 'Yanlış kategori',
  misleading_price: 'Yanıltıcı fiyat',
  missing_photos: 'Eksik fotoğraf',
  spam: 'Spam',
  fraud: 'Dolandırıcılık',
  inappropriate: 'Uygunsuz içerik',
  harassment: 'Taciz veya hakaret',
  other: 'Diğer'
};
%>

<div class="d-flex align-items-center gap-3 mb-3">
    <a href="/admin/reports" class="btn btn-light border btn-sm"><i class="fa-solid fa-arrow-left"></i></a>
    <h1 class="fs-4 fw-bold mb-0">Şikayet Edilen Sohbet</h1>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-3 small">
            <div class="col-md-3">
                <div class="text-muted">Şikayet Nedeni</div>
                <div class="fw-bold"><%= reasonLabels[report.reason] || report.reason %></div>
            </div>
            <div class="col-md-3">
                <div class="text-muted">Bildiren</div>
                <div class="fw-bold"><%= report.reporter_name || '-' %></div>
            </div>
            <div class="col-md-3">
                <div class="text-muted">Şikayet Edilen</div>
                <div class="fw-bold">
                    <a href="/profile/<%= report.reported_user_id %>" target="_blank" rel="noopener"><%= report.reported_user_name || '-' %></a>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-muted">İlan</div>
                <div class="fw-bold">
                    <% if (report.listing_slug) { %>
                        <a href="/listings/<%= report.listing_slug %>" target="_blank" rel="noopener"><%= report.listing_title %></a>
                    <% } else { %>
                        <span class="text-muted">ilan dışı sohbet</span>
                    <% } %>
                </div>
            </div>
        </div>

        <% if (report.description) { %>
            <div class="mt-3 pt-3 border-top">
                <div class="text-muted small">Bildirenin açıklaması</div>
                <div><%= report.description %></div>
            </div>
        <% } %>
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h2 class="fs-6 fw-bold mb-0">Sohbetin Tamamı (<%= messages.length %> mesaj)</h2>
        <span class="badge bg-secondary bg-opacity-10 text-secondary">yalnızca inceleme amaçlı</span>
    </div>
    <div class="card-body">
        <% if (messages.length === 0) { %>
            <p class="text-muted text-center py-4 mb-0">Bu sohbette mesaj bulunamadı.</p>
        <% } else { %>
            <% messages.forEach(function(m) { %>
                <% const fromReported = m.sender_id === report.reported_user_id; %>
                <div class="d-flex mb-3 <%= fromReported ? 'justify-content-start' : 'justify-content-end' %>">
                    <div class="<%= fromReported ? 'bg-danger bg-opacity-10 border border-danger border-opacity-25' : 'bg-light' %> rounded-3 px-3 py-2"
                         style="max-width: 78%;">
                        <div class="small fw-bold mb-1 <%= fromReported ? 'text-danger' : 'text-muted' %>">
                            <%= m.sender_name %><%= fromReported ? ' (şikayet edilen)' : '' %>
                            <% if (report.message_id && m.id === report.message_id) { %>
                                <span class="badge bg-warning text-dark ms-1">şikayet anındaki son mesaj</span>
                            <% } %>
                        </div>
                        <div style="white-space: pre-wrap; word-break: break-word;"><%= m.content %></div>
                        <div class="small text-muted text-end mt-1" style="font-size: 0.75rem;">
                            <%= helpers.formatDate(m.created_at, 'tr') %> &middot; <%= helpers.timeAgo(m.created_at, 'tr') %>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } %>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <% if (report.status === 'pending' || report.status === 'reviewed') { %>
            <form action="/admin/reports/<%= report.id %>" method="POST" class="row g-2 align-items-center">
                <input type="hidden" name="_method" value="PUT">
                <div class="col-12 col-md-6">
                    <input type="text" name="admin_note" class="form-control form-control-sm" placeholder="Karar notu (opsiyonel)">
                </div>
                <div class="col-auto">
                    <button name="status" value="resolved" class="btn btn-sm btn-success">Çözüldü</button>
                </div>
                <div class="col-auto">
                    <button name="status" value="dismissed" class="btn btn-sm btn-outline-secondary">Reddet</button>
                </div>
            </form>
        <% } else { %>
            <p class="mb-0 text-muted small">Bu şikayet kapatılmış. Durum: <strong><%= report.status %></strong></p>
        <% } %>

        <% if (Number(report.reported_user_active) !== 0) { %>
            <form action="/admin/users/<%= report.reported_user_id %>/status" method="POST" class="mt-3 pt-3 border-top">
                <input type="hidden" name="_method" value="PUT">
                <input type="hidden" name="status" value="suspended">
                <button class="btn btn-sm btn-outline-danger">
                    <i class="fa-solid fa-ban me-1"></i>Şikayet edilen kullanıcıyı askıya al
                </button>
            </form>
        <% } %>
    </div>
</div>

<%
const statsObj = (typeof stats !== 'undefined' && stats) ? stats : { totalUsers: 0, activeListings: 0, pendingListings: 0, pendingReports: 0 };
const recentListingsArr = (typeof recentListings !== 'undefined' && recentListings) ? recentListings : [];
const analyticsData = (typeof analytics !== 'undefined' && analytics) ? analytics : { summary: {}, trends: [], categories: [], roles: [], statuses: [] };
%>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="fs-4 fw-bold mb-0">Admin Paneli & Analitik</h1>
        <p class="text-muted small mb-0">Site trafiği, kayıtlar ve ilan performans istatistikleri</p>
    </div>
    <div class="btn-group btn-group-sm" role="group" id="timeframeSelector">
        <button type="button" class="btn btn-outline-primary" data-tf="today">Bugün</button>
        <button type="button" class="btn btn-outline-primary" data-tf="week">7 Gün</button>
        <button type="button" class="btn btn-outline-primary active" data-tf="month">30 Gün</button>
        <button type="button" class="btn btn-outline-primary" data-tf="year">1 Yıl</button>
        <button type="button" class="btn btn-outline-primary" data-tf="all">Tüm Zamanlar</button>
    </div>
</div>

<!-- Timeframe Responsive Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-info bg-opacity-10 text-info rounded-3 p-3 me-3 flex-shrink-0">
                    <i class="fa-solid fa-chart-line fs-4"></i>
                </div>
                <div class="min-w-0">
                    <div class="text-muted small fw-medium text-uppercase">Sayfa Gösterimi</div>
                    <div class="fs-4 fw-bold" id="statViews"><%= analyticsData.summary.month?.views || 0 %></div>
                    <div class="small text-muted" style="font-size: 0.75rem;">Son 30 gün hit</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3 me-3 flex-shrink-0">
                    <i class="fa-solid fa-user-check fs-4"></i>
                </div>
                <div class="min-w-0">
                    <div class="text-muted small fw-medium text-uppercase">Tekil Ziyaretçi</div>
                    <div class="fs-4 fw-bold" id="statVisitors"><%= analyticsData.summary.month?.visitors || 0 %></div>
                    <div class="small text-muted" style="font-size: 0.75rem;">Farklı IP / Oturum</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-success bg-opacity-10 text-success rounded-3 p-3 me-3 flex-shrink-0">
                    <i class="fa-solid fa-user-plus fs-4"></i>
                </div>
                <div class="min-w-0">
                    <div class="text-muted small fw-medium text-uppercase">Yeni Kayıtlar</div>
                    <div class="fs-4 fw-bold" id="statRegistrations"><%= analyticsData.summary.month?.registrations || 0 %></div>
                    <div class="small text-muted" style="font-size: 0.75rem;">Üye sayısı</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-3 me-3 flex-shrink-0">
                    <i class="fa-solid fa-plus-circle fs-4"></i>
                </div>
                <div class="min-w-0">
                    <div class="text-muted small fw-medium text-uppercase">Açılan İlanlar</div>
                    <div class="fs-4 fw-bold" id="statListings"><%= analyticsData.summary.month?.listings || 0 %></div>
                    <div class="small text-muted" style="font-size: 0.75rem;">Yeni eklenen</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-3 mb-4">
    <!-- Traffic Line Chart -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-0">
                <h2 class="fs-6 fw-bold mb-0">Ziyaretçi & Sayfa Gösterim Trendi (Son 30 Gün)</h2>
            </div>
            <div class="card-body">
                <canvas id="trafficChart" height="260"></canvas>
            </div>
        </div>
    </div>
    <!-- Category Doughnut Chart -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-0">
                <h2 class="fs-6 fw-bold mb-0">Kategoriye Göre İlanlar</h2>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="categoryChart" height="240"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Registrations vs Listings Bar Chart -->
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-0">
                <h2 class="fs-6 fw-bold mb-0">Yeni Kayıtlar & Yeni İlanlar (Son 30 Gün)</h2>
            </div>
            <div class="card-body">
                <canvas id="growthChart" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Listings Table -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h2 class="fs-6 fw-bold mb-0">Son Eklenen İlanlar</h2>
        <a href="/admin/listings" class="btn btn-sm btn-light">Tümünü Gör</a>
    </div>
    <div class="card-body p-0">
        <% if (recentListingsArr.length === 0) { %>
            <p class="text-muted text-center py-5 mb-0">Henüz ilan yok.</p>
        <% } else { %>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-muted">
                        <tr>
                            <th class="ps-3">İlan</th>
                            <th class="d-none d-md-table-cell">Sahibi</th>
                            <th>Fiyat</th>
                            <th>Durum</th>
                            <th class="pe-3 text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentListingsArr.forEach(function(l) { %>
                            <tr>
                                <td class="ps-3">
                                    <div class="d-flex align-items-center">
                                        <img src="<%= l.primary_image || '/img/logo.png' %>" class="rounded bg-light me-2 object-fit-cover" width="40" height="40" alt="">
                                        <div>
                                            <div class="fw-medium text-truncate" style="max-width: 220px;"><%= l.title %></div>
                                            <div class="text-muted small"><%= l.category_name || '-' %></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="d-none d-md-table-cell small text-muted"><%= l.owner_name || '-' %></td>
                                <td class="fw-bold text-nowrap"><%= helpers.formatPrice(l.price, l.currency) %></td>
                                <td><%- include('_statusBadge', { status: l.status }) %></td>
                                <td class="pe-3 text-end text-nowrap">
                                    <a href="/listings/<%= l.slug %>" target="_blank" rel="noopener" class="btn btn-sm btn-light" title="Görüntüle">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <% if (l.status !== 'active') { %>
                                        <form action="/admin/listings/<%= l.id %>/status" method="POST" class="d-inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" name="_method" value="PUT">
                                            <input type="hidden" name="status" value="active">
                                            <button class="btn btn-sm btn-success" title="Onayla"><i class="fa-solid fa-check"></i></button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const summaryData = <%- JSON.stringify(analyticsData.summary || {}) %>;
    const trendsData = <%- JSON.stringify(analyticsData.trends || []) %>;
    const categoriesData = <%- JSON.stringify(analyticsData.categories || []) %>;

    // Timeframe Selector Logic
    const tfButtons = document.querySelectorAll('#timeframeSelector button');
    tfButtons.forEach(btn => {
        btn.addEventListener('click', function () {
            tfButtons.forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            const tf = this.getAttribute('data-tf');
            const data = summaryData[tf] || { views: 0, visitors: 0, registrations: 0, listings: 0 };
            document.getElementById('statViews').textContent = data.views.toLocaleString();
            document.getElementById('statVisitors').textContent = data.visitors.toLocaleString();
            document.getElementById('statRegistrations').textContent = data.registrations.toLocaleString();
            document.getElementById('statListings').textContent = data.listings.toLocaleString();
        });
    });

    // Chart.js Data Preparation
    const labels = trendsData.map(t => {
        const parts = t.date.split('-');
        return `${parts[2]}/${parts[1]}`;
    });
    const viewsArray = trendsData.map(t => t.views);
    const visitorsArray = trendsData.map(t => t.visitors);
    const registrationsArray = trendsData.map(t => t.registrations);
    const listingsArray = trendsData.map(t => t.listings);

    // Traffic Line Chart
    const ctxTraffic = document.getElementById('trafficChart').getContext('2d');
    new Chart(ctxTraffic, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Sayfa Gösterimi (Views)',
                    data: viewsArray,
                    borderColor: '#3A7CA5',
                    backgroundColor: 'rgba(58, 124, 165, 0.1)',
                    fill: true,
                    tension: 0.3
                },
                {
                    label: 'Tekil Ziyaretçi (Visitors)',
                    data: visitorsArray,
                    borderColor: '#E8982D',
                    backgroundColor: 'rgba(232, 152, 45, 0.1)',
                    fill: true,
                    tension: 0.3
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'top' } },
            scales: { y: { beginAtZero: true } }
        }
    });

    // Category Doughnut Chart
    const ctxCategory = document.getElementById('categoryChart').getContext('2d');
    new Chart(ctxCategory, {
        type: 'doughnut',
        data: {
            labels: categoriesData.map(c => c.name),
            datasets: [{
                data: categoriesData.map(c => c.count),
                backgroundColor: [
                    '#3A7CA5', '#E8982D', '#2a9d8f', '#e76f51', '#f4a261', '#1d3557', '#457b9d', '#a8dadc'
                ]
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'bottom' } }
        }
    });

    // Growth Bar Chart
    const ctxGrowth = document.getElementById('growthChart').getContext('2d');
    new Chart(ctxGrowth, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Yeni Üye Kayıtları',
                    data: registrationsArray,
                    backgroundColor: '#2a9d8f'
                },
                {
                    label: 'Yeni Eklenen İlanlar',
                    data: listingsArray,
                    backgroundColor: '#E8982D'
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'top' } },
            scales: { y: { beginAtZero: true } }
        }
    });
});
</script>

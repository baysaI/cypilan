<%
const statsObj = (typeof stats !== 'undefined' && stats) ? stats : { totalUsers: 0, activeListings: 0, pendingListings: 0, pendingReports: 0 };
const recentListingsArr = (typeof recentListings !== 'undefined' && recentListings) ? recentListings : [];
%>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fs-4 fw-bold mb-0">Panel</h1>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3 me-3">
                    <i class="fa-solid fa-users fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium text-uppercase">Kullanıcı</div>
                    <div class="fs-4 fw-bold"><%= statsObj.totalUsers || 0 %></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-success bg-opacity-10 text-success rounded-3 p-3 me-3">
                    <i class="fa-solid fa-list-check fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium text-uppercase">Aktif İlan</div>
                    <div class="fs-4 fw-bold"><%= statsObj.activeListings || 0 %></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-3 me-3">
                    <i class="fa-solid fa-hourglass-half fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium text-uppercase">Onay Bekleyen</div>
                    <div class="fs-4 fw-bold"><%= statsObj.pendingListings || 0 %></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-danger bg-opacity-10 text-danger rounded-3 p-3 me-3">
                    <i class="fa-solid fa-flag fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium text-uppercase">Bekleyen Şikayet</div>
                    <div class="fs-4 fw-bold"><%= statsObj.pendingReports || 0 %></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h2 class="fs-6 fw-bold mb-0">Son Eklenen İlanlar</h2>
        <a href="/admin/listings" class="btn btn-sm btn-light">Tümünü Gör</a>
    </div>
    <div class="card-body p-0">
        <% if (recentListingsArr.length === 0) { %>
            <p class="text-muted text-center py-5 mb-0">Henüz ilan yok.</p>
        <% } else { %>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-muted">
                        <tr>
                            <th class="ps-3">İlan</th>
                            <th class="d-none d-md-table-cell">Sahibi</th>
                            <th>Fiyat</th>
                            <th>Durum</th>
                            <th class="pe-3 text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentListingsArr.forEach(function(l) { %>
                            <tr>
                                <td class="ps-3">
                                    <div class="d-flex align-items-center">
                                        <img src="<%= l.primary_image || '/img/logo.png' %>" class="rounded bg-light me-2 object-fit-cover" width="40" height="40" alt="">
                                        <div>
                                            <div class="fw-medium text-truncate" style="max-width: 220px;"><%= l.title %></div>
                                            <div class="text-muted small"><%= l.category_name || '-' %></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="d-none d-md-table-cell small text-muted"><%= l.owner_name || '-' %></td>
                                <td class="fw-bold text-nowrap"><%= helpers.formatPrice(l.price, l.currency) %></td>
                                <td><%- include('_statusBadge', { status: l.status }) %></td>
                                <td class="pe-3 text-end text-nowrap">
                                    <a href="/listings/<%= l.slug %>" target="_blank" rel="noopener" class="btn btn-sm btn-light" title="Görüntüle">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <% if (l.status !== 'active') { %>
                                        <form action="/admin/listings/<%= l.id %>/status" method="POST" class="d-inline">
                                            <input type="hidden" name="_method" value="PUT">
                                            <input type="hidden" name="status" value="active">
                                            <button class="btn btn-sm btn-success" title="Onayla"><i class="fa-solid fa-check"></i></button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yönetim Paneli | CYPILAN.COM</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8f9fa; }
        .sidebar { min-height: 100vh; width: 280px; }
        .main-content { margin-left: 280px; width: calc(100% - 280px); }
        .hover-bg-light:hover { background-color: rgba(255,255,255,0.1); }
        @media (max-width: 991.98px) {
            .sidebar { position: fixed; transform: translateX(-100%); transition: transform 0.3s ease; z-index: 1045; }
            .sidebar.show { transform: translateX(0); }
            .main-content { margin-left: 0; width: 100%; }
        }
    </style>
</head>
<body>

<div class="d-flex">
    <aside class="sidebar bg-dark text-white flex-shrink-0 d-flex flex-column p-3 position-fixed top-0 start-0 h-100 shadow">
        <a href="/" class="d-flex align-items-center mb-4 mt-2 text-white text-decoration-none px-3">
            <i class="fa-solid fa-layer-group fs-3 text-warning me-2"></i>
            <span class="fs-4 fw-bold">CYPILAN<span class="text-white-50 fs-6 fw-normal ms-1">Admin</span></span>
        </a>
        <hr class="border-secondary mt-0 mb-3">
        <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item">
                <a href="/admin/dashboard" class="nav-link active bg-primary text-white rounded-3 mb-1">
                    <i class="fa-solid fa-gauge-high fa-fw me-2"></i> Dashboard
                </a>
            </li>
            <li>
                <a href="/admin/users" class="nav-link text-white hover-bg-light rounded-3 mb-1">
                    <i class="fa-solid fa-users fa-fw me-2"></i> Kullanıcılar
                </a>
            </li>
            <li>
                <a href="/admin/listings" class="nav-link text-white hover-bg-light rounded-3 mb-1">
                    <i class="fa-solid fa-list fa-fw me-2"></i> İlanlar
                </a>
            </li>
            <li>
                <a href="/admin/reports" class="nav-link text-white hover-bg-light rounded-3 mb-1 d-flex justify-content-between align-items-center">
                    <span><i class="fa-solid fa-flag fa-fw me-2"></i> Şikayetler</span>
                    <span class="badge bg-danger rounded-pill">4</span>
                </a>
            </li>
            <li>
                <a href="/admin/settings" class="nav-link text-white hover-bg-light rounded-3 mb-1">
                    <i class="fa-solid fa-gear fa-fw me-2"></i> Ayarlar
                </a>
            </li>
        </ul>
        <hr class="border-secondary">
        <div class="dropdown px-3">
            <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" data-bs-toggle="dropdown">
                <img src="/images/avatar-placeholder.png" alt="" width="32" height="32" class="rounded-circle me-2 bg-white">
                <strong>Admin</strong>
            </a>
            <ul class="dropdown-menu dropdown-menu-dark text-small shadow">
                <li><a class="dropdown-item" href="/">Siteye Dön</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item text-danger" href="/auth/logout">Çıkış Yap</a></li>
            </ul>
        </div>
    </aside>

    <main class="main-content">
        <nav class="navbar navbar-light bg-white px-3 py-2 shadow-sm d-lg-none sticky-top">
            <button class="btn btn-light" type="button" onclick="document.querySelector('.sidebar').classList.toggle('show')">
                <i class="fa-solid fa-bars fs-5"></i>
            </button>
            <span class="fw-bold fs-5">CYPILAN Admin</span>
        </nav>

        <div class="p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0">Dashboard</h2>
                <button class="btn btn-primary rounded-pill"><i class="fa-solid fa-download me-2"></i> Rapor İndir</button>
            </div>

            <div class="row g-4 mb-5">
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                        <div class="card-body p-4 d-flex align-items-center">
                            <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3 me-3">
                                <i class="fa-solid fa-users fs-3"></i>
                            </div>
                            <div>
                                <h6 class="text-muted fw-bold mb-1 text-uppercase small">Toplam Kullanıcı</h6>
                                <h3 class="fw-bold mb-0">12,450</h3>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                        <div class="card-body p-4 d-flex align-items-center">
                            <div class="bg-success bg-opacity-10 text-success rounded-3 p-3 me-3">
                                <i class="fa-solid fa-list-check fs-3"></i>
                            </div>
                            <div>
                                <h6 class="text-muted fw-bold mb-1 text-uppercase small">Aktif İlan</h6>
                                <h3 class="fw-bold mb-0">45,821</h3>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                        <div class="card-body p-4 d-flex align-items-center">
                            <div class="bg-danger bg-opacity-10 text-danger rounded-3 p-3 me-3">
                                <i class="fa-solid fa-flag fs-3"></i>
                            </div>
                            <div>
                                <h6 class="text-muted fw-bold mb-1 text-uppercase small">Bekleyen Şikayet</h6>
                                <h3 class="fw-bold mb-0">24</h3>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                        <div class="card-body p-4 d-flex align-items-center">
                            <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-3 me-3">
                                <i class="fa-solid fa-wallet fs-3"></i>
                            </div>
                            <div>
                                <h6 class="text-muted fw-bold mb-1 text-uppercase small">Aylık Gelir</h6>
                                <h3 class="fw-bold mb-0">₺142K</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-12 col-xl-8">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                        <div class="card-header bg-white border-bottom pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold mb-0">Son Eklenen İlanlar</h5>
                            <a href="/admin/listings" class="btn btn-sm btn-light">Tümünü Gör</a>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light text-muted small">
                                        <tr>
                                            <th class="ps-4">İlan Başlığı</th>
                                            <th>Kategori</th>
                                            <th>Fiyat</th>
                                            <th>Durum</th>
                                            <th class="pe-4 text-end">İşlem</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-light rounded me-2" style="width:40px; height:40px;"></div>
                                                    <div class="fw-medium text-truncate" style="max-width: 200px;">Girne Lüks Villa</div>
                                                </div>
                                            </td>
                                            <td>Emlak</td>
                                            <td class="fw-bold">£250,000</td>
                                            <td><span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2">Aktif</span></td>
                                            <td class="pe-4 text-end">
                                                <button class="btn btn-sm btn-light text-primary"><i class="fa-solid fa-eye"></i></button>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-light rounded me-2" style="width:40px; height:40px;"></div>
                                                    <div class="fw-medium text-truncate" style="max-width: 200px;">iPhone 14 Pro Max</div>
                                                </div>
                                            </td>
                                            <td>İkinci El</td>
                                            <td class="fw-bold">₺35,000</td>
                                            <td><span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2">Onay Bekliyor</span></td>
                                            <td class="pe-4 text-end">
                                                <button class="btn btn-sm btn-light text-primary"><i class="fa-solid fa-eye"></i></button>
                                                <button class="btn btn-sm btn-success text-white"><i class="fa-solid fa-check"></i></button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                        <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                            <h5 class="fw-bold mb-0">Son Şikayetler</h5>
                        </div>
                        <div class="card-body p-0">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item p-4">
                                    <div class="d-flex w-100 justify-content-between mb-1">
                                        <h6 class="mb-1 fw-bold">Sahte İlan Bildirimi</h6>
                                        <small class="text-muted">10 dk önce</small>
                                    </div>
                                    <p class="mb-1 small text-muted">İlan #12345 fiyatı çok düşük, dolandırıcı olabilir.</p>
                                    <div class="mt-2">
                                        <button class="btn btn-sm btn-outline-danger">İlanı Kaldır</button>
                                        <button class="btn btn-sm btn-light">İncele</button>
                                    </div>
                                </li>
                                <li class="list-group-item p-4">
                                    <div class="d-flex w-100 justify-content-between mb-1">
                                        <h6 class="mb-1 fw-bold">Uygunsuz İçerik</h6>
                                        <small class="text-muted">2 saat önce</small>
                                    </div>
                                    <p class="mb-1 small text-muted">İlan #98765 fotoğrafları uygunsuz.</p>
                                    <div class="mt-2">
                                        <button class="btn btn-sm btn-outline-danger">İlanı Kaldır</button>
                                        <button class="btn btn-sm btn-light">İncele</button>
                                    </div>
                                </li>
                            </ul>
                        </div>
                        <div class="card-footer bg-white text-center py-3 border-top">
                            <a href="/admin/reports" class="text-decoration-none fw-medium small">Tüm Şikayetleri Gör</a>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

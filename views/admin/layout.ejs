<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'tr' %>" data-bs-theme="<%= typeof theme !== 'undefined' ? theme : 'light' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Admin' %> | CYPILAN.COM</title>
    <meta name="robots" content="noindex, nofollow">
    <% if (typeof csrfToken !== 'undefined' && csrfToken) { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- The admin panel never loaded this, so it sat on Bootstrap's stock palette
         and missed the theme mapping the rest of the site uses. -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/img/logo.png">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: var(--bs-tertiary-bg); }
        .admin-sidebar { width: 260px; }
        .admin-main { margin-left: 260px; }
        .admin-sidebar .nav-link { color: rgba(255,255,255,0.75); }
        .admin-sidebar .nav-link:hover { background-color: rgba(255,255,255,0.08); color: #fff; }
        .admin-sidebar .nav-link.active { background-color: var(--cyp-primary); color: #fff; }
        @media (max-width: 991.98px) {
            .admin-sidebar { position: fixed; transform: translateX(-100%); transition: transform .3s ease; z-index: 1045; }
            .admin-sidebar.show { transform: translateX(0); }
            .admin-main { margin-left: 0; }
        }
    </style>
    <% if (typeof style !== 'undefined' && style) { %><%- style %><% } %>
</head>
<body>

<aside class="admin-sidebar bg-dark text-white d-flex flex-column p-3 position-fixed top-0 start-0 h-100 shadow">
    <a href="/admin" class="d-flex align-items-center mb-4 mt-2 text-white text-decoration-none px-2">
        <i class="fa-solid fa-shield-halved fs-4 text-warning me-2"></i>
        <span class="fs-5 fw-bold">CYPILAN<span class="text-white-50 fw-normal ms-1">Admin</span></span>
    </a>
    <hr class="border-secondary mt-0 mb-3">
    <ul class="nav nav-pills flex-column mb-auto gap-1">
        <li class="nav-item">
            <a href="/admin" class="nav-link rounded-3 <%= activePage === 'dashboard' ? 'active' : '' %>">
                <i class="fa-solid fa-gauge-high fa-fw me-2"></i> Panel
            </a>
        </li>
        <li>
            <a href="/admin/listings" class="nav-link rounded-3 <%= activePage === 'listings' ? 'active' : '' %>">
                <i class="fa-solid fa-list fa-fw me-2"></i> İlanlar
            </a>
        </li>
        <li>
            <a href="/admin/users" class="nav-link rounded-3 <%= activePage === 'users' ? 'active' : '' %>">
                <i class="fa-solid fa-users fa-fw me-2"></i> Kullanıcılar
            </a>
        </li>
        <li>
            <a href="/admin/reports" class="nav-link rounded-3 d-flex justify-content-between align-items-center <%= activePage === 'reports' ? 'active' : '' %>">
                <span><i class="fa-solid fa-flag fa-fw me-2"></i> Şikayetler</span>
                <% if (typeof pendingReports !== 'undefined' && pendingReports > 0) { %>
                    <span class="badge bg-danger rounded-pill"><%= pendingReports %></span>
                <% } %>
            </a>
        </li>
        <li>
            <a href="/admin/hizmet-talepleri" class="nav-link rounded-3 d-flex justify-content-between align-items-center <%= activePage === 'services' ? 'active' : '' %>">
                <span><i class="fa-solid fa-handshake fa-fw me-2"></i> Hizmet Talepleri</span>
                <% if (typeof pendingServices !== 'undefined' && pendingServices > 0) { %>
                    <span class="badge bg-warning text-dark rounded-pill"><%= pendingServices %></span>
                <% } %>
            </a>
        </li>
    </ul>
    <hr class="border-secondary">
    <div class="px-2">
        <a href="/" class="btn btn-outline-light btn-sm w-100 mb-2"><i class="fa-solid fa-arrow-left me-2"></i>Siteye Dön</a>
        <form action="/auth/logout" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-outline-danger btn-sm w-100"><%= t('nav.logout') %></button>
        </form>
    </div>
</aside>

<main class="admin-main">
    <nav class="navbar bg-white px-3 py-2 shadow-sm d-lg-none sticky-top">
        <button class="btn btn-light" type="button" onclick="document.querySelector('.admin-sidebar').classList.toggle('show')">
            <i class="fa-solid fa-bars"></i>
        </button>
        <span class="fw-bold">CYPILAN Admin</span>
    </nav>

    <div class="p-3 p-md-4">
        <% if (typeof flash !== 'undefined' && flash && (flash.success || flash.error || flash.info)) { %>
            <% if (flash.error) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= flash.error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            <% if (flash.success) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= flash.success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            <% if (flash.info) { %>
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    <%= flash.info %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
        <% } %>

        <%- body %>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<% if (typeof script !== 'undefined' && script) { %><%- script %><% } %>
</body>
</html>

<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'tr' %>" data-bs-theme="<%= typeof theme !== 'undefined' ? theme : 'light' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= typeof title !== 'undefined' ? title : 'Admin' %> | CYPILAN.COM</title>
    <meta name="robots" content="noindex, nofollow">
    <% if (typeof csrfToken !== 'undefined' && csrfToken) { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- The admin panel never loaded this, so it sat on Bootstrap's stock palette
         and missed the theme mapping the rest of the site uses. -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/svg+xml" href="/img/logo.svg">
    <link rel="apple-touch-icon" href="/img/logo.svg">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: var(--bs-tertiary-bg); }
        .admin-sidebar { width: 260px; overflow-y: auto; }
        .admin-main { margin-left: 260px; min-width: 0; }
        .admin-sidebar .nav-link { color: rgba(255,255,255,0.75); }
        .admin-sidebar .nav-link:hover { background-color: rgba(255,255,255,0.08); color: #fff; }
        .admin-sidebar .nav-link.active { background-color: var(--cyp-primary); color: #fff; }

        /* Below lg the sidebar becomes a drawer. It needs a backdrop of its own:
           without one there is nothing to tap to dismiss it, and it sits over
           the table the admin was reading. */
        @media (max-width: 991.98px) {
            .admin-sidebar {
                position: fixed;
                width: min(82vw, 300px);
                transform: translateX(-100%);
                transition: transform .3s ease;
                z-index: 1045;
                padding-bottom: calc(1rem + env(safe-area-inset-bottom));
            }
            .admin-sidebar.show { transform: translateX(0); }
            .admin-main { margin-left: 0; }

            .admin-backdrop {
                position: fixed;
                inset: 0;
                background: rgba(0, 0, 0, .5);
                z-index: 1040;
                opacity: 0;
                pointer-events: none;
                transition: opacity .3s ease;
            }
            .admin-backdrop.show { opacity: 1; pointer-events: auto; }
            body.admin-drawer-open { overflow: hidden; }
        }

        @media (prefers-reduced-motion: reduce) {
            .admin-sidebar, .admin-backdrop { transition: none; }
        }

        /* RTL note: the admin panel is Turkish-only, so the drawer slides in
           from the left in every locale. */
        [dir="rtl"] .admin-main { margin-left: 0; margin-right: 260px; }
        @media (max-width: 991.98px) {
            [dir="rtl"] .admin-main { margin-right: 0; }
        }
    </style>
    <% if (typeof style !== 'undefined' && style) { %><%- style %><% } %>
</head>
<body>

<div class="admin-backdrop d-lg-none" id="adminBackdrop" hidden></div>

<aside class="admin-sidebar bg-dark text-white d-flex flex-column p-3 position-fixed top-0 start-0 h-100 shadow" id="adminSidebar">
    <div class="d-flex align-items-center mb-4 mt-2">
        <a href="/admin" class="d-flex align-items-center text-white text-decoration-none px-2 flex-grow-1">
            <i class="fa-solid fa-shield-halved fs-4 text-warning me-2"></i>
            <span class="fs-5 fw-bold">CYPILAN<span class="text-white-50 fw-normal ms-1">Admin</span></span>
        </a>
        <button type="button" class="btn btn-sm btn-outline-light border-0 d-lg-none" id="adminSidebarClose" aria-label="Menüyü kapat">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
    <hr class="border-secondary mt-0 mb-3">
    <ul class="nav nav-pills flex-column mb-auto gap-1">
        <li class="nav-item">
            <a href="/admin" class="nav-link rounded-3 <%= activePage === 'dashboard' ? 'active' : '' %>">
                <i class="fa-solid fa-gauge-high fa-fw me-2"></i> Panel
            </a>
        </li>
        <li>
            <a href="/admin/analytics" class="nav-link rounded-3 <%= activePage === 'analytics' ? 'active' : '' %>">
                <i class="fa-solid fa-chart-line fa-fw me-2"></i> Ziyaretçi Günlüğü
            </a>
        </li>
        <li>
            <a href="/admin/listings" class="nav-link rounded-3 <%= activePage === 'listings' ? 'active' : '' %>">
                <i class="fa-solid fa-list fa-fw me-2"></i> İlanlar
            </a>
        </li>
        <li>
            <a href="/admin/users" class="nav-link rounded-3 d-flex justify-content-between align-items-center <%= activePage === 'users' ? 'active' : '' %>">
                <span><i class="fa-solid fa-users fa-fw me-2"></i> Kullanıcılar</span>
                <% if (typeof pendingCorporate !== 'undefined' && pendingCorporate > 0) { %>
                    <span class="badge bg-warning text-dark rounded-pill" title="<%= pendingCorporate %> kurumsal başvuru onay bekliyor"><%= pendingCorporate %></span>
                <% } %>
            </a>
        </li>
        <li>
            <a href="/admin/reports" class="nav-link rounded-3 d-flex justify-content-between align-items-center <%= activePage === 'reports' ? 'active' : '' %>">
                <span><i class="fa-solid fa-flag fa-fw me-2"></i> Şikayetler</span>
                <% if (typeof pendingReports !== 'undefined' && pendingReports > 0) { %>
                    <span class="badge bg-danger rounded-pill"><%= pendingReports %></span>
                <% } %>
            </a>
        </li>
        <li>
            <a href="/admin/hizmet-talepleri" class="nav-link rounded-3 d-flex justify-content-between align-items-center <%= activePage === 'services' ? 'active' : '' %>">
                <span><i class="fa-solid fa-handshake fa-fw me-2"></i> Hizmet Talepleri</span>
                <% if (typeof pendingServices !== 'undefined' && pendingServices > 0) { %>
                    <span class="badge bg-warning text-dark rounded-pill"><%= pendingServices %></span>
                <% } %>
            </a>
        </li>
        <li>
            <a href="/admin/canli-destek" class="nav-link rounded-3 d-flex justify-content-between align-items-center <%= activePage === 'support' ? 'active' : '' %>">
                <span><i class="fa-solid fa-headset fa-fw me-2"></i> Canlı Destek</span>
                <% if (typeof pendingSupport !== 'undefined' && pendingSupport > 0) { %>
                    <span class="badge bg-danger rounded-pill"><%= pendingSupport %></span>
                <% } %>
            </a>
        </li>
        <li>
            <a href="/admin/duyuru" class="nav-link rounded-3 <%= activePage === 'broadcast' ? 'active' : '' %>">
                <span><i class="fa-solid fa-bullhorn fa-fw me-2"></i> Duyuru Gönder</span>
            </a>
        </li>
        <li>
            <a href="/admin/geri-bildirim" class="nav-link rounded-3 d-flex justify-content-between align-items-center <%= activePage === 'feedback' ? 'active' : '' %>">
                <span><i class="fa-solid fa-lightbulb fa-fw me-2"></i> Öneri &amp; Hata</span>
                <% if (typeof pendingFeedback !== 'undefined' && pendingFeedback > 0) { %>
                    <span class="badge bg-warning text-dark rounded-pill"><%= pendingFeedback %></span>
                <% } %>
            </a>
        </li>
        <li>
            <a href="/admin/bakim" class="nav-link rounded-3 d-flex justify-content-between align-items-center <%= activePage === 'maintenance' ? 'active' : '' %>">
                <span><i class="fa-solid fa-sliders fa-fw me-2"></i> Sistem &amp; Ayarlar</span>
                <div class="d-flex gap-1">
                    <% if (typeof unlimitedOn !== 'undefined' && unlimitedOn) { %>
                        <span class="badge bg-success rounded-pill" title="Sınırsız İlan Modu Açık"><i class="fa-solid fa-infinity"></i></span>
                    <% } %>
                    <% if (typeof maintenanceOn !== 'undefined' && maintenanceOn) { %>
                        <span class="badge bg-danger rounded-pill">BAKIM</span>
                    <% } %>
                </div>
            </a>
        </li>
    </ul>
    <hr class="border-secondary">
    <div class="px-2">
        <a href="/" class="btn btn-outline-light btn-sm w-100 mb-2"><i class="fa-solid fa-arrow-left me-2"></i>Siteye Dön</a>
        <form action="/auth/logout" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-outline-danger btn-sm w-100"><%= t('nav.logout') %></button>
        </form>
    </div>
</aside>

<main class="admin-main">
    <nav class="navbar bg-white px-3 py-2 shadow-sm d-lg-none sticky-top">
        <button class="btn btn-light" type="button" id="adminSidebarToggle"
                aria-controls="adminSidebar" aria-expanded="false" aria-label="Menü">
            <i class="fa-solid fa-bars"></i>
        </button>
        <span class="fw-bold">CYPILAN Admin</span>
    </nav>

    <div class="p-3 p-md-4">
        <% if (typeof flash !== 'undefined' && flash && (flash.success || flash.error || flash.info)) { %>
            <% if (flash.error) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= flash.error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            <% if (flash.success) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= flash.success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            <% if (flash.info) { %>
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    <%= flash.info %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
        <% } %>

        <%- body %>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
    var sidebar = document.getElementById('adminSidebar');
    var backdrop = document.getElementById('adminBackdrop');
    var toggle = document.getElementById('adminSidebarToggle');
    var closeBtn = document.getElementById('adminSidebarClose');
    if (!sidebar || !toggle) return;

    function setOpen(open) {
        sidebar.classList.toggle('show', open);
        backdrop.hidden = false;
        backdrop.classList.toggle('show', open);
        document.body.classList.toggle('admin-drawer-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        if (open) {
            var firstLink = sidebar.querySelector('.nav-link');
            if (firstLink) firstLink.focus();
        }
    }

    toggle.addEventListener('click', function () {
        setOpen(!sidebar.classList.contains('show'));
    });
    backdrop.addEventListener('click', function () { setOpen(false); });
    if (closeBtn) closeBtn.addEventListener('click', function () {
        setOpen(false);
        toggle.focus();
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && sidebar.classList.contains('show')) setOpen(false);
    });

    // Crossing into the desktop layout leaves the drawer state behind.
    window.matchMedia('(min-width: 992px)').addEventListener('change', function (e) {
        if (e.matches) setOpen(false);
    });
})();
</script>

<!-- Global Real-Time Live Support Admin Notification System -->
<div id="adminSupportToastContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 1080;"></div>

<script>
(function() {
    let audioCtx = null;
    let audioUnlocked = false;
    let originalTitle = document.title;
    let titleBlinkInterval = null;
    let knownLastMessageAt = null;
    let previousWaitingCount = <%= typeof pendingSupport !== 'undefined' ? pendingSupport : 0 %>;

    function initAudio() {
        if (audioUnlocked) return;
        try {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (AudioContext) {
                audioCtx = new AudioContext();
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
                audioUnlocked = true;
            }
        } catch(e) {}
    }

    document.addEventListener('click', initAudio, { once: true });
    document.addEventListener('keydown', initAudio, { once: true });

    function playChime() {
        try {
            if (!audioCtx) {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                if (AudioContext) audioCtx = new AudioContext();
            }
            if (audioCtx) {
                if (audioCtx.state === 'suspended') audioCtx.resume();
                const now = audioCtx.currentTime;
                // High clarity two-tone notification bell
                const osc1 = audioCtx.createOscillator();
                const gain1 = audioCtx.createGain();
                osc1.type = 'sine';
                osc1.frequency.setValueAtTime(587.33, now); // D5
                osc1.frequency.exponentialRampToValueAtTime(880, now + 0.12); // A5
                gain1.gain.setValueAtTime(0.35, now);
                gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
                osc1.connect(gain1);
                gain1.connect(audioCtx.destination);
                osc1.start(now);
                osc1.stop(now + 0.35);

                const osc2 = audioCtx.createOscillator();
                const gain2 = audioCtx.createGain();
                osc2.type = 'sine';
                osc2.frequency.setValueAtTime(1174.66, now + 0.12); // D6
                gain2.gain.setValueAtTime(0.35, now + 0.12);
                gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.5);
                osc2.connect(gain2);
                gain2.connect(audioCtx.destination);
                osc2.start(now + 0.12);
                osc2.stop(now + 0.5);
            }
        } catch(err) {
            console.error('Audio alert error:', err);
        }
    }

    function showSupportAlertToast(latest, waitingCount) {
        const container = document.getElementById('adminSupportToastContainer');
        if (!container) return;

        const toastEl = document.createElement('div');
        toastEl.className = 'toast align-items-center text-white bg-dark border-0 shadow-lg mb-2 show';
        toastEl.setAttribute('role', 'alert');
        toastEl.setAttribute('aria-live', 'assertive');
        toastEl.setAttribute('aria-atomic', 'true');
        toastEl.innerHTML = `
            <div class="d-flex p-3 align-items-start gap-3">
                <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px;">
                    <i class="fa-solid fa-headset fs-5"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center justify-content-between">
                        <strong class="text-warning small"><i class="fa-solid fa-bell me-1"></i>Yeni Canlı Destek Talebi!</strong>
                        <span class="badge bg-danger rounded-pill">${waitingCount} Bekleyen</span>
                    </div>
                    <div class="fw-bold mt-1 text-white">${latest && latest.user_name ? escapeHtml(latest.user_name) : 'Bir Ziyaretçi'}</div>
                    <div class="text-light small text-truncate mt-1" style="max-width: 240px; opacity: 0.85;">
                        ${latest && latest.last_message ? escapeHtml(latest.last_message) : 'Mesaj bekliyor...'}
                    </div>
                    <div class="mt-2 pt-1">
                        <a href="/admin/canli-destek" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold">
                            <i class="fa-solid fa-comments me-1"></i>Hemen Yanıtla
                        </a>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
            </div>
        `;
        container.appendChild(toastEl);

        const closeBtn = toastEl.querySelector('.btn-close');
        if (closeBtn) {
            closeBtn.addEventListener('click', () => toastEl.remove());
        }
        setTimeout(() => { if (toastEl.parentNode) toastEl.remove(); }, 12000);
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function startTitleBlink(count) {
        if (titleBlinkInterval) clearInterval(titleBlinkInterval);
        let toggle = false;
        titleBlinkInterval = setInterval(() => {
            document.title = toggle ? `(${count}) 🔔 Yeni Destek Talebi!` : originalTitle;
            toggle = !toggle;
        }, 1200);

        window.addEventListener('focus', () => {
            clearInterval(titleBlinkInterval);
            document.title = originalTitle;
        }, { once: true });
    }

    async function checkSupportHeartbeat() {
        try {
            const res = await fetch('/admin/canli-destek/heartbeat');
            const data = await res.json();
            if (!data || !data.success) return;

            const waiting = data.waitingCount || 0;
            const latest = data.latest || null;

            // Update sidebar badge
            const supportBadge = document.querySelector('a[href="/admin/canli-destek"] .badge');
            if (waiting > 0) {
                if (supportBadge) {
                    supportBadge.textContent = waiting;
                    supportBadge.style.display = 'inline-block';
                } else {
                    const navLink = document.querySelector('a[href="/admin/canli-destek"]');
                    if (navLink) {
                        const newBadge = document.createElement('span');
                        newBadge.className = 'badge bg-danger rounded-pill';
                        newBadge.textContent = waiting;
                        navLink.appendChild(newBadge);
                    }
                }
            } else if (supportBadge) {
                supportBadge.style.display = 'none';
            }

            // Check if there is a new waiting conversation or message
            const isNewer = latest && latest.last_message_at && latest.last_message_at !== knownLastMessageAt;
            const countIncreased = waiting > previousWaitingCount;

            if (waiting > 0 && (countIncreased || (isNewer && knownLastMessageAt !== null))) {
                playChime();
                showSupportAlertToast(latest, waiting);
                startTitleBlink(waiting);
            }

            if (latest && latest.last_message_at) {
                knownLastMessageAt = latest.last_message_at;
            }
            previousWaitingCount = waiting;
        } catch(err) {}
    }

    setInterval(checkSupportHeartbeat, 5000);
})();
</script>

<% if (typeof script !== 'undefined' && script) { %><%- script %><% } %>
</body>
</html>

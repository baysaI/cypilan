<%
const reasonLabels = {
  wrong_category: 'Yanlış kategori',
  misleading_price: 'Yanıltıcı fiyat',
  missing_photos: 'Eksik fotoğraf',
  spam: 'Spam',
  fraud: 'Dolandırıcılık',
  inappropriate: 'Uygunsuz içerik',
  harassment: 'Taciz veya hakaret',
  other: 'Diğer'
};
const statusLabels = {
  pending: ['warning', 'Bekliyor'],
  reviewed: ['info', 'İncelendi'],
  resolved: ['success', 'Çözüldü'],
  dismissed: ['secondary', 'Reddedildi']
};
const pag = (typeof pagination !== 'undefined' && pagination) ? pagination : { page: 1, totalItems: 0, totalPages: 1 };
const f = (typeof filters !== 'undefined' && filters) ? filters : {};
const list = (typeof reports !== 'undefined' && reports) ? reports : [];
%>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="fs-4 fw-bold mb-0">Şikayetler <span class="text-muted fw-normal fs-6">(<%= pag.totalItems %>)</span></h1>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="GET" action="/admin/reports" class="row g-2 align-items-center">
            <div class="col-8 col-md-4">
                <select name="status" class="form-select">
                    <option value="pending" <%= f.status === 'pending' ? 'selected' : '' %>>Bekleyen</option>
                    <option value="reviewed" <%= f.status === 'reviewed' ? 'selected' : '' %>>İncelenen</option>
                    <option value="resolved" <%= f.status === 'resolved' ? 'selected' : '' %>>Çözülen</option>
                    <option value="dismissed" <%= f.status === 'dismissed' ? 'selected' : '' %>>Reddedilen</option>
                </select>
            </div>
            <div class="col-4 col-md-3 d-grid">
                <button class="btn btn-primary">Filtrele</button>
            </div>
        </form>
    </div>
</div>

<% if (list.length === 0) { %>
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="fa-solid fa-flag fs-1 text-muted opacity-25 d-block mb-3"></i>
            <p class="text-muted mb-0">Bu durumda şikayet yok.</p>
        </div>
    </div>
<% } else { %>
    <div class="row g-3">
        <% list.forEach(function(r) { %>
            <% const [color, label] = statusLabels[r.status] || ['secondary', r.status]; %>
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
                            <div>
                                <span class="badge bg-<%= color %> bg-opacity-10 text-<%= color %> rounded-pill px-2 me-2"><%= label %></span>
                                <strong><%= reasonLabels[r.reason] || r.reason %></strong>
                            </div>
                            <small class="text-muted text-nowrap"><%= helpers.timeAgo(r.created_at, 'tr') %></small>
                        </div>

                        <p class="small text-muted mb-2">
                            <% if (r.listing_id) { %>
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2 me-1">İlan</span>
                                <% if (r.listing_slug) { %>
                                    <a href="/listings/<%= r.listing_slug %>" target="_blank" rel="noopener"><%= r.listing_title %></a>
                                <% } else { %>
                                    <em>silinmiş</em>
                                <% } %>
                            <% } else { %>
                                <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2 me-1">Kullanıcı</span>
                            <% } %>
                            <% if (r.reported_user_id) { %>
                                &middot; Şikayet edilen:
                                <a href="/profile/<%= r.reported_user_id %>" target="_blank" rel="noopener"><%= r.reported_user_name || 'bilinmiyor' %></a>
                                <% if (Number(r.reported_user_active) === 0) { %>
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2">askıda</span>
                                <% } %>
                            <% } %>
                            &middot; Bildiren: <%= r.reporter_name || 'bilinmiyor' %>
                        </p>

                        <% if (r.message_content) { %>
                            <div class="border-start border-3 ps-3 mb-3 small text-muted fst-italic">
                                Son mesaj: <%= r.message_content %>
                            </div>
                        <% } %>

                        <% if (r.description) { %>
                            <p class="mb-3"><%= r.description %></p>
                        <% } %>

                        <% if (r.reported_user_id && Number(r.reported_user_active) !== 0) { %>
                            <form action="/admin/users/<%= r.reported_user_id %>/status" method="POST" class="d-inline mb-3">
                                <input type="hidden" name="_method" value="PUT">
                                <input type="hidden" name="status" value="suspended">
                                <button class="btn btn-sm btn-outline-danger mb-3">
                                    <i class="fa-solid fa-ban me-1"></i>Kullanıcıyı askıya al
                                </button>
                            </form>
                        <% } %>

                        <% if (r.admin_note) { %>
                            <p class="small text-muted mb-3">Yönetici notu: <%= r.admin_note %></p>
                        <% } %>

                        <% if (r.status === 'pending' || r.status === 'reviewed') { %>
                            <form action="/admin/reports/<%= r.id %>" method="POST" class="row g-2 align-items-center">
                                <input type="hidden" name="_method" value="PUT">
                                <div class="col-12 col-md-6">
                                    <input type="text" name="admin_note" class="form-control form-control-sm" placeholder="Not (opsiyonel)">
                                </div>
                                <div class="col-auto">
                                    <button name="status" value="resolved" class="btn btn-sm btn-success">Çözüldü</button>
                                </div>
                                <div class="col-auto">
                                    <button name="status" value="dismissed" class="btn btn-sm btn-outline-secondary">Reddet</button>
                                </div>
                            </form>
                        <% } %>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>
<% } %>

<%- include('_pagination', { pagination: pag, baseUrl: '/admin/reports', query: f }) %>

<%
    const verification = catalog.filter(function (b) { return !b.defaultDays; });
    const periodic = catalog.filter(function (b) { return Boolean(b.defaultDays); });
    const displayName = targetUser.company_name || targetUser.full_name;
    const today = new Date().toISOString().slice(0, 10);
%>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
    <div>
        <h1 class="h4 fw-bold mb-1">Rozetler &amp; Unvanlar</h1>
        <p class="text-muted small mb-0">
            <strong><%= displayName %></strong> &middot; <%= targetUser.email %>
        </p>
    </div>
    <a href="/admin/users" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
        <i class="fa-solid fa-arrow-left me-1"></i>Kullanıcılara Dön
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h2 class="fs-6 fw-bold mb-3"><i class="fa-solid fa-award text-warning me-2"></i>Rozet Ver</h2>

                <form action="/admin/users/<%= targetUser.id %>/rozetler" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="badgeKey">Rozet</label>
                        <select class="form-select" name="badgeKey" id="badgeKey" required>
                            <optgroup label="Doğrulama rozetleri (kalıcı)">
                                <% verification.forEach(function (b) { %>
                                    <option value="<%= b.key %>"><%= t('badges.' + b.key) %></option>
                                <% }); %>
                            </optgroup>
                            <optgroup label="Dönemsel unvanlar (süreli)">
                                <% periodic.forEach(function (b) { %>
                                    <option value="<%= b.key %>"><%= t('badges.' + b.key) %> — varsayılan <%= b.defaultDays %> gün</option>
                                <% }); %>
                            </optgroup>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="expiryMode">Süre</label>
                        <select class="form-select" name="expiryMode" id="expiryMode">
                            <option value="default">Rozetin varsayılan süresi</option>
                            <option value="never">Süresiz</option>
                            <option value="custom">Tarih seç</option>
                        </select>
                        <div class="form-text small">
                            Dönemsel unvanlar süresi dolunca kendiliğinden düşer; kaldırmayı hatırlamanız gerekmez.
                        </div>
                    </div>

                    <div class="mb-3 d-none" id="expiryDateWrap">
                        <label class="form-label small fw-semibold" for="expiresAt">Bitiş tarihi</label>
                        <input type="date" class="form-control" name="expiresAt" id="expiresAt" min="<%= today %>">
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold" for="note">Not <span class="text-muted fw-normal">(isteğe bağlı)</span></label>
                        <input type="text" class="form-control" name="note" id="note" maxlength="200"
                               placeholder="Örn. Ocak ayı en yüksek puanlı emlakçı">
                        <div class="form-text small">Rozetin üzerine gelince görünür.</div>
                    </div>

                    <button type="submit" class="btn btn-success fw-medium px-4">
                        <i class="fa-solid fa-medal me-2"></i>Rozeti Ver ve Bildir
                    </button>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h2 class="fs-6 fw-bold mb-3">Bu Kullanıcının Rozetleri</h2>

                <% if (!badgeRows.length) { %>
                    <p class="text-muted small mb-0">Henüz rozeti yok.</p>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light small text-muted">
                                <tr>
                                    <th>Rozet</th>
                                    <th class="d-none d-md-table-cell">Veren</th>
                                    <th>Bitiş</th>
                                    <th class="text-end">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% badgeRows.forEach(function (row) { %>
                                    <% const def = userBadges.describe(row.badge_key); %>
                                    <tr class="<%= row.is_expired ? 'opacity-50' : '' %>">
                                        <td>
                                            <span class="badge rounded-pill bg-<%= def.variant %>-subtle text-<%= def.variant %>-emphasis border border-<%= def.variant %>-subtle fw-semibold">
                                                <i class="fa-solid <%= def.icon %> me-1"></i><%= t('badges.' + row.badge_key) %>
                                            </span>
                                            <% if (row.note) { %>
                                                <div class="small text-muted mt-1"><%= row.note %></div>
                                            <% } %>
                                        </td>
                                        <td class="small text-muted d-none d-md-table-cell">
                                            <%= row.granted_by_name || '—' %><br>
                                            <%= helpers.timeAgo(row.granted_at, lang) %>
                                        </td>
                                        <td class="small">
                                            <% if (!row.expires_at) { %>
                                                <span class="text-muted">Süresiz</span>
                                            <% } else if (row.is_expired) { %>
                                                <span class="text-danger fw-semibold">Süresi doldu</span>
                                            <% } else { %>
                                                <%= helpers.formatDate(row.expires_at, lang) %>
                                            <% } %>
                                        </td>
                                        <td class="text-end">
                                            <form action="/admin/users/<%= targetUser.id %>/rozetler/kaldir" method="POST" class="d-inline"
                                                  onsubmit="return confirm('Bu rozeti kaldırmak istediğinize emin misiniz?');">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="badgeKey" value="<%= row.badge_key %>">
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Kaldır</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h3 class="fs-6 fw-bold mb-3"><i class="fa-solid fa-circle-info text-primary me-2"></i>Rozet Verince Ne Oluyor?</h3>
                <ul class="small text-muted mb-0 ps-3">
                    <li class="mb-2"><strong>Kullanıcıya bildirim gider:</strong> kendi dilinde, "tebrikler" mesajıyla ve profiline bağlantıyla.</li>
                    <li class="mb-2"><strong>İki yerde görünür:</strong> herkese açık profilinde ve ilanlarındaki satıcı kutusunda.</li>
                    <li class="mb-2"><strong>Aynı rozeti tekrar vermek</strong> ikinci bir etiket eklemez, sürenin bitişini öteler.</li>
                    <li class="mb-0"><strong>Kaldırmak sessizdir:</strong> kullanıcıya rozetini kaybettiğine dair bildirim gitmez.</li>
                </ul>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h3 class="fs-6 fw-bold mb-3">Dönemsel Unvanlar Şu An Kimde?</h3>
                <% let anyHolder = false; %>
                <% periodic.forEach(function (b) { %>
                    <% const list = holders[b.key] || []; %>
                    <% if (list.length) { anyHolder = true; %>
                        <div class="mb-3">
                            <div class="small fw-semibold"><%= t('badges.' + b.key) %></div>
                            <% list.forEach(function (h) { %>
                                <div class="small text-muted">
                                    <a href="/admin/users/<%= h.user_id %>/rozetler" class="text-decoration-none">
                                        <%= h.company_name || h.full_name %>
                                    </a>
                                    <% if (h.expires_at) { %>
                                        &middot; <%= helpers.formatDate(h.expires_at, lang) %>'e kadar
                                    <% } %>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                <% }); %>
                <% if (!anyHolder) { %>
                    <p class="text-muted small mb-0">Şu an başka kimsede dönemsel unvan yok.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var mode = document.getElementById('expiryMode');
        var wrap = document.getElementById('expiryDateWrap');
        var input = document.getElementById('expiresAt');
        if (!mode || !wrap) return;

        function sync() {
            var custom = mode.value === 'custom';
            wrap.classList.toggle('d-none', !custom);
            // Tarih alani gizliyken required kalirsa form hic gonderilemez ve
            // tarayici gorunmeyen bir alani isaret eder.
            if (input) input.required = custom;
        }

        mode.addEventListener('change', sync);
        sync();
    })();
</script>

<%
const pag = (typeof pagination !== 'undefined' && pagination) ? pagination : { page: 1, totalItems: 0, totalPages: 1 };
const f = (typeof filters !== 'undefined' && filters) ? filters : {};
const list = (typeof users !== 'undefined' && users) ? users : [];
const activeAdminUser = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : ((typeof user !== 'undefined' && user) ? user : {});
%>

<style>
.user-row-pending {
    background-color: rgba(245, 158, 11, 0.08) !important;
    border-left: 4px solid #f59e0b !important;
}
.user-row-pending td {
    background-color: transparent !important;
    color: #1e293b !important;
}
.user-row-pending a.user-name-link {
    color: #0f172a !important;
}
.user-row-pending .user-email-text {
    color: #334155 !important;
}
[data-bs-theme="dark"] .user-row-pending {
    background-color: rgba(245, 158, 11, 0.16) !important;
    border-left: 4px solid #f59e0b !important;
}
[data-bs-theme="dark"] .user-row-pending td,
[data-bs-theme="dark"] .user-row-pending a.user-name-link {
    color: #f8fafc !important;
}
[data-bs-theme="dark"] .user-row-pending .user-email-text {
    color: #cbd5e1 !important;
}
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="fs-4 fw-bold mb-0">Kullanıcılar <span class="text-muted fw-normal fs-6">(<%= pag.totalItems %>)</span></h1>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="GET" action="/admin/users" class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <input type="text" name="q" class="form-control" placeholder="Ad veya e-posta" value="<%= f.q || '' %>">
            </div>
            <div class="col-6 col-md-3">
                <select name="role" class="form-select">
                    <option value="">Tüm roller</option>
                    <option value="pending_corporate" <%= f.role === 'pending_corporate' ? 'selected' : '' %>>⏳ Kurumsal Onay Bekleyenler</option>
                    <option value="user" <%= f.role === 'user' ? 'selected' : '' %>>Bireysel</option>
                    <option value="business" <%= f.role === 'business' ? 'selected' : '' %>>Kurumsal</option>
                    <option value="agent" <%= f.role === 'agent' ? 'selected' : '' %>>Danışman</option>
                    <option value="admin" <%= f.role === 'admin' ? 'selected' : '' %>>Yönetici</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select name="corporateType" class="form-select">
                    <option value="">Tüm Kurumsal Gruplar</option>
                    <option value="real_estate" <%= (f.corporate_type === 'real_estate' || f.corporateType === 'real_estate') ? 'selected' : '' %>>🏡 Emlak Ofisleri</option>
                    <option value="auto" <%= (f.corporate_type === 'auto' || f.corporateType === 'auto') ? 'selected' : '' %>>🚗 Oto Galerileri</option>
                    <option value="service" <%= (f.corporate_type === 'service' || f.corporateType === 'service') ? 'selected' : '' %>>🛠️ Usta & Hizmet</option>
                    <option value="construction" <%= (f.corporate_type === 'construction' || f.corporateType === 'construction') ? 'selected' : '' %>>🏗️ İnşaat / Tedarik</option>
                    <option value="shopping" <%= (f.corporate_type === 'shopping' || f.corporateType === 'shopping') ? 'selected' : '' %>>🛍️ Mağaza & Perakende</option>
                    <option value="other" <%= (f.corporate_type === 'other' || f.corporateType === 'other') ? 'selected' : '' %>>🏢 Diğer İşletme</option>
                </select>
            </div>
            <div class="col-12 col-md-2 d-grid">
                <button class="btn btn-primary">Filtrele</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <% if (list.length === 0) { %>
            <p class="text-muted text-center py-5 mb-0">Bu filtreye uyan kullanıcı yok.</p>
        <% } else { %>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-muted">
                        <tr>
                            <th class="ps-3">Kullanıcı</th>
                            <th class="d-none d-md-table-cell">Telefon</th>
                            <th>Rol / Kurumsal Durum</th>
                            <th class="d-none d-sm-table-cell">İlan</th>
                            <th class="d-none d-md-table-cell">E-posta Onayı</th>
                            <th>Hesap Durumu</th>
                            <th>Son Aktiflik</th>
                            <th>Uyarı</th>
                            <th class="pe-3 text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% list.forEach(function(u) { %>
                            <% const seen = helpers.lastSeenState(u.last_seen_at); %>
                            <tr class="<%= u.corporate_status === 'pending' ? 'user-row-pending' : '' %>">
                                <td class="ps-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="d-inline-block rounded-circle flex-shrink-0 <%= seen.online ? 'bg-success shadow-sm' : 'bg-secondary opacity-50' %>"
                                              style="width: 8px; height: 8px;"
                                              title="<%= seen.online ? 'Şu anda çevrimiçi' : (seen.known ? 'Son aktiflik: ' + helpers.formatDateTime(u.last_seen_at, lang) : 'Aktiflik kaydı yok') %>"></span>
                                        <a href="/profile/<%= u.id %>" target="_blank" rel="noopener" class="fw-bold text-decoration-none d-inline-flex align-items-center gap-1 hover-primary user-name-link" title="Kullanıcı Profilini Aç">
                                            <span><%= u.company_name || u.full_name %></span>
                                            <i class="fa-solid fa-arrow-up-right-from-square text-primary small" style="font-size: 0.70rem;"></i>
                                        </a>
                                    </div>
                                    <div class="user-email-text small ms-3 fw-medium"><%= u.email %></div>
                                    <% if (u.company_name && u.company_name !== u.full_name) { %>
                                        <div class="text-secondary small ms-3" style="font-size: 0.73rem;">
                                            <i class="fa-regular fa-id-card me-1"></i><%= u.full_name %>
                                        </div>
                                    <% } %>
                                    <% if (u.created_at) { %>
                                        <div class="text-secondary opacity-75 small ms-3 mt-1" style="font-size: 0.73rem;" title="Kayıt Zamanı: <%= helpers.formatDateTime(u.created_at, lang) %>">
                                            <i class="fa-regular fa-calendar-plus me-1"></i>Kayıt: <%= helpers.formatDate(u.created_at, lang) %>
                                        </div>
                                    <% } %>
                                </td>
                                <td class="d-none d-md-table-cell small"><%= u.phone || '-' %></td>
                                <td>
                                    <div class="d-flex flex-column gap-1 align-items-start">
                                        <div class="d-flex flex-wrap gap-1 align-items-center">
                                            <span class="badge <%= (u.role === 'business' || u.role === 'agent') ? 'bg-primary bg-opacity-10 text-primary border border-primary-subtle' : (u.role === 'admin' ? 'bg-danger bg-opacity-10 text-danger border border-danger-subtle' : 'bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle') %> rounded-pill px-2 py-0.5">
                                                <%= u.role === 'business' ? 'Kurumsal' : (u.role === 'agent' ? 'Emlakçı' : (u.role === 'admin' ? 'Yönetici' : 'Bireysel')) %>
                                            </span>
                                            <% if (u.corporate_type) { %>
                                                <%
                                                    const corpTypeMap = {
                                                        real_estate: { label: 'Emlak Ofisi', icon: 'fa-house-chimney-user', cls: 'badge bg-info bg-opacity-10 text-info border border-info-subtle' },
                                                        auto: { label: 'Oto Galeri', icon: 'fa-car', cls: 'badge bg-warning bg-opacity-10 text-warning border border-warning-subtle' },
                                                        service: { label: 'Usta & Hizmet', icon: 'fa-screwdriver-wrench', cls: 'badge bg-primary bg-opacity-10 text-primary border border-primary-subtle' },
                                                        construction: { label: 'İnşaat/Tedarik', icon: 'fa-trowel-bricks', cls: 'badge bg-success bg-opacity-10 text-success border border-success-subtle' },
                                                        shopping: { label: 'Mağaza/2.El', icon: 'fa-bag-shopping', cls: 'badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle' },
                                                        other: { label: 'Kurumsal', icon: 'fa-building', cls: 'badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle' }
                                                    };
                                                    const cBadge = corpTypeMap[u.corporate_type] || corpTypeMap.other;
                                                %>
                                                <span class="<%= cBadge.cls %> rounded-pill px-2 py-0.5" style="font-size: 0.70rem;">
                                                    <i class="fa-solid <%= cBadge.icon %> me-1"></i><%= cBadge.label %>
                                                </span>
                                            <% } %>
                                        </div>
                                        <% if (u.corporate_status === 'pending') { %>
                                            <span class="badge bg-warning text-dark border border-warning-subtle rounded-pill px-2 py-1 shadow-sm d-inline-flex align-items-center gap-1" style="font-size: 0.72rem;" title="Kurumsal Hesap Başvurusu">
                                                <i class="fa-solid fa-hourglass-half text-dark"></i> Onay Bekliyor
                                            </span>
                                            <% if (u.corporate_tax_no) { %>
                                                <span class="text-secondary small" style="font-size: 0.70rem;">VKN: <%= u.corporate_tax_no %></span>
                                            <% } %>
                                        <% } else if (u.corporate_status === 'approved') { %>
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle rounded-pill px-2" style="font-size: 0.70rem;">
                                                <i class="fa-solid fa-check me-1"></i>Kurumsal Onaylı
                                            </span>
                                        <% } %>
                                    </div>
                                </td>
                                <td class="d-none d-sm-table-cell">
                                    <a href="/profile/<%= u.id %>" target="_blank" rel="noopener" class="text-decoration-none"><%= u.listing_count || 0 %></a>
                                </td>
                                <td class="d-none d-md-table-cell">
                                    <% if (u.is_verified) { %>
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2" title="E-posta Doğrulanmış">
                                            <i class="fa-solid fa-circle-check me-1"></i>Onaylı
                                        </span>
                                    <% } else { %>
                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2" title="E-posta Henüz Doğrulanmamış">
                                            <i class="fa-solid fa-clock me-1"></i>Onaysız
                                        </span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (u.is_active) { %>
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2" title="Hesap Aktif">Aktif Hesap</span>
                                    <% } else { %>
                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2" title="Hesap Askıda">Askıda</span>
                                    <% } %>
                                </td>
                                <td class="small text-nowrap">
                                    <% if (!seen.known) { %>
                                        <span class="text-muted" title="Bu hesap hiç görülmedi (son aktiflik kaydı tutulmaya başlamadan önce oluşturulmuş olabilir)">&mdash;</span>
                                    <% } else { %>
                                        <span title="<%= helpers.formatDateTime(u.last_seen_at, lang) %>">
                                            <span class="d-inline-block rounded-circle align-middle me-1 <%= seen.online ? 'bg-success shadow-sm' : 'bg-secondary opacity-50' %>"
                                                  style="width: 8px; height: 8px;" aria-hidden="true"></span>
                                            <span class="<%= seen.online ? 'text-success fw-bold' : 'text-muted' %>"><%= seen.online ? 'Çevrimiçi' : helpers.timeAgo(u.last_seen_at, lang) %></span>
                                        </span>
                                    <% } %>
                                </td>
                                <td>
                                    <%
                                        const warnCount = (typeof warningCounts !== 'undefined' && warningCounts[u.id]) || 0;
                                        const warnHistory = (typeof warningHistory !== 'undefined' && warningHistory[u.id]) || [];
                                    %>
                                    <%# The count is the way into the history: clicking it opens the same
                                        panel the "Uyar" button does, one row down. %>
                                    <% if (warnCount > 0 || warnHistory.length > 0) { %>
                                        <button type="button"
                                                class="btn btn-sm border-0 p-0 bg-transparent"
                                                data-bs-toggle="collapse" data-bs-target="#warnForm<%= u.id %>"
                                                title="Uyarı geçmişini aç (<%= warnHistory.length %> kayıt)">
                                            <span class="badge <%= warnCount > 0 ? 'bg-warning bg-opacity-10 text-warning' : 'bg-secondary bg-opacity-10 text-secondary' %> rounded-pill px-2">
                                                <i class="fa-solid fa-triangle-exclamation me-1"></i><%= warnCount %>/<%= suspensionThreshold %>
                                            </span>
                                        </button>
                                    <% } else { %>
                                        <span class="text-muted small">&mdash;</span>
                                    <% } %>
                                </td>
                                <td class="pe-3 text-end text-nowrap">
                                    <% if (u.corporate_status === 'pending') { %>
                                        <form action="/admin/users/<%= u.id %>/kurumsal-onayla" method="POST" class="d-inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" name="role" value="business">
                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-2 me-1 shadow-sm" title="Kurumsal Olarak Onayla">
                                                <i class="fa-solid fa-check me-1"></i>Kurumsala Çek
                                            </button>
                                        </form>
                                        <form action="/admin/users/<%= u.id %>/kurumsal-reddet" method="POST" class="d-inline" onsubmit="return confirm('Kurumsal hesap başvurusunu reddetmek istediğinize emin misiniz?');">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 me-1" title="Başvuruyu Reddet">
                                                <i class="fa-solid fa-xmark"></i>
                                            </button>
                                        </form>
                                    <% } %>
                                    <a href="/profile/<%= u.id %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary me-1" title="Profili Görüntüle">
                                        <i class="fa-regular fa-user"></i>
                                    </a>
                                    <button class="btn btn-sm btn-outline-primary btn-edit-user me-1" type="button"
                                            data-id="<%= u.id %>"
                                            data-name="<%= u.full_name || '' %>"
                                            data-email="<%= u.email || '' %>"
                                            data-phone="<%= u.phone || '' %>"
                                            data-role="<%= u.role || 'user' %>"
                                            data-company="<%= u.company_name || '' %>"
                                            data-corporate-status="<%= u.corporate_status || 'none' %>"
                                            data-corporate-type="<%= u.corporate_type || '' %>"
                                            data-is-verified="<%= u.is_verified ? '1' : '0' %>"
                                            data-listings="<%= u.listing_count || 0 %>"
                                            title="Düzenle">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>
                                    <% if (u.id === activeAdminUser.id) { %>
                                        <span class="text-muted small ms-1">(Siz)</span>
                                    <% } else { %>
                                        <button class="btn btn-sm btn-outline-warning me-1" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#warnForm<%= u.id %>">
                                            Uyar
                                        </button>
                                        <form action="/admin/users/<%= u.id %>/status" method="POST" class="d-inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" name="_method" value="PUT">
                                            <input type="hidden" name="status" value="<%= u.is_active ? 'suspended' : 'active' %>">
                                            <button class="btn btn-sm <%= u.is_active ? 'btn-outline-danger' : 'btn-outline-success' %> me-1" title="<%= u.is_active ? 'Hesabı Askıya Al' : 'Hesabı Aktifleştir' %>">
                                                <%= u.is_active ? 'Askıya Al' : 'Aktifleştir' %>
                                            </button>
                                        </form>
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-delete-user"
                                                data-id="<%= u.id %>"
                                                data-name="<%= (u.company_name || u.full_name || '') %>"
                                                data-email="<%= u.email || '' %>"
                                                data-listings="<%= u.listing_count || 0 %>"
                                                title="Kullanıcıyı ve Tüm Verilerini Kalıcı Olarak Sil">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    <% } %>
                                </td>
                            </tr>
                            <%# Rendered for every row, including the admin's own: they cannot warn
                                themselves, but they can still read a history somebody else recorded. %>
                            <tr class="collapse" id="warnForm<%= u.id %>">
                                <td colspan="9" class="bg-light">

                                    <div class="py-2">
                                        <h3 class="fs-6 fw-bold mb-2 d-flex align-items-center gap-2">
                                            <i class="fa-solid fa-clock-rotate-left text-secondary"></i>
                                            Uyarı Geçmişi
                                            <span class="text-muted fw-normal small">(<%= warnHistory.length %> kayıt, <%= warnCount %> aktif)</span>
                                        </h3>

                                        <% if (warnHistory.length === 0) { %>
                                            <p class="text-muted small mb-0">Bu kullanıcıya hiç uyarı verilmemiş.</p>
                                        <% } else { %>
                                            <div class="table-responsive">
                                                <table class="table table-sm bg-white align-middle mb-0 border">
                                                    <thead class="table-light small text-muted">
                                                        <tr>
                                                            <th>Gerekçe</th>
                                                            <th>Yönetici Notu</th>
                                                            <th class="d-none d-md-table-cell">Veren</th>
                                                            <th class="d-none d-sm-table-cell">Tarih</th>
                                                            <th>Durum</th>
                                                            <th class="text-end">İşlem</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% warnHistory.forEach(function (w) { %>
                                                            <% const isStanding = Number(w.is_active) === 1; %>
                                                            <tr class="<%= isStanding ? '' : 'text-muted' %>">
                                                                <td class="small fw-semibold">
                                                                    <%= t('report_modal.reasons.' + w.reason) %>
                                                                </td>
                                                                <td class="small" style="max-width: 320px;">
                                                                    <% if (w.note) { %>
                                                                        <span class="text-break-anywhere"><%= w.note %></span>
                                                                    <% } else { %>
                                                                        <span class="text-muted">&mdash;</span>
                                                                    <% } %>
                                                                </td>
                                                                <td class="small d-none d-md-table-cell">
                                                                    <%= w.issued_by_name || 'Sistem' %>
                                                                </td>
                                                                <td class="small d-none d-sm-table-cell text-nowrap"
                                                                    title="<%= w.created_at %>">
                                                                    <%= helpers.formatDate(w.created_at, lang) %>
                                                                </td>
                                                                <td>
                                                                    <% if (isStanding) { %>
                                                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2">Aktif</span>
                                                                    <% } else { %>
                                                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2">Kaldırıldı</span>
                                                                    <% } %>
                                                                </td>
                                                                <td class="text-end text-nowrap">
                                                                    <% if (isStanding) { %>
                                                                        <form action="/admin/uyari/<%= w.id %>/kaldir" method="POST" class="d-inline">
                                                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                                            <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                                                                    title="Uyarıyı kaldır — kayıt geçmişte kalır, kullanıcıya bildirilir">
                                                                                Kaldır
                                                                            </button>
                                                                        </form>
                                                                    <% } %>
                                                                    <form action="/admin/uyari/<%= w.id %>/sil" method="POST" class="d-inline btn-delete-warning">
                                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                                        <button class="btn btn-sm btn-outline-danger py-0 px-2"
                                                                                title="Kaydı kalıcı olarak sil">
                                                                            <i class="fa-regular fa-trash-can"></i>
                                                                        </button>
                                                                    </form>
                                                                </td>
                                                            </tr>
                                                        <% }); %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        <% } %>
                                    </div>

                                    <% if (u.id !== activeAdminUser.id) { %>
                                        <form action="/admin/users/<%= u.id %>/uyari" method="POST"
                                              class="d-flex flex-wrap gap-2 align-items-center py-2 border-top mt-2">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <select name="reason" class="form-select form-select-sm" style="width: auto;" required>
                                                <% reportReasons.forEach(function (r) { %>
                                                    <option value="<%= r %>"><%= t('report_modal.reasons.' + r) %></option>
                                                <% }); %>
                                            </select>
                                            <input type="text" name="note" class="form-control form-control-sm"
                                                   style="max-width: min(320px, 100%);" maxlength="500" placeholder="Açıklama (opsiyonel)">
                                            <button class="btn btn-sm btn-warning fw-medium">Uyarı Gönder</button>
                                            <span class="text-muted small">
                                                <%= suspensionThreshold %>. uyarıda hesap otomatik askıya alınır.
                                            </span>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<%- include('_pagination', { pagination: pag, baseUrl: '/admin/users', query: f }) %>

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="editUserForm" action="" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="_method" value="PUT">
                <div class="modal-header">
                    <h5 class="modal-title fs-6 fw-bold" id="editUserModalLabel"><i class="fa-solid fa-user-gear me-2 text-primary"></i>Kullanıcı Bilgilerini Düzenle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-medium">Ad Soyad</label>
                        <input type="text" name="fullName" id="editFullName" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-medium">E-posta Adresi</label>
                        <input type="email" name="email" id="editEmail" class="form-control" required>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-medium">Telefon</label>
                            <input type="text" name="phone" id="editPhone" class="form-control">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-medium">Hesap Rolü</label>
                            <select name="role" id="editRole" class="form-select" required>
                                <option value="user">Bireysel Kullanıcı</option>
                                <option value="business">Kurumsal Hesabı</option>
                                <option value="agent">Emlak / Acente Danışmanı</option>
                                <option value="admin">Yönetici (Admin)</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-medium">Firma Adı (Opsiyonel)</label>
                            <input type="text" name="companyName" id="editCompanyName" class="form-control">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-medium">Kurumsal Onay Durumu</label>
                            <select name="corporateStatus" id="editCorporateStatus" class="form-select">
                                <option value="none">Bireysel / Başvuru Yok</option>
                                <option value="pending">Onay Bekliyor</option>
                                <option value="approved">Onaylandı (Kurumsal)</option>
                                <option value="rejected">Reddedildi</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-medium">Kurumsal Sektör / Grubu</label>
                        <select name="corporateType" id="editCorporateType" class="form-select">
                            <option value="">Belirtilmemiş / Genel</option>
                            <option value="real_estate">🏡 Emlak & Gayrimenkul Ofisi</option>
                            <option value="auto">🚗 Oto Galeri & Vasıta</option>
                            <option value="service">🛠️ Usta & Hizmet Servisi</option>
                            <option value="construction">🏗️ İnşaat & Kurumsal Tedarikçi</option>
                            <option value="shopping">🛍️ Mağaza & Perakende / 2. El</option>
                            <option value="other">🏢 Diğer Kurumsal İşletme</option>
                        </select>
                    </div>

                    <!-- Email Verification Toggle -->
                    <div class="mb-3 form-check form-switch bg-light rounded p-3 border ms-0">
                        <input class="form-check-input ms-0 me-2 cursor-pointer" type="checkbox" name="isVerified" id="editIsVerified" value="1">
                        <label class="form-check-label small fw-bold cursor-pointer" for="editIsVerified">
                            <i class="fa-solid fa-circle-check me-1 text-success"></i>E-posta Adresi Doğrulanmış
                        </label>
                        <div class="form-text small mt-1">Manuel olarak kullanıcının e-posta doğrulama durumunu değiştirmek için işaretleyin.</div>
                    </div>

                    <hr class="my-3">
                    <div class="mb-2">
                        <label class="form-label small fw-medium text-danger"><i class="fa-solid fa-key me-1"></i>Yeni Şifre Belirle (Opsiyonel)</label>
                        <input type="password" name="password" id="editPassword" class="form-control" placeholder="Değiştirmek istemiyorsanız boş bırakın">
                        <div class="form-text small">Admin müdahalesi ile kullanıcının şifresini sıfırlamak için buraya yeni şifre yazın.</div>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-danger btn-sm" id="btnModalDeleteUser" title="Kullanıcıyı Kalıcı Olarak Sil">
                        <i class="fa-solid fa-trash-can me-1"></i>Kullanıcıyı Sil
                    </button>
                    <div>
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-primary fw-medium">Değişiklikleri Kaydet</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Admin Delete User Confirmation Modal -->
<div class="modal fade" id="adminDeleteConfirmModal" tabindex="-1" aria-labelledby="adminDeleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-danger text-white border-0 py-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-triangle-exclamation fs-5"></i>
                    <h5 class="modal-title fw-bold fs-6 mb-0" id="adminDeleteConfirmModalLabel">Kullanıcıyı Kalıcı Olarak Sil</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle p-3 mb-2" style="width: 64px; height: 64px;">
                        <i class="fa-solid fa-trash-can fs-2"></i>
                    </div>
                    <h6 class="fw-bold mb-1 fs-5 text-dark" id="delModalUserName">Kullanıcı Adı</h6>
                    <div class="text-secondary small fw-medium" id="delModalUserEmail">kullanici@eposta.com</div>
                </div>

                <div class="alert alert-danger border-danger-subtle bg-danger bg-opacity-10 p-3 rounded-3 small text-danger-emphasis mb-3">
                    <div class="d-flex gap-2">
                        <i class="fa-solid fa-circle-exclamation flex-shrink-0 mt-0.5 fs-6"></i>
                        <div>
                            <strong>DİKKAT: Bu işlem geri alınamaz!</strong><br>
                            Bu kullanıcı sistemden silindiğinde:
                            <ul class="mb-0 mt-1 ps-3">
                                <li>Yayındaki ve taslaktaki <strong>tüm ilanları (<span id="delModalListingCount">0</span> ilan)</strong> ve fotoğrafları sunucudan silinir.</li>
                                <li>Gelen/giden tüm mesajları, favorileri ve bildirimleri silinir.</li>
                                <li>Kayıtlı CV, özgeçmiş ve profil verileri kalıcı olarak yok edilir.</li>
                            </ul>
                        </div>
                    </div>
                </div>
                
                <p class="text-muted small text-center mb-0">
                    Hesabı ve tüm verilerini kalıcı olarak silmek istediğinize emin misiniz?
                </p>
            </div>
            <div class="modal-footer bg-light border-0 py-3 d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Vazgeç</button>
                <form id="adminConfirmDeleteForm" action="" method="POST" class="d-inline m-0">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-danger fw-bold px-3 shadow-sm">
                        <i class="fa-solid fa-trash-can me-1"></i>Evet, Kullanıcıyı Sil
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    // Deleting a warning erases the moderation record rather than lifting it, so
    // it asks first. Lifting is reversible and does not.
    document.querySelectorAll('.btn-delete-warning').forEach(function (form) {
        form.addEventListener('submit', function (event) {
            if (!confirm('Bu uyarı kaydı kalıcı olarak silinecek. Geçmişte iz bırakmaz. Emin misiniz?')) {
                event.preventDefault();
            }
        });
    });

    const editModalEl = document.getElementById('editUserModal');
    const editModal = editModalEl ? new bootstrap.Modal(editModalEl) : null;
    const editForm = document.getElementById('editUserForm');

    const deleteModalEl = document.getElementById('adminDeleteConfirmModal');
    const deleteModal = deleteModalEl ? new bootstrap.Modal(deleteModalEl) : null;
    const confirmDeleteForm = document.getElementById('adminConfirmDeleteForm');
    const delModalUserName = document.getElementById('delModalUserName');
    const delModalUserEmail = document.getElementById('delModalUserEmail');
    const delModalListingCount = document.getElementById('delModalListingCount');

    let currentEditUserId = null;
    let currentEditUserName = '';
    let currentEditUserEmail = '';
    let currentEditUserListings = '0';

    function openDeleteModal(id, name, email, listingCount) {
        if (!deleteModal || !confirmDeleteForm) return;
        confirmDeleteForm.action = '/admin/users/' + id + '/sil';
        if (delModalUserName) delModalUserName.textContent = name || 'Kullanıcı #' + id;
        if (delModalUserEmail) delModalUserEmail.textContent = email || '';
        if (delModalListingCount) delModalListingCount.textContent = listingCount || '0';
        deleteModal.show();
    }

    document.querySelectorAll('.btn-delete-user').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const id = this.getAttribute('data-id');
            const name = this.getAttribute('data-name');
            const email = this.getAttribute('data-email');
            const listings = this.getAttribute('data-listings') || '0';
            openDeleteModal(id, name, email, listings);
        });
    });

    const btnModalDelete = document.getElementById('btnModalDeleteUser');
    if (btnModalDelete) {
        btnModalDelete.addEventListener('click', function () {
            if (!currentEditUserId) return;
            if (editModal) editModal.hide();
            openDeleteModal(currentEditUserId, currentEditUserName, currentEditUserEmail, currentEditUserListings);
        });
    }

    document.querySelectorAll('.btn-edit-user').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const id = this.getAttribute('data-id');
            const name = this.getAttribute('data-name');
            const email = this.getAttribute('data-email');
            const phone = this.getAttribute('data-phone');
            const role = this.getAttribute('data-role');
            const company = this.getAttribute('data-company');
            const corporateStatus = this.getAttribute('data-corporate-status') || 'none';
            const corporateType = this.getAttribute('data-corporate-type') || '';
            const isVerified = this.getAttribute('data-is-verified') === '1';
            const listings = this.getAttribute('data-listings') || '0';

            currentEditUserId = id;
            currentEditUserName = company || name;
            currentEditUserEmail = email;
            currentEditUserListings = listings;

            if (editForm) editForm.action = '/admin/users/' + id;
            if (document.getElementById('editFullName')) document.getElementById('editFullName').value = name;
            if (document.getElementById('editEmail')) document.getElementById('editEmail').value = email;
            if (document.getElementById('editPhone')) document.getElementById('editPhone').value = phone;
            if (document.getElementById('editRole')) document.getElementById('editRole').value = role;
            if (document.getElementById('editCompanyName')) document.getElementById('editCompanyName').value = company;
            if (document.getElementById('editCorporateStatus')) {
                document.getElementById('editCorporateStatus').value = corporateStatus;
            }
            if (document.getElementById('editCorporateType')) {
                document.getElementById('editCorporateType').value = corporateType;
            }
            if (document.getElementById('editIsVerified')) document.getElementById('editIsVerified').checked = isVerified;
            if (document.getElementById('editPassword')) document.getElementById('editPassword').value = '';

            if (editModal) editModal.show();
        });
    });
});
</script>

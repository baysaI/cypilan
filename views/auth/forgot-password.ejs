<div class="container py-5 py-md-7">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 pt-4 pb-0 text-center">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                        <i class="fa-solid fa-key fs-4"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1"><%= t('auth.forgot_password_title') %></h3>
                    <p class="text-muted small px-3"><%= t('auth.forgot_password_desc') %></p>
                </div>
                
                <div class="card-body p-4 p-md-5 pt-3">
                    <form action="/auth/forgot-password" method="POST" class="needs-validation" novalidate>
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="mb-4">
                            <label for="email" class="form-label fw-medium small"><%= t('auth.email') %></label>
                            <input type="email" class="form-control form-control-lg rounded-3 bg-light border-0 shadow-none focus-ring-primary" id="email" name="email" required placeholder="ornek@email.com">
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm hover-lift">
                                <i class="fa-paper-plane fa-solid me-2"></i><%= t('auth.send_reset_link') %>
                            </button>
                        </div>

                        <div class="text-center">
                            <a href="/auth/login" class="text-decoration-none small text-muted">
                                <i class="fa-solid fa-arrow-left me-1"></i> <%= t('auth.back_to_login') %>
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

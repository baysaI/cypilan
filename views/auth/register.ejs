<%
const fData = (typeof formData !== 'undefined' && formData) ? formData : {};
%>

<div class="container py-5 py-md-7">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 pt-4 pb-0 text-center">
                    <h3 class="fw-bold text-dark mb-1"><%= t('auth.register_title') %></h3>
                    <p class="text-muted small"><%= t('site.tagline') %></p>
                </div>
                
                <div class="card-body p-4 p-md-5 pt-3">
                    <div class="d-grid gap-2 mb-4">
                        <a href="/auth/google" class="btn btn-outline-dark rounded-pill py-2 fw-medium d-flex align-items-center justify-content-center gap-2 hover-lift">
                            <i class="fa-brands fa-google text-danger"></i> Google ile <%= t('auth.register_title') %>
                        </a>
                    </div>

                    <div class="position-relative mb-4 text-center">
                        <hr class="text-muted">
                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 small text-muted"><%= t('common.or') %> <%= t('auth.email') %></span>
                    </div>

                    <form action="/auth/register" method="POST" class="needs-validation" novalidate>
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="mb-4 d-flex gap-3">
                            <div class="form-check bg-light rounded-3 p-3 flex-fill text-center border cursor-pointer hover-bg-primary-light transition-all">
                                <input class="form-check-input float-none mx-auto d-block mb-2 shadow-none cursor-pointer" type="radio" name="accountType" id="typeIndividual" value="individual" <%= fData.accountType !== 'corporate' ? 'checked' : '' %>>
                                <label class="form-check-label fw-bold d-block cursor-pointer" for="typeIndividual">
                                    <%= t('auth.individual') %>
                                </label>
                            </div>
                            <div class="form-check bg-light rounded-3 p-3 flex-fill text-center border cursor-pointer hover-bg-primary-light transition-all">
                                <input class="form-check-input float-none mx-auto d-block mb-2 shadow-none cursor-pointer" type="radio" name="accountType" id="typeCorporate" value="corporate" <%= fData.accountType === 'corporate' ? 'checked' : '' %>>
                                <label class="form-check-label fw-bold d-block cursor-pointer" for="typeCorporate">
                                    <%= t('auth.business') %>
                                </label>
                            </div>
                        </div>

                        <div id="corporateFields" class="<%= fData.accountType === 'corporate' ? '' : 'd-none' %>">
                            <div class="alert alert-warning border-warning-subtle py-2 px-3 small rounded-3 mb-3">
                                <i class="fa-solid fa-clock-rotate-left me-1 text-warning"></i>
                                <strong><%= t('auth.corporate_approval_notice_title') %>:</strong> <%= t('auth.corporate_approval_notice_body') %>
                            </div>

                            <div class="mb-3">
                                <label for="companyName" class="form-label fw-medium small"><%= t('auth.company_name') %> <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-lg rounded-3 bg-light border-0 shadow-none focus-ring-primary" id="companyName" name="companyName" placeholder="<%= t('auth.company_name_placeholder') %>" value="<%= fData.companyName || '' %>">
                            </div>

                            <div class="mb-3">
                                <label for="corporateType" class="form-label fw-medium small"><%= t('auth.corporate_type') || 'Faaliyet Alanı / Kurumsal Grubu' %> <span class="text-danger">*</span></label>
                                <select class="form-select form-select-lg rounded-3 bg-light border-0 shadow-none focus-ring-primary cursor-pointer" id="corporateType" name="corporateType">
                                    <option value="real_estate" <%= fData.corporateType === 'real_estate' ? 'selected' : '' %>>🏡 <%= t('auth.corporate_type_real_estate') || 'Emlak & Gayrimenkul Ofisi' %></option>
                                    <option value="auto" <%= fData.corporateType === 'auto' ? 'selected' : '' %>>🚗 <%= t('auth.corporate_type_auto') || 'Oto Galeri & Araç Satışı' %></option>
                                    <option value="service" <%= fData.corporateType === 'service' ? 'selected' : '' %>>🛠️ <%= t('auth.corporate_type_service') || 'Usta & Hizmet Servisi' %></option>
                                    <option value="construction" <%= fData.corporateType === 'construction' ? 'selected' : '' %>>🏗️ <%= t('auth.corporate_type_construction') || 'İnşaat & Kurumsal Tedarikçi' %></option>
                                    <option value="shopping" <%= fData.corporateType === 'shopping' ? 'selected' : '' %>>🛍️ <%= t('auth.corporate_type_shopping') || 'Mağaza & Perakende / 2. El' %></option>
                                    <option value="other" <%= fData.corporateType === 'other' ? 'selected' : '' %>>🏢 <%= t('auth.corporate_type_other') || 'Diğer Kurumsal İşletme' %></option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="taxNo" class="form-label fw-medium small"><%= t('auth.tax_no') %> <span class="text-muted small">(<%= t('common.optional') %>)</span></label>
                                <input type="text" class="form-control form-control-lg rounded-3 bg-light border-0 shadow-none focus-ring-primary" id="taxNo" name="taxNo" placeholder="<%= t('auth.tax_no_placeholder') %>" value="<%= fData.taxNo || '' %>">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="fullName" class="form-label fw-medium small"><%= t('auth.full_name') %> / <%= t('auth.authorized_person') %></label>
                            <input type="text" class="form-control form-control-lg rounded-3 bg-light border-0 shadow-none focus-ring-primary" id="fullName" name="fullName" value="<%= fData.fullName || '' %>" required>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label fw-medium small"><%= t('auth.email') %></label>
                            <input type="email" class="form-control form-control-lg rounded-3 bg-light border-0 shadow-none focus-ring-primary" id="email" name="email" value="<%= fData.email || '' %>" required>
                        </div>

                        <div class="mb-3">
                            <label for="phone" class="form-label fw-medium small"><%= t('auth.phone') %></label>
                            <input type="tel" class="form-control form-control-lg rounded-3 bg-light border-0 shadow-none focus-ring-primary" id="phone" name="phone" placeholder="0533 123 4567" value="<%= fData.phone || '' %>" required>
                        </div>
                        
                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label for="password" class="form-label fw-medium small"><%= t('auth.password') %></label>
                                <input type="password" class="form-control form-control-lg rounded-3 bg-light border-0 shadow-none focus-ring-primary" id="password" name="password" required>
                            </div>
                            <div class="col-sm-6">
                                <label for="passwordConfirm" class="form-label fw-medium small"><%= t('auth.confirm_password') %></label>
                                <input type="password" class="form-control form-control-lg rounded-3 bg-light border-0 shadow-none focus-ring-primary" id="passwordConfirm" name="passwordConfirm" required>
                            </div>
                        </div>

                        <!-- Live Password Rules Checklist -->
                        <div class="p-3 bg-light rounded-3 mb-4 border">
                            <div class="small fw-bold mb-2 text-dark"><i class="fa-solid fa-shield-halved me-1 text-primary"></i><%= t('auth.password_requirements') %>:</div>
                            <div class="row g-2 small">
                                <div class="col-6 text-muted" id="ruleLength">
                                    <i class="fa-solid fa-circle-xmark text-danger me-1"></i><span><%= t('auth.rule_min_length') %></span>
                                </div>
                                <div class="col-6 text-muted" id="ruleUpper">
                                    <i class="fa-solid fa-circle-xmark text-danger me-1"></i><span><%= t('auth.rule_uppercase') %></span>
                                </div>
                                <div class="col-6 text-muted" id="ruleDigit">
                                    <i class="fa-solid fa-circle-xmark text-danger me-1"></i><span><%= t('auth.rule_digit') %></span>
                                </div>
                                <div class="col-6 text-muted" id="ruleMatch">
                                    <i class="fa-solid fa-circle-xmark text-danger me-1"></i><span><%= t('auth.rule_match') %></span>
                                </div>
                            </div>
                        </div>

                        <%# Yas ve kullanim kosullari kutulari: Google onay adimiyla ortak parca. %>
                        <%- include('../partials/consentChecks') %>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm hover-lift"><%= t('auth.register_title') %></button>
                        </div>
                    </form>
                </div>
                
                <div class="card-footer bg-light border-0 py-3 text-center">
                    <p class="mb-0 small text-muted"><%= t('auth.has_account') %> <a href="/auth/login" class="text-primary fw-bold text-decoration-none"><%= t('auth.login_title') %></a></p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const passwordInput = document.getElementById('password');
    const confirmInput = document.getElementById('passwordConfirm');
    if (!passwordInput || !confirmInput) return;

    const ruleLength = document.getElementById('ruleLength');
    const ruleUpper = document.getElementById('ruleUpper');
    const ruleDigit = document.getElementById('ruleDigit');
    const ruleMatch = document.getElementById('ruleMatch');

    function updateRule(el, valid) {
        if (!el) return;
        const icon = el.querySelector('i');
        if (valid) {
            el.className = 'col-6 text-success fw-medium';
            icon.className = 'fa-solid fa-circle-check text-success me-1';
        } else {
            el.className = 'col-6 text-muted';
            icon.className = 'fa-solid fa-circle-xmark text-danger me-1';
        }
    }

    function validatePassword() {
        const val = passwordInput.value || '';
        const confirmVal = confirmInput.value || '';

        const hasMin = val.length >= 8;
        const hasUpper = /[A-Z]/.test(val);
        const hasDigit = /[0-9]/.test(val);
        const matches = val.length > 0 && val === confirmVal;

        updateRule(ruleLength, hasMin);
        updateRule(ruleUpper, hasUpper);
        updateRule(ruleDigit, hasDigit);
        updateRule(ruleMatch, matches);
    }

    passwordInput.addEventListener('input', validatePassword);
    confirmInput.addEventListener('input', validatePassword);

    const typeIndividual = document.getElementById('typeIndividual');
    const typeCorporate = document.getElementById('typeCorporate');
    const corporateFields = document.getElementById('corporateFields');
    const companyNameInput = document.getElementById('companyName');

    function toggleAccountType() {
        if (typeCorporate && typeCorporate.checked) {
            corporateFields.classList.remove('d-none');
            if (companyNameInput) companyNameInput.required = true;
        } else if (corporateFields) {
            corporateFields.classList.add('d-none');
            if (companyNameInput) companyNameInput.required = false;
        }
    }

    if (typeIndividual) typeIndividual.addEventListener('change', toggleAccountType);
    if (typeCorporate) typeCorporate.addEventListener('change', toggleAccountType);
    toggleAccountType();
});
</script>

<div class="container py-5 py-md-7">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 pt-4 pb-0 text-center">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                        <i class="fa-solid fa-lock-open fs-4"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1"><%= t('auth.reset_password_title') %></h3>
                    <p class="text-muted small"><%= t('auth.reset_password_desc') %></p>
                </div>
                
                <div class="card-body p-4 p-md-5 pt-3">
                    <form action="/auth/reset-password" method="POST" class="needs-validation" novalidate>
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="token" value="<%= token %>">

                        <div class="mb-3">
                            <label for="password" class="form-label fw-medium small"><%= t('auth.new_password') %></label>
                            <input type="password" class="form-control form-control-lg rounded-3 bg-light border-0 shadow-none focus-ring-primary" id="password" name="password" required placeholder="••••••••">
                        </div>

                        <div class="mb-3">
                            <label for="passwordConfirm" class="form-label fw-medium small"><%= t('auth.confirm_password') %></label>
                            <input type="password" class="form-control form-control-lg rounded-3 bg-light border-0 shadow-none focus-ring-primary" id="passwordConfirm" name="passwordConfirm" required placeholder="••••••••">
                        </div>

                        <!-- Live Password Rules Checklist -->
                        <div class="p-3 bg-light rounded-3 mb-4 border">
                            <div class="small fw-bold mb-2 text-dark"><i class="fa-solid fa-shield-halved me-1 text-primary"></i><%= t('auth.password_requirements') %>:</div>
                            <div class="row g-2 small">
                                <div class="col-6 text-muted" id="ruleLength">
                                    <i class="fa-solid fa-circle-xmark text-danger me-1"></i><span><%= t('auth.rule_min_length') %></span>
                                </div>
                                <div class="col-6 text-muted" id="ruleUpper">
                                    <i class="fa-solid fa-circle-xmark text-danger me-1"></i><span><%= t('auth.rule_uppercase') %></span>
                                </div>
                                <div class="col-6 text-muted" id="ruleDigit">
                                    <i class="fa-solid fa-circle-xmark text-danger me-1"></i><span><%= t('auth.rule_digit') %></span>
                                </div>
                                <div class="col-6 text-muted" id="ruleMatch">
                                    <i class="fa-solid fa-circle-xmark text-danger me-1"></i><span><%= t('auth.rule_match') %></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm hover-lift">
                                <%= t('auth.save_new_password') %>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const passwordInput = document.getElementById('password');
    const confirmInput = document.getElementById('passwordConfirm');
    if (!passwordInput || !confirmInput) return;

    const ruleLength = document.getElementById('ruleLength');
    const ruleUpper = document.getElementById('ruleUpper');
    const ruleDigit = document.getElementById('ruleDigit');
    const ruleMatch = document.getElementById('ruleMatch');

    function updateRule(el, valid) {
        if (!el) return;
        const icon = el.querySelector('i');
        if (valid) {
            el.className = 'col-6 text-success fw-medium';
            icon.className = 'fa-solid fa-circle-check text-success me-1';
        } else {
            el.className = 'col-6 text-muted';
            icon.className = 'fa-solid fa-circle-xmark text-danger me-1';
        }
    }

    function validatePassword() {
        const val = passwordInput.value || '';
        const confirmVal = confirmInput.value || '';

        const hasMin = val.length >= 8;
        const hasUpper = /[A-Z]/.test(val);
        const hasDigit = /[0-9]/.test(val);
        const matches = val.length > 0 && val === confirmVal;

        updateRule(ruleLength, hasMin);
        updateRule(ruleUpper, hasUpper);
        updateRule(ruleDigit, hasDigit);
        updateRule(ruleMatch, matches);
    }

    passwordInput.addEventListener('input', validatePassword);
    confirmInput.addEventListener('input', validatePassword);
});
</script>

<div class="container py-5 py-md-7">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 pt-4 pb-0 text-center">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                        <i class="fa-solid fa-lock-open fs-4"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1"><%= t('auth.reset_password_title') %></h3>
                    <p class="text-muted small"><%= t('auth.reset_password_desc') %></p>
                </div>
                
                <div class="card-body p-4 p-md-5 pt-3">
                    <form action="/auth/reset-password" method="POST" class="needs-validation" novalidate>
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="token" value="<%= token %>">

                        <div class="mb-3">
                            <label for="password" class="form-label fw-medium small"><%= t('auth.new_password') %></label>
                            <input type="password" class="form-control form-control-lg rounded-3 bg-light border-0 shadow-none focus-ring-primary" id="password" name="password" required minlength="8" placeholder="••••••••">
                            <div class="form-text small text-muted"><%= t('auth.password_hint') %></div>
                        </div>

                        <div class="mb-4">
                            <label for="passwordConfirm" class="form-label fw-medium small"><%= t('auth.confirm_password') %></label>
                            <input type="password" class="form-control form-control-lg rounded-3 bg-light border-0 shadow-none focus-ring-primary" id="passwordConfirm" name="passwordConfirm" required placeholder="••••••••">
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm hover-lift">
                                <%= t('auth.save_new_password') %>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

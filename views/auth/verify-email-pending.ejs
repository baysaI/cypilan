<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden text-center">
                <div class="card-body p-4 p-sm-5">
                    
                    <!-- Icon Container with soft pulse accent -->
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="fa-solid fa-envelope-open-text fs-1 text-primary"></i>
                    </div>

                    <h2 class="fs-3 fw-bold text-dark mb-2"><%= t('auth.verify_pending_title') %></h2>
                    <p class="text-muted small mb-4"><%= t('auth.verify_pending_desc') %></p>

                    <!-- Email Box -->
                    <div class="alert alert-light border rounded-3 p-3 mb-4 text-start small">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="fa-solid fa-at text-primary fs-5 flex-shrink-0"></i>
                            <strong class="text-dark text-break fs-6"><%= email %></strong>
                        </div>
                        <p class="text-muted mb-0 lh-sm"><%= t('auth.verify_pending_instructions') %></p>
                    </div>

                    <!-- Spam Notice Box -->
                    <div class="bg-warning bg-opacity-10 border border-warning text-dark rounded-3 p-3 mb-4 text-start small d-flex align-items-start gap-2">
                        <i class="fa-solid fa-triangle-exclamation text-warning fs-6 mt-0.5 flex-shrink-0"></i>
                        <span class="lh-sm"><%= t('auth.verify_pending_spam_notice') %></span>
                    </div>

                    <!-- Actions -->
                    <div class="d-grid gap-2 mb-4">
                        <a href="/auth/verify-email-pending" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm hover-lift py-3 text-wrap">
                            <i class="fa-solid fa-rotate me-2"></i><%= t('auth.verify_pending_refresh_btn') %>
                        </a>

                        <form action="/auth/resend-verification" method="POST" class="m-0">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="btn btn-outline-dark w-100 rounded-pill py-2.5 fw-semibold hover-lift">
                                <i class="fa-solid fa-paper-plane me-2"></i><%= t('common.resend_verification_btn') %>
                            </button>
                        </form>
                    </div>

                    <a href="/profile" class="text-decoration-none small text-muted hover-underline d-inline-flex align-items-center gap-1">
                        <i class="fa-solid fa-arrow-left me-1"></i><%= t('auth.back_to_profile') %>
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>

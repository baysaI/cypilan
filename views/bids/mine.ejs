<%
    const statusStyles = {
        pending: 'bg-primary-subtle text-primary-emphasis border-primary-subtle',
        accepted: 'bg-success-subtle text-success-emphasis border-success-subtle',
        rejected: 'bg-danger-subtle text-danger-emphasis border-danger-subtle',
        withdrawn: 'bg-secondary-subtle text-secondary-emphasis border-secondary-subtle'
    };
%>

<div class="container py-4 py-md-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fs-3 fw-bold mb-1"><%= t('bids.my_bids') %></h1>
            <p class="text-muted small mb-0"><%= t('bids.my_bids_desc') %></p>
        </div>
        <a href="/teklifler" class="btn btn-primary rounded-pill px-4 fw-medium">
            <i class="fa-solid fa-magnifying-glass me-2"></i><%= t('bids.browse_requests') %>
        </a>
    </div>

    <% if (bids.length > 0) { %>
        <div class="d-flex flex-column gap-3">
            <% bids.forEach(function (bid) { %>
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex flex-wrap align-items-start gap-3">
                            <img src="<%= bid.primary_image || '/img/logo.png' %>"
                                 class="rounded-3 object-fit-cover bg-light flex-shrink-0"
                                 width="88" height="88" alt="<%= bid.listing_title %>">

                            <div class="flex-grow-1 min-w-0">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                                    <h2 class="fs-6 fw-bold mb-1">
                                        <a href="/listings/<%= bid.listing_slug %>" class="text-decoration-none text-body"><%= bid.listing_title %></a>
                                    </h2>
                                    <span class="badge rounded-pill border <%= statusStyles[bid.status] || statusStyles.pending %>">
                                        <%= t('bids.status_' + bid.status) %>
                                    </span>
                                </div>

                                <div class="d-flex flex-wrap gap-3 text-muted small mb-2">
                                    <span><i class="fa-solid fa-location-dot me-1"></i><%= helpers.getCityName(bid.listing_city, lang) %></span>
                                    <span><i class="fa-regular fa-clock me-1"></i><%= helpers.timeAgo(bid.created_at, lang) %></span>
                                </div>

                                <p class="mb-2">
                                    <span class="text-muted small"><%= t('bids.your_offer') %>:</span>
                                    <strong class="fs-5 ms-1"><%= helpers.formatPrice(bid.amount, bid.currency, currency) %></strong>
                                </p>

                                <% if (bid.message) { %>
                                    <p class="text-muted small mb-2 fst-italic">"<%= bid.message %>"</p>
                                <% } %>

                                <% if (bid.status === 'accepted') { %>
                                    <div class="alert alert-success py-2 px-3 small mb-0">
                                        <i class="fa-solid fa-trophy me-1"></i><%= t('bids.you_won') %>
                                        <a href="/messages/<%= bid.listing_id %>" class="fw-semibold"><%= t('bids.go_to_messages') %></a>
                                    </div>
                                <% } else if (bid.status === 'pending') { %>
                                    <form action="/teklifler/<%= bid.id %>/geri-cek" method="POST" class="d-inline"
                                          onsubmit="return confirm('<%= t('bids.withdraw_confirm') %>');">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                            <i class="fa-solid fa-rotate-left me-1"></i><%= t('bids.withdraw') %>
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="text-center py-5 bg-white rounded-4 border">
            <i class="fa-solid fa-gavel fs-1 text-muted mb-3 opacity-50 d-block"></i>
            <p class="text-muted mb-3"><%= t('bids.no_bids_yet') %></p>
            <a href="/teklifler" class="btn btn-primary rounded-pill px-4 fw-medium"><%= t('bids.browse_requests') %></a>
        </div>
    <% } %>
</div>

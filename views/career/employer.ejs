<%
    const statusStyles = {
        pending: 'bg-primary-subtle text-primary-emphasis border-primary-subtle',
        reviewed: 'bg-info-subtle text-info-emphasis border-info-subtle',
        shortlisted: 'bg-success-subtle text-success-emphasis border-success-subtle',
        rejected: 'bg-danger-subtle text-danger-emphasis border-danger-subtle',
        withdrawn: 'bg-secondary-subtle text-secondary-emphasis border-secondary-subtle'
    };
%>

<div class="container py-4 py-md-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fs-3 fw-bold mb-1"><%= t('career.employer_panel') %></h1>
            <p class="text-muted small mb-0"><%= t('career.employer_panel_desc') %></p>
        </div>
        <a href="/listings/create" class="btn btn-primary rounded-pill px-4 fw-medium">
            <i class="fa-solid fa-plus me-2"></i><%= t('career.post_job') %>
        </a>
    </div>

    <% if (groups.length > 0) { %>
        <% groups.forEach(function (group) { %>
            <% const activeApps = group.applications.filter(function (a) { return a.status !== 'withdrawn'; }); %>
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-3 border-bottom">
                        <h2 class="fs-5 fw-bold mb-0">
                            <a href="/listings/<%= group.listingSlug %>" class="text-decoration-none text-body"><%= group.listingTitle %></a>
                        </h2>
                        <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis border border-primary-subtle">
                            <%= t('career.applicants', { count: activeApps.length }) %>
                        </span>
                    </div>

                    <div class="d-flex flex-column gap-3">
                        <% group.applications.forEach(function (application) { %>
                            <div class="border rounded-4 p-3 <%= application.status === 'shortlisted' ? 'border-success border-2' : '' %>">
                                <div class="d-flex flex-wrap align-items-start gap-3">
                                    <img src="<%= application.applicant_avatar || '/img/logo.png' %>"
                                         class="rounded-circle border bg-light object-fit-cover flex-shrink-0"
                                         width="48" height="48" alt="<%= application.applicant_name %>">

                                    <div class="flex-grow-1 min-w-0">
                                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                            <a href="/profile/<%= application.applicant_id %>" class="fw-semibold text-decoration-none text-body">
                                                <%= application.applicant_name %>
                                            </a>
                                            <% if (application.experience_years > 0) { %>
                                                <span class="badge rounded-pill bg-light text-muted border">
                                                    <%= t('career.years_experience', { years: application.experience_years }) %>
                                                </span>
                                            <% } %>
                                            <span class="badge rounded-pill border ms-auto <%= statusStyles[application.status] || statusStyles.pending %>">
                                                <%= t('career.status_' + application.status) %>
                                            </span>
                                        </div>

                                        <% if (application.headline) { %>
                                            <p class="fw-medium small mb-1"><%= application.headline %></p>
                                        <% } %>

                                        <% if (application.summary) { %>
                                            <p class="text-muted small mb-2"><%= helpers.truncate(application.summary, 220) %></p>
                                        <% } %>

                                        <div class="d-flex flex-wrap gap-3 text-muted small mb-2">
                                            <% if (application.skills) { %>
                                                <span><i class="fa-solid fa-screwdriver-wrench me-1"></i><%= helpers.truncate(application.skills, 90) %></span>
                                            <% } %>
                                            <% if (application.languages) { %>
                                                <span><i class="fa-solid fa-language me-1"></i><%= application.languages %></span>
                                            <% } %>
                                            <% if (application.preferred_city) { %>
                                                <span><i class="fa-solid fa-location-dot me-1"></i><%= helpers.getCityName(application.preferred_city, lang) %></span>
                                            <% } %>
                                        </div>

                                        <% if (application.cover_letter) { %>
                                            <p class="small fst-italic border-start border-3 ps-3 text-muted mb-2">
                                                "<%= application.cover_letter %>"
                                            </p>
                                        <% } %>

                                        <% if (application.status !== 'withdrawn') { %>
                                            <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
                                                <form action="/kariyer/basvurular/<%= application.id %>/durum" method="POST"
                                                      class="d-flex flex-wrap gap-2 align-items-center">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <select name="status" class="form-select form-select-sm" style="width: auto;"
                                                            aria-label="<%= t('career.set_status') %>">
                                                        <% statuses.forEach(function (status) { %>
                                                            <option value="<%= status %>" <%= application.status === status ? 'selected' : '' %>>
                                                                <%= t('career.status_' + status) %>
                                                            </option>
                                                        <% }); %>
                                                    </select>
                                                    <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                        <%= t('career.set_status') %>
                                                    </button>
                                                </form>

                                                <a href="/messages/<%= application.applicant_id %>?listing=<%= application.listing_id %>"
                                                   class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                                    <i class="fa-regular fa-comment me-1"></i><%= t('listing.send_message') %>
                                                </a>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="text-center py-5 bg-white rounded-4 border">
            <i class="fa-solid fa-inbox fs-1 text-muted mb-3 opacity-50 d-block"></i>
            <p class="text-muted mb-3"><%= t('career.no_applicants') %></p>
            <a href="/listings/create" class="btn btn-primary rounded-pill px-4 fw-medium">
                <i class="fa-solid fa-plus me-2"></i><%= t('career.post_job') %>
            </a>
        </div>
    <% } %>
</div>

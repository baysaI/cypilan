<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                    <h1 class="fs-3 fw-bold mb-1"><%= t('career.my_cv') %></h1>
                    <p class="text-muted small mb-0"><%= t('career.my_cv_desc') %></p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <% if (profile && (profile.headline || profile.custom_cv_url)) { %>
                        <a href="/kariyer/cv/pdf" target="_blank" class="btn btn-outline-danger rounded-pill px-3 fw-medium d-inline-flex align-items-center shadow-none">
                            <i class="fa-solid fa-file-pdf me-2 fs-5"></i><%= t('career.download_cypilan_pdf') || 'CYPILAN PDF Çıktısı' %>
                        </a>
                    <% } %>
                    <a href="/kariyer" class="btn btn-outline-primary rounded-pill px-3 fw-medium">
                        <i class="fa-solid fa-briefcase me-2"></i><%= t('career.openings') %>
                    </a>
                </div>
            </div>

            <!-- Completeness Bar -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-semibold small"><%= t('career.completeness') %></span>
                        <span class="fw-bold"><%= completeness %>%</span>
                    </div>
                    <div class="progress" style="height: 8px;" role="progressbar"
                         aria-label="<%= t('career.completeness') %>" aria-valuenow="<%= completeness %>"
                         aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar <%= completeness >= 70 ? 'bg-success' : 'bg-warning' %>"
                             style="width: <%= completeness %>%"></div>
                    </div>
                    <p class="text-muted small mb-0 mt-2"><%= t('career.completeness_help') %></p>
                </div>
            </div>

            <form action="/kariyer/cv" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <!-- Photo & Custom PDF Section -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h2 class="fs-5 fw-bold mb-3"><%= t('career.section_media') || 'Fotoğraf ve Hazır PDF Dosyası' %></h2>

                        <div class="row g-4">
                            <!-- CV Photo -->
                            <div class="col-12 col-md-6 border-end-md">
                                <label class="form-label small fw-semibold d-block mb-2">
                                    <i class="fa-solid fa-camera text-primary me-1"></i><%= t('career.cv_photo') || 'Özgeçmiş Fotoğrafı' %>
                                </label>
                                
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <% const currentPhoto = (profile && profile.photo_url) || (candidateUser && candidateUser.avatar_url); %>
                                    <% if (currentPhoto) { %>
                                        <img src="<%= currentPhoto %>" class="rounded-4 object-fit-cover border shadow-sm" width="75" height="75" alt="CV Fotoğrafı" style="aspect-ratio: 1/1;">
                                    <% } else { %>
                                        <div class="rounded-4 bg-light border d-flex align-items-center justify-content-center text-muted" style="width: 75px; height: 75px;">
                                            <i class="fa-regular fa-user fs-3"></i>
                                        </div>
                                    <% } %>
                                    
                                    <div class="flex-grow-1">
                                        <input type="file" class="form-control form-control-sm" id="cvPhoto" name="photo" accept="image/jpeg,image/png,image/webp">
                                        <div class="form-text small"><%= t('career.photo_help') || 'Kare format, JPG, PNG veya WEBP (Maks. 5 MB)' %></div>
                                    </div>
                                </div>

                                <% if (profile && profile.photo_url) { %>
                                    <button type="submit" formaction="/kariyer/cv/photo/delete" class="btn btn-sm btn-link text-danger p-0 text-decoration-none small">
                                        <i class="fa-regular fa-trash-can me-1"></i><%= t('career.remove_photo') || 'Özel CV Fotoğrafını Kaldır' %>
                                    </button>
                                <% } %>
                            </div>

                            <!-- Custom PDF CV Upload -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold d-block mb-2">
                                    <i class="fa-solid fa-file-pdf text-danger me-1"></i><%= t('career.custom_cv_file') || 'Hazır PDF Özgeçmişi' %>
                                </label>

                                <% if (profile && profile.custom_cv_url) { %>
                                    <div class="p-3 bg-light border rounded-3 mb-2">
                                        <div class="d-flex align-items-center justify-content-between gap-2">
                                            <div class="d-flex align-items-center gap-2 min-w-0">
                                                <i class="fa-solid fa-file-pdf text-danger fs-4"></i>
                                                <div class="text-truncate">
                                                    <div class="fw-bold small text-truncate"><%= profile.custom_cv_name || 'Özgeçmiş.pdf' %></div>
                                                    <% if (profile.custom_cv_size) { %>
                                                        <span class="text-muted" style="font-size: 0.75rem;"><%= (profile.custom_cv_size / (1024 * 1024)).toFixed(2) %> MB</span>
                                                    <% } %>
                                                </div>
                                            </div>
                                            <a href="/kariyer/cv/custom" class="btn btn-sm btn-primary rounded-pill px-3 shadow-none flex-shrink-0" target="_blank">
                                                <i class="fa-solid fa-download me-1"></i><%= t('common.download') || 'İndir' %>
                                            </a>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center justify-content-between">
                                        <label for="customCvInput" class="btn btn-sm btn-outline-secondary rounded-pill px-3 mb-0" style="cursor: pointer;">
                                            <i class="fa-solid fa-arrows-rotate me-1"></i><%= t('career.replace_custom_cv') || 'Yeni PDF Yükle' %>
                                        </label>
                                        <input type="file" class="d-none" id="customCvInput" name="cv_file" accept="application/pdf" onchange="this.form.submit()">

                                        <button type="submit" formaction="/kariyer/cv/custom/delete" class="btn btn-sm btn-link text-danger p-0 text-decoration-none small">
                                            <i class="fa-regular fa-trash-can me-1"></i><%= t('career.remove_custom_cv') || 'PDF\'i Kaldır' %>
                                        </button>
                                    </div>
                                <% } else { %>
                                    <input type="file" class="form-control form-control-sm mb-2" id="cvFile" name="cv_file" accept="application/pdf">
                                    <div class="form-text small"><%= t('career.custom_cv_help') || 'Hazır bir PDF özgeçmişiniz varsa buradan yükleyebilirsiniz (Maks. 10 MB).' %></div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section Basics -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h2 class="fs-5 fw-bold mb-3"><%= t('career.section_basics') %></h2>

                        <div class="mb-3">
                            <label for="headline" class="form-label small fw-semibold">
                                <%= t('career.headline') %> <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="headline" name="headline"
                                   maxlength="120" <%= (!profile || !profile.custom_cv_url) ? 'required' : '' %>
                                   placeholder="<%= t('career.headline_placeholder') %>"
                                   value="<%= profile && profile.headline ? profile.headline : '' %>">
                        </div>

                        <div class="mb-3">
                            <label for="summary" class="form-label small fw-semibold"><%= t('career.summary') %></label>
                            <textarea class="form-control" id="summary" name="summary" rows="4" maxlength="2000"
                                      placeholder="<%= t('career.summary_placeholder') %>"><%= profile && profile.summary ? profile.summary : '' %></textarea>
                            <div class="form-text small"><%= t('career.summary_help') %></div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="experience_years" class="form-label small fw-semibold"><%= t('career.experience_years') %></label>
                                <input type="number" class="form-control" id="experience_years" name="experience_years"
                                       min="0" max="60"
                                       value="<%= profile ? profile.experience_years : 0 %>">
                            </div>
                            <div class="col-md-4">
                                <label for="preferred_city" class="form-label small fw-semibold"><%= t('career.preferred_city') %></label>
                                <select class="form-select" id="preferred_city" name="preferred_city">
                                    <option value=""><%= t('common.all') %></option>
                                    <% cities.grouped().forEach(function (group) { %>
                                        <optgroup label="<%= t('cities.region_' + group.region) %>">
                                             <% group.cities.forEach(function (cityName) { %>
                                                <option value="<%= cityName %>" <%= profile && profile.preferred_city === cityName ? 'selected' : '' %>>
                                                    <%= helpers.getCityName(cityName, lang) %>
                                                </option>
                                            <% }); %>
                                        </optgroup>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="preferred_work_type" class="form-label small fw-semibold"><%= t('career.preferred_work_type') %></label>
                                <select class="form-select" id="preferred_work_type" name="preferred_work_type">
                                    <option value=""><%= t('common.all') %></option>
                                    <% workTypes.forEach(function (workType) { %>
                                        <option value="<%= workType %>" <%= profile && profile.preferred_work_type === workType ? 'selected' : '' %>>
                                            <%= t('career.work_type_' + workType) %>
                                        </option>
                                    <% }); %>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section Background -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h2 class="fs-5 fw-bold mb-3"><%= t('career.section_background') %></h2>

                        <div class="mb-3">
                            <label for="education" class="form-label small fw-semibold"><%= t('career.education') %></label>
                            <textarea class="form-control" id="education" name="education" rows="3" maxlength="1000"
                                      placeholder="<%= t('career.education_placeholder') %>"><%= profile && profile.education ? profile.education : '' %></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="skills" class="form-label small fw-semibold"><%= t('career.skills') %></label>
                            <input type="text" class="form-control" id="skills" name="skills" maxlength="600"
                                   placeholder="<%= t('career.skills_placeholder') %>"
                                   value="<%= profile && profile.skills ? profile.skills : '' %>">
                            <div class="form-text small"><%= t('career.comma_help') %></div>
                        </div>

                        <div class="mb-3">
                            <label for="languages" class="form-label small fw-semibold"><%= t('career.languages') %></label>
                            <input type="text" class="form-control" id="languages" name="languages" maxlength="300"
                                   placeholder="<%= t('career.languages_placeholder') %>"
                                   value="<%= profile && profile.languages ? profile.languages : '' %>">
                            <div class="form-text small"><%= t('career.comma_help') %></div>
                        </div>

                        <div class="mb-0">
                            <label for="certificates" class="form-label small fw-semibold"><%= t('career.certificates') %></label>
                            <textarea class="form-control" id="certificates" name="certificates" rows="2" maxlength="800"
                                      placeholder="<%= t('career.certificates_placeholder') %>"><%= profile && profile.certificates ? profile.certificates : '' %></textarea>
                        </div>
                    </div>
                </div>

                <!-- Section Visibility -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h2 class="fs-5 fw-bold mb-3"><%= t('career.section_visibility') %></h2>

                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="is_open_to_work" value="1" id="isOpenToWork"
                                   <%= !profile || Number(profile.is_open_to_work) === 1 ? 'checked' : '' %>>
                            <label class="form-check-label" for="isOpenToWork"><%= t('career.open_to_work') %></label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="is_public" value="1" id="isPublic"
                                   <%= !profile || Number(profile.is_public) === 1 ? 'checked' : '' %>>
                            <label class="form-check-label" for="isPublic"><%= t('career.public_cv') %></label>
                            <div class="form-text small"><%= t('career.public_cv_help') %></div>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold">
                        <i class="fa-solid fa-floppy-disk me-2"></i><%= t('career.save_cv') %>
                    </button>
                    <% if (profile && (profile.headline || profile.custom_cv_url)) { %>
                        <a href="/kariyer/cv/pdf" target="_blank" class="btn btn-danger btn-lg rounded-pill px-4 fw-bold">
                            <i class="fa-solid fa-file-pdf me-2"></i><%= t('career.download_cypilan_pdf') || 'CYPILAN PDF İndir' %>
                        </a>
                    <% } %>
                    <a href="/kariyer/basvurularim" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                        <%= t('career.my_applications') %>
                    </a>
                    <% if (profile && (profile.headline || profile.custom_cv_url || profile.summary || profile.photo_url)) { %>
                        <button type="button" class="btn btn-outline-danger btn-lg rounded-pill px-4 ms-md-auto" data-bs-toggle="modal" data-bs-target="#resetCvModal">
                            <i class="fa-solid fa-trash-can me-2"></i><%= t('career.reset_cv') || 'CV\'yi Sıfırla' %>
                        </button>
                    <% } %>
                </div>
            </form>

            <% if (profile && (profile.headline || profile.custom_cv_url || profile.summary || profile.photo_url)) { %>
                <!-- Reset CV Confirmation Modal -->
                <div class="modal fade" id="resetCvModal" tabindex="-1" aria-labelledby="resetCvModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow rounded-4">
                            <div class="modal-header border-bottom-0 pb-0">
                                <h5 class="modal-title fw-bold text-danger" id="resetCvModalLabel">
                                    <i class="fa-solid fa-triangle-exclamation me-2"></i><%= t('career.reset_cv_title') || 'Özgeçmişi Sıfırla' %>
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body py-3">
                                <p class="text-muted mb-0">
                                    <%= t('career.reset_cv_confirm') || 'Özgeçmiş bilgilerinizi, yüklediğiniz CV fotoğrafını ve hazır PDF belgenizi tamamen silmek istediğinize emin misiniz? Bu işlem geri alınamaz.' %>
                                </p>
                            </div>
                            <div class="modal-footer border-top-0 pt-0">
                                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">
                                    <%= t('common.cancel') || 'Vazgeç' %>
                                </button>
                                <form action="/kariyer/cv/sifirla" method="POST">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
                                        <i class="fa-solid fa-trash-can me-1"></i><%= t('career.confirm_reset_cv') || 'Evet, Sıfırla' %>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 text-center my-4">
                <div class="card-body p-5">
                    <div class="display-1 fw-bolder text-primary mb-2">404</div>
                    <h1 class="fs-4 fw-bold text-dark mb-3"><%= t('errors.not_found_title') %></h1>
                    <p class="text-muted mb-4"><%= t('errors.not_found_message') %></p>

                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                        <a href="/" class="btn btn-primary rounded-pill px-4 fw-bold">
                            <i class="fa-solid fa-house me-2"></i><%= t('nav.home') %>
                        </a>
                        <a href="/listings" class="btn btn-outline-primary rounded-pill px-4 fw-medium">
                            <i class="fa-solid fa-magnifying-glass me-2"></i><%= t('nav.all_listings') %>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

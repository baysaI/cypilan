<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 text-center">

            <div class="mb-4">
                <i class="fa-solid fa-screwdriver-wrench text-primary" style="font-size: 4rem;"></i>
            </div>

            <h1 class="fs-2 fw-bold mb-3"><%= t('maintenance.title') %></h1>

            <p class="text-muted lead fs-6 mb-4">
                <%= maintenanceMessage || t('maintenance.default_message') %>
            </p>

            <% if (maintenanceUntil) { %>
                <div class="alert alert-light border rounded-4 d-inline-block px-4">
                    <i class="fa-regular fa-clock text-primary me-2"></i>
                    <%= t('maintenance.expected_back') %>
                    <strong><%= helpers.formatDate(maintenanceUntil, lang) %></strong>
                </div>
            <% } %>

            <p class="text-muted small mt-4 mb-0">
                <%= t('maintenance.thanks') %>
            </p>

        </div>
    </div>
</div>

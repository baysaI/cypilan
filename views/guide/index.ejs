<div class="container py-4 py-lg-5">
    <!-- Hero Banner -->
    <div class="card border-0 rounded-4 shadow-sm bg-gradient text-white p-4 p-md-5 mb-5 position-relative overflow-hidden" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
        <div class="row align-items-center position-relative z-1">
            <div class="col-lg-8">
                <span class="badge bg-white bg-opacity-25 text-white rounded-pill px-3 py-2 mb-3 fw-semibold">
                    <i class="fa-solid fa-compass me-1"></i> CYPILAN Yaşam & Bilgi Masası
                </span>
                <h1 class="display-6 fw-bold mb-3">Kıbrıs Yaşam, Emlak & Yatırım Rehberi</h1>
                <p class="lead opacity-90 mb-0">Kuzey Kıbrıs'ta ev alımından araç devir işlemlerine, kiralık daire fiyatlarından çalışma izinlerine kadar aradığınız tüm güncel ve güvenilir bilgiler.</p>
            </div>
            <div class="col-lg-4 d-none d-lg-flex justify-content-end">
                <i class="fa-solid fa-book-open-reader opacity-25" style="font-size: 130px;"></i>
            </div>
        </div>
    </div>

    <!-- Category Filter Pills -->
    <div class="d-flex flex-wrap gap-2 mb-4 pb-2">
        <% categories.forEach(function(cat) { %>
            <% const isActive = (activeCategory === cat.slug); %>
            <a href="/rehber<%= cat.slug === 'all' ? '' : '?cat=' + cat.slug %>" 
               class="btn rounded-pill px-4 py-2 fw-semibold d-flex align-items-center gap-2 transition-all <%= isActive ? 'btn-primary shadow-sm' : 'btn-white border text-secondary hover-lift' %>">
                <i class="fa-solid <%= cat.icon %>"></i>
                <span><%= cat.name %></span>
            </a>
        <% }); %>
    </div>

    <!-- Guides Grid -->
    <% if (guides && guides.length > 0) { %>
        <div class="row g-4">
            <% guides.forEach(function(guide) { %>
                <div class="col-12 col-md-6 col-lg-4">
                    <article class="card h-100 border-0 rounded-4 shadow-sm hover-lift overflow-hidden bg-white d-flex flex-column">
                        <div class="p-4 flex-grow-1 d-flex flex-column">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fw-semibold small">
                                    <i class="fa-solid <%= guide.icon %> me-1"></i> <%= guide.categoryName %>
                                </span>
                                <span class="text-muted small">
                                    <i class="fa-regular fa-clock me-1"></i> <%= guide.readTime %>
                                </span>
                            </div>

                            <h2 class="h5 fw-bold text-dark mb-3">
                                <a href="/rehber/<%= guide.slug %>" class="text-dark text-decoration-none hover-text-primary">
                                    <%= guide.title %>
                                </a>
                            </h2>

                            <p class="text-secondary small line-clamp-3 mb-4 flex-grow-1">
                                <%= guide.summary %>
                            </p>

                            <div class="d-flex flex-wrap gap-1 mb-3">
                                <% guide.tags.slice(0, 3).forEach(function(tag) { %>
                                    <span class="badge bg-light text-muted fw-normal rounded-pill px-2 py-1 small">#<%= tag %></span>
                                <% }); %>
                            </div>

                            <div class="pt-3 border-top d-flex align-items-center justify-content-between mt-auto">
                                <span class="text-muted small">
                                    <i class="fa-regular fa-calendar me-1"></i> <%= guide.publishedAt %>
                                </span>
                                <a href="/rehber/<%= guide.slug %>" class="btn btn-sm btn-outline-primary rounded-pill fw-bold px-3">
                                    Oku <i class="fa-solid fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </article>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="text-center py-5">
            <i class="fa-solid fa-folder-open text-muted mb-3" style="font-size: 48px;"></i>
            <h4 class="fw-bold">Bu kategoride henüz rehber bulunmuyor</h4>
            <p class="text-muted">Diğer kategorilerimizi inceleyebilir veya tüm rehberleri görüntüleyebilirsiniz.</p>
            <a href="/rehber" class="btn btn-primary rounded-pill px-4 fw-bold">Tüm Rehberleri Gör</a>
        </div>
    <% } %>
</div>

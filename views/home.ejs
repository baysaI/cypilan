<div class="home-wrapper">
    <h1 class="visually-hidden"><%= t('site.tagline') %> <%= t('site.name') %></h1>

    <section class="categories-section py-5 bg-white">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <h2 class="fw-bold mb-1 text-dark"><%= t('home.categories_title') %></h2>
                    <p class="text-muted mb-0"><%= t('home.categories_subtitle') %></p>
                </div>
            </div>
            
            <%# Three across on a phone rather than two: five categories in a
                two-column grid leaves the last one alone on a half-empty row,
                and three rows of tall cards push everything else off screen.
                Centring keeps the short final row deliberate at any count. %>
            <div class="row g-2 g-sm-3 g-md-4 justify-content-center">
                <% 
                const catIcons = {
                    'emlak': 'fa-house',
                    'vasita': 'fa-car',
                    'is-ilanlari': 'fa-briefcase',
                    'usta-hizmetler': 'fa-screwdriver-wrench',
                    'ikinci-el': 'fa-couch'
                };
                const currentLang = typeof lang !== 'undefined' ? lang : 'tr';
                %>
                
                <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                    <% categories.forEach(function(cat) { %>
                        <div class="col-4 col-lg">
                            <a href="/listings?category=<%= cat.slug %>" class="text-decoration-none">
                                <div class="card category-card border-0 shadow-sm rounded-4 h-100 bg-light hover-bg-primary-light transition-all text-center p-3 p-md-4 group">
                                    <div class="icon-wrapper mb-2 mb-md-3 mx-auto bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 64px; height: 64px;">
                                        <i class="fa-solid <%= catIcons[cat.slug] || 'fa-tag' %> fs-3 text-primary group-hover-scale"></i>
                                    </div>
                                    <h6 class="category-card-title fw-bold text-dark mb-1"><%= cat['name_' + currentLang] || cat.name_tr %></h6>
                                    <span class="small text-muted"><%= cat.listing_count || 0 %> <%= t('home.ad_unit') %></span>
                                </div>
                            </a>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </div>
    </section>

    <section class="featured-section py-5 bg-light">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <h2 class="fw-bold mb-1 text-dark d-flex align-items-center">
                        <i class="fa-solid fa-crown text-warning me-2 fs-4"></i> <%= t('home.featured_listings') %>
                    </h2>
                    <p class="text-muted mb-0"><%= t('home.featured_subtitle') %></p>
                </div>
                <a href="/listings?premium=true" class="btn btn-outline-primary rounded-pill px-4 fw-medium d-none d-md-inline-block hover-lift"><%= t('home.show_all') %></a>
            </div>

            <%# Two to a row on a phone. One full-width card is 356px tall, so a
                single listing filled the screen and four meant three screens of
                scrolling to see them. %>
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3 g-md-4">
                <% const displayListings = (typeof featuredListings !== 'undefined' && featuredListings && featuredListings.length > 0) ? featuredListings : (typeof recentListings !== 'undefined' ? recentListings : []); %>
                
                <% if (displayListings.length > 0) { %>
                    <% displayListings.forEach(function(listing) { %>
                        <div class="col">
                            <%- include('partials/listingCard', { listing: listing }) %>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="col-12 text-center py-5 text-muted">
                        <i class="fa-solid fa-folder-open fs-1 mb-3 opacity-50 d-block"></i>
                        <p class="mb-0"><%= t('home.no_featured') %></p>
                    </div>
                <% } %>
            </div>
            
            <div class="text-center mt-4 d-md-none">
                <a href="/listings" class="btn btn-outline-primary rounded-pill px-4 fw-medium"><%= t('home.show_all') %></a>
            </div>
        </div>
    </section>

    <section class="stats-cta-section py-5 py-md-7 position-relative overflow-hidden bg-primary text-white">
        <div class="container position-relative z-1">
            <div class="row g-4 align-items-center">
                <div class="col-lg-6 text-center text-lg-start">
                    <h2 class="display-5 fw-bold mb-3"><%= t('home.cta_title') %></h2>
                    <p class="lead text-white-50 mb-4"><%= t('home.cta_subtitle') %></p>
                    <a href="/listings/create" class="btn btn-accent btn-lg rounded-pill px-5 fw-bold shadow-lg pulse-button"><%= t('home.cta_button') %></a>
                </div>
                
                <div class="col-lg-6">
                    <div class="row g-3">
                        <div class="col-6 col-md-4">
                            <div class="bg-white bg-opacity-10 rounded-4 p-4 text-center backdrop-blur border border-white border-opacity-10">
                                <h3 class="fw-bold mb-0"><%= (typeof stats !== 'undefined' && stats.totalListings) ? stats.totalListings : 0 %></h3>
                                <p class="small text-white-50 mb-0"><%= t('home.active_listings') %></p>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="bg-white bg-opacity-10 rounded-4 p-4 text-center backdrop-blur border border-white border-opacity-10">
                                <h3 class="fw-bold mb-0"><%= (typeof stats !== 'undefined' && stats.totalUsers) ? stats.totalUsers : 1 %></h3>
                                <p class="small text-white-50 mb-0"><%= t('home.registered_users') %></p>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="bg-white bg-opacity-10 rounded-4 p-4 text-center backdrop-blur border border-white border-opacity-10">
                                <h3 class="fw-bold mb-0"><%= (typeof stats !== 'undefined' && stats.totalCities) ? stats.totalCities : 5 %></h3>
                                <p class="small text-white-50 mb-0"><%= t('home.major_cities') %></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="student-hub-section py-5 bg-light border-top">
        <div class="container">
            <div class="card border-0 rounded-4 shadow-sm bg-white p-4 p-md-5 position-relative overflow-hidden">
                <div class="row align-items-center position-relative z-1 g-4">
                    <div class="col-lg-6 text-center text-lg-start">
                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-20 px-3 py-2 rounded-pill fw-bold mb-3 text-uppercase" style="letter-spacing: 1px;">
                            <i class="fa-solid fa-graduation-cap me-1"></i> <%= t('students.badge') %>
                        </span>
                        <h2 class="display-6 fw-bold mb-2 text-dark"><%= t('students.title') %></h2>
                        <p class="lead text-muted mb-4"><%= t('students.subtitle') %></p>
                        <div class="d-flex justify-content-center justify-content-lg-start">
                            <a href="/ogrenci" class="btn btn-primary btn-lg rounded-pill px-4 fw-bold shadow-sm">
                                <i class="fa-solid fa-graduation-cap me-2"></i><%= t('students.title') %>
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="row g-3">
                            <div class="col-6">
                                <a href="/ogrenci" class="text-decoration-none">
                                    <div class="card h-100 border-0 bg-light p-3 p-md-4 text-center rounded-4 hover-lift group">
                                        <div class="icon-box mx-auto mb-2 bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                            <i class="fa-solid fa-user-group fs-4"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-0 small"><%= t('students.roommates_title') %></h6>
                                    </div>
                                </a>
                            </div>
                            <div class="col-6">
                                <a href="/ogrenci" class="text-decoration-none">
                                    <div class="card h-100 border-0 bg-light p-3 p-md-4 text-center rounded-4 hover-lift group">
                                        <div class="icon-box mx-auto mb-2 bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                            <i class="fa-solid fa-house-user fs-4"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-0 small"><%= t('students.housing_title') %></h6>
                                    </div>
                                </a>
                            </div>
                            <div class="col-6">
                                <a href="/ogrenci" class="text-decoration-none">
                                    <div class="card h-100 border-0 bg-light p-3 p-md-4 text-center rounded-4 hover-lift group">
                                        <div class="icon-box mx-auto mb-2 bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                            <i class="fa-solid fa-box-open fs-4"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-0 small"><%= t('students.second_hand_title') %></h6>
                                    </div>
                                </a>
                            </div>
                            <div class="col-6">
                                <a href="/ogrenci" class="text-decoration-none">
                                    <div class="card h-100 border-0 bg-light p-3 p-md-4 text-center rounded-4 hover-lift group">
                                        <div class="icon-box mx-auto mb-2 bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                            <i class="fa-solid fa-briefcase fs-4"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-0 small"><%= t('students.part_time_title') %></h6>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<div class="home-wrapper">
    <h1 class="visually-hidden">Kıbrıs'ın İlan Platformu CYPILAN.COM</h1>

    <section class="categories-section py-5 bg-white">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <h2 class="fw-bold mb-1 text-dark">Kategoriler</h2>
                    <p class="text-muted mb-0">İhtiyacınıza uygun kategoriyi seçin</p>
                </div>
            </div>
            
            <div class="row g-3 g-md-4">
                <% 
                const catIcons = {
                    'emlak': 'fa-house',
                    'vasita': 'fa-car',
                    'is-ilanlari': 'fa-briefcase',
                    'usta-hizmetler': 'fa-screwdriver-wrench',
                    'ikinci-el': 'fa-couch'
                };
                %>
                
                <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                    <% categories.forEach(function(cat) { %>
                        <div class="col-6 col-md-4 col-lg">
                            <a href="/listings?category=<%= cat.slug %>" class="text-decoration-none">
                                <div class="card category-card border-0 shadow-sm rounded-4 h-100 bg-light hover-bg-primary-light transition-all text-center p-3 p-md-4 group">
                                    <div class="icon-wrapper mb-3 mx-auto bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 64px; height: 64px;">
                                        <i class="fa-solid <%= catIcons[cat.slug] || 'fa-tag' %> fs-3 text-primary group-hover-scale"></i>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-1"><%= cat.name_tr %></h6>
                                    <span class="small text-muted"><%= cat.listing_count || 0 %> İlan</span>
                                </div>
                            </a>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </div>
    </section>

    <section class="featured-section py-5 bg-light">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <h2 class="fw-bold mb-1 text-dark d-flex align-items-center">
                        <i class="fa-solid fa-crown text-warning me-2 fs-4"></i> Vitrin İlanları
                    </h2>
                    <p class="text-muted mb-0">Öne çıkan fırsatları kaçırmayın</p>
                </div>
                <a href="/listings?premium=true" class="btn btn-outline-primary rounded-pill px-4 fw-medium d-none d-md-inline-block hover-lift">Tümünü Gör</a>
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
                <% const displayListings = (typeof featuredListings !== 'undefined' && featuredListings && featuredListings.length > 0) ? featuredListings : (typeof recentListings !== 'undefined' ? recentListings : []); %>
                
                <% if (displayListings.length > 0) { %>
                    <% displayListings.forEach(function(listing) { %>
                        <div class="col">
                            <%- include('partials/listingCard', { listing: listing }) %>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="col-12 text-center py-5 text-muted">
                        <i class="fa-solid fa-folder-open fs-1 mb-3 opacity-50 d-block"></i>
                        <p class="mb-0">Henüz vitrin ilanı bulunmuyor.</p>
                    </div>
                <% } %>
            </div>
            
            <div class="text-center mt-4 d-md-none">
                <a href="/listings" class="btn btn-outline-primary rounded-pill px-4 fw-medium">Tüm İlanları Gör</a>
            </div>
        </div>
    </section>

    <section class="stats-cta-section py-5 py-md-7 position-relative overflow-hidden bg-primary text-white">
        <div class="position-absolute top-0 start-0 w-100 h-100" style="background: url('/images/pattern.svg') center/cover; opacity: 0.1;"></div>
        
        <div class="container position-relative z-1">
            <div class="row g-4 align-items-center">
                <div class="col-lg-6 text-center text-lg-start">
                    <h2 class="display-5 fw-bold mb-3">Hemen İlan Verin!</h2>
                    <p class="lead text-white-50 mb-4">Binlerce alıcıya anında ulaşın, eşyalarınızı hızla satın veya kiralayın.</p>
                    <a href="/listings/create" class="btn btn-accent btn-lg rounded-pill px-5 fw-bold shadow-lg pulse-button">Ücretsiz İlan Ver</a>
                </div>
                
                <div class="col-lg-6">
                    <div class="row g-3">
                        <div class="col-6 col-md-4">
                            <div class="bg-white bg-opacity-10 rounded-4 p-4 text-center backdrop-blur border border-white border-opacity-10">
                                <h3 class="fw-bold mb-0"><%= (typeof stats !== 'undefined' && stats.totalListings) ? stats.totalListings : 0 %></h3>
                                <p class="small text-white-50 mb-0">Aktif İlan</p>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="bg-white bg-opacity-10 rounded-4 p-4 text-center backdrop-blur border border-white border-opacity-10">
                                <h3 class="fw-bold mb-0"><%= (typeof stats !== 'undefined' && stats.totalUsers) ? stats.totalUsers : 1 %></h3>
                                <p class="small text-white-50 mb-0">Kayıtlı Üye</p>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="bg-white bg-opacity-10 rounded-4 p-4 text-center backdrop-blur border border-white border-opacity-10">
                                <h3 class="fw-bold mb-0"><%= (typeof stats !== 'undefined' && stats.totalCities) ? stats.totalCities : 5 %></h3>
                                <p class="small text-white-50 mb-0">Büyük Şehir</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<div class="home-wrapper">
    <!-- Hero Section -->
    <section class="hero-section position-relative bg-gradient-primary overflow-hidden py-5 py-md-7">
        <!-- Abstract background elements -->
        <div class="position-absolute top-0 start-0 w-100 h-100 overflow-hidden pointer-events-none">
            <div class="position-absolute rounded-circle bg-white opacity-5" style="width: 500px; height: 500px; top: -100px; right: -100px; filter: blur(40px);"></div>
            <div class="position-absolute rounded-circle bg-accent opacity-10" style="width: 300px; height: 300px; bottom: -50px; left: 10%; filter: blur(50px);"></div>
        </div>

        <div class="container position-relative z-1 py-5">
            <div class="row justify-content-center text-center mb-5">
                <div class="col-12 col-lg-8">
                    <h1 class="display-4 fw-bolder text-white mb-3 text-shadow-sm animate-fade-in-up">Kıbrıs'ın En Büyük İlan Platformu</h1>
                    <p class="lead text-white-50 mb-0 fw-medium animate-fade-in-up delay-1">Aradığınız her şey burada. Hayalinizdeki ev, araba veya iş fırsatı sadece bir tık uzağınızda.</p>
                </div>
            </div>

            <div class="row justify-content-center animate-fade-in-up delay-2">
                <div class="col-12 col-xl-10">
                    <%- include('partials/searchBar') %>
                </div>
            </div>
        </div>
    </section>

    <!-- Categories Section -->
    <section class="categories-section py-5 bg-white">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <h2 class="fw-bold mb-1 text-dark">Kategoriler</h2>
                    <p class="text-muted mb-0">İhtiyacınıza uygun kategoriyi seçin</p>
                </div>
            </div>
            
            <div class="row g-3 g-md-4">
                <!-- Real Estate -->
                <div class="col-6 col-md-4 col-lg">
                    <a href="/listings?category=emlak" class="text-decoration-none">
                        <div class="card category-card border-0 shadow-sm rounded-4 h-100 bg-light hover-bg-primary-light transition-all text-center p-3 p-md-4 group">
                            <div class="icon-wrapper mb-3 mx-auto bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 64px; height: 64px;">
                                <i class="fa-solid fa-house fs-3 text-primary group-hover-scale"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">Emlak</h6>
                            <span class="small text-muted">12.5K+ İlan</span>
                        </div>
                    </a>
                </div>
                
                <!-- Vehicles -->
                <div class="col-6 col-md-4 col-lg">
                    <a href="/listings?category=vasita" class="text-decoration-none">
                        <div class="card category-card border-0 shadow-sm rounded-4 h-100 bg-light hover-bg-primary-light transition-all text-center p-3 p-md-4 group">
                            <div class="icon-wrapper mb-3 mx-auto bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 64px; height: 64px;">
                                <i class="fa-solid fa-car fs-3 text-primary group-hover-scale"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">Vasıta</h6>
                            <span class="small text-muted">8.2K+ İlan</span>
                        </div>
                    </a>
                </div>

                <!-- Jobs -->
                <div class="col-6 col-md-4 col-lg">
                    <a href="/listings?category=is-ilanlari" class="text-decoration-none">
                        <div class="card category-card border-0 shadow-sm rounded-4 h-100 bg-light hover-bg-primary-light transition-all text-center p-3 p-md-4 group">
                            <div class="icon-wrapper mb-3 mx-auto bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 64px; height: 64px;">
                                <i class="fa-solid fa-briefcase fs-3 text-primary group-hover-scale"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">İş İlanları</h6>
                            <span class="small text-muted">3.1K+ İlan</span>
                        </div>
                    </a>
                </div>

                <!-- Services -->
                <div class="col-6 col-md-4 col-lg">
                    <a href="/listings?category=ustalar" class="text-decoration-none">
                        <div class="card category-card border-0 shadow-sm rounded-4 h-100 bg-light hover-bg-primary-light transition-all text-center p-3 p-md-4 group">
                            <div class="icon-wrapper mb-3 mx-auto bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 64px; height: 64px;">
                                <i class="fa-solid fa-tools fs-3 text-primary group-hover-scale"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">Ustalar</h6>
                            <span class="small text-muted">1.5K+ İlan</span>
                        </div>
                    </a>
                </div>

                <!-- Second Hand -->
                <div class="col-12 col-md-4 col-lg">
                    <a href="/listings?category=ikinci-el" class="text-decoration-none">
                        <div class="card category-card border-0 shadow-sm rounded-4 h-100 bg-light hover-bg-primary-light transition-all text-center p-3 p-md-4 group">
                            <div class="icon-wrapper mb-3 mx-auto bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 64px; height: 64px;">
                                <i class="fa-solid fa-couch fs-3 text-primary group-hover-scale"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">İkinci El</h6>
                            <span class="small text-muted">5.4K+ İlan</span>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Listings -->
    <section class="featured-section py-5 bg-light">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <h2 class="fw-bold mb-1 text-dark d-flex align-items-center">
                        <i class="fa-solid fa-crown text-warning me-2 fs-4"></i> Vitrin İlanları
                    </h2>
                    <p class="text-muted mb-0">Öne çıkan fırsatları kaçırmayın</p>
                </div>
                <a href="/listings?premium=true" class="btn btn-outline-primary rounded-pill px-4 fw-medium d-none d-md-inline-block hover-lift">Tümünü Gör</a>
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
                <% 
                // Placeholder dummy data for view
                const dummyListings = [
                    { id: 1, title: 'Girne Merkezde Lüks 3+1 Daire', price: 125000, currency: 'GBP', city: 'Girne', district: 'Merkez', categoryName: 'Satılık Daire', isPremium: true, imageCount: 12, dateFormatted: '2 saat önce' },
                    { id: 2, title: '2020 Model Mercedes C200d AMG', price: 42000, currency: 'GBP', city: 'Lefkoşa', district: 'Küçük Kaymaklı', categoryName: 'Otomobil', isPremium: true, imageCount: 8, dateFormatted: '5 saat önce' },
                    { id: 3, title: 'Deniz Manzaralı Kiralık Villa', price: 1500, currency: 'GBP', city: 'İskele', district: 'Boğaz', categoryName: 'Kiralık Villa', isPremium: true, imageCount: 15, dateFormatted: 'Dün' },
                    { id: 4, title: 'Temiz İkinci El iPhone 13 Pro', price: 25000, currency: 'TRY', city: 'Gazimağusa', district: 'Merkez', categoryName: 'Cep Telefonu', isPremium: true, imageCount: 3, dateFormatted: 'Bugün' }
                ];
                %>
                
                <% dummyListings.forEach(function(listing) { %>
                    <div class="col">
                        <%- include('partials/listingCard', { listing: listing }) %>
                    </div>
                <% }); %>
            </div>
            
            <div class="text-center mt-4 d-md-none">
                <a href="/listings?premium=true" class="btn btn-outline-primary rounded-pill px-4 fw-medium w-100">Tüm Vitrin İlanlarını Gör</a>
            </div>
        </div>
    </section>

    <!-- Stats & CTA -->
    <section class="stats-cta-section py-5 py-md-7 position-relative overflow-hidden bg-primary text-white">
        <div class="position-absolute top-0 start-0 w-100 h-100" style="background: url('/images/pattern.svg') center/cover; opacity: 0.1;"></div>
        
        <div class="container position-relative z-1">
            <div class="row g-4 align-items-center">
                <div class="col-lg-6 text-center text-lg-start">
                    <h2 class="display-5 fw-bold mb-3">Hemen İlan Verin!</h2>
                    <p class="lead text-white-50 mb-4">Binlerce alıcıya anında ulaşın, eşyalarınızı hızla satın veya kiralayın.</p>
                    <a href="/listings/create" class="btn btn-accent btn-lg rounded-pill px-5 fw-bold shadow-lg pulse-button">Ücretsiz İlan Ver</a>
                </div>
                
                <div class="col-lg-6">
                    <div class="row g-3">
                        <div class="col-6 col-md-4">
                            <div class="bg-white bg-opacity-10 rounded-4 p-4 text-center backdrop-blur border border-white border-opacity-10">
                                <h3 class="fw-bold mb-0">50K+</h3>
                                <p class="small text-white-50 mb-0">Aktif İlan</p>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="bg-white bg-opacity-10 rounded-4 p-4 text-center backdrop-blur border border-white border-opacity-10">
                                <h3 class="fw-bold mb-0">120K+</h3>
                                <p class="small text-white-50 mb-0">Mutlu Üye</p>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="bg-white bg-opacity-10 rounded-4 p-4 text-center backdrop-blur border border-white border-opacity-10">
                                <h3 class="fw-bold mb-0">5</h3>
                                <p class="small text-white-50 mb-0">Büyük Şehir</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

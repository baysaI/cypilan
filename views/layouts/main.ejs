<!DOCTYPE html>
<%
    const pageLang = typeof lang !== 'undefined' ? lang : 'tr';
    const pageDir = typeof dir !== 'undefined' ? dir : 'ltr';
    const pageMeta = typeof meta !== 'undefined' && meta ? meta : {};
    const siteName = 'CYPILAN.COM';

    const rawTitle = pageMeta.title || 'Kıbrıs\'ın En Büyük İlan Platformu';
    const pageTitle = rawTitle.indexOf(siteName) > -1 ? rawTitle : `${rawTitle} | ${siteName}`;

    const pageDescription = pageMeta.description || 'Kıbrıs emlak, vasıta, iş ilanları, ustalar ve ikinci el eşya alım satım platformu.';
    const canonicalUrl = pageMeta.canonical || 'https://www.cypilan.com';
    const pageUrl = pageMeta.url || canonicalUrl;

    const base = typeof siteUrl !== 'undefined' && siteUrl ? siteUrl : 'https://www.cypilan.com';
    const rawImage = pageMeta.ogImage || '/img/logo.png';
    const ogImageUrl = rawImage.indexOf('http') === 0 ? rawImage : base + rawImage;
%>
<html lang="<%= pageLang %>" dir="<%= pageDir %>" data-bs-theme="<%= theme %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <meta name="theme-color" content="<%= theme === 'dark' ? '#15181b' : '#ffffff' %>">
    <title><%= pageTitle %></title>
    <meta name="description" content="<%= pageDescription %>">
    <% if (pageMeta.keywords) { %><meta name="keywords" content="<%= pageMeta.keywords %>"><% } %>
    <% if (pageMeta.robots) { %><meta name="robots" content="<%= pageMeta.robots %>"><% } %>
    <% if (typeof csrfToken !== 'undefined' && csrfToken) { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>

    <meta property="og:site_name" content="<%= siteName %>">
    <meta property="og:locale" content="<%= pageLang %>">
    <meta property="og:title" content="<%= pageTitle %>">
    <meta property="og:description" content="<%= pageDescription %>">
    <meta property="og:image" content="<%= ogImageUrl %>">
    <meta property="og:url" content="<%= pageUrl %>">
    <meta property="og:type" content="<%= pageMeta.type || 'website' %>">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= pageTitle %>">
    <meta name="twitter:description" content="<%= pageDescription %>">
    <meta name="twitter:image" content="<%= ogImageUrl %>">

    <link rel="canonical" href="<%= canonicalUrl %>">

    <% ['tr', 'en', 'el', 'ru', 'fa'].forEach(function (code) { %>
        <link rel="alternate" hreflang="<%= code %>" href="<%= canonicalUrl %>?lang=<%= code %>" />
    <% }); %>
    <link rel="alternate" hreflang="x-default" href="<%= canonicalUrl %>" />

    <% if (typeof schemaOrg !== 'undefined' && schemaOrg) { %>
    <script type="application/ld+json">
        <%- JSON.stringify(schemaOrg) %>
    </script>
    <% } %>

    <link rel="icon" type="image/png" href="/img/logo.png">
    <link rel="apple-touch-icon" href="/img/logo.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <% if (pageDir === 'rtl') { %>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <% } else { %>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <% } %>

    <link rel="stylesheet" href="/css/style.css">

    <% if (typeof style !== 'undefined' && style) { %><%- style %><% } %>
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    
    <%- include('../partials/header') %>

    <% if (typeof maintenanceBypass !== 'undefined' && maintenanceBypass) { %>
        <div class="bg-danger text-white py-2">
            <div class="container d-flex flex-wrap align-items-center gap-2 small">
                <i class="fa-solid fa-screwdriver-wrench"></i>
                <strong><%= t('maintenance.admin_banner') %></strong>
                <a href="/admin/bakim" class="text-white text-decoration-underline ms-auto fw-semibold">
                    <%= t('maintenance.admin_banner_action') %>
                </a>
            </div>
        </div>
    <% } %>

    <% if (typeof flash !== 'undefined' && flash && (flash.success || flash.error || flash.info)) { %>
        <div class="container mt-3">
            <% if (flash.error) { %>
                <div class="alert alert-danger alert-dismissible fade show mb-0" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2"></i><%= flash.error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                </div>
            <% } %>
            <% if (flash.success) { %>
                <div class="alert alert-success alert-dismissible fade show mb-0" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i><%= flash.success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                </div>
            <% } %>
            <% if (flash.info) { %>
                <div class="alert alert-info alert-dismissible fade show mb-0" role="alert">
                    <i class="fa-solid fa-circle-info me-2"></i><%= flash.info %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                </div>
            <% } %>
        </div>
    <% } %>

    <main id="content" role="main" class="flex-grow-1">
        <%- body %>
    </main>

    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="/js/main.js"></script>

    <% if (typeof script !== 'undefined' && script) { %><%- script %><% } %>
</body>
</html>

<!DOCTYPE html>
<%
    const pageLang = typeof lang !== 'undefined' ? lang : 'tr';
    const pageDir = typeof dir !== 'undefined' ? dir : 'ltr';
    const pageMeta = typeof meta !== 'undefined' && meta ? meta : {};
    const siteName = 'CYPILAN.COM';

    const rawTitle = pageMeta.title || 'Kıbrıs\'ın En Büyük İlan Platformu';
    const pageTitle = rawTitle.indexOf(siteName) > -1 ? rawTitle : `${rawTitle} | ${siteName}`;

    const pageDescription = pageMeta.description || 'Kıbrıs emlak, vasıta, iş ilanları, ustalar ve ikinci el eşya alım satım platformu.';
    const canonicalUrl = pageMeta.canonical || 'https://www.cypilan.com';
    const pageUrl = pageMeta.url || canonicalUrl;

    const base = typeof siteUrl !== 'undefined' && siteUrl ? siteUrl : 'https://www.cypilan.com';
    const rawImage = pageMeta.ogImage || '/img/logo.png';
    const ogImageUrl = rawImage.indexOf('http') === 0 ? rawImage : base + rawImage;
%>
<html lang="<%= pageLang %>" dir="<%= pageDir %>" data-bs-theme="<%= theme %>">
<head>
    <meta charset="UTF-8">
    <%# viewport-fit=cover lets the page paint under the notch and home bar; the
        safe-area insets in style.css keep content out from under them. %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
    <meta name="theme-color" content="<%= theme === 'dark' ? '#15181b' : '#ffffff' %>">
    <meta name="color-scheme" content="<%= theme === 'dark' ? 'dark' : 'light' %>">
    <title><%= pageTitle %></title>
    <meta name="description" content="<%= pageDescription %>">
    <% if (pageMeta.keywords) { %><meta name="keywords" content="<%= pageMeta.keywords %>"><% } %>
    <% if (pageMeta.robots) { %><meta name="robots" content="<%= pageMeta.robots %>"><% } %>
    <% if (typeof csrfToken !== 'undefined' && csrfToken) { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>

    <meta property="og:site_name" content="<%= siteName %>">
    <meta property="og:locale" content="<%= pageLang %>">
    <meta property="og:title" content="<%= pageTitle %>">
    <meta property="og:description" content="<%= pageDescription %>">
    <meta property="og:image" content="<%= ogImageUrl %>">
    <meta property="og:url" content="<%= pageUrl %>">
    <meta property="og:type" content="<%= pageMeta.type || 'website' %>">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= pageTitle %>">
    <meta name="twitter:description" content="<%= pageDescription %>">
    <meta name="twitter:image" content="<%= ogImageUrl %>">

    <link rel="canonical" href="<%= canonicalUrl %>">

    <% ['tr', 'en', 'el', 'ru', 'fa'].forEach(function (code) { %>
        <link rel="alternate" hreflang="<%= code %>" href="<%= canonicalUrl %>?lang=<%= code %>" />
    <% }); %>
    <link rel="alternate" hreflang="x-default" href="<%= canonicalUrl %>" />

    <% if (typeof schemaOrg !== 'undefined' && schemaOrg) { %>
    <script type="application/ld+json">
        <%- JSON.stringify(schemaOrg) %>
    </script>
    <% } %>

    <link rel="icon" type="image/png" href="/img/logo.png">
    <link rel="apple-touch-icon" href="/img/logo.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <% if (pageDir === 'rtl') { %>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <% } else { %>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <% } %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
    <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>">

    <% if (typeof style !== 'undefined' && style) { %><%- style %><% } %>
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    
    <%- include('../partials/header') %>

    <% if (typeof maintenanceBypass !== 'undefined' && maintenanceBypass) { %>
        <div class="bg-danger text-white py-2">
            <div class="container d-flex flex-wrap align-items-center gap-2 small">
                <i class="fa-solid fa-screwdriver-wrench"></i>
                <strong><%= t('maintenance.admin_banner') %></strong>
                <a href="/admin/bakim" class="text-white text-decoration-underline ms-auto fw-semibold">
                    <%= t('maintenance.admin_banner_action') %>
                </a>
            </div>
        </div>
    <% } %>

    <% if (typeof previewBanner !== 'undefined' && previewBanner) { %>
        <div class="bg-warning text-dark py-2 border-bottom border-warning-subtle">
            <div class="container d-flex flex-wrap align-items-center gap-2 small">
                <i class="fa-solid fa-eye"></i>
                <strong><%= t('admin.preview_banner_title') || 'İlan Önizleme Modu' %></strong>
                <span class="text-muted"><%= t('admin.preview_banner_desc') || 'Bu ilan henüz onaylanmamış veya taslak durumdadır.' %></span>
                <a href="/admin/ilanlar" class="text-dark fw-semibold ms-auto">
                    <%= t('admin.preview_banner_back') || 'Yönetim Paneline Dön' %> &rarr;
                </a>
            </div>
        </div>
    <% } %>

    <% if (typeof isEmailUnverified !== 'undefined' && isEmailUnverified) { %>
        <div class="bg-warning text-dark py-2">
            <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2 small">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-envelope-circle-check fs-6 text-dark"></i>
                    <span><%= t('common.unverified_email_banner') %></span>
                </div>
                <form action="/auth/resend-verification" method="POST" class="m-0">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-sm btn-dark py-0 px-2" style="font-size: 0.8rem;">
                        <%= t('common.resend_verification_btn') %>
                    </button>
                </form>
            </div>
        </div>
    <% } %>

    <% const hasFlash = (typeof success !== 'undefined' && success && success.length > 0) || (typeof error !== 'undefined' && error && error.length > 0) || (typeof info !== 'undefined' && info && info.length > 0); %>
    <% if (hasFlash) { %>
        <div class="container mt-3">
            <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show mb-0" role="alert">
                    <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                </div>
            <% } %>
            <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show mb-0" role="alert">
                    <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                </div>
            <% } %>
            <% if (typeof info !== 'undefined' && info && info.length > 0) { %>
                <div class="alert alert-info alert-dismissible fade show mb-0" role="alert">
                    <%= info %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                </div>
            <% } %>
        </div>
    <% } %>

    <main id="content" role="main" class="flex-grow-1">
        <%- body %>
    </main>

    <!-- Floating Comparison Drawer (Self-contained Fixed Layout & Elevated Above Live Support) -->
    <div id="compareFloatingDrawer" class="position-fixed start-50 translate-middle-x d-none shadow-lg bg-white border rounded-pill p-2 px-3" style="bottom: 80px; z-index: 1060; max-width: calc(100vw - 20px); width: max-content; min-width: 280px; box-shadow: 0 10px 30px rgba(0,0,0,0.2) !important;">
        <div class="d-flex align-items-center justify-content-between gap-2 gap-md-3">
            <div class="d-flex align-items-center gap-2 min-w-0">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 shadow-sm" style="width: 32px; height: 32px; font-size: 0.85rem;">
                    <i class="fa-solid fa-code-compare"></i>
                </div>
                <div class="min-w-0 d-flex align-items-center gap-1 gap-md-2">
                    <strong class="small text-dark text-nowrap"><span id="compareCount">0</span> İlan</strong>
                    <div class="d-flex gap-1 overflow-hidden" id="compareThumbnails"></div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-1 gap-md-2 flex-shrink-0">
                <button type="button" class="btn btn-light btn-sm rounded-circle p-0 d-flex align-items-center justify-content-center text-muted border-0" style="width: 28px; height: 28px;" id="clearCompareDrawerBtn" title="Temizle">
                    <i class="fa-solid fa-xmark small"></i>
                </button>
                <a href="/listings/compare" id="goToCompareBtn" class="btn btn-primary btn-sm rounded-pill px-3 py-1 fw-bold shadow-sm d-flex align-items-center gap-1 text-white text-decoration-none" style="font-size: 0.82rem;">
                    <span>Karşılaştır</span>
                    <i class="fa-solid fa-arrow-right small"></i>
                </a>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>

    <%# One copy for the whole site: the footer link and the account menu item both
        open this modal, so the form cannot drift into two versions. %>
    <%- include('../partials/feedbackModal') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>

    <script src="/js/main.js?v=<%= Date.now() %>"></script>

    <% if (typeof script !== 'undefined' && script) { %><%- script %><% } %>
</body>
</html>

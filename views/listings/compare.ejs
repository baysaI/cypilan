<style>
.compare-table-container {
    position: relative;
    border-radius: 1rem;
    background: #ffffff;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
}
.compare-sticky-col {
    position: sticky;
    left: 0;
    z-index: 5;
    background: #f8fafc !important;
    min-width: 160px;
    width: 200px;
    box-shadow: 2px 0 6px rgba(0,0,0,0.04);
}
.compare-item-col {
    min-width: 230px;
    width: <%= listings ? Math.max(230, Math.floor(75 / listings.length)) : 230 %>px;
}
@media (max-width: 768px) {
    .compare-sticky-col {
        min-width: 100px !important;
        width: 100px !important;
        font-size: 0.75rem !important;
        padding: 8px 6px !important;
        font-weight: 700 !important;
    }
    .compare-item-col {
        min-width: 150px !important;
        width: 150px !important;
        padding: 8px 6px !important;
    }
    .compare-cell {
        font-size: 0.78rem !important;
        padding: 8px 6px !important;
    }
    .compare-img-box {
        height: 90px !important;
        border-radius: 8px !important;
    }
    .compare-title {
        font-size: 0.8rem !important;
        line-height: 1.25 !important;
        min-height: 2.5em !important;
        margin-bottom: 4px !important;
    }
    .compare-price {
        font-size: 0.95rem !important;
        margin-bottom: 6px !important;
    }
    .compare-btn {
        font-size: 0.75rem !important;
        padding: 4px 8px !important;
    }
}
</style>

<div class="bg-primary text-white py-3 py-md-5">
    <div class="container text-center">
        <div class="d-inline-flex align-items-center justify-content-center bg-white bg-opacity-25 rounded-circle p-2 p-md-3 mb-2 mb-md-3" style="width: 48px; height: 48px;">
            <i class="fa-solid fa-code-compare fs-4"></i>
        </div>
        <h1 class="fw-bold fs-4 fs-md-2 mb-1"><%= t('compare.title') || 'İlan Karşılaştırma' %></h1>
        <p class="text-white-50 small mb-0">Seçtiğiniz ilanları yan yana tüm özellikleri ve fiyatlarıyla kıyaslayın.</p>
    </div>
</div>

<div class="container py-3 py-md-5">
    <% if (!listings || listings.length === 0) { %>
        <div class="card border-0 shadow-sm rounded-4 text-center p-4 p-md-5">
            <div class="my-3 my-md-4">
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                    <i class="fa-solid fa-code-compare text-muted fs-3"></i>
                </div>
                <h4 class="fw-bold text-dark fs-5 mb-2">Karşılaştırılacak İlan Bulunamadı</h4>
                <p class="text-muted small mb-4" style="max-width: 460px; margin: 0 auto;">
                    İlan detay sayfalarındaki veya ilan kartlarındaki <strong>"Karşılaştır"</strong> butonuna tıklayarak en fazla 4 ilanı buraya ekleyip kıyaslayabilirsiniz.
                </p>
                <a href="/listings" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold btn-sm fs-6">
                    <i class="fa-solid fa-magnifying-glass me-2"></i> İlanları İncele
                </a>
            </div>
        </div>
    <% } else { %>
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <div>
                <span class="badge bg-primary rounded-pill px-3 py-2 fw-semibold" style="font-size: 0.8rem;">
                    <i class="fa-solid fa-layer-group me-1"></i> <%= listings.length %> İlan Kıyaslanıyor
                </span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="highlightDiffsToggle" role="switch">
                    <label class="form-check-label small fw-semibold text-muted" for="highlightDiffsToggle">Farklılıklar</label>
                </div>
                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-2 px-md-3" id="clearAllCompareBtn" style="font-size: 0.78rem;">
                    <i class="fa-solid fa-trash-can me-1"></i> Temizle
                </button>
            </div>
        </div>

        <div class="d-md-none text-muted small text-center mb-3 bg-light rounded-pill py-2 border shadow-sm" style="font-size: 0.78rem;">
            <i class="fa-solid fa-arrows-left-right text-primary me-1"></i> İlanları yana kaydırarak karşılaştırabilirsiniz
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden compare-table-container">
            <div class="table-responsive mb-0">
                <table class="table table-hover align-middle mb-0 compare-table" id="compareMatrixTable">
                    <thead>
                        <tr class="bg-light">
                            <th class="p-3 border-end compare-sticky-col">
                                <span class="fw-bold text-dark">İlan Özeti</span>
                            </th>
                            <% listings.forEach(function(item) { %>
                                <th class="p-3 text-center border-end position-relative compare-item-col">
                                    <button type="button" class="btn-close position-absolute top-0 end-0 m-2 remove-compare-item-btn shadow-none" style="font-size: 0.7rem;" data-id="<%= item.id %>" title="Karşılaştırmadan Çıkar"></button>
                                    <div class="mb-2 position-relative overflow-hidden rounded-3 bg-light shadow-sm compare-img-box" style="height: 140px;">
                                        <img src="<%= item.primary_image || 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800' %>" class="w-100 h-100 object-fit-cover" alt="<%= item.title %>">
                                        <% if (item.listing_type === 'wanted') { %>
                                            <span class="position-absolute top-0 start-0 m-1 badge bg-warning text-dark fw-bold" style="font-size: 0.65rem;">📢 TALEP</span>
                                        <% } else if (item.is_premium) { %>
                                            <span class="position-absolute top-0 start-0 m-1 badge bg-gradient-golden text-white fw-bold" style="font-size: 0.65rem;">👑 Premium</span>
                                        <% } %>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-1 text-truncate-2 compare-title" style="font-size: 0.88rem; min-height: 2.6em;" title="<%= item.title %>">
                                        <a href="/listings/<%= item.slug %>" class="text-decoration-none text-dark hover-text-primary"><%= item.title %></a>
                                    </h6>
                                    <div class="text-primary fw-bolder fs-6 compare-price mb-2">
                                        <%= item.price ? helpers.formatPrice(item.price, item.currency) : (item.listing_type === 'job' ? 'Maaş Belirtilmedi' : 'Fiyat Belirtilmedi') %>
                                    </div>
                                    <a href="/listings/<%= item.slug %>" class="btn btn-primary btn-sm rounded-pill w-100 fw-semibold shadow-sm compare-btn">
                                        <i class="fa-solid fa-eye me-1"></i> İncele
                                    </a>
                                </th>
                            <% }); %>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Kategori ve Tür -->
                        <tr class="compare-row" data-field="category">
                            <td class="fw-bold text-muted bg-light p-3 border-end compare-sticky-col">Kategori / Tür</td>
                            <% listings.forEach(function(item) { %>
                                <td class="p-3 text-center border-end compare-cell">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1" style="font-size: 0.72rem;">
                                        <%= item.category_name_tr || item.category_name || '-' %>
                                    </span>
                                    <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-2 py-1 ms-1" style="font-size: 0.72rem;">
                                        <%= item.listing_type === 'wanted' ? 'Talep' : (item.listing_type === 'rent' ? 'Kiralık' : 'Satılık') %>
                                    </span>
                                </td>
                            <% }); %>
                        </tr>

                        <!-- Konum -->
                        <tr class="compare-row" data-field="location">
                            <td class="fw-bold text-muted bg-light p-3 border-end compare-sticky-col">Konum</td>
                            <% listings.forEach(function(item) { %>
                                <td class="p-3 text-center border-end compare-cell">
                                    <i class="fa-solid fa-location-dot text-danger me-1"></i>
                                    <strong><%= helpers.getCityName(item.location_city, lang) || item.location_city || '-' %></strong>
                                    <% if (item.location_district) { %>
                                        <div class="small text-muted" style="font-size: 0.72rem;"><%= item.location_district %></div>
                                    <% } %>
                                </td>
                            <% }); %>
                        </tr>

                        <!-- Emlak Özellikleri (varsa) -->
                        <%
                            const hasRooms = listings.some(l => l.attributes && l.attributes.rooms);
                            const hasSize = listings.some(l => l.attributes && l.attributes.size);
                            const hasFloor = listings.some(l => l.attributes && l.attributes.floor);
                            const hasBuildYear = listings.some(l => l.attributes && (l.attributes.build_year || l.attributes.buildYear));
                            const hasBrand = listings.some(l => l.attributes && l.attributes.brand);
                            const hasModel = listings.some(l => l.attributes && l.attributes.model);
                            const hasKM = listings.some(l => l.attributes && l.attributes.km);
                            const hasFuel = listings.some(l => l.attributes && l.attributes.fuel);
                            const hasGear = listings.some(l => l.attributes && l.attributes.gear);
                            const hasCondition = listings.some(l => l.attributes && l.attributes.condition);
                            const hasBodyType = listings.some(l => l.attributes && l.attributes.body_type);
                            const hasEnginePower = listings.some(l => l.attributes && l.attributes.engine_power);
                            const hasEngineSize = listings.some(l => l.attributes && l.attributes.engine_size);
                            const hasDrivetrain = listings.some(l => l.attributes && l.attributes.drivetrain);
                            const hasColor = listings.some(l => l.attributes && l.attributes.color);
                            const hasVehicleStatus = listings.some(l => l.attributes && l.attributes.vehicle_status);
                            const hasSwap = listings.some(l => l.attributes && l.attributes.swap);
                        %>

                        <% if (hasRooms) { %>
                            <tr class="compare-row" data-field="rooms">
                                <td class="fw-bold text-muted bg-light p-3 border-end compare-sticky-col">Oda Sayısı</td>
                                <% listings.forEach(function(item) { %>
                                    <td class="p-3 text-center border-end compare-cell fw-medium"><%= (item.attributes && item.attributes.rooms) || '-' %></td>
                                <% }); %>
                            </tr>
                        <% } %>

                        <% if (hasSize) { %>
                            <tr class="compare-row" data-field="size">
                                <td class="fw-bold text-muted bg-light p-3 border-end compare-sticky-col">Metrekare (m²)</td>
                                <% listings.forEach(function(item) { %>
                                    <td class="p-3 text-center border-end compare-cell fw-medium"><%= (item.attributes && item.attributes.size) ? (item.attributes.size + ' m²') : '-' %></td>
                                <% }); %>
                            </tr>
                        <% } %>

                        <% if (hasFloor) { %>
                            <tr class="compare-row" data-field="floor">
                                <td class="fw-bold text-muted bg-light p-3 border-end compare-sticky-col">Bulunduğu Kat</td>
                                <% listings.forEach(function(item) { %>
                                    <td class="p-3 text-center border-end compare-cell"><%= (item.attributes && item.attributes.floor) || '-' %></td>
                                <% }); %>
                            </tr>
                        <% } %>

                        <% if (hasBuildYear) { %>
                            <tr class="compare-row" data-field="build_year">
                                <td class="fw-bold text-muted bg-light p-3 border-end compare-sticky-col">Bina / Model Yılı</td>
                                <% listings.forEach(function(item) { %>
                                    <td class="p-3 text-center border-end compare-cell fw-medium"><%= (item.attributes && (item.attributes.build_year || item.attributes.buildYear || item.attributes.year)) || '-' %></td>
                                <% }); %>
                            </tr>
                        <% } %>

                        <% if (hasBrand) { %>
                            <tr class="compare-row" data-field="brand">
                                <td class="fw-bold text-muted bg-light p-3 border-end compare-sticky-col">Marka &amp; Model</td>
                                <% listings.forEach(function(item) { %>
                                    <td class="p-3 text-center border-end compare-cell fw-medium">
                                        <%= (item.attributes && item.attributes.brand) ? (item.attributes.brand + ' ' + (item.attributes.model || '')) : '-' %>
                                    </td>
                                <% }); %>
                            </tr>
                        <% } %>

                        <% if (hasKM) { %>
                            <tr class="compare-row" data-field="km">
                                <td class="fw-bold text-muted bg-light p-3 border-end compare-sticky-col">Kilometre (KM)</td>
                                <% listings.forEach(function(item) { %>
                                    <td class="p-3 text-center border-end compare-cell fw-medium">
                                        <%= (item.attributes && item.attributes.km) ? Number(item.attributes.km).toLocaleString('tr-TR') + ' km' : '-' %>
                                    </td>
                                <% }); %>
                            </tr>
                        <% } %>

                        <% if (hasFuel || hasGear) { %>
                            <tr class="compare-row" data-field="fuel_gear">
                                <td class="fw-bold text-muted bg-light p-3 border-end compare-sticky-col">Yakıt &amp; Vites</td>
                                <% listings.forEach(function(item) { %>
                                    <td class="p-3 text-center border-end compare-cell">
                                        <%= (item.attributes && (item.attributes.fuel || item.attributes.gear)) ? ((item.attributes.fuel || '') + ' / ' + (item.attributes.gear || '')) : '-' %>
                                    </td>
                                <% }); %>
                            </tr>
                        <% } %>

                        <% if (hasBodyType) { %>
                            <tr class="compare-row" data-field="body_type">
                                <td class="fw-bold text-muted bg-light p-3 border-end compare-sticky-col">Kasa Tipi</td>
                                <% listings.forEach(function(item) { %>
                                    <td class="p-3 text-center border-end compare-cell"><%= (item.attributes && item.attributes.body_type) || '-' %></td>
                                <% }); %>
                            </tr>
                        <% } %>

                        <% if (hasEnginePower || hasEngineSize) { %>
                            <tr class="compare-row" data-field="engine">
                                <td class="fw-bold text-muted bg-light p-3 border-end compare-sticky-col">Motor Gücü &amp; Hacmi</td>
                                <% listings.forEach(function(item) { %>
                                    <td class="p-3 text-center border-end compare-cell">
                                        <%= (item.attributes && (item.attributes.engine_power || item.attributes.engine_size)) ? ((item.attributes.engine_power || '') + ' ' + (item.attributes.engine_size || '')) : '-' %>
                                    </td>
                                <% }); %>
                            </tr>
                        <% } %>

                        <% if (hasDrivetrain) { %>
                            <tr class="compare-row" data-field="drivetrain">
                                <td class="fw-bold text-muted bg-light p-3 border-end compare-sticky-col">Çekiş</td>
                                <% listings.forEach(function(item) { %>
                                    <td class="p-3 text-center border-end compare-cell"><%= (item.attributes && item.attributes.drivetrain) || '-' %></td>
                                <% }); %>
                            </tr>
                        <% } %>

                        <% if (hasColor) { %>
                            <tr class="compare-row" data-field="color">
                                <td class="fw-bold text-muted bg-light p-3 border-end compare-sticky-col">Renk</td>
                                <% listings.forEach(function(item) { %>
                                    <td class="p-3 text-center border-end compare-cell"><%= (item.attributes && item.attributes.color) || '-' %></td>
                                <% }); %>
                            </tr>
                        <% } %>

                        <% if (hasVehicleStatus) { %>
                            <tr class="compare-row" data-field="vehicle_status">
                                <td class="fw-bold text-muted bg-light p-3 border-end compare-sticky-col">Araç Durumu</td>
                                <% listings.forEach(function(item) { %>
                                    <td class="p-3 text-center border-end compare-cell"><%= (item.attributes && item.attributes.vehicle_status) || '-' %></td>
                                <% }); %>
                            </tr>
                        <% } %>

                        <% if (hasCondition) { %>
                            <tr class="compare-row" data-field="condition">
                                <td class="fw-bold text-muted bg-light p-3 border-end compare-sticky-col">Kullanım Durumu</td>
                                <% listings.forEach(function(item) { %>
                                    <td class="p-3 text-center border-end compare-cell"><%= (item.attributes && item.attributes.condition) || '-' %></td>
                                <% }); %>
                            </tr>
                        <% } %>

                        <% if (hasSwap) { %>
                            <tr class="compare-row" data-field="swap">
                                <td class="fw-bold text-muted bg-light p-3 border-end compare-sticky-col">Takas</td>
                                <% listings.forEach(function(item) { %>
                                    <%
                                        const itemSwap = item.attributes && item.attributes.swap;
                                        const swapStr = String(itemSwap || '').trim().toLowerCase();
                                        const isNo = swapStr.startsWith('hayır') || swapStr.includes('yok') || swapStr === 'no' || swapStr === '0';
                                    %>
                                    <td class="p-3 text-center border-end compare-cell">
                                        <% if (!itemSwap) { %>
                                            -
                                        <% } else if (isNo) { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1" style="font-size: 0.72rem;"><i class="fa-solid fa-xmark me-1"></i><%= itemSwap %></span>
                                        <% } else { %>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1" style="font-size: 0.72rem;"><i class="fa-solid fa-arrows-rotate me-1"></i><%= itemSwap %></span>
                                        <% } %>
                                    </td>
                                <% }); %>
                            </tr>
                        <% } %>

                        <!-- Satıcı Bilgileri -->
                        <tr class="compare-row" data-field="seller">
                            <td class="fw-bold text-muted bg-light p-3 border-end compare-sticky-col">Satıcı &amp; Puan</td>
                            <% listings.forEach(function(item) { %>
                                <td class="p-3 text-center border-end compare-cell">
                                    <div class="fw-bold text-dark" style="font-size: 0.85rem;"><%= item.seller_company || helpers.formatDisplayName(item.seller_name, item.seller_show_surname) || 'Kullanıcı' %></div>
                                    <div class="small text-muted mb-1" style="font-size: 0.72rem;"><%= item.seller_role === 'business' ? 'Kurumsal Mağaza' : (item.seller_role === 'agent' ? 'Emlak / Galeri' : 'Bireysel Üye') %></div>
                                    <% if (item.seller_rating_count && item.seller_rating_count > 0) { %>
                                        <div class="small text-warning" style="font-size: 0.75rem;">
                                            <i class="fa-solid fa-star"></i> <%= Number(item.seller_rating || item.seller_rating_avg || 0).toFixed(1) %> (<%= item.seller_rating_count %>)
                                        </div>
                                    <% } else { %>
                                        <div class="small text-muted" style="font-size: 0.72rem;">Henüz değerlendirilmedi</div>
                                    <% } %>
                                    <% const compSellerSeen = helpers.lastSeenState(item.seller_last_seen || item.created_at); %>
                                    <div class="small mt-1 text-muted d-flex align-items-center justify-content-center gap-1" style="font-size: 0.72rem;">
                                        <span class="d-inline-block rounded-circle <%= compSellerSeen.online ? 'bg-success' : 'bg-secondary opacity-50' %>" style="width: 6px; height: 6px;"></span>
                                        <span><%= compSellerSeen.online ? 'Çevrimiçi' : (helpers.timeAgo(item.seller_last_seen || item.created_at, lang) + ' aktifti') %></span>
                                    </div>
                                </td>
                            <% }); %>
                        </tr>

                        <!-- İlan Tarihi -->
                        <tr class="compare-row" data-field="date">
                            <td class="fw-bold text-muted bg-light p-3 border-end compare-sticky-col">İlan Tarihi</td>
                            <% listings.forEach(function(item) { %>
                                <td class="p-3 text-center border-end compare-cell small text-muted" style="font-size: 0.75rem;">
                                    <i class="fa-regular fa-calendar me-1"></i> <%= helpers.formatDate(item.created_at, lang) %>
                                </td>
                            <% }); %>
                        </tr>

                        <!-- Aksiyon -->
                        <tr class="bg-light">
                            <td class="fw-bold text-muted p-3 border-end compare-sticky-col">İşlem</td>
                            <% listings.forEach(function(item) { %>
                                <td class="p-3 text-center border-end">
                                    <a href="/listings/<%= item.slug %>" class="btn btn-outline-primary btn-sm rounded-pill w-100 fw-semibold" style="font-size: 0.78rem;">
                                        <i class="fa-regular fa-comment-dots me-1"></i> İletişim
                                    </a>
                                </td>
                            <% }); %>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>
</div>

<div class="bg-primary text-white py-4 py-md-5 position-relative overflow-hidden">
    <div class="container position-relative z-1 text-center">
        <h1 class="fw-bold mb-2"><%= t('home.cta_button') %></h1>
        <p class="text-white-50 mb-0"><%= t('home.hero_subtitle') %></p>
    </div>
</div>

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">
            
            <% if (typeof quota !== 'undefined' && quota) { %>
                <% if (quota.isCorporate) { %>
                    <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-primary">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-start gap-3">
                                <i class="fa-solid fa-building-circle-check fs-4 text-primary mt-1"></i>
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold text-primary mb-1"><%= t('listing.corporate_unlimited_title') %></h6>
                                    <p class="text-muted small mb-0">
                                        <%= t('listing.corporate_unlimited_desc') %>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } else if (quota.isUnlimited) { %>
                    <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-success">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-start gap-3">
                                <i class="fa-solid fa-gift fs-4 text-success mt-1"></i>
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold text-success mb-1"><%= t('listing.unlimited_mode_title') %></h6>
                                    <p class="text-muted small mb-0">
                                        <%= t('listing.unlimited_mode_desc') %>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } else if (quota.limit !== null) { %>
                    <div class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-start gap-3">
                                <i class="fa-solid fa-circle-info fs-4 text-primary mt-1"></i>
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold mb-1">İlan Hakkınız</h6>
                                    <p class="text-muted small mb-2">
                                        <strong>Emlak, Vasıta ve İkinci El</strong> kategorilerinde ilk
                                        <strong><%= quota.limit %> ilan ücretsizdir.</strong>
                                        <% if (quota.remaining > 0) { %>
                                            Kalan ücretsiz hakkınız:
                                            <span class="badge bg-success rounded-pill"><%= quota.remaining %></span>
                                        <% } else { %>
                                            <span class="text-danger fw-medium">Ücretsiz hakkınızı doldurdunuz.</span>
                                            <a href="/ilan-paketleri">İlan paketlerine göz atın.</a>
                                        <% } %>
                                    </p>
                                    <p class="text-muted small mb-0">
                                        <i class="fa-solid fa-check text-success me-1"></i>
                                        <strong>Usta &amp; Hizmet</strong> ve <strong>İş İlanları</strong> kategorileri her zaman ücretsiz, sınırsız.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            <% } %>

            <form action="/listings" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate id="createListingForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold text-dark d-flex align-items-center mb-0">
                            <span class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; font-size: 0.9rem;">1</span>
                            <%= t('listing.category') %>
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <%
                            const categoryById = {};
                            if (typeof categories !== 'undefined' && Array.isArray(categories)) {
                                categories.forEach(function (cat) { categoryById[cat.id] = cat; });
                            }
                            const rootSlugOf = function (cat) {
                                const parent = cat.parent_id ? categoryById[cat.parent_id] : null;
                                return parent ? parent.slug : cat.slug;
                            };

                            let treeToRender = [];
                            if (typeof categoryTree !== 'undefined' && Array.isArray(categoryTree) && categoryTree.length > 0) {
                                treeToRender = categoryTree;
                            } else if (typeof categories !== 'undefined' && Array.isArray(categories)) {
                                const tempMap = {};
                                categories.forEach(function(c) {
                                    tempMap[c.id] = Object.assign({}, c, { children: [] });
                                });
                                categories.forEach(function(c) {
                                    if (c.parent_id && tempMap[c.parent_id]) {
                                        tempMap[c.parent_id].children.push(tempMap[c.id]);
                                    } else if (!c.parent_id) {
                                        treeToRender.push(tempMap[c.id]);
                                    }
                                });
                            }
                        %>
                        <select name="category_id" id="categorySelect" class="form-select form-select-lg bg-light border-0 shadow-none focus-ring-primary fw-medium cursor-pointer" required>
                            <option value=""><%= t('listing.all_categories') %>...</option>
                            <% treeToRender.forEach(function(mainCat) { %>
                                <% const mainName = mainCat['name_' + (typeof lang !== 'undefined' ? lang : 'tr')] || mainCat.name_tr; %>
                                <% if (mainCat.children && mainCat.children.length > 0) { %>
                                    <optgroup label="<%= mainName %>">
                                        <% mainCat.children.forEach(function(subCat) { %>
                                            <option value="<%= subCat.id %>" data-root="<%= mainCat.slug %>" data-slug="<%= subCat.slug %>" <%= (typeof formData !== 'undefined' && String(formData.category_id) === String(subCat.id)) ? 'selected' : '' %>>
                                                <%= subCat['name_' + (typeof lang !== 'undefined' ? lang : 'tr')] || subCat.name_tr %>
                                            </option>
                                        <% }); %>
                                    </optgroup>
                                <% } else { %>
                                    <option value="<%= mainCat.id %>" data-root="<%= mainCat.slug %>" data-slug="<%= mainCat.slug %>" <%= (typeof formData !== 'undefined' && String(formData.category_id) === String(mainCat.id)) ? 'selected' : '' %>>
                                        <%= mainName %>
                                    </option>
                                <% } %>
                            <% }); %>
                        </select>
                        <div class="invalid-feedback"><%= t('flash.select_valid_category') %></div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold text-dark d-flex align-items-center mb-0">
                            <span class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; font-size: 0.9rem;">2</span>
                            <%= t('listing.title') %> & <%= t('listing.description') %>
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        
                        <div class="mb-4" id="purposeBox">
                            <label class="form-label fw-bold small text-muted d-block mb-2" id="purposeMainLabel">
                                <i class="fa-solid fa-layer-group text-primary me-1"></i><%= t('listing.listing_purpose') || 'İlan Amacı / Türü' %> <span class="text-danger">*</span>
                            </label>
                            <div class="row g-2" id="purposeOptionsRow">
                                <div class="col-4" id="purposeSaleCol">
                                    <input type="radio" class="btn-check" name="listing_type" id="typeSale" value="sale" <%= (!formData.listing_type || formData.listing_type === 'sale' || formData.listing_type === 'job' || formData.listing_type === 'service') ? 'checked' : '' %>>
                                    <label class="btn btn-outline-primary w-100 h-100 rounded-3 py-2 px-1 fw-semibold small d-flex flex-column align-items-center justify-content-center" for="typeSale" id="typeSaleLabel">
                                        <i class="fa-solid fa-tag mb-1 fs-5" id="typeSaleIcon"></i>
                                        <span id="typeSaleText"><%= t('listing.type_sale') || 'Satılık' %></span>
                                    </label>
                                </div>
                                <div class="col-4" id="purposeRentCol">
                                    <input type="radio" class="btn-check" name="listing_type" id="typeRent" value="rent" <%= (formData.listing_type === 'rent') ? 'checked' : '' %>>
                                    <label class="btn btn-outline-primary w-100 h-100 rounded-3 py-2 px-1 fw-semibold small d-flex flex-column align-items-center justify-content-center" for="typeRent" id="typeRentLabel">
                                        <i class="fa-solid fa-key mb-1 fs-5" id="typeRentIcon"></i>
                                        <span id="typeRentText"><%= t('listing.type_rent') || 'Kiralık' %></span>
                                    </label>
                                </div>
                                <div class="col-4" id="purposeWantedCol">
                                    <input type="radio" class="btn-check" name="listing_type" id="typeWanted" value="wanted" <%= (formData.listing_type === 'wanted') ? 'checked' : '' %>>
                                    <label class="btn btn-outline-warning w-100 h-100 rounded-3 py-2 px-1 fw-semibold small d-flex flex-column align-items-center justify-content-center wanted-purpose-btn" for="typeWanted" id="typeWantedLabel">
                                        <i class="fa-solid fa-hand-holding-heart mb-1 fs-5 wanted-icon" id="typeWantedIcon"></i>
                                        <span id="typeWantedText"><%= t('listing.type_wanted') || 'Arıyorum' %></span>
                                    </label>
                                </div>
                            </div>
                            <div class="form-text small text-muted mt-2" id="purposeHelpText">
                                İlanınızın amacını belirleyin.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted"><%= t('listing.title') %> <span class="text-danger">*</span></label>
                            <input type="text" name="title" id="titleInput" class="form-control form-control-lg bg-light border-0 shadow-none focus-ring-primary" placeholder="<%= t('listing.title') %>" value="<%= typeof formData !== 'undefined' && formData.title ? formData.title : '' %>" required maxlength="70">
                            <div class="invalid-feedback"><%= t('listing.title') %> gereklidir.</div>
                            <div class="form-text small text-end" id="titleCount">0/70</div>
                        </div>

                        <div class="row g-3 mb-4" id="priceRow">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted" id="priceLabel"><%= t('listing.price') %> <span class="text-danger" id="priceRequiredStar">*</span></label>
                                <div class="input-group has-validation">
                                    <input type="number" name="price" id="priceInput" class="form-control form-control-lg bg-light border-0 shadow-none focus-ring-primary" placeholder="0" value="<%= typeof formData !== 'undefined' && typeof formData.price !== 'undefined' ? formData.price : '' %>" required min="0" step="any">
                                    <select name="currency" class="form-select bg-light border-0 shadow-none" style="max-width: 100px;">
                                        <option value="GBP" <%= (typeof formData === 'undefined' || formData.currency !== 'TRY') ? 'selected' : '' %>>£ GBP</option>
                                        <option value="TRY" <%= (typeof formData !== 'undefined' && formData.currency === 'TRY') ? 'selected' : '' %>>₺ TRY</option>
                                    </select>
                                    <div class="invalid-feedback"><%= t('listing.price') %> gereklidir.</div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="descriptionInput" class="form-label fw-bold small text-muted"><%= t('listing.description') %> <span class="text-danger">*</span></label>

                            <div class="border rounded-4 p-3 mb-3 bg-light" id="draftBox">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2 pb-2 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-layer-group text-primary"></i>
                                        <span class="fw-semibold small text-dark">İlan Özellikleri &amp; Detayları</span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-none" id="draftBtn">
                                        <i class="fa-solid fa-wand-magic-sparkles me-1"></i><%= t('draft.generate') %>
                                    </button>
                                </div>
                                <p class="text-muted small mb-3">Bu bilgileri doldurduğunuzda ilanda detay olarak gösterilir. Dilerseniz yukarıdaki butonla otomatik açıklama metni de oluşturabilirsiniz.</p>

                                <%# Degerler burada, gorunen arayuzden bagimsiz: form gonderimi ve
                                    aciklama taslagi ureteci ikisi de [data-draft] okuyor. %>
                                <div id="draftValues" hidden></div>

                                <%# Genis ekranda kompakt izgara, dar ekranda adim adim.
                                    Ikisi de ayni FIELDS tanimindan besleniyor ve ayni gizli
                                    alanlara yaziyor; ayrisan tek sey cizim. %>
                                <div class="row g-2 mb-2 d-none" id="draftGrid"></div>

                                <div class="d-flex flex-wrap gap-2" id="draftAnswered"></div>
                                <div class="border rounded-4 bg-white p-3 mb-2" id="draftSteps"></div>

                                <button type="button" class="btn btn-sm btn-link text-decoration-none px-0" id="draftDetailsToggle"
                                        data-bs-toggle="collapse" data-bs-target="#draftDetailsWrap">
                                    <i class="fa-solid fa-sliders me-1"></i>Daha fazla detay ekle
                                </button>
                                <div class="collapse" id="draftDetailsWrap">
                                    <div class="row g-2 pt-2" id="draftDetails"></div>
                                </div>

                                <div class="pt-2 border-top" id="featuresSection">
                                    <label class="form-label small fw-semibold text-muted d-block mb-2">
                                        <i class="fa-solid fa-check-double text-primary me-1"></i>Ekstra Donanım &amp; Özellikler
                                    </label>
                                    <div class="d-flex flex-wrap gap-2" id="draftFeatures"></div>
                                </div>

                                <div class="mt-2 text-end">
                                    <span class="text-muted small" id="draftStatus"></span>
                                </div>
                            </div>

                            <textarea name="description" id="descriptionInput" class="form-control bg-light border-0 shadow-none focus-ring-primary" rows="6" placeholder="<%= t('listing.description') %>" required minlength="20"><%= typeof formData !== 'undefined' && formData.description ? formData.description : '' %></textarea>
                            <div class="invalid-feedback">Lütfen en az 20 karakterlik bir açıklama giriniz.</div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold text-dark d-flex align-items-center mb-0">
                            <span class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; font-size: 0.9rem;">3</span>
                            <%= t('listing.location') %>
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted"><%= t('listing.city') %> <span class="text-danger">*</span></label>
                                <%- include('../partials/citySelect', { required: true, selectClass: 'form-select bg-light border-0 shadow-none focus-ring-primary cursor-pointer', selectedCity: (typeof formData !== 'undefined' && formData.city) ? formData.city : '' }) %>
                                <div class="invalid-feedback"><%= t('flash.select_valid_city') %></div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted"><%= t('listing.district') %></label>
                                <input type="text" name="district" class="form-control bg-light border-0 shadow-none focus-ring-primary" placeholder="<%= t('listing.district') %>" value="<%= typeof formData !== 'undefined' && formData.district ? formData.district : '' %>">
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold small text-muted">
                                    <%= t('listing.pick_area') %>
                                    <span class="fw-normal text-muted">(<%= t('common.optional') || 'isteğe bağlı' %>)</span>
                                </label>

                                <%# Iğne kaydedilirken ızgaraya oturtuluyor; sunucuda
                                    kabalaştırılıyor, burada da öyle anlatılıyor. Formun
                                    söylediğiyle veritabanına yazılanın aynı olması gerekiyor. %>
                                <div class="rounded-4 overflow-hidden border">
                                    <div id="areaPicker" style="height: 260px; background: #e9ecef;"></div>
                                </div>
                                <input type="hidden" name="location_lat" id="locationLat"
                                       value="<%= typeof formData !== 'undefined' && formData.location_lat ? formData.location_lat : '' %>">
                                <input type="hidden" name="location_lng" id="locationLng"
                                       value="<%= typeof formData !== 'undefined' && formData.location_lng ? formData.location_lng : '' %>">
                                <div class="form-text small mt-1">
                                    <i class="fa-solid fa-circle-info me-1"></i><%= t('listing.pick_area_note') %>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold small text-muted">İletişim Telefonu <span class="text-danger">*</span></label>
                                <input type="tel" name="phone" class="form-control bg-light border-0 shadow-none focus-ring-primary" placeholder="0533 123 4567" value="<%= (typeof formData !== 'undefined' && typeof formData.phone !== 'undefined') ? formData.phone : (typeof userPhone !== 'undefined' ? userPhone : '') %>" required>
                                <div class="invalid-feedback"><%= t('flash.listing_phone_required') %></div>
                                <div class="form-text small">Alıcılar size bu numaradan ulaşacak. Numara profilinize kaydedilir.</div>

                                <div class="form-check mt-3">
                                    <input class="form-check-input cursor-pointer" type="checkbox" name="hide_phone" value="1" id="hidePhone"
                                           <%= ((typeof formData !== 'undefined' && typeof formData.hide_phone !== 'undefined') ? Boolean(formData.hide_phone) : (typeof hidePhone !== 'undefined' && hidePhone)) ? 'checked' : '' %>>
                                    <label class="form-check-label cursor-pointer" for="hidePhone">
                                        Telefonumu ilanlarımda gösterme, sadece mesajla iletişim kurulsun
                                    </label>
                                    <div class="form-text small">
                                        Numaranız kayıtlı kalır ama alıcılara gösterilmez. Bu ayar tüm ilanlarınız için geçerlidir.
                                    </div>
                                </div>

                                <div class="form-check mt-2">
                                    <input class="form-check-input cursor-pointer" type="checkbox" name="hide_surname" value="1" id="hideSurname"
                                           <%= ((typeof formData !== 'undefined' && typeof formData.hide_surname !== 'undefined') ? Boolean(formData.hide_surname) : (typeof hideSurname !== 'undefined' ? hideSurname : true)) ? 'checked' : '' %>>
                                    <label class="form-check-label cursor-pointer" for="hideSurname">
                                        Soyadımı sitede ve ilanlarımda gizle (<%= (typeof currentUser !== 'undefined' && currentUser && currentUser.full_name) ? helpers.formatDisplayName(currentUser.full_name, false) : 'Örn: Ahmet Y.' %>)
                                    </label>
                                    <div class="form-text small">
                                        İlanlarınızda ve satıcı profilinizde soyadınızın yalnızca baş harfi gösterilir. Bu ayar profilinize kaydedilir.
                                    </div>
                                </div>

                                <div class="form-check mt-3 border rounded-4 p-3 bg-light" id="collectBidsBox" style="display: none;" hidden>
                                    <input class="form-check-input cursor-pointer" type="checkbox" name="collect_bids" value="1" id="collectBids"
                                           <%= (typeof formData !== 'undefined' && formData.collect_bids) ? 'checked' : '' %>>
                                    <label class="form-check-label cursor-pointer fw-semibold" for="collectBids">
                                        <i class="fa-solid fa-gavel text-primary me-1" id="collectBidsIcon"></i><span id="collectBidsLabel"><%= t('bids.opt_in_label') %></span>
                                    </label>
                                    <div class="form-text small mb-0" id="collectBidsHelp"><%= t('bids.opt_in_help') %></div>
                                </div>

                                <div class="mt-3">
                                    <%- include('../partials/badgePicker', {
                                        current: (typeof formData !== 'undefined' ? formData : {}),
                                        idPrefix: 'new_'
                                    }) %>
                                </div>

                                <div class="border rounded-4 p-3 mt-3 bg-light" id="jobFieldsBox" hidden>
                                    <h6 class="fw-bold mb-3">
                                        <i class="fa-solid fa-briefcase text-primary me-1"></i><%= t('career.job_details') %>
                                    </h6>

                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label for="workType" class="form-label small fw-semibold"><%= t('career.work_type') %></label>
                                            <select class="form-select" id="workType" name="work_type">
                                                <% ['full_time', 'part_time', 'contract', 'seasonal', 'internship'].forEach(function (workType) { %>
                                                    <option value="<%= workType %>" <%= (typeof formData !== 'undefined' && formData.work_type === workType) ? 'selected' : '' %>><%= t('career.work_type_' + workType) %></option>
                                                <% }); %>
                                            </select>
                                        </div>

                                        <div class="col-md-6">
                                            <label for="experienceRequired" class="form-label small fw-semibold"><%= t('career.experience_required') %></label>
                                            <input type="number" class="form-control" id="experienceRequired"
                                                   name="experience_required" min="0" max="40" value="<%= (typeof formData !== 'undefined' && typeof formData.experience_required !== 'undefined') ? formData.experience_required : 0 %>">
                                        </div>

                                        <div class="col-md-4">
                                            <label for="salaryMin" class="form-label small fw-semibold"><%= t('career.salary_min') %></label>
                                            <input type="number" class="form-control" id="salaryMin" name="salary_min" min="0" step="any" value="<%= (typeof formData !== 'undefined' && formData.salary_min) ? formData.salary_min : '' %>">
                                        </div>

                                        <div class="col-md-4">
                                            <label for="salaryMax" class="form-label small fw-semibold"><%= t('career.salary_max') %></label>
                                            <input type="number" class="form-control" id="salaryMax" name="salary_max" min="0" step="any" value="<%= (typeof formData !== 'undefined' && formData.salary_max) ? formData.salary_max : '' %>">
                                        </div>

                                        <div class="col-md-4">
                                            <label for="salaryPeriod" class="form-label small fw-semibold"><%= t('career.salary_period') %></label>
                                            <select class="form-select" id="salaryPeriod" name="salary_period">
                                                <% ['monthly', 'hourly', 'daily', 'yearly'].forEach(function (period) { %>
                                                    <option value="<%= period %>" <%= (typeof formData !== 'undefined' && formData.salary_period === period) ? 'selected' : '' %>><%= t('career.period_' + period) %></option>
                                                <% }); %>
                                            </select>
                                        </div>

                                        <div class="col-12">
                                            <label for="requiredSkills" class="form-label small fw-semibold"><%= t('career.required_skills') %></label>
                                            <input type="text" class="form-control" id="requiredSkills" name="required_skills"
                                                   maxlength="600" placeholder="<%= t('career.skills_placeholder') %>" value="<%= (typeof formData !== 'undefined' && formData.required_skills) ? formData.required_skills : '' %>">
                                            <div class="form-text small"><%= t('career.match_help') %></div>
                                        </div>

                                        <div class="col-12">
                                            <label for="requiredLanguages" class="form-label small fw-semibold"><%= t('career.required_languages') %></label>
                                            <input type="text" class="form-control" id="requiredLanguages" name="required_languages"
                                                   maxlength="300" placeholder="<%= t('career.languages_placeholder') %>" value="<%= (typeof formData !== 'undefined' && formData.required_languages) ? formData.required_languages : '' %>">
                                        </div>

                                        <div class="col-12">
                                            <label for="benefits" class="form-label small fw-semibold"><%= t('career.benefits') %></label>
                                            <textarea class="form-control" id="benefits" name="benefits" rows="2" maxlength="600"
                                                      placeholder="<%= t('career.benefits_placeholder') %>"><%= (typeof formData !== 'undefined' && formData.benefits) ? formData.benefits : '' %></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-5 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold text-dark d-flex align-items-center mb-0">
                            <span class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; font-size: 0.9rem;">4</span>
                            <%= t('listing.images') %>
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <label for="fileInput" class="w-100 border-2 border-dashed border-primary rounded-4 p-4 p-md-5 text-center bg-light cursor-pointer hover-bg-primary-light transition-all d-block position-relative mb-0" id="dropArea">
                            <div class="mb-3 d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle pointer-events-none" style="width: 68px; height: 68px;">
                                <i class="fa-solid fa-camera fs-2"></i>
                            </div>
                            <h5 class="fw-bold text-dark pointer-events-none mb-1"><%= t('listing.drag_images') %></h5>
                            <p class="text-muted small mb-3 pointer-events-none"><%= t('listing.max_images') %> (Maks. 15 MB)</p>
                            <span class="btn btn-primary rounded-pill px-4 fw-medium shadow-sm pointer-events-none"><i class="fa-solid fa-plus me-1"></i><%= t('listing.select_photos') || 'Fotoğraf Seç' %></span>
                            <input type="file" name="images" id="fileInput" multiple accept="image/jpeg,image/jpg,image/png,image/webp" class="position-absolute" style="opacity: 0; width: 0.1px; height: 0.1px; overflow: hidden; z-index: -1;">
                        </label>

                        <div class="row g-3 mt-3" id="imagePreviewContainer"></div>
                    </div>
                </div>

                <%# Vitrin onizlemesi. Yayinlamadan hemen once, cunku "bu ilani
                    yayinlayayim mi" sorusunun cevabi tam olarak bu kart. %>
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
                            <i class="fa-regular fa-eye text-primary"></i>
                            <h2 class="fs-6 fw-bold mb-0"><%= t('listing.preview_title') %></h2>
                            <span class="text-muted small ms-auto"><%= t('listing.preview_hint') %></span>
                        </div>
                        <div class="row justify-content-center">
                            <div class="col-9 col-sm-6 col-md-4">
                                <%# pe-none: karttaki baglantilar ve favori dugmesi henuz
                                    var olmayan bir ilana gidiyor; onizleme bakilacak bir
                                    sey, tiklanacak degil. %>
                                <div id="listingPreview" class="pe-none"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <%# Reversed on phones so the primary action sits at the bottom,
                    under the thumb, and spans the full width. %>
                <div class="d-flex flex-column-reverse flex-sm-row gap-3 justify-content-sm-end mb-5">
                    <a href="/listings" class="btn btn-light btn-lg rounded-pill fw-medium px-4 hover-lift"><%= t('common.cancel') %></a>
                    <button type="submit" class="btn btn-accent btn-lg rounded-pill fw-bold px-5 text-white shadow-lg hover-lift pulse-button"><%= t('listing.post_ad') %></button>
                </div>

            </form>
        </div>
    </div>
</div>

<style>
    .border-dashed { border-style: dashed !important; }
    .pointer-events-none { pointer-events: none !important; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const dropArea = document.getElementById('dropArea');
    const fileInput = document.getElementById('fileInput');
    const previewContainer = document.getElementById('imagePreviewContainer');
    const titleInput = document.getElementById('titleInput');
    const titleCount = document.getElementById('titleCount');
    const form = document.getElementById('createListingForm');

    if (titleInput && titleCount) {
        titleCount.textContent = `${titleInput.value.length}/70`;
        titleInput.addEventListener('input', function() {
            titleCount.textContent = `${this.value.length}/70`;
        });
    }

    if (!dropArea || !fileInput || !previewContainer) return;

    let selectedFiles = [];

    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        window.addEventListener(eventName, function(e) {
            e.preventDefault();
            e.stopPropagation();
        }, false);
    });

    ['dragenter', 'dragover'].forEach(eventName => {
        dropArea.addEventListener(eventName, function() {
            dropArea.classList.add('border-accent', 'bg-primary-light');
        }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
        dropArea.addEventListener(eventName, function() {
            dropArea.classList.remove('border-accent', 'bg-primary-light');
        }, false);
    });

    dropArea.addEventListener('drop', function(e) {
        if (e.dataTransfer && e.dataTransfer.files) {
            handleNewFiles(e.dataTransfer.files);
        }
    }, false);

    dropArea.addEventListener('click', function() {
        fileInput.value = '';
    });

    fileInput.addEventListener('change', function() {
        if (this.files && this.files.length > 0) {
            handleNewFiles(this.files);
        }
    });

    function handleNewFiles(files) {
        const fileList = Array.from(files);
        const MAX_BYTES = 15 * 1024 * 1024;

        for (let i = 0; i < fileList.length; i++) {
            if (selectedFiles.length >= 20) {
                alert('<%= t("listing.max_images") %>');
                break;
            }
            const file = fileList[i];
            const isImage = (file.type && file.type.startsWith('image/')) || /\.(jpe?g|png|webp)$/i.test(file.name);
            
            if (!isImage) {
                alert('Desteklenmeyen dosya formatı: ' + file.name + '. Sadece JPG, PNG ve WEBP kabul edilir.');
                continue;
            }

            if (file.size > MAX_BYTES) {
                alert('Dosya boyutu 15 MB sınırını aşıyor: ' + file.name);
                continue;
            }

            if (!selectedFiles.some(f => f.name === file.name && f.size === file.size)) {
                selectedFiles.push(file);
            }
        }
        syncInputAndRender();
    }

    function syncInputAndRender() {
        try {
            if (window.DataTransfer) {
                const dt = new DataTransfer();
                selectedFiles.forEach(file => dt.items.add(file));
                fileInput.files = dt.files;
            }
        } catch (err) {
            console.warn('DataTransfer sync notice:', err);
        }

        renderPreviews();
    }

    function renderPreviews() {
        previewContainer.innerHTML = '';
        selectedFiles.forEach((file, index) => {
            const objectUrl = URL.createObjectURL(file);
            const col = document.createElement('div');
            col.className = 'col-6 col-sm-4 col-md-3 position-relative';
            col.innerHTML = `
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden position-relative" style="padding-top: 75%;">
                    <img src="${objectUrl}" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover" alt="Preview">
                    <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2 rounded-circle d-flex align-items-center justify-content-center p-0 remove-btn shadow-sm" style="width: 28px; height: 28px; z-index: 10;" title="Sil">
                        <i class="fa-solid fa-xmark fs-6"></i>
                    </button>
                </div>
            `;
            previewContainer.appendChild(col);

            col.querySelector('.remove-btn').addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                URL.revokeObjectURL(objectUrl);
                selectedFiles.splice(index, 1);
                syncInputAndRender();
            });
        });
    }

    if (form) {
        form.addEventListener('submit', function() {
            try {
                if (window.DataTransfer && selectedFiles.length > 0) {
                    const dt = new DataTransfer();
                    selectedFiles.forEach(file => dt.items.add(file));
                    fileInput.files = dt.files;
                }
            } catch (err) {
                console.warn('Submit sync notice:', err);
            }
        });
    }

    // Offers from registered agents and dealers only make sense for property and
    // vehicles, so the checkbox appears once such a category is chosen and is
    // cleared again if the seller switches away.
    const categorySelect = document.getElementById('categorySelect');
    const collectBidsBox = document.getElementById('collectBidsBox');
    const collectBids = document.getElementById('collectBids');

    const jobFieldsBox = document.getElementById('jobFieldsBox');

    if (categorySelect && collectBidsBox && collectBids) {
        const BID_ROOTS = ['emlak', 'vasita'];

        const syncCategoryOptions = function () {
            const option = categorySelect.options[categorySelect.selectedIndex];
            const root = option ? option.getAttribute('data-root') : null;
            const slug = option ? option.getAttribute('data-slug') : null;

            const bidEligible = BID_ROOTS.indexOf(root) > -1;
            if (bidEligible) {
                collectBidsBox.hidden = false;
                collectBidsBox.style.display = 'block';
                collectBids.disabled = false;

                const labelEl = document.getElementById('collectBidsLabel');
                const helpEl = document.getElementById('collectBidsHelp');
                const iconEl = document.getElementById('collectBidsIcon');

                if (root === 'emlak') {
                    if (labelEl) labelEl.textContent = '<%= t("bids.opt_in_label_emlak") || "Emlakçılardan teklif toplansın" %>';
                    if (helpEl) helpEl.textContent = '<%= t("bids.opt_in_help_emlak") || "İlanınız kayıtlı emlak ofislerine ve danışmanlara açılır, size teklif verirler. Teklifleri karşılaştırıp dilediğinizi seçebilirsiniz." %>';
                    if (iconEl) iconEl.className = 'fa-solid fa-house-chimney-user text-primary me-1';
                } else if (root === 'vasita') {
                    if (labelEl) labelEl.textContent = '<%= t("bids.opt_in_label_vasita") || "Galericilerden teklif toplansın" %>';
                    if (helpEl) helpEl.textContent = '<%= t("bids.opt_in_help_vasita") || "İlanınız kayıtlı oto galerilerine ve yetkili alıcılara açılır, aracınıza teklif verirler. Teklifleri karşılaştırıp dilediğinizi seçebilirsiniz." %>';
                    if (iconEl) iconEl.className = 'fa-solid fa-car text-primary me-1';
                }
            } else {
                collectBidsBox.hidden = true;
                collectBidsBox.style.display = 'none';
                collectBids.checked = false;
                collectBids.disabled = true;
            }

            // Pay and requirements only make sense on a job advert.
            if (jobFieldsBox) jobFieldsBox.hidden = root !== 'is-ilanlari';

            const priceInput = document.getElementById('priceInput');
            const priceRequiredStar = document.getElementById('priceRequiredStar');
            const priceLabel = document.getElementById('priceLabel');

            // A wage is negotiated, a job quoted after a survey, and wholesale
            // priced per pallet or on request — none of the three fit one number
            // in a box, so the star comes off. The server agrees: requiresPrice
            // covers the quota categories only.
            const PRICE_OPTIONAL_ROOTS = ['is-ilanlari', 'usta-hizmetler', 'kurumsal-tedarikci'];

            if (PRICE_OPTIONAL_ROOTS.indexOf(root) > -1) {
                if (priceInput) {
                    priceInput.required = false;
                    priceInput.classList.remove('is-invalid');
                }
                if (priceRequiredStar) priceRequiredStar.hidden = true;
                if (priceLabel) priceLabel.innerHTML = (root === 'is-ilanlari' ? '<%= t("career.salary_optional") %>' : '<%= t("listing.price_optional") %>');
            } else {
                if (priceInput) priceInput.required = true;
                if (priceRequiredStar) priceRequiredStar.hidden = false;
                if (priceLabel) priceLabel.innerHTML = '<%= t("listing.price") %> <span class="text-danger" id="priceRequiredStar">*</span>';
            }

            // Filter attention badges according to category (Jobs and Services do not have sale/product badges)
            const badgePickerWrapper = document.getElementById('new_badgePickerWrapper');
            const isNoBadgeCategory = ['is-ilanlari', 'usta-hizmetler', 'ustalar'].includes(root);
            if (badgePickerWrapper) {
                badgePickerWrapper.classList.toggle('d-none', isNoBadgeCategory);
            }
            document.querySelectorAll('.badge-picker-item').forEach(item => {
                const excluded = JSON.parse(item.getAttribute('data-excluded-roots') || '[]');
                const shouldHide = isNoBadgeCategory || (root && excluded.includes(root));
                item.classList.toggle('d-none', shouldHide);
                if (shouldHide) {
                    const cb = item.querySelector('input[type="checkbox"]');
                    if (cb) cb.checked = false;
                }
            });

            // Dynamically configure Listing Purpose (Satılık / Kiralık / Arıyorum etc.)
            const purposeSaleCol = document.getElementById('purposeSaleCol');
            const purposeRentCol = document.getElementById('purposeRentCol');
            const purposeWantedCol = document.getElementById('purposeWantedCol');
            const typeSale = document.getElementById('typeSale');
            const typeRent = document.getElementById('typeRent');
            const typeWanted = document.getElementById('typeWanted');
            const typeSaleText = document.getElementById('typeSaleText');
            const typeSaleIcon = document.getElementById('typeSaleIcon');
            const typeWantedText = document.getElementById('typeWantedText');
            const typeWantedIcon = document.getElementById('typeWantedIcon');
            const purposeHelpText = document.getElementById('purposeHelpText');

            if (purposeSaleCol && purposeRentCol && purposeWantedCol && typeSale && typeRent && typeWanted) {
                if (root === 'emlak') {
                    // Emlak: Satılık / Kiralık / Arıyorum
                    purposeSaleCol.className = 'col-4';
                    purposeSaleCol.hidden = false;
                    typeSale.value = 'sale';
                    if (typeSaleText) typeSaleText.textContent = '<%= t("listing.type_sale") || "Satılık" %>';
                    if (typeSaleIcon) typeSaleIcon.className = 'fa-solid fa-tag mb-1 fs-5';

                    purposeRentCol.className = 'col-4';
                    purposeRentCol.hidden = false;

                    purposeWantedCol.className = 'col-4';
                    purposeWantedCol.hidden = false;
                    typeWanted.value = 'wanted';
                    if (typeWantedText) typeWantedText.textContent = '<%= t("listing.type_wanted") || "Arıyorum" %>';
                    if (typeWantedIcon) typeWantedIcon.className = 'fa-solid fa-hand-holding-heart mb-1 fs-5 wanted-icon';

                    if (purposeHelpText) purposeHelpText.textContent = 'Satılık, kiralık veya gayrimenkul arayışınız için ilan verebilirsiniz.';
                } else if (root === 'vasita') {
                    // Vasıta: Satılık / Kiralık (Rent a Car)
                    purposeSaleCol.className = 'col-6';
                    purposeSaleCol.hidden = false;
                    typeSale.value = 'sale';
                    if (typeSaleText) typeSaleText.textContent = '<%= t("listing.type_sale") || "Satılık" %>';
                    if (typeSaleIcon) typeSaleIcon.className = 'fa-solid fa-car mb-1 fs-5';

                    purposeRentCol.className = 'col-6';
                    purposeRentCol.hidden = false;
                    typeRent.value = 'rent';
                    if (typeRentText) typeRentText.textContent = '<%= t("listing.type_rent") || "Kiralık (Rent a Car)" %>';
                    if (typeRentIcon) typeRentIcon.className = 'fa-solid fa-key mb-1 fs-5';

                    purposeWantedCol.hidden = true;

                    if (typeWanted.checked) typeSale.checked = true;

                    if (purposeHelpText) purposeHelpText.textContent = 'Satılık araç veya araç kiralama (Rent a Car) ilanı verebilirsiniz.';
                } else if (root === 'is-ilanlari') {
                    // İş İlanları: Eleman Arıyorum (İşveren) / İş Arıyorum (Aday)
                    purposeSaleCol.className = 'col-6';
                    purposeSaleCol.hidden = false;
                    typeSale.value = 'sale';
                    if (typeSaleText) typeSaleText.textContent = '<%= t("listing.type_job_employer") || "Eleman Arıyorum (İşveren)" %>';
                    if (typeSaleIcon) typeSaleIcon.className = 'fa-solid fa-briefcase mb-1 fs-5';

                    purposeRentCol.hidden = true;

                    purposeWantedCol.className = 'col-6';
                    purposeWantedCol.hidden = false;
                    typeWanted.value = 'wanted';
                    if (typeWantedText) typeWantedText.textContent = '<%= t("listing.type_job_seeker") || "İş Arıyorum (Aday)" %>';
                    if (typeWantedIcon) typeWantedIcon.className = 'fa-solid fa-user-tie mb-1 fs-5 wanted-icon';

                    if (typeRent.checked) typeSale.checked = true;

                    if (purposeHelpText) purposeHelpText.textContent = 'Eleman arıyorsanız "Eleman Arıyorum", iş arıyorsanız "İş Arıyorum" seçeneğini belirleyin.';
                } else if (root === 'usta-hizmetler' || root === 'ustalar') {
                    // Usta & Hizmetler: Hizmet Veriyorum / Hizmet Arıyorum
                    purposeSaleCol.className = 'col-6';
                    purposeSaleCol.hidden = false;
                    typeSale.value = 'sale';
                    if (typeSaleText) typeSaleText.textContent = '<%= t("listing.type_service_provider") || "Hizmet Veriyorum" %>';
                    if (typeSaleIcon) typeSaleIcon.className = 'fa-solid fa-screwdriver-wrench mb-1 fs-5';

                    purposeRentCol.hidden = true;

                    purposeWantedCol.className = 'col-6';
                    purposeWantedCol.hidden = false;
                    typeWanted.value = 'wanted';
                    if (typeWantedText) typeWantedText.textContent = '<%= t("listing.type_service_seeker") || "Hizmet Arıyorum" %>';
                    if (typeWantedIcon) typeWantedIcon.className = 'fa-solid fa-hand-holding-heart mb-1 fs-5 wanted-icon';

                    if (typeRent.checked) typeSale.checked = true;

                    if (purposeHelpText) purposeHelpText.textContent = 'Hizmet sunuyorsanız "Hizmet Veriyorum", usta veya hizmet arıyorsanız "Hizmet Arıyorum" seçin.';
                } else if (root === 'ikinci-el') {
                    const isNoRent = (slug === 'mobilya' || slug === 'giyim' || slug === 'mobilya-dekorasyon-toptan');
                    if (isNoRent) {
                        // Mobilya & Giyim: Kiralama seçeneği devre dışı -> Satılık / Arıyorum (2 kolon)
                        purposeSaleCol.className = 'col-6';
                        purposeSaleCol.hidden = false;
                        typeSale.value = 'sale';
                        if (typeSaleText) typeSaleText.textContent = '<%= t("listing.type_sale") || "Satılık" %>';
                        if (typeSaleIcon) typeSaleIcon.className = 'fa-solid fa-tag mb-1 fs-5';

                        purposeRentCol.hidden = true;
                        if (typeRent.checked) typeSale.checked = true;

                        purposeWantedCol.className = 'col-6';
                        purposeWantedCol.hidden = false;
                        typeWanted.value = 'wanted';
                        if (typeWantedText) typeWantedText.textContent = '<%= t("listing.type_wanted") || "Arıyorum" %>';
                        if (typeWantedIcon) typeWantedIcon.className = 'fa-solid fa-hand-holding-heart mb-1 fs-5 wanted-icon';

                        if (purposeHelpText) purposeHelpText.textContent = 'Satılık ürün veya aradığınız bir eşya/ürün için ilan verebilirsiniz.';
                    } else {
                        // İkinci El: Satılık / Kiralık / Arıyorum (3 kolon)
                        purposeSaleCol.className = 'col-4';
                        purposeSaleCol.hidden = false;
                        typeSale.value = 'sale';
                        if (typeSaleText) typeSaleText.textContent = '<%= t("listing.type_sale") || "Satılık" %>';
                        if (typeSaleIcon) typeSaleIcon.className = 'fa-solid fa-tag mb-1 fs-5';

                        purposeRentCol.className = 'col-4';
                        purposeRentCol.hidden = false;
                        typeRent.value = 'rent';
                        if (typeRentText) typeRentText.textContent = '<%= t("listing.type_rent") || "Kiralık" %>';
                        if (typeRentIcon) typeRentIcon.className = 'fa-solid fa-key mb-1 fs-5';

                        purposeWantedCol.className = 'col-4';
                        purposeWantedCol.hidden = false;
                        typeWanted.value = 'wanted';
                        if (typeWantedText) typeWantedText.textContent = '<%= t("listing.type_wanted") || "Arıyorum" %>';
                        if (typeWantedIcon) typeWantedIcon.className = 'fa-solid fa-hand-holding-heart mb-1 fs-5 wanted-icon';

                        if (purposeHelpText) purposeHelpText.textContent = 'Satılık, kiralık ürün veya aradığınız bir eşya/ürün için ilan verebilirsiniz.';
                    }
                } else if (root === 'kurumsal-tedarikci') {
                    // Kurumsal Tedarikçi: Tedarikçi / Talep
                    purposeSaleCol.className = 'col-6';
                    purposeSaleCol.hidden = false;
                    typeSale.value = 'sale';
                    if (typeSaleText) typeSaleText.textContent = '<%= t("listing.type_supplier") || "Tedarikçiyim" %>';
                    if (typeSaleIcon) typeSaleIcon.className = 'fa-solid fa-truck-field mb-1 fs-5';

                    purposeRentCol.hidden = true;

                    purposeWantedCol.className = 'col-6';
                    purposeWantedCol.hidden = false;
                    typeWanted.value = 'wanted';
                    if (typeWantedText) typeWantedText.textContent = '<%= t("listing.type_supply_request") || "Alım Talebi" %>';
                    if (typeWantedIcon) typeWantedIcon.className = 'fa-solid fa-hand-holding-heart mb-1 fs-5 wanted-icon';

                    if (typeRent.checked) typeSale.checked = true;

                    if (purposeHelpText) purposeHelpText.textContent = 'Tedarikçi olarak teklif vermek için "Tedarikçiyim", toplu alım/ihtiyaç için "Alım Talebi" seçin.';
                } else {
                    // Genel
                    purposeSaleCol.className = 'col-4';
                    purposeSaleCol.hidden = false;
                    typeSale.value = 'sale';
                    if (typeSaleText) typeSaleText.textContent = '<%= t("listing.type_sale") || "Satılık" %>';
                    if (typeSaleIcon) typeSaleIcon.className = 'fa-solid fa-tag mb-1 fs-5';

                    purposeRentCol.className = 'col-4';
                    purposeRentCol.hidden = false;

                    purposeWantedCol.className = 'col-4';
                    purposeWantedCol.hidden = false;
                    typeWanted.value = 'wanted';
                    if (typeWantedText) typeWantedText.textContent = '<%= t("listing.type_wanted") || "Arıyorum" %>';
                    if (typeWantedIcon) typeWantedIcon.className = 'fa-solid fa-hand-holding-heart mb-1 fs-5 wanted-icon';

                    if (purposeHelpText) purposeHelpText.textContent = 'İlanınızın amacını belirleyin.';
                }
            }
        };

        categorySelect.addEventListener('change', syncCategoryOptions);
        syncCategoryOptions();
    }

    // --- Listing Attributes & Description draft ---------------------------
    const draftBox = document.getElementById('draftBox');
    const draftFields = document.getElementById('draftFields');
    const draftFeatures = document.getElementById('draftFeatures');
    const featuresSection = document.getElementById('featuresSection');
    const draftBtn = document.getElementById('draftBtn');
    const draftStatus = document.getElementById('draftStatus');
    const descriptionInput = document.getElementById('descriptionInput');

    if (draftBox && categorySelect && descriptionInput) {
        // Alanların üç türü var: serbest metin, kapalı liste (choices) ve
        // markaya bağlı olarak sunucudan gelen liste (dynamic).
        //
        // Kapalı listeler artık açılır kutu değil, dokunulacak etiketler.
        // Telefonda açılır kutu üç hareket istiyor - aç, kaydır, seç; etiket bir
        // dokunuş. Satıcının bir ilanda on kez tekrarladığı şey tam olarak bu.
        // Alanlar iki bolume ayriliyor: adim adim sorulanlar ve isteyenin actigi
        // detaylar.
        //
        // Ilk hal on uc alani ayni anda ekrana basiyordu. Etiketlere cevirmek onu
        // daha okunur yapmadi, yalnizca daha renkli yapti - telefonda goz nereye
        // bakacagini bilemiyordu. Bir seferde bir soru sormak, ayni bilgiyi
        // toplamanin tek okunabilir yolu.
        //
        // Adim olacak alanlar, bir aracin ya da evin ne oldugunu soyleyen az
        // sayidaki alan. Motor hacmi de gerekli bir bilgi ama once "hangi marka"
        // sorusunun cevaplanmasi gerekiyor; ikisini yan yana koymak ikisini de
        // zorlastiriyor.
        const FIELDS = {
            emlak: [
                { name: 'rooms', label: '<%= t("draft.field_rooms") %>', step: true, choices: ['1+0', '1+1', '2+1', '3+1', '4+1', '5+1', '6+1 ve üzeri'], placeholder: 'Örn: 3+1' },
                { name: 'size', label: '<%= t("draft.field_size") %>', step: true, placeholder: 'Örn: 120' },
                { name: 'floor', label: '<%= t("draft.field_floor") %>', step: true, choices: ['Bodrum', 'Zemin', 'Bahçe Katı', '1', '2', '3', '4', '5', '6-10', '10 üzeri'], placeholder: 'Örn: 2' },
                { name: 'build_year', draftKey: 'buildYear', label: '<%= t("draft.field_build_year") %>', placeholder: 'Örn: 2018' }
            ],
            vasita: [
                { name: 'brand', label: '<%= t("draft.field_brand") %>', step: true, brandChoices: true, searchable: true, placeholder: 'Örn: BMW' },
                { name: 'model', label: '<%= t("draft.field_model") %>', step: true, modelChoices: true, placeholder: 'Örn: 320i' },
                { name: 'year', label: '<%= t("draft.field_year") %>', step: true, yearChoices: true, placeholder: 'Örn: 2020' },
                { name: 'km', label: '<%= t("draft.field_km") %>', step: true, placeholder: 'Örn: 85000' },
                { name: 'fuel', label: '<%= t("draft.field_fuel") %>', step: true, choices: ['Benzin', 'Dizel', 'Hibrit', 'Elektrik', 'LPG'] },
                { name: 'gear', label: '<%= t("draft.field_gear") %>', step: true, choices: ['Otomatik', 'Manuel', 'Yarı Otomatik'] },
                { name: 'body_type', label: '<%= t("draft.field_body_type") %>', choices: ['Sedan', 'Hatchback', 'SUV', 'Coupe', 'Cabrio', 'Station Wagon', 'Pick-up', 'Minivan'] },
                { name: 'engine_power', label: '<%= t("draft.field_engine_power") %>', placeholder: 'Örn: 150 HP' },
                { name: 'engine_size', label: '<%= t("draft.field_engine_size") %>', placeholder: 'Örn: 1600 cc' },
                { name: 'drivetrain', label: '<%= t("draft.field_drivetrain") %>', choices: ['Önden Çekiş', 'Arkadan İtiş', '4x4 / AWD (Dört Çeker)'] },
                { name: 'color', label: '<%= t("draft.field_color") %>', placeholder: 'Örn: Beyaz' },
                { name: 'vehicle_status', label: '<%= t("draft.field_vehicle_status") %>', choices: ['İkinci El', 'Sıfır (0 KM)', 'Hasarsız / Boyasız', 'Boyalı / Değişenli', 'Ağır Hasar Kayıtlı'] },
                { name: 'swap', label: '<%= t("draft.field_swap") %>', choices: ['Hayır (Takas Yok)', 'Evet (Takasa Uygun)', 'Sadece Araçla Takas', 'Düşük Model Araçla Takas'] }
            ],
            'ikinci-el': [
                { name: 'condition', label: '<%= t("draft.field_condition") %>', step: true, choices: ['Sıfır / Kapalı Kutu', 'Çok Az Kullanılmış (Yeni Gibi)', 'İkinci El (Sorunsuz)', 'Kozmetik Kusurlu'] },
                { name: 'swap', label: '<%= t("draft.field_swap") %>', choices: ['Hayır (Takas Yok)', 'Evet (Takasa Uygun)'] }
            ]
        };

        const BRANDS_BY_SUB = <%- JSON.stringify(typeof vehicleBrandsBySub !== 'undefined' ? vehicleBrandsBySub : {}) %>;

        const FEATURES = <%- JSON.stringify(draftFeatureMap) %>;
        const FEATURE_LABELS = <%- JSON.stringify(draftFeatureLabels) %>;
        const savedFormData = <%- JSON.stringify(typeof formData !== 'undefined' ? formData : {}) %>;
        const savedAttributes = savedFormData.attributes || savedFormData;

        const currentRoot = function () {
            const option = categorySelect.options[categorySelect.selectedIndex];
            return option ? option.getAttribute('data-root') : null;
        };

        const currentSub = function () {
            const option = categorySelect.options[categorySelect.selectedIndex];
            return option ? option.getAttribute('data-slug') : null;
        };

        const escapeAttr = function (value) {
            return String(value === undefined || value === null ? '' : value).replace(/"/g, '&quot;');
        };

        const escapeHtml = function (value) {
            const div = document.createElement('div');
            div.textContent = String(value === undefined || value === null ? '' : value);
            return div.innerHTML;
        };

        // Son yirmi bes yil. Bir arac ilaninda yil neredeyse her zaman yakin
        // gecmiste; daha eskisi icin "Baska" var.
        const yearChoices = function () {
            const now = new Date().getFullYear();
            const list = [];
            for (let y = now + 1; y >= now - 24; y--) list.push(String(y));
            return list;
        };

        const choicesFor = function (field) {
            if (field.choices) return field.choices;
            if (field.yearChoices) return yearChoices();
            if (field.brandChoices) {
                const brands = BRANDS_BY_SUB[currentSub()] || BRANDS_BY_SUB.otomobil || { all: [] };
                return brands.all;
            }
            return null;
        };

        // Degerler her zaman gizli alanlarda duruyor, gorunen arayuzden bagimsiz.
        // Boylece form gonderimi ve aciklama taslagi ureteci - ikisi de
        // `[data-draft]` okuyor - adim adim arayuzden hic haberdar olmadan
        // eskisi gibi calisiyor.
        const valueStore = document.getElementById('draftValues');

        // Girilen her deger burada da tutuluyor. Gizli alanlar kategori
        // degistiginde yeniden kuruluyor ve o kategoride bulunmayan alanlar
        // DOM'dan dusuyor; bu hafiza olmasa emlaktan vasitaya bakip geri donen
        // biri oda sayisini yeniden girmek zorunda kalirdi.
        const enteredValues = {};

        const ensureInputs = function (fields) {
            valueStore.querySelectorAll('input[type="hidden"]').forEach(function (el) {
                enteredValues[el.getAttribute('name')] = el.value;
            });

            valueStore.innerHTML = fields.map(function (field) {
                const draftKey = field.draftKey || field.name;
                const existing = enteredValues[field.name] !== undefined
                    ? enteredValues[field.name]
                    : (savedAttributes[field.name] || savedAttributes[draftKey] || '');
                return '<input type="hidden" name="' + field.name + '" id="attr_' + field.name +
                    '" data-draft="' + draftKey + '" value="' + escapeAttr(existing) + '">';
            }).join('');
        };

        const getValue = function (name) {
            const el = document.getElementById('attr_' + name);
            return el ? el.value : '';
        };

        const setValue = function (name, value) {
            const el = document.getElementById('attr_' + name);
            if (!el) return;
            el.value = value;
            enteredValues[name] = value;
            el.dispatchEvent(new Event('input', { bubbles: true }));
            el.dispatchEvent(new Event('change', { bubbles: true }));
        };

        // --- Adim durumu ---------------------------------------------------------
        let stepFields = [];
        let detailFields = [];
        let stepIndex = 0;

        const stepHost = document.getElementById('draftSteps');
        const doneHost = document.getElementById('draftAnswered');
        const detailHost = document.getElementById('draftDetails');
        const detailToggle = document.getElementById('draftDetailsToggle');

        // Cevaplanmis adimlar tek satirlik ozetlere iniyor. Ekranda kalmalari
        // gerekiyor - insan ne sectigini gormek ister - ama yer kaplamamalari da
        // gerekiyor; dokununca o adima geri donuluyor.
        const renderAnswered = function () {
            const parts = [];
            stepFields.forEach(function (field, index) {
                if (index >= stepIndex) return;
                const value = getValue(field.name);
                parts.push(
                    '<button type="button" class="btn btn-sm btn-light border rounded-pill answered-chip d-inline-flex align-items-center gap-2" data-step="' + index + '">' +
                    '<span class="text-muted">' + escapeHtml(field.label) + '</span>' +
                    '<span class="fw-semibold">' + (value ? escapeHtml(value) : '—') + '</span>' +
                    '<i class="fa-solid fa-pen text-muted" style="font-size: 0.7rem;"></i></button>'
                );
            });
            doneHost.innerHTML = parts.join('');
            doneHost.classList.toggle('mb-3', parts.length > 0);
        };

        const renderStep = function () {
            renderAnswered();

            if (stepIndex >= stepFields.length) {
                stepHost.innerHTML = '';
                stepHost.classList.add('d-none');
                return;
            }

            stepHost.classList.remove('d-none');
            const field = stepFields[stepIndex];
            const value = getValue(field.name);
            const options = choicesFor(field);

            let html = '<div class="d-flex align-items-center gap-2 mb-2">' +
                '<span class="badge bg-primary rounded-pill">' + (stepIndex + 1) + ' / ' + stepFields.length + '</span>' +
                '<span class="fw-bold">' + escapeHtml(field.label) + '</span>' +
                '</div>';

            if (field.searchable && options && options.length > 12) {
                html += '<input type="search" class="form-control form-control-sm mb-2 step-search" ' +
                    'placeholder="Yazarak ara…" autocomplete="off">';
            }

            if (options) {
                html += '<div class="d-flex flex-wrap gap-2 step-options">';
                options.forEach(function (option) {
                    const on = String(option) === String(value);
                    html += '<button type="button" class="btn rounded-pill step-option ' +
                        (on ? 'btn-primary' : 'btn-outline-secondary') + '" data-value="' + escapeAttr(option) + '">' +
                        escapeHtml(option) + '</button>';
                });
                html += '</div>';
                html += '<input type="text" class="form-control form-control-sm mt-2 step-free" ' +
                    'placeholder="' + escapeAttr(field.placeholder || 'Listede yoksa buraya yazın') + '" value="' +
                    escapeAttr(options.indexOf(value) === -1 ? value : '') + '">';
            } else {
                html += '<input type="text" class="form-control step-free" inputmode="' +
                    (field.name === 'km' || field.name === 'size' ? 'numeric' : 'text') + '" placeholder="' +
                    escapeAttr(field.placeholder || '') + '" value="' + escapeAttr(value) + '">';
            }

            if (field.modelChoices) {
                // d-none ile gizleniyor, hidden ozniteligiyle degil: d-flex
                // display'i !important yaziyor ve hidden'i eziyor.
                html += '<div class="d-flex flex-wrap gap-2 mt-2 model-suggestions d-none"></div>';
            }

            html += '<div class="d-flex gap-2 mt-3">' +
                '<button type="button" class="btn btn-primary rounded-pill px-4 step-next">Devam</button>' +
                '<button type="button" class="btn btn-link text-muted step-skip">Bu adımı atla</button>' +
                '</div>';

            stepHost.innerHTML = html;

            const search = stepHost.querySelector('.step-search');
            if (search) search.focus();

            if (field.modelChoices) loadModelSuggestions();
        };

        // Detaylar acilana kadar basilmiyor: cogu ilanda bunlarin cogu bos
        // kaliyor ve bos kalacak on alani gostermek, doldurulacak besini
        // gizliyor.
        const renderDetails = function () {
            detailHost.innerHTML = detailFields.map(function (field) {
                const value = getValue(field.name);
                const options = choicesFor(field);
                let html = '<div class="col-12 mb-2"><label class="form-label small fw-semibold text-muted mb-1">' +
                    escapeHtml(field.label) + '</label>';

                if (options) {
                    html += '<div class="d-flex flex-wrap gap-1 detail-options" data-field="' + field.name + '">';
                    options.forEach(function (option) {
                        const on = String(option) === String(value);
                        html += '<button type="button" class="btn btn-sm rounded-pill detail-option ' +
                            (on ? 'btn-primary' : 'btn-outline-secondary') + '" data-value="' + escapeAttr(option) + '">' +
                            escapeHtml(option) + '</button>';
                    });
                    html += '</div>';
                } else {
                    html += '<input type="text" class="form-control form-control-sm detail-free" data-field="' +
                        field.name + '" placeholder="' + escapeAttr(field.placeholder || '') +
                        '" value="' + escapeAttr(value) + '">';
                }

                return html + '</div>';
            }).join('');
        };

        // Genis ekranda adim adim ilerlemek yavaslatiyor: yer var, klavye var,
        // fare var. Orada butun alanlar kompakt bir izgarada duruyor ve kapali
        // listeler acilir kutu olarak basiliyor - kirk alti markayi etiket
        // olarak yan yana dizmek tam da sikayet edilen goruntuydu ve o goruntu
        // masaustunde ortaya cikmisti.
        //
        // Izgaradaki kontroller name tasimiyor: deger yine gizli alanlarda
        // duruyor, bunlar yalnizca onu yazan arayuz. Boylece iki gorunum
        // arasinda gecis yapinca girilenler yerinde kaliyor.
        const gridHost = document.getElementById('draftGrid');
        const wideScreen = window.matchMedia('(min-width: 992px)');

        const renderGrid = function (fields) {
            gridHost.innerHTML = fields.map(function (field) {
                const value = getValue(field.name);
                const options = choicesFor(field);
                const id = 'grid_' + field.name;

                let control;
                if (options) {
                    control = '<select class="form-select form-select-sm bg-white grid-control" id="' + id +
                        '" data-field="' + field.name + '">' +
                        '<option value="">Seçiniz</option>' +
                        options.map(function (option) {
                            const on = String(option) === String(value) ? ' selected' : '';
                            return '<option value="' + escapeAttr(option) + '"' + on + '>' + escapeHtml(option) + '</option>';
                        }).join('') +
                        // Listede olmayan bir deger daha once girilmisse acilir
                        // kutuda da gorunmeli, yoksa kaydedilmis ilan bosalirdi.
                        (value && options.indexOf(value) === -1
                            ? '<option value="' + escapeAttr(value) + '" selected>' + escapeHtml(value) + '</option>'
                            : '') +
                        '</select>';
                } else {
                    control = '<input type="text" class="form-control form-control-sm bg-white grid-control" id="' + id +
                        '" data-field="' + field.name + '" placeholder="' + escapeAttr(field.placeholder || '') +
                        '" value="' + escapeAttr(value) + '">';
                }

                return '<div class="col-6 col-md-3">' +
                    '<label class="form-label small fw-semibold text-muted mb-1" for="' + id + '">' +
                    escapeHtml(field.label) + '</label>' + control + '</div>';
            }).join('');
        };

        gridHost.addEventListener('change', function (event) {
            const control = event.target.closest('.grid-control');
            if (control) setValue(control.getAttribute('data-field'), control.value.trim());
        });

        gridHost.addEventListener('input', function (event) {
            const control = event.target.closest('input.grid-control');
            if (control) setValue(control.getAttribute('data-field'), control.value.trim());
        });

        const renderDraftInputs = function () {
            const root = currentRoot();
            const fields = FIELDS[root] || [];

            ensureInputs(fields);
            stepFields = fields.filter(function (f) { return f.step; });
            detailFields = fields.filter(function (f) { return !f.step; });

            // Gizlemek icin d-none sinifi kullaniliyor, hidden ozniteligi degil.
            // Bootstrap'in .row ve .d-flex siniflari display'i !important ile
            // yaziyor ve hidden ozniteligini eziyor: oge gizli isaretleniyor ama
            // ekranda durmaya devam ediyordu.
            const wide = wideScreen.matches;
            gridHost.classList.toggle('d-none', !wide);
            doneHost.classList.toggle('d-none', wide);
            stepHost.classList.toggle('d-none', wide);
            detailToggle.classList.toggle('d-none', wide || detailFields.length === 0);
            if (wide) {
                const wrap = document.getElementById('draftDetailsWrap');
                if (wrap) wrap.classList.remove('show');
            }

            if (wide) {
                renderGrid(fields);
            } else {
                // Kaldigi yerden devam: daha once doldurulmus alanlar tekrar
                // sorulmuyor.
                stepIndex = 0;
                while (stepIndex < stepFields.length && getValue(stepFields[stepIndex].name)) stepIndex++;

                renderStep();
                renderDetails();
            }

            const feats = FEATURES[root] || [];
            draftFeatures.innerHTML = '';
            if (feats.length > 0) {
                if (featuresSection) featuresSection.hidden = false;
                const savedFeats = savedAttributes.features ? (Array.isArray(savedAttributes.features) ? savedAttributes.features : String(savedAttributes.features).split(',')) : [];
                feats.forEach(function (feature) {
                    const id = 'feat_' + feature;
                    const isChecked = savedFeats.includes(feature) ? 'checked' : '';
                    const wrap = document.createElement('div');
                    wrap.className = 'form-check form-check-inline bg-white px-3 py-1 rounded-pill border';
                    wrap.innerHTML = '<input class="form-check-input cursor-pointer" type="checkbox" name="features[]" value="' + feature +
                        '" id="' + id + '" data-draft-feature="1" ' + isChecked + '>' +
                        '<label class="form-check-label small cursor-pointer ms-1" for="' + id + '">' +
                        (FEATURE_LABELS[feature] || feature) + '</label>';
                    draftFeatures.appendChild(wrap);
                });
            } else {
                if (featuresSection) featuresSection.hidden = true;
            }

            draftBox.hidden = !root || (fields.length === 0 && feats.length === 0);
        };

        // --- Etkilesim -----------------------------------------------------------
        const advance = function () {
            stepIndex = Math.min(stepIndex + 1, stepFields.length);
            renderStep();
        };

        stepHost.addEventListener('click', function (event) {
            const option = event.target.closest('.step-option');
            if (option) {
                const field = stepFields[stepIndex];
                setValue(field.name, option.getAttribute('data-value'));
                // Secim yapinca bir sonraki soruya geciliyor: "Devam"a basmak
                // ayni seyi iki kez yaptirmak olurdu.
                if (field.modelChoices || !field.brandChoices) advance();
                else { renderStep(); advance(); }
                return;
            }

            if (event.target.closest('.step-next')) {
                const free = stepHost.querySelector('.step-free');
                if (free) setValue(stepFields[stepIndex].name, free.value.trim());
                advance();
                return;
            }

            if (event.target.closest('.step-skip')) {
                setValue(stepFields[stepIndex].name, '');
                advance();
                return;
            }

            const suggestion = event.target.closest('.model-chip');
            if (suggestion) {
                setValue('model', suggestion.getAttribute('data-value'));
                advance();
            }
        });

        stepHost.addEventListener('input', function (event) {
            const search = event.target.closest('.step-search');
            if (search) {
                const needle = search.value.trim().toLocaleLowerCase('tr');
                stepHost.querySelectorAll('.step-option').forEach(function (btn) {
                    const hit = !needle || btn.textContent.toLocaleLowerCase('tr').indexOf(needle) !== -1;
                    btn.classList.toggle('d-none', !hit);
                });
                return;
            }

            const free = event.target.closest('.step-free');
            if (free) setValue(stepFields[stepIndex].name, free.value.trim());
        });

        stepHost.addEventListener('keydown', function (event) {
            if (event.key !== 'Enter') return;
            if (!event.target.closest('.step-free') && !event.target.closest('.step-search')) return;
            event.preventDefault();
            const free = stepHost.querySelector('.step-free');
            if (free) setValue(stepFields[stepIndex].name, free.value.trim());
            advance();
        });

        doneHost.addEventListener('click', function (event) {
            const chip = event.target.closest('.answered-chip');
            if (!chip) return;
            stepIndex = parseInt(chip.getAttribute('data-step'), 10) || 0;
            renderStep();
        });

        detailHost.addEventListener('click', function (event) {
            const option = event.target.closest('.detail-option');
            if (!option) return;
            const group = option.closest('.detail-options');
            const name = group.getAttribute('data-field');
            const already = option.classList.contains('btn-primary');
            setValue(name, already ? '' : option.getAttribute('data-value'));
            group.querySelectorAll('.detail-option').forEach(function (btn) {
                const on = btn === option && !already;
                btn.classList.toggle('btn-primary', on);
                btn.classList.toggle('btn-outline-secondary', !on);
            });
        });

        detailHost.addEventListener('input', function (event) {
            const free = event.target.closest('.detail-free');
            if (free) setValue(free.getAttribute('data-field'), free.value.trim());
        });

        // --- Markaya gore model onerileri ---------------------------------------
        let modelRequest = 0;
        async function loadModelSuggestions() {
            const box = stepHost.querySelector('.model-suggestions');
            if (!box) return;

            const brand = getValue('brand');
            if (!brand) { box.classList.add('d-none'); box.innerHTML = ''; return; }

            const ticket = ++modelRequest;
            try {
                const res = await fetch('/api/vehicle-models?brand=' + encodeURIComponent(brand), {
                    headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await res.json();
                if (ticket !== modelRequest) return;

                const models = (data && Array.isArray(data.models)) ? data.models : [];
                if (models.length === 0) { box.classList.add('d-none'); box.innerHTML = ''; return; }

                const current = getValue('model');
                box.innerHTML = models.map(function (model) {
                    const on = String(model) === String(current);
                    return '<button type="button" class="btn rounded-pill model-chip ' +
                        (on ? 'btn-primary' : 'btn-outline-secondary') + '" data-value="' + escapeAttr(model) + '">' +
                        escapeHtml(model) + '</button>';
                }).join('');
                box.classList.remove('d-none');
            } catch (err) {
                box.classList.add('d-none');
                box.innerHTML = '';
            }
        }

        // --- Yaklasik konum secici -----------------------------------------------
        //
        // Amac istatistik: haritada "su bolgede su fiyatlar var" diyebilmek. Bu
        // yuzden igne kaydedilirken sunucuda bir izgaraya oturtuluyor ve tam
        // adres hicbir zaman saklanmiyor. Daire de bunu gosteriyor: satici
        // noktayi degil, bir bolgeyi isaretliyor.
        (function () {
            const host = document.getElementById('areaPicker');
            const latInput = document.getElementById('locationLat');
            const lngInput = document.getElementById('locationLng');
            if (!host || !latInput || !lngInput || typeof L === 'undefined') return;

            const CITY_POINTS = <%- JSON.stringify(cities.CITIES.map(function (c) { return { name: c.name, lat: c.lat, lng: c.lng, zoom: c.zoom || 13 }; })) %>;
            const RADIUS = 500;

            const start = (latInput.value && lngInput.value)
                ? [Number(latInput.value), Number(lngInput.value)]
                : [35.15, 33.40];

            const map = L.map(host, { scrollWheelZoom: false }).setView(start, latInput.value ? 13 : 9);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 18, attribution: '&copy; OpenStreetMap'
            }).addTo(map);
            map.on('click', function () { map.scrollWheelZoom.enable(); });

            let circle = null;
            const place = function (lat, lng) {
                latInput.value = lat.toFixed(5);
                lngInput.value = lng.toFixed(5);
                if (circle) map.removeLayer(circle);
                circle = L.circle([lat, lng], {
                    radius: RADIUS, color: '#0d6efd', weight: 2, fillOpacity: 0.15
                }).addTo(map);
            };

            if (latInput.value && lngInput.value) place(Number(latInput.value), Number(lngInput.value));

            map.on('click', function (event) { place(event.latlng.lat, event.latlng.lng); });

            // Sehir secildiginde harita oraya gidiyor: ada olcegindeki bir
            // haritada dogru mahalleyi bulmak zor.
            const citySelect = document.querySelector('select[name="city"]');
            if (citySelect) {
                citySelect.addEventListener('change', function () {
                    const found = CITY_POINTS.find(function (c) { return c.name === citySelect.value; });
                    if (found) map.setView([found.lat, found.lng], found.zoom);
                });
            }
        })();

        categorySelect.addEventListener('change', renderDraftInputs);

        // Pencere kucultulup buyutuldugunde gorunum degisiyor. Degerler gizli
        // alanlarda durdugu icin gecis sirasinda hicbir sey kaybolmuyor.
        if (typeof wideScreen.addEventListener === 'function') {
            wideScreen.addEventListener('change', renderDraftInputs);
        }

        renderDraftInputs();


        // --- Vitrin onizlemesi ---------------------------------------------------
        //
        // Kart sunucuda, sitenin gercek partial'i ile uretiliyor. Ayni karti bir
        // de burada JavaScript ile cizmek daha hizli olurdu ama iki kopya
        // kacinilmaz olarak ayrisir: kart bir gun degisir, onizleme eski halini
        // gostermeye devam eder ve satici yayinladiginda baska bir sey gorur.
        (function () {
            const box = document.getElementById('listingPreview');
            const form = document.getElementById('createListingForm');
            if (!box || !form) return;

            const fileInput = document.getElementById('fileInput');
            let timer = null;
            let ticket = 0;
            let objectUrl = null;

            const val = function (name) {
                const el = form.querySelector('[name="' + name + '"]');
                return el ? el.value : '';
            };

            const checked = function (name) {
                const el = form.querySelector('[name="' + name + '"]');
                return Boolean(el && el.checked);
            };

            const collect = function () {
                return {
                    title: val('title'),
                    price: val('price'),
                    currency: val('currency'),
                    city: val('city'),
                    district: val('district'),
                    category_id: categorySelect.value,
                    listing_type: val('listing_type'),
                    is_urgent: checked('badge_urgent'),
                    is_opportunity: checked('badge_opportunity'),
                    is_negotiable: checked('badge_negotiable'),
                    is_swap: checked('badge_swap'),
                    image_count: fileInput && fileInput.files ? fileInput.files.length : 0
                };
            };

            // Secilen fotograf henuz sunucuda yok; karttaki gorsel tarayicidaki
            // dosyadan gosteriliyor. Onceki adres serbest birakiliyor, yoksa her
            // tus vurusunda bir tane daha sizar.
            const applyLocalPhoto = function () {
                if (!fileInput || !fileInput.files || fileInput.files.length === 0) return;
                const img = box.querySelector('img');
                if (!img) return;

                if (objectUrl) URL.revokeObjectURL(objectUrl);
                objectUrl = URL.createObjectURL(fileInput.files[0]);
                img.src = objectUrl;
                img.removeAttribute('onerror');
            };

            const refresh = async function () {
                const mine = ++ticket;
                try {
                    const res = await fetch('/api/listing-preview', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest',
                            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                        },
                        body: JSON.stringify(collect())
                    });
                    const data = await res.json();
                    // Hizli yazan birinde gec gelen eski cevap yenisini ezmemeli.
                    if (mine !== ticket || !data || !data.success) return;

                    box.innerHTML = data.html;
                    applyLocalPhoto();
                } catch (err) {
                    // Onizleme bir kolaylik: alinamazsa form calismaya devam etsin.
                }
            };

            const schedule = function () {
                clearTimeout(timer);
                timer = setTimeout(refresh, 400);
            };

            form.addEventListener('input', schedule);
            form.addEventListener('change', schedule);
            refresh();
        })();


        draftBtn.addEventListener('click', async function () {
            const root = currentRoot();
            if (!root) return;

            const citySelect = document.querySelector('select[name="city"]');
            const payload = {
                rootSlug: root,
                categoryName: categorySelect.options[categorySelect.selectedIndex].text.trim(),
                cityName: citySelect && citySelect.value ? citySelect.selectedOptions[0].text.trim() : '',
                district: (document.querySelector('input[name="district"]') || {}).value || '',
                features: Array.from(document.querySelectorAll('[data-draft-feature]:checked')).map(function (el) { return el.value; })
            };

            document.querySelectorAll('[data-draft]').forEach(function (input) {
                payload[input.getAttribute('data-draft')] = input.value;
            });

            draftBtn.disabled = true;
            draftStatus.textContent = '<%= t("draft.working") %>';

            try {
                const res = await fetch('/api/listing-draft', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                    },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                if (data.draft) {
                    // Appended rather than overwriting, so a seller who already
                    // started typing does not lose what they wrote.
                    descriptionInput.value = descriptionInput.value.trim()
                        ? descriptionInput.value.trim() + '\n\n' + data.draft
                        : data.draft;
                    descriptionInput.focus();
                    draftStatus.textContent = '<%= t("draft.done") %>';
                } else {
                    draftStatus.textContent = '<%= t("draft.failed") %>';
                }
            } catch (err) {
                console.error('Draft error:', err);
                draftStatus.textContent = '<%= t("draft.failed") %>';
            } finally {
                draftBtn.disabled = false;
            }
        });
    }
});
</script>

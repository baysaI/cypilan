<div class="bg-primary text-white py-4 py-md-5 position-relative overflow-hidden">
    <div class="container position-relative z-1 text-center">
        <h1 class="fw-bold mb-2"><%= t('home.cta_button') %></h1>
        <p class="text-white-50 mb-0"><%= t('home.hero_subtitle') %></p>
    </div>
</div>

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">
            
            <% if (typeof quota !== 'undefined' && quota) { %>
                <% if (quota.isCorporate) { %>
                    <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-primary">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-start gap-3">
                                <i class="fa-solid fa-building-circle-check fs-4 text-primary mt-1"></i>
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold text-primary mb-1"><%= t('listing.corporate_unlimited_title') %></h6>
                                    <p class="text-muted small mb-0">
                                        <%= t('listing.corporate_unlimited_desc') %>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } else if (quota.isUnlimited) { %>
                    <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-success">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-start gap-3">
                                <i class="fa-solid fa-gift fs-4 text-success mt-1"></i>
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold text-success mb-1"><%= t('listing.unlimited_mode_title') %></h6>
                                    <p class="text-muted small mb-0">
                                        <%= t('listing.unlimited_mode_desc') %>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } else if (quota.limit !== null) { %>
                    <div class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-start gap-3">
                                <i class="fa-solid fa-circle-info fs-4 text-primary mt-1"></i>
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold mb-1">İlan Hakkınız</h6>
                                    <p class="text-muted small mb-2">
                                        <strong>Emlak, Vasıta ve İkinci El</strong> kategorilerinde ilk
                                        <strong><%= quota.limit %> ilan ücretsizdir.</strong>
                                        <% if (quota.remaining > 0) { %>
                                            Kalan ücretsiz hakkınız:
                                            <span class="badge bg-success rounded-pill"><%= quota.remaining %></span>
                                        <% } else { %>
                                            <span class="text-danger fw-medium">Ücretsiz hakkınızı doldurdunuz.</span>
                                            <a href="/ilan-paketleri">İlan paketlerine göz atın.</a>
                                        <% } %>
                                    </p>
                                    <p class="text-muted small mb-0">
                                        <i class="fa-solid fa-check text-success me-1"></i>
                                        <strong>Usta &amp; Hizmet</strong> ve <strong>İş İlanları</strong> kategorileri her zaman ücretsiz, sınırsız.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            <% } %>

            <form action="/listings" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate id="createListingForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold text-dark d-flex align-items-center mb-0">
                            <span class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; font-size: 0.9rem;">1</span>
                            <%= t('listing.category') %>
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <%
                            const categoryById = {};
                            if (typeof categories !== 'undefined' && Array.isArray(categories)) {
                                categories.forEach(function (cat) { categoryById[cat.id] = cat; });
                            }
                            const rootSlugOf = function (cat) {
                                const parent = cat.parent_id ? categoryById[cat.parent_id] : null;
                                return parent ? parent.slug : cat.slug;
                            };

                            let treeToRender = [];
                            if (typeof categoryTree !== 'undefined' && Array.isArray(categoryTree) && categoryTree.length > 0) {
                                treeToRender = categoryTree;
                            } else if (typeof categories !== 'undefined' && Array.isArray(categories)) {
                                const tempMap = {};
                                categories.forEach(function(c) {
                                    tempMap[c.id] = Object.assign({}, c, { children: [] });
                                });
                                categories.forEach(function(c) {
                                    if (c.parent_id && tempMap[c.parent_id]) {
                                        tempMap[c.parent_id].children.push(tempMap[c.id]);
                                    } else if (!c.parent_id) {
                                        treeToRender.push(tempMap[c.id]);
                                    }
                                });
                            }
                        %>
                        <select name="category_id" id="categorySelect" class="form-select form-select-lg bg-light border-0 shadow-none focus-ring-primary fw-medium cursor-pointer" required>
                            <option value=""><%= t('listing.all_categories') %>...</option>
                            <% treeToRender.forEach(function(mainCat) { %>
                                <% const mainName = mainCat['name_' + (typeof lang !== 'undefined' ? lang : 'tr')] || mainCat.name_tr; %>
                                <% if (mainCat.children && mainCat.children.length > 0) { %>
                                    <optgroup label="<%= mainName %>">
                                        <% mainCat.children.forEach(function(subCat) { %>
                                            <option value="<%= subCat.id %>" data-root="<%= mainCat.slug %>" <%= (typeof formData !== 'undefined' && String(formData.category_id) === String(subCat.id)) ? 'selected' : '' %>>
                                                <%= subCat['name_' + (typeof lang !== 'undefined' ? lang : 'tr')] || subCat.name_tr %>
                                            </option>
                                        <% }); %>
                                    </optgroup>
                                <% } else { %>
                                    <option value="<%= mainCat.id %>" data-root="<%= mainCat.slug %>" <%= (typeof formData !== 'undefined' && String(formData.category_id) === String(mainCat.id)) ? 'selected' : '' %>>
                                        <%= mainName %>
                                    </option>
                                <% } %>
                            <% }); %>
                        </select>
                        <div class="invalid-feedback"><%= t('flash.select_valid_category') %></div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold text-dark d-flex align-items-center mb-0">
                            <span class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; font-size: 0.9rem;">2</span>
                            <%= t('listing.title') %> & <%= t('listing.description') %>
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted d-block mb-2">
                                <i class="fa-solid fa-layer-group text-primary me-1"></i><%= t('listing.listing_purpose') || 'İlan Amacı / Türü' %> <span class="text-danger">*</span>
                            </label>
                            <div class="row g-2">
                                <div class="col-4">
                                    <input type="radio" class="btn-check" name="listing_type" id="typeSale" value="sale" <%= (!formData.listing_type || formData.listing_type === 'sale') ? 'checked' : '' %>>
                                    <label class="btn btn-outline-primary w-100 h-100 rounded-3 py-2 px-1 fw-semibold small d-flex flex-column align-items-center justify-content-center" for="typeSale">
                                        <i class="fa-solid fa-tag mb-1 fs-5"></i>
                                        <span><%= t('listing.type_sale') || 'Satılık' %></span>
                                    </label>
                                </div>
                                <div class="col-4">
                                    <input type="radio" class="btn-check" name="listing_type" id="typeRent" value="rent" <%= (formData.listing_type === 'rent') ? 'checked' : '' %>>
                                    <label class="btn btn-outline-primary w-100 h-100 rounded-3 py-2 px-1 fw-semibold small d-flex flex-column align-items-center justify-content-center" for="typeRent">
                                        <i class="fa-solid fa-key mb-1 fs-5"></i>
                                        <span><%= t('listing.type_rent') || 'Kiralık' %></span>
                                    </label>
                                </div>
                                <div class="col-4">
                                    <input type="radio" class="btn-check" name="listing_type" id="typeWanted" value="wanted" <%= (formData.listing_type === 'wanted') ? 'checked' : '' %>>
                                    <label class="btn btn-outline-warning w-100 h-100 rounded-3 py-2 px-1 fw-semibold small d-flex flex-column align-items-center justify-content-center wanted-purpose-btn" for="typeWanted">
                                        <i class="fa-solid fa-hand-holding-heart mb-1 fs-5 wanted-icon"></i>
                                        <span><%= t('listing.type_wanted') || 'Arıyorum' %></span>
                                    </label>
                                </div>
                            </div>
                            <div class="form-text small text-muted mt-2">
                                Bir ürün, ev veya araç arıyorsanız <strong>"Arıyorum"</strong> seçeneğini işaretleyerek ihtiyacınızı duyurabilirsiniz.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted"><%= t('listing.title') %> <span class="text-danger">*</span></label>
                            <input type="text" name="title" id="titleInput" class="form-control form-control-lg bg-light border-0 shadow-none focus-ring-primary" placeholder="<%= t('listing.title') %>" value="<%= typeof formData !== 'undefined' && formData.title ? formData.title : '' %>" required maxlength="70">
                            <div class="invalid-feedback"><%= t('listing.title') %> gereklidir.</div>
                            <div class="form-text small text-end" id="titleCount">0/70</div>
                        </div>

                        <div class="row g-3 mb-4" id="priceRow">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted" id="priceLabel"><%= t('listing.price') %> <span class="text-danger" id="priceRequiredStar">*</span></label>
                                <div class="input-group has-validation">
                                    <input type="number" name="price" id="priceInput" class="form-control form-control-lg bg-light border-0 shadow-none focus-ring-primary" placeholder="0" value="<%= typeof formData !== 'undefined' && typeof formData.price !== 'undefined' ? formData.price : '' %>" required min="0" step="any">
                                    <select name="currency" class="form-select bg-light border-0 shadow-none" style="max-width: 100px;">
                                        <option value="TRY" <%= (typeof formData !== 'undefined' && formData.currency === 'TRY') ? 'selected' : '' %>>₺ TRY</option>
                                        <option value="GBP" <%= (typeof formData !== 'undefined' && formData.currency === 'GBP') ? 'selected' : '' %>>£ GBP</option>
                                    </select>
                                    <div class="invalid-feedback"><%= t('listing.price') %> gereklidir.</div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="descriptionInput" class="form-label fw-bold small text-muted"><%= t('listing.description') %> <span class="text-danger">*</span></label>

                            <div class="border rounded-4 p-3 mb-3 bg-light" id="draftBox">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2 pb-2 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-layer-group text-primary"></i>
                                        <span class="fw-semibold small text-dark">İlan Özellikleri &amp; Detayları</span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-none" id="draftBtn">
                                        <i class="fa-solid fa-wand-magic-sparkles me-1"></i><%= t('draft.generate') %>
                                    </button>
                                </div>
                                <p class="text-muted small mb-3">Bu bilgileri doldurduğunuzda ilanda detay olarak gösterilir. Dilerseniz yukarıdaki butonla otomatik açıklama metni de oluşturabilirsiniz.</p>

                                <div class="row g-2 mb-3" id="draftFields"></div>

                                <div class="pt-2 border-top" id="featuresSection">
                                    <label class="form-label small fw-semibold text-muted d-block mb-2">
                                        <i class="fa-solid fa-check-double text-primary me-1"></i>Ekstra Donanım &amp; Özellikler
                                    </label>
                                    <div class="d-flex flex-wrap gap-2" id="draftFeatures"></div>
                                </div>

                                <div class="mt-2 text-end">
                                    <span class="text-muted small" id="draftStatus"></span>
                                </div>
                            </div>

                            <textarea name="description" id="descriptionInput" class="form-control bg-light border-0 shadow-none focus-ring-primary" rows="6" placeholder="<%= t('listing.description') %>" required minlength="20"><%= typeof formData !== 'undefined' && formData.description ? formData.description : '' %></textarea>
                            <div class="invalid-feedback">Lütfen en az 20 karakterlik bir açıklama giriniz.</div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold text-dark d-flex align-items-center mb-0">
                            <span class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; font-size: 0.9rem;">3</span>
                            <%= t('listing.location') %>
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted"><%= t('listing.city') %> <span class="text-danger">*</span></label>
                                <%- include('../partials/citySelect', { required: true, selectClass: 'form-select bg-light border-0 shadow-none focus-ring-primary cursor-pointer', selectedCity: (typeof formData !== 'undefined' && formData.city) ? formData.city : '' }) %>
                                <div class="invalid-feedback"><%= t('flash.select_valid_city') %></div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted"><%= t('listing.district') %></label>
                                <input type="text" name="district" class="form-control bg-light border-0 shadow-none focus-ring-primary" placeholder="<%= t('listing.district') %>" value="<%= typeof formData !== 'undefined' && formData.district ? formData.district : '' %>">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold small text-muted">İletişim Telefonu <span class="text-danger">*</span></label>
                                <input type="tel" name="phone" class="form-control bg-light border-0 shadow-none focus-ring-primary" placeholder="0533 123 4567" value="<%= (typeof formData !== 'undefined' && typeof formData.phone !== 'undefined') ? formData.phone : (typeof userPhone !== 'undefined' ? userPhone : '') %>" required>
                                <div class="invalid-feedback"><%= t('flash.listing_phone_required') %></div>
                                <div class="form-text small">Alıcılar size bu numaradan ulaşacak. Numara profilinize kaydedilir.</div>

                                <div class="form-check mt-3">
                                    <input class="form-check-input cursor-pointer" type="checkbox" name="hide_phone" value="1" id="hidePhone"
                                           <%= ((typeof formData !== 'undefined' && typeof formData.hide_phone !== 'undefined') ? Boolean(formData.hide_phone) : (typeof hidePhone !== 'undefined' && hidePhone)) ? 'checked' : '' %>>
                                    <label class="form-check-label cursor-pointer" for="hidePhone">
                                        Telefonumu ilanlarımda gösterme, sadece mesajla iletişim kurulsun
                                    </label>
                                    <div class="form-text small">
                                        Numaranız kayıtlı kalır ama alıcılara gösterilmez. Bu ayar tüm ilanlarınız için geçerlidir.
                                    </div>
                                </div>

                                <div class="form-check mt-2">
                                    <input class="form-check-input cursor-pointer" type="checkbox" name="hide_surname" value="1" id="hideSurname"
                                           <%= ((typeof formData !== 'undefined' && typeof formData.hide_surname !== 'undefined') ? Boolean(formData.hide_surname) : (typeof hideSurname !== 'undefined' ? hideSurname : true)) ? 'checked' : '' %>>
                                    <label class="form-check-label cursor-pointer" for="hideSurname">
                                        Soyadımı sitede ve ilanlarımda gizle (<%= (typeof currentUser !== 'undefined' && currentUser && currentUser.full_name) ? helpers.formatDisplayName(currentUser.full_name, false) : 'Örn: Ahmet Y.' %>)
                                    </label>
                                    <div class="form-text small">
                                        İlanlarınızda ve satıcı profilinizde soyadınızın yalnızca baş harfi gösterilir. Bu ayar profilinize kaydedilir.
                                    </div>
                                </div>

                                <div class="form-check mt-3 border rounded-4 p-3 bg-light" id="collectBidsBox" style="display: none;" hidden>
                                    <input class="form-check-input cursor-pointer" type="checkbox" name="collect_bids" value="1" id="collectBids"
                                           <%= (typeof formData !== 'undefined' && formData.collect_bids) ? 'checked' : '' %>>
                                    <label class="form-check-label cursor-pointer fw-semibold" for="collectBids">
                                        <i class="fa-solid fa-gavel text-primary me-1" id="collectBidsIcon"></i><span id="collectBidsLabel"><%= t('bids.opt_in_label') %></span>
                                    </label>
                                    <div class="form-text small mb-0" id="collectBidsHelp"><%= t('bids.opt_in_help') %></div>
                                </div>

                                <div class="mt-3">
                                    <%- include('../partials/badgePicker', {
                                        current: (typeof formData !== 'undefined' ? formData : {}),
                                        idPrefix: 'new_'
                                    }) %>
                                </div>

                                <div class="border rounded-4 p-3 mt-3 bg-light" id="jobFieldsBox" hidden>
                                    <h6 class="fw-bold mb-3">
                                        <i class="fa-solid fa-briefcase text-primary me-1"></i><%= t('career.job_details') %>
                                    </h6>

                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label for="workType" class="form-label small fw-semibold"><%= t('career.work_type') %></label>
                                            <select class="form-select" id="workType" name="work_type">
                                                <% ['full_time', 'part_time', 'contract', 'seasonal', 'internship'].forEach(function (workType) { %>
                                                    <option value="<%= workType %>" <%= (typeof formData !== 'undefined' && formData.work_type === workType) ? 'selected' : '' %>><%= t('career.work_type_' + workType) %></option>
                                                <% }); %>
                                            </select>
                                        </div>

                                        <div class="col-md-6">
                                            <label for="experienceRequired" class="form-label small fw-semibold"><%= t('career.experience_required') %></label>
                                            <input type="number" class="form-control" id="experienceRequired"
                                                   name="experience_required" min="0" max="40" value="<%= (typeof formData !== 'undefined' && typeof formData.experience_required !== 'undefined') ? formData.experience_required : 0 %>">
                                        </div>

                                        <div class="col-md-4">
                                            <label for="salaryMin" class="form-label small fw-semibold"><%= t('career.salary_min') %></label>
                                            <input type="number" class="form-control" id="salaryMin" name="salary_min" min="0" step="any" value="<%= (typeof formData !== 'undefined' && formData.salary_min) ? formData.salary_min : '' %>">
                                        </div>

                                        <div class="col-md-4">
                                            <label for="salaryMax" class="form-label small fw-semibold"><%= t('career.salary_max') %></label>
                                            <input type="number" class="form-control" id="salaryMax" name="salary_max" min="0" step="any" value="<%= (typeof formData !== 'undefined' && formData.salary_max) ? formData.salary_max : '' %>">
                                        </div>

                                        <div class="col-md-4">
                                            <label for="salaryPeriod" class="form-label small fw-semibold"><%= t('career.salary_period') %></label>
                                            <select class="form-select" id="salaryPeriod" name="salary_period">
                                                <% ['monthly', 'hourly', 'daily', 'yearly'].forEach(function (period) { %>
                                                    <option value="<%= period %>" <%= (typeof formData !== 'undefined' && formData.salary_period === period) ? 'selected' : '' %>><%= t('career.period_' + period) %></option>
                                                <% }); %>
                                            </select>
                                        </div>

                                        <div class="col-12">
                                            <label for="requiredSkills" class="form-label small fw-semibold"><%= t('career.required_skills') %></label>
                                            <input type="text" class="form-control" id="requiredSkills" name="required_skills"
                                                   maxlength="600" placeholder="<%= t('career.skills_placeholder') %>" value="<%= (typeof formData !== 'undefined' && formData.required_skills) ? formData.required_skills : '' %>">
                                            <div class="form-text small"><%= t('career.match_help') %></div>
                                        </div>

                                        <div class="col-12">
                                            <label for="requiredLanguages" class="form-label small fw-semibold"><%= t('career.required_languages') %></label>
                                            <input type="text" class="form-control" id="requiredLanguages" name="required_languages"
                                                   maxlength="300" placeholder="<%= t('career.languages_placeholder') %>" value="<%= (typeof formData !== 'undefined' && formData.required_languages) ? formData.required_languages : '' %>">
                                        </div>

                                        <div class="col-12">
                                            <label for="benefits" class="form-label small fw-semibold"><%= t('career.benefits') %></label>
                                            <textarea class="form-control" id="benefits" name="benefits" rows="2" maxlength="600"
                                                      placeholder="<%= t('career.benefits_placeholder') %>"><%= (typeof formData !== 'undefined' && formData.benefits) ? formData.benefits : '' %></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-5 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold text-dark d-flex align-items-center mb-0">
                            <span class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; font-size: 0.9rem;">4</span>
                            <%= t('listing.images') %>
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <label for="fileInput" class="w-100 border-2 border-dashed border-primary rounded-4 p-4 p-md-5 text-center bg-light cursor-pointer hover-bg-primary-light transition-all d-block position-relative mb-0" id="dropArea">
                            <div class="mb-3 d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle pointer-events-none" style="width: 68px; height: 68px;">
                                <i class="fa-solid fa-camera fs-2"></i>
                            </div>
                            <h5 class="fw-bold text-dark pointer-events-none mb-1"><%= t('listing.drag_images') %></h5>
                            <p class="text-muted small mb-3 pointer-events-none"><%= t('listing.max_images') %> (Maks. 15 MB)</p>
                            <span class="btn btn-primary rounded-pill px-4 fw-medium shadow-sm pointer-events-none"><i class="fa-solid fa-plus me-1"></i><%= t('listing.select_photos') || 'Fotoğraf Seç' %></span>
                            <input type="file" name="images" id="fileInput" multiple accept="image/jpeg,image/jpg,image/png,image/webp" class="position-absolute" style="opacity: 0; width: 0.1px; height: 0.1px; overflow: hidden; z-index: -1;">
                        </label>

                        <div class="row g-3 mt-3" id="imagePreviewContainer"></div>
                    </div>
                </div>

                <%# Reversed on phones so the primary action sits at the bottom,
                    under the thumb, and spans the full width. %>
                <div class="d-flex flex-column-reverse flex-sm-row gap-3 justify-content-sm-end mb-5">
                    <a href="/listings" class="btn btn-light btn-lg rounded-pill fw-medium px-4 hover-lift"><%= t('common.cancel') %></a>
                    <button type="submit" class="btn btn-accent btn-lg rounded-pill fw-bold px-5 text-white shadow-lg hover-lift pulse-button"><%= t('listing.post_ad') %></button>
                </div>

            </form>
        </div>
    </div>
</div>

<style>
    .border-dashed { border-style: dashed !important; }
    .pointer-events-none { pointer-events: none !important; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const dropArea = document.getElementById('dropArea');
    const fileInput = document.getElementById('fileInput');
    const previewContainer = document.getElementById('imagePreviewContainer');
    const titleInput = document.getElementById('titleInput');
    const titleCount = document.getElementById('titleCount');
    const form = document.getElementById('createListingForm');

    if (titleInput && titleCount) {
        titleCount.textContent = `${titleInput.value.length}/70`;
        titleInput.addEventListener('input', function() {
            titleCount.textContent = `${this.value.length}/70`;
        });
    }

    if (!dropArea || !fileInput || !previewContainer) return;

    let selectedFiles = [];

    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        window.addEventListener(eventName, function(e) {
            e.preventDefault();
            e.stopPropagation();
        }, false);
    });

    ['dragenter', 'dragover'].forEach(eventName => {
        dropArea.addEventListener(eventName, function() {
            dropArea.classList.add('border-accent', 'bg-primary-light');
        }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
        dropArea.addEventListener(eventName, function() {
            dropArea.classList.remove('border-accent', 'bg-primary-light');
        }, false);
    });

    dropArea.addEventListener('drop', function(e) {
        if (e.dataTransfer && e.dataTransfer.files) {
            handleNewFiles(e.dataTransfer.files);
        }
    }, false);

    dropArea.addEventListener('click', function() {
        fileInput.value = '';
    });

    fileInput.addEventListener('change', function() {
        if (this.files && this.files.length > 0) {
            handleNewFiles(this.files);
        }
    });

    function handleNewFiles(files) {
        const fileList = Array.from(files);
        const MAX_BYTES = 15 * 1024 * 1024;

        for (let i = 0; i < fileList.length; i++) {
            if (selectedFiles.length >= 20) {
                alert('<%= t("listing.max_images") %>');
                break;
            }
            const file = fileList[i];
            const isImage = (file.type && file.type.startsWith('image/')) || /\.(jpe?g|png|webp)$/i.test(file.name);
            
            if (!isImage) {
                alert('Desteklenmeyen dosya formatı: ' + file.name + '. Sadece JPG, PNG ve WEBP kabul edilir.');
                continue;
            }

            if (file.size > MAX_BYTES) {
                alert('Dosya boyutu 15 MB sınırını aşıyor: ' + file.name);
                continue;
            }

            if (!selectedFiles.some(f => f.name === file.name && f.size === file.size)) {
                selectedFiles.push(file);
            }
        }
        syncInputAndRender();
    }

    function syncInputAndRender() {
        try {
            if (window.DataTransfer) {
                const dt = new DataTransfer();
                selectedFiles.forEach(file => dt.items.add(file));
                fileInput.files = dt.files;
            }
        } catch (err) {
            console.warn('DataTransfer sync notice:', err);
        }

        renderPreviews();
    }

    function renderPreviews() {
        previewContainer.innerHTML = '';
        selectedFiles.forEach((file, index) => {
            const objectUrl = URL.createObjectURL(file);
            const col = document.createElement('div');
            col.className = 'col-6 col-sm-4 col-md-3 position-relative';
            col.innerHTML = `
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden position-relative" style="padding-top: 75%;">
                    <img src="${objectUrl}" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover" alt="Preview">
                    <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2 rounded-circle d-flex align-items-center justify-content-center p-0 remove-btn shadow-sm" style="width: 28px; height: 28px; z-index: 10;" title="Sil">
                        <i class="fa-solid fa-xmark fs-6"></i>
                    </button>
                </div>
            `;
            previewContainer.appendChild(col);

            col.querySelector('.remove-btn').addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                URL.revokeObjectURL(objectUrl);
                selectedFiles.splice(index, 1);
                syncInputAndRender();
            });
        });
    }

    if (form) {
        form.addEventListener('submit', function() {
            try {
                if (window.DataTransfer && selectedFiles.length > 0) {
                    const dt = new DataTransfer();
                    selectedFiles.forEach(file => dt.items.add(file));
                    fileInput.files = dt.files;
                }
            } catch (err) {
                console.warn('Submit sync notice:', err);
            }
        });
    }

    // Offers from registered agents and dealers only make sense for property and
    // vehicles, so the checkbox appears once such a category is chosen and is
    // cleared again if the seller switches away.
    const categorySelect = document.getElementById('categorySelect');
    const collectBidsBox = document.getElementById('collectBidsBox');
    const collectBids = document.getElementById('collectBids');

    const jobFieldsBox = document.getElementById('jobFieldsBox');

    if (categorySelect && collectBidsBox && collectBids) {
        const BID_ROOTS = ['emlak', 'vasita'];

        const syncCategoryOptions = function () {
            const option = categorySelect.options[categorySelect.selectedIndex];
            const root = option ? option.getAttribute('data-root') : null;

            const bidEligible = BID_ROOTS.indexOf(root) > -1;
            if (bidEligible) {
                collectBidsBox.hidden = false;
                collectBidsBox.style.display = 'block';
                collectBids.disabled = false;

                const labelEl = document.getElementById('collectBidsLabel');
                const helpEl = document.getElementById('collectBidsHelp');
                const iconEl = document.getElementById('collectBidsIcon');

                if (root === 'emlak') {
                    if (labelEl) labelEl.textContent = '<%= t("bids.opt_in_label_emlak") || "Emlakçılardan teklif toplansın" %>';
                    if (helpEl) helpEl.textContent = '<%= t("bids.opt_in_help_emlak") || "İlanınız kayıtlı emlak ofislerine ve danışmanlara açılır, size teklif verirler. Teklifleri karşılaştırıp dilediğinizi seçebilirsiniz." %>';
                    if (iconEl) iconEl.className = 'fa-solid fa-house-chimney-user text-primary me-1';
                } else if (root === 'vasita') {
                    if (labelEl) labelEl.textContent = '<%= t("bids.opt_in_label_vasita") || "Galericilerden teklif toplansın" %>';
                    if (helpEl) helpEl.textContent = '<%= t("bids.opt_in_help_vasita") || "İlanınız kayıtlı oto galerilerine ve yetkili alıcılara açılır, aracınıza teklif verirler. Teklifleri karşılaştırıp dilediğinizi seçebilirsiniz." %>';
                    if (iconEl) iconEl.className = 'fa-solid fa-car text-primary me-1';
                }
            } else {
                collectBidsBox.hidden = true;
                collectBidsBox.style.display = 'none';
                collectBids.checked = false;
                collectBids.disabled = true;
            }

            // Pay and requirements only make sense on a job advert.
            if (jobFieldsBox) jobFieldsBox.hidden = root !== 'is-ilanlari';

            const priceInput = document.getElementById('priceInput');
            const priceRequiredStar = document.getElementById('priceRequiredStar');
            const priceLabel = document.getElementById('priceLabel');

            // A wage is negotiated, a job quoted after a survey, and wholesale
            // priced per pallet or on request — none of the three fit one number
            // in a box, so the star comes off. The server agrees: requiresPrice
            // covers the quota categories only.
            const PRICE_OPTIONAL_ROOTS = ['is-ilanlari', 'usta-hizmetler', 'kurumsal-tedarikci'];

            if (PRICE_OPTIONAL_ROOTS.indexOf(root) > -1) {
                if (priceInput) {
                    priceInput.required = false;
                    priceInput.classList.remove('is-invalid');
                }
                if (priceRequiredStar) priceRequiredStar.hidden = true;
                if (priceLabel) priceLabel.innerHTML = (root === 'is-ilanlari' ? '<%= t("career.salary_optional") %>' : '<%= t("listing.price_optional") %>');
            } else {
                if (priceInput) priceInput.required = true;
                if (priceRequiredStar) priceRequiredStar.hidden = false;
                if (priceLabel) priceLabel.innerHTML = '<%= t("listing.price") %> <span class="text-danger" id="priceRequiredStar">*</span>';
            }

            // Filter attention badges according to category (e.g. Takaslı is not applicable for emlak)
            document.querySelectorAll('.badge-picker-item').forEach(item => {
                const excluded = JSON.parse(item.getAttribute('data-excluded-roots') || '[]');
                const shouldHide = root && excluded.includes(root);
                item.classList.toggle('d-none', shouldHide);
                if (shouldHide) {
                    const cb = item.querySelector('input[type="checkbox"]');
                    if (cb) cb.checked = false;
                }
            });
        };

        categorySelect.addEventListener('change', syncCategoryOptions);
        syncCategoryOptions();
    }

    // --- Listing Attributes & Description draft ---------------------------
    const draftBox = document.getElementById('draftBox');
    const draftFields = document.getElementById('draftFields');
    const draftFeatures = document.getElementById('draftFeatures');
    const featuresSection = document.getElementById('featuresSection');
    const draftBtn = document.getElementById('draftBtn');
    const draftStatus = document.getElementById('draftStatus');
    const descriptionInput = document.getElementById('descriptionInput');

    if (draftBox && categorySelect && descriptionInput) {
        const FIELDS = {
            emlak: [
                { name: 'rooms', label: '<%= t("draft.field_rooms") %>', placeholder: 'Örn: 3+1' },
                { name: 'size', label: '<%= t("draft.field_size") %> (m²)', placeholder: 'Örn: 120' },
                { name: 'floor', label: '<%= t("draft.field_floor") %>', placeholder: 'Örn: 2' },
                { name: 'build_year', draftKey: 'buildYear', label: '<%= t("draft.field_build_year") %>', placeholder: 'Örn: 2018' }
            ],
            vasita: [
                { name: 'brand', label: '<%= t("draft.field_brand") %>', placeholder: 'Örn: BMW' },
                { name: 'model', label: '<%= t("draft.field_model") %>', placeholder: 'Örn: 320i' },
                { name: 'year', label: '<%= t("draft.field_year") %>', placeholder: 'Örn: 2020' },
                { name: 'km', label: '<%= t("draft.field_km") %>', placeholder: 'Örn: 85000' },
                { name: 'fuel', label: '<%= t("draft.field_fuel") %>', options: ['', 'Benzin', 'Dizel', 'Hibrit', 'Elektrik', 'LPG'] },
                { name: 'gear', label: '<%= t("draft.field_gear") %>', options: ['', 'Otomatik', 'Manuel', 'Yarı Otomatik'] },
                { name: 'body_type', label: '<%= t("draft.field_body_type") %>', options: ['', 'Sedan', 'Hatchback', 'SUV', 'Coupe', 'Cabrio', 'Station Wagon', 'Pick-up', 'Minivan'] },
                { name: 'engine_power', label: '<%= t("draft.field_engine_power") %>', placeholder: 'Örn: 150 HP' },
                { name: 'engine_size', label: '<%= t("draft.field_engine_size") %>', placeholder: 'Örn: 1600 cc' },
                { name: 'drivetrain', label: '<%= t("draft.field_drivetrain") %>', options: ['', 'Önden Çekiş', 'Arkadan İtiş', '4x4 / AWD (Dört Çeker)'] },
                { name: 'color', label: '<%= t("draft.field_color") %>', placeholder: 'Örn: Beyaz' },
                { name: 'vehicle_status', label: '<%= t("draft.field_vehicle_status") %>', options: ['', 'İkinci El', 'Sıfır (0 KM)', 'Hasarsız / Boyasız', 'Boyalı / Değişenli', 'Ağır Hasar Kayıtlı'] },
                { name: 'swap', label: '<%= t("draft.field_swap") %>', options: ['', 'Hayır (Takas Yok)', 'Evet (Takasa Uygun)', 'Sadece Araçla Takas', 'Düşük Model Araçla Takas'] }
            ],
            'ikinci-el': [
                { name: 'condition', label: '<%= t("draft.field_condition") %>', options: ['', 'Sıfır / Kapalı Kutu', 'Çok Az Kullanılmış (Yeni Gibi)', 'İkinci El (Sorunsuz)', 'Kozmetik Kusurlu'] },
                { name: 'swap', label: '<%= t("draft.field_swap") %>', options: ['', 'Hayır (Takas Yok)', 'Evet (Takasa Uygun)'] }
            ]
        };

        const FEATURES = <%- JSON.stringify(draftFeatureMap) %>;
        const FEATURE_LABELS = <%- JSON.stringify(draftFeatureLabels) %>;
        const savedFormData = <%- JSON.stringify(typeof formData !== 'undefined' ? formData : {}) %>;
        const savedAttributes = savedFormData.attributes || savedFormData;

        const currentRoot = function () {
            const option = categorySelect.options[categorySelect.selectedIndex];
            return option ? option.getAttribute('data-root') : null;
        };

        const renderDraftInputs = function () {
            const root = currentRoot();
            draftFields.innerHTML = '';
            draftFeatures.innerHTML = '';

            const fields = FIELDS[root] || [];
            fields.forEach(function (field) {
                const col = document.createElement('div');
                col.className = (field.options ? 'col-12 col-sm-6 col-md-3' : 'col-6 col-md-3');
                const draftKey = field.draftKey || field.name;
                const existingVal = savedAttributes[field.name] || savedAttributes[draftKey] || '';

                let inputHtml = '';
                if (field.options) {
                    inputHtml = '<select class="form-select form-select-sm bg-white" name="' + field.name +
                        '" id="attr_' + field.name + '" data-draft="' + draftKey + '">';
                    field.options.forEach(function (opt) {
                        const optVal = opt;
                        const optLabel = opt === '' ? 'Seçiniz' : opt;
                        const isSel = String(existingVal) === String(optVal) ? 'selected' : '';
                        inputHtml += '<option value="' + optVal + '" ' + isSel + '>' + optLabel + '</option>';
                    });
                    inputHtml += '</select>';
                } else {
                    inputHtml = '<input type="text" class="form-control form-control-sm bg-white" name="' + field.name +
                        '" id="attr_' + field.name + '" data-draft="' + draftKey +
                        '" placeholder="' + (field.placeholder || '') + '" value="' + (existingVal ? String(existingVal).replace(/"/g, '&quot;') : '') + '">';
                }

                col.innerHTML = '<label class="form-label small fw-semibold text-muted mb-1" for="attr_' + field.name + '">' + field.label + '</label>' + inputHtml;
                draftFields.appendChild(col);
            });

            const feats = FEATURES[root] || [];
            if (feats.length > 0) {
                if (featuresSection) featuresSection.hidden = false;
                const savedFeats = savedAttributes.features ? (Array.isArray(savedAttributes.features) ? savedAttributes.features : String(savedAttributes.features).split(',')) : [];
                feats.forEach(function (feature) {
                    const id = 'feat_' + feature;
                    const isChecked = savedFeats.includes(feature) ? 'checked' : '';
                    const wrap = document.createElement('div');
                    wrap.className = 'form-check form-check-inline bg-white px-3 py-1 rounded-pill border';
                    wrap.innerHTML = '<input class="form-check-input cursor-pointer" type="checkbox" name="features[]" value="' + feature +
                        '" id="' + id + '" data-draft-feature="1" ' + isChecked + '>' +
                        '<label class="form-check-label small cursor-pointer ms-1" for="' + id + '">' +
                        (FEATURE_LABELS[feature] || feature) + '</label>';
                    draftFeatures.appendChild(wrap);
                });
            } else {
                if (featuresSection) featuresSection.hidden = true;
            }

            draftBox.hidden = !root || (fields.length === 0 && feats.length === 0);
        };

        categorySelect.addEventListener('change', renderDraftInputs);
        renderDraftInputs();

        draftBtn.addEventListener('click', async function () {
            const root = currentRoot();
            if (!root) return;

            const citySelect = document.querySelector('select[name="city"]');
            const payload = {
                rootSlug: root,
                categoryName: categorySelect.options[categorySelect.selectedIndex].text.trim(),
                cityName: citySelect && citySelect.value ? citySelect.selectedOptions[0].text.trim() : '',
                district: (document.querySelector('input[name="district"]') || {}).value || '',
                features: Array.from(document.querySelectorAll('[data-draft-feature]:checked')).map(function (el) { return el.value; })
            };

            document.querySelectorAll('[data-draft]').forEach(function (input) {
                payload[input.getAttribute('data-draft')] = input.value;
            });

            draftBtn.disabled = true;
            draftStatus.textContent = '<%= t("draft.working") %>';

            try {
                const res = await fetch('/api/listing-draft', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                    },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                if (data.draft) {
                    // Appended rather than overwriting, so a seller who already
                    // started typing does not lose what they wrote.
                    descriptionInput.value = descriptionInput.value.trim()
                        ? descriptionInput.value.trim() + '\n\n' + data.draft
                        : data.draft;
                    descriptionInput.focus();
                    draftStatus.textContent = '<%= t("draft.done") %>';
                } else {
                    draftStatus.textContent = '<%= t("draft.failed") %>';
                }
            } catch (err) {
                console.error('Draft error:', err);
                draftStatus.textContent = '<%= t("draft.failed") %>';
            } finally {
                draftBtn.disabled = false;
            }
        });
    }
});
</script>

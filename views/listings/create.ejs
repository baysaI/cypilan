<div class="bg-primary text-white py-4 py-md-5 position-relative overflow-hidden">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: url('/images/pattern.svg') center/cover; opacity: 0.05;"></div>
    <div class="container position-relative z-1 text-center">
        <h1 class="fw-bold mb-2"><%= t('home.cta_button') %></h1>
        <p class="text-white-50 mb-0"><%= t('home.hero_subtitle') %></p>
    </div>
</div>

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">
            
            <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
                <div class="alert alert-danger rounded-3 mb-4"><%= error %></div>
            <% } %>

            <form action="/listings" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate id="createListingForm">

                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold text-dark d-flex align-items-center mb-0">
                            <span class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; font-size: 0.9rem;">1</span>
                            <%= t('listing.category') %>
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <select name="category_id" class="form-select form-select-lg bg-light border-0 shadow-none focus-ring-primary fw-medium cursor-pointer" required>
                            <option value=""><%= t('listing.all_categories') %>...</option>
                            <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                                <% categories.forEach(function(cat) { %>
                                    <option value="<%= cat.id %>"><%= cat['name_' + (typeof lang !== 'undefined' ? lang : 'tr')] || cat.name_tr %></option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold text-dark d-flex align-items-center mb-0">
                            <span class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; font-size: 0.9rem;">2</span>
                            <%= t('listing.title') %> & <%= t('listing.description') %>
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted"><%= t('listing.title') %> <span class="text-danger">*</span></label>
                            <input type="text" name="title" id="titleInput" class="form-control form-control-lg bg-light border-0 shadow-none focus-ring-primary" placeholder="<%= t('listing.title') %>" required maxlength="70">
                            <div class="form-text small text-end" id="titleCount">0/70</div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted"><%= t('listing.price') %> <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="number" name="price" class="form-control form-control-lg bg-light border-0 shadow-none focus-ring-primary" placeholder="0" required min="0" step="any">
                                    <select name="currency" class="form-select bg-light border-0 shadow-none" style="max-width: 100px;">
                                        <option value="TRY">₺ TRY</option>
                                        <option value="GBP">£ GBP</option>
                                        <option value="EUR">€ EUR</option>
                                        <option value="USD">$ USD</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted"><%= t('listing.description') %> <span class="text-danger">*</span></label>
                            <textarea name="description" class="form-control bg-light border-0 shadow-none focus-ring-primary" rows="6" placeholder="<%= t('listing.description') %>" required></textarea>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold text-dark d-flex align-items-center mb-0">
                            <span class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; font-size: 0.9rem;">3</span>
                            <%= t('listing.location') %>
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted"><%= t('listing.city') %> <span class="text-danger">*</span></label>
                                <select name="city" class="form-select bg-light border-0 shadow-none focus-ring-primary cursor-pointer" required>
                                    <option value=""><%= t('listing.all_cities') %></option>
                                    <option value="Lefkoşa"><%= t('cities.nicosia') %></option>
                                    <option value="Girne"><%= t('cities.kyrenia') %></option>
                                    <option value="Gazimağusa"><%= t('cities.famagusta') %></option>
                                    <option value="İskele"><%= t('cities.iskele') %></option>
                                    <option value="Güzelyurt"><%= t('cities.guzelyurt') %></option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted"><%= t('listing.district') %></label>
                                <input type="text" name="district" class="form-control bg-light border-0 shadow-none focus-ring-primary" placeholder="<%= t('listing.district') %>">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-5 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold text-dark d-flex align-items-center mb-0">
                            <span class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; font-size: 0.9rem;">4</span>
                            <%= t('listing.images') %>
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <label for="fileInput" class="w-100 border-2 border-dashed border-primary rounded-4 p-5 text-center bg-light cursor-pointer hover-bg-primary-light transition-all d-block position-relative mb-0" id="dropArea">
                            <i class="fa-solid fa-cloud-arrow-up display-4 text-primary mb-3"></i>
                            <h5 class="fw-bold text-dark"><%= t('listing.drag_images') %></h5>
                            <p class="text-muted small mb-4"><%= t('listing.max_images') %></p>
                            <span class="btn btn-primary rounded-pill px-4 fw-medium shadow-sm pe-none"><%= t('nav.post_ad') %></span>
                            <input type="file" name="images" id="fileInput" multiple accept="image/jpeg,image/jpg,image/png,image/webp" style="display: none;">
                        </label>

                        <div class="row g-3 mt-3" id="imagePreviewContainer"></div>
                    </div>
                </div>

                <div class="d-flex gap-3 justify-content-end mb-5">
                    <a href="/listings" class="btn btn-light btn-lg rounded-pill fw-medium px-4 hover-lift"><%= t('common.cancel') %></a>
                    <button type="submit" class="btn btn-accent btn-lg rounded-pill fw-bold px-5 text-white shadow-lg hover-lift pulse-button"><%= t('listing.post_ad') %></button>
                </div>

            </form>
        </div>
    </div>
</div>

<style>
    .border-dashed { border-style: dashed !important; }
    .pe-none { pointer-events: none !important; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const dropArea = document.getElementById('dropArea');
    const fileInput = document.getElementById('fileInput');
    const previewContainer = document.getElementById('imagePreviewContainer');
    const titleInput = document.getElementById('titleInput');
    const titleCount = document.getElementById('titleCount');

    if (titleInput && titleCount) {
        titleInput.addEventListener('input', function() {
            titleCount.textContent = `${this.value.length}/70`;
        });
    }

    if (!dropArea || !fileInput || !previewContainer) return;

    const dt = new DataTransfer();

    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        dropArea.addEventListener(eventName, function(e) {
            e.preventDefault();
            e.stopPropagation();
        }, false);
    });

    ['dragenter', 'dragover'].forEach(eventName => {
        dropArea.addEventListener(eventName, function() {
            dropArea.classList.add('border-accent', 'bg-primary-light');
        }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
        dropArea.addEventListener(eventName, function() {
            dropArea.classList.remove('border-accent', 'bg-primary-light');
        }, false);
    });

    dropArea.addEventListener('drop', function(e) {
        const files = e.dataTransfer.files;
        addFiles(files);
    }, false);

    fileInput.addEventListener('change', function() {
        addFiles(this.files);
    });

    function addFiles(files) {
        if (!files || files.length === 0) return;

        for (let i = 0; i < files.length; i++) {
            if (dt.items.length >= 10) {
                alert('<%= t("listing.max_images") %>');
                break;
            }
            const file = files[i];
            if (file.type && file.type.startsWith('image/')) {
                dt.items.add(file);
            }
        }
        
        try {
            fileInput.files = dt.files;
        } catch (err) {
            console.error('Error assigning DataTransfer to fileInput:', err);
        }
        
        renderPreviews();
    }

    function renderPreviews() {
        previewContainer.innerHTML = '';
        const filesArray = Array.from(dt.files);
        
        filesArray.forEach((file, index) => {
            const reader = new FileReader();
            reader.onload = function(e) {
                const col = document.createElement('div');
                col.className = 'col-6 col-sm-4 col-md-3';
                col.innerHTML = `
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden position-relative group" style="padding-top: 75%;">
                        <img src="${e.target.result}" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover" alt="Preview">
                        <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2 rounded-circle d-flex align-items-center justify-content-center p-0 remove-img-btn shadow" style="width: 28px; height: 28px; z-index: 10;">
                            <i class="fa-solid fa-xmark fs-6"></i>
                        </button>
                    </div>
                `;
                previewContainer.appendChild(col);

                col.querySelector('.remove-img-btn').addEventListener('click', function(ev) {
                    ev.preventDefault();
                    ev.stopPropagation();
                    removeFile(index);
                });
            };
            reader.readAsDataURL(file);
        });
    }

    function removeFile(index) {
        const newDt = new DataTransfer();
        Array.from(dt.files).forEach((file, i) => {
            if (i !== index) newDt.items.add(file);
        });
        dt.items.clear();
        Array.from(newDt.files).forEach(file => dt.items.add(file));
        
        try {
            fileInput.files = dt.files;
        } catch (err) {
            console.error('Error setting DataTransfer files:', err);
        }

        renderPreviews();
    }
});
</script>

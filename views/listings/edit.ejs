<div class="bg-primary text-white py-4 py-md-5">
    <div class="container text-center">
        <h1 class="fw-bold mb-2"><%= t('listing.edit_ad') %></h1>
        <p class="text-white-50 mb-0 text-truncate"><%= listing.title %></p>
    </div>
</div>

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">

            <form action="/listings/<%= listing.slug %>/edit" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate id="editListingForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold text-dark mb-0"><%= t('listing.title') %> &amp; <%= t('listing.description') %></h5>
                    </div>
                    <div class="card-body p-4">

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted"><%= t('listing.title') %> <span class="text-danger">*</span></label>
                            <input type="text" name="title" id="titleInput" class="form-control form-control-lg bg-light border-0 shadow-none focus-ring-primary"
                                   value="<%= listing.title %>" required maxlength="150">
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">
                                    <%= t('listing.price') %> <% if (requiresPrice) { %><span class="text-danger">*</span><% } %>
                                </label>
                                <div class="input-group">
                                    <input type="number" name="price" class="form-control form-control-lg bg-light border-0 shadow-none focus-ring-primary"
                                           value="<%= listing.price == null ? '' : listing.price %>" min="0" step="any" <%= requiresPrice ? 'required' : '' %>>
                                    <select name="currency" class="form-select bg-light border-0 shadow-none" style="max-width: 100px;">
                                        <option value="TRY" <%= listing.currency === 'TRY' ? 'selected' : '' %>>₺ TRY</option>
                                        <option value="GBP" <%= listing.currency === 'GBP' ? 'selected' : '' %>>£ GBP</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted"><%= t('listing.status') %></label>
                                <select name="status" class="form-select form-select-lg bg-light border-0 shadow-none">
                                    <% ownerStatuses.forEach(function (value) { %>
                                        <option value="<%= value %>" <%= listing.status === value ? 'selected' : '' %>><%= t('listing.status_' + value) %></option>
                                    <% }); %>
                                </select>
                            </div>
                        </div>

                        <div class="mb-0">
                            <label class="form-label fw-bold small text-muted"><%= t('listing.description') %> <span class="text-danger">*</span></label>
                            <textarea name="description" class="form-control bg-light border-0 shadow-none focus-ring-primary" rows="6" required minlength="20"><%= listing.description || '' %></textarea>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold text-dark mb-0"><%= t('listing.location') %></h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted"><%= t('listing.city') %> <span class="text-danger">*</span></label>
                                <%- include('../partials/citySelect', { selectedCity: listing.location_city, required: true, selectClass: 'form-select bg-light border-0 shadow-none focus-ring-primary' }) %>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted"><%= t('listing.district') %></label>
                                <input type="text" name="district" class="form-control bg-light border-0 shadow-none focus-ring-primary"
                                       value="<%= listing.location_district || '' %>">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-5 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold text-dark mb-0"><%= t('listing.images') %></h5>
                    </div>
                    <div class="card-body p-4">

                        <% if (images && images.length > 0) { %>
                            <div class="mb-4">
                                <div class="fw-bold small text-muted mb-2"><%= t('listing.current_images') %></div>
                                <div class="row g-3">
                                    <% images.forEach(function (img) { %>
                                        <div class="col-6 col-sm-4 col-md-3">
                                            <div class="position-relative rounded-4 overflow-hidden bg-light" style="padding-top: 75%;">
                                                <img src="<%= img %>" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover" alt="">
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                            </div>
                        <% } %>

                        <div class="alert alert-light border small">
                            <i class="fa-solid fa-circle-info text-primary me-1"></i>
                            <%= t('listing.images_replace_help') %>
                        </div>

                        <label for="fileInput" class="w-100 border-2 border-dashed border-primary rounded-4 p-4 text-center bg-light cursor-pointer d-block position-relative mb-0" id="dropArea">
                            <i class="fa-solid fa-cloud-arrow-up fs-1 text-primary mb-2 pointer-events-none d-block"></i>
                            <h6 class="fw-bold text-dark pointer-events-none"><%= t('listing.drag_images') %></h6>
                            <p class="text-muted small mb-0 pointer-events-none"><%= t('listing.max_images') %></p>
                            <input type="file" name="images" id="fileInput" multiple accept="image/jpeg,image/jpg,image/png,image/webp" style="display: none;">
                        </label>

                        <div class="row g-3 mt-3" id="imagePreviewContainer"></div>
                    </div>
                </div>

                <div class="d-flex gap-3 justify-content-between align-items-center mb-5 flex-wrap">
                    <button type="button" class="btn btn-outline-danger rounded-pill fw-medium px-4" data-bs-toggle="modal" data-bs-target="#deleteListingModal">
                        <i class="fa-regular fa-trash-can me-2"></i><%= t('listing.delete_ad') %>
                    </button>

                    <div class="d-flex gap-2">
                        <a href="/listings/<%= listing.slug %>" class="btn btn-light btn-lg rounded-pill fw-medium px-4"><%= t('common.cancel') %></a>
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold px-5 shadow-sm"><%= t('listing.save_changes') %></button>
                    </div>
                </div>

            </form>

        </div>
    </div>
</div>

<div class="modal fade" id="deleteListingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold"><%= t('listing.delete_ad') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0"><%= t('common.confirm_delete') %></p>
                <p class="text-muted small mb-0 mt-2"><strong><%= listing.title %></strong></p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
                <form action="/listings/<%= listing.slug %>" method="POST" class="d-inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="_method" value="DELETE">
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold"><%= t('common.delete') %></button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .border-dashed { border-style: dashed !important; }
    .pointer-events-none { pointer-events: none !important; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const fileInput = document.getElementById('fileInput');
    const previewContainer = document.getElementById('imagePreviewContainer');
    const dropArea = document.getElementById('dropArea');

    if (!fileInput || !previewContainer || !dropArea) return;

    let selectedFiles = [];

    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(function (eventName) {
        window.addEventListener(eventName, function (e) {
            e.preventDefault();
            e.stopPropagation();
        }, false);
    });

    dropArea.addEventListener('drop', function (e) {
        if (e.dataTransfer && e.dataTransfer.files) handleNewFiles(e.dataTransfer.files);
    }, false);

    fileInput.addEventListener('change', function () {
        if (this.files) handleNewFiles(this.files);
    });

    function handleNewFiles(files) {
        Array.from(files).forEach(function (file) {
            if (selectedFiles.length >= 10) return;
            if (!file.type || !file.type.startsWith('image/')) return;
            if (selectedFiles.some(function (f) { return f.name === file.name && f.size === file.size; })) return;
            selectedFiles.push(file);
        });
        syncInputAndRender();
    }

    function syncInputAndRender() {
        try {
            const dt = new DataTransfer();
            selectedFiles.forEach(function (file) { dt.items.add(file); });
            fileInput.files = dt.files;
        } catch (err) {
            console.error('DataTransfer sync error:', err);
        }
        renderPreviews();
    }

    function renderPreviews() {
        previewContainer.innerHTML = '';
        selectedFiles.forEach(function (file, index) {
            const objectUrl = URL.createObjectURL(file);
            const col = document.createElement('div');
            col.className = 'col-6 col-sm-4 col-md-3';
            col.innerHTML = '<div class="card border-0 shadow-sm rounded-4 overflow-hidden position-relative" style="padding-top: 75%;">'
                + '<img src="' + objectUrl + '" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover" alt="">'
                + '<button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2 rounded-circle d-flex align-items-center justify-content-center p-0 remove-btn" style="width: 28px; height: 28px; z-index: 10;">'
                + '<i class="fa-solid fa-xmark fs-6"></i></button></div>';
            previewContainer.appendChild(col);

            col.querySelector('.remove-btn').addEventListener('click', function (e) {
                e.preventDefault();
                URL.revokeObjectURL(objectUrl);
                selectedFiles.splice(index, 1);
                syncInputAndRender();
            });
        });
    }
});
</script>

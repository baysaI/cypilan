<div class="bg-primary text-white py-4 py-md-5">
    <div class="container text-center">
        <h1 class="fw-bold mb-2"><%= t('listing.edit_ad') %></h1>
        <p class="text-white-50 mb-0 text-truncate"><%= listing.title %></p>
    </div>
</div>

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">

            <form action="/listings/<%= listing.slug %>/edit" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate id="editListingForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold text-dark mb-0"><%= t('listing.title') %> &amp; <%= t('listing.description') %></h5>
                    </div>
                    <div class="card-body p-4">

                        <% const activeRoot = typeof rootSlug !== 'undefined' ? rootSlug : ''; %>
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted d-block mb-2">
                                <i class="fa-solid fa-layer-group text-primary me-1"></i><%= t('listing.listing_purpose') || 'İlan Amacı / Türü' %> <span class="text-danger">*</span>
                            </label>
                            <div class="row g-2">
                                <% if (activeRoot === 'vasita') { %>
                                    <div class="col-6">
                                        <input type="radio" class="btn-check" name="listing_type" id="typeSale" value="sale" <%= (!listing.listing_type || listing.listing_type === 'sale') ? 'checked' : '' %>>
                                        <label class="btn btn-outline-primary w-100 h-100 rounded-3 py-2 px-1 fw-semibold small d-flex flex-column align-items-center justify-content-center" for="typeSale">
                                            <i class="fa-solid fa-car mb-1 fs-5"></i>
                                            <span><%= t('listing.type_sale') || 'Satılık' %></span>
                                        </label>
                                    </div>
                                    <div class="col-6">
                                        <input type="radio" class="btn-check" name="listing_type" id="typeRent" value="rent" <%= (listing.listing_type === 'rent') ? 'checked' : '' %>>
                                        <label class="btn btn-outline-primary w-100 h-100 rounded-3 py-2 px-1 fw-semibold small d-flex flex-column align-items-center justify-content-center" for="typeRent">
                                            <i class="fa-solid fa-key mb-1 fs-5"></i>
                                            <span><%= t('listing.type_rent') || 'Kiralık (Rent a Car)' %></span>
                                        </label>
                                    </div>
                                <% } else if (activeRoot === 'is-ilanlari') { %>
                                    <div class="col-6">
                                        <input type="radio" class="btn-check" name="listing_type" id="typeSale" value="sale" <%= (!listing.listing_type || listing.listing_type === 'sale' || listing.listing_type === 'job') ? 'checked' : '' %>>
                                        <label class="btn btn-outline-primary w-100 h-100 rounded-3 py-2 px-1 fw-semibold small d-flex flex-column align-items-center justify-content-center" for="typeSale">
                                            <i class="fa-solid fa-briefcase mb-1 fs-5"></i>
                                            <span><%= t('listing.type_job_employer') || 'Eleman Arıyorum (İşveren)' %></span>
                                        </label>
                                    </div>
                                    <div class="col-6">
                                        <input type="radio" class="btn-check" name="listing_type" id="typeWanted" value="wanted" <%= (listing.listing_type === 'wanted') ? 'checked' : '' %>>
                                        <label class="btn btn-outline-warning w-100 h-100 rounded-3 py-2 px-1 fw-semibold small d-flex flex-column align-items-center justify-content-center wanted-purpose-btn" for="typeWanted">
                                            <i class="fa-solid fa-user-tie mb-1 fs-5 wanted-icon"></i>
                                            <span><%= t('listing.type_job_seeker') || 'İş Arıyorum (Aday)' %></span>
                                        </label>
                                    </div>
                                <% } else if (activeRoot === 'usta-hizmetler' || activeRoot === 'ustalar') { %>
                                    <div class="col-6">
                                        <input type="radio" class="btn-check" name="listing_type" id="typeSale" value="sale" <%= (!listing.listing_type || listing.listing_type === 'sale' || listing.listing_type === 'service') ? 'checked' : '' %>>
                                        <label class="btn btn-outline-primary w-100 h-100 rounded-3 py-2 px-1 fw-semibold small d-flex flex-column align-items-center justify-content-center" for="typeSale">
                                            <i class="fa-solid fa-screwdriver-wrench mb-1 fs-5"></i>
                                            <span><%= t('listing.type_service_provider') || 'Hizmet Veriyorum' %></span>
                                        </label>
                                    </div>
                                    <div class="col-6">
                                        <input type="radio" class="btn-check" name="listing_type" id="typeWanted" value="wanted" <%= (listing.listing_type === 'wanted') ? 'checked' : '' %>>
                                        <label class="btn btn-outline-warning w-100 h-100 rounded-3 py-2 px-1 fw-semibold small d-flex flex-column align-items-center justify-content-center wanted-purpose-btn" for="typeWanted">
                                            <i class="fa-solid fa-hand-holding-heart mb-1 fs-5 wanted-icon"></i>
                                            <span><%= t('listing.type_service_seeker') || 'Hizmet Arıyorum' %></span>
                                        </label>
                                    </div>
                                <% } else if (activeRoot === 'ikinci-el') { %>
                                    <div class="col-4">
                                        <input type="radio" class="btn-check" name="listing_type" id="typeSale" value="sale" <%= (!listing.listing_type || listing.listing_type === 'sale') ? 'checked' : '' %>>
                                        <label class="btn btn-outline-primary w-100 h-100 rounded-3 py-2 px-1 fw-semibold small d-flex flex-column align-items-center justify-content-center" for="typeSale">
                                            <i class="fa-solid fa-tag mb-1 fs-5"></i>
                                            <span><%= t('listing.type_sale') || 'Satılık' %></span>
                                        </label>
                                    </div>
                                    <div class="col-4">
                                        <input type="radio" class="btn-check" name="listing_type" id="typeRent" value="rent" <%= (listing.listing_type === 'rent') ? 'checked' : '' %>>
                                        <label class="btn btn-outline-primary w-100 h-100 rounded-3 py-2 px-1 fw-semibold small d-flex flex-column align-items-center justify-content-center" for="typeRent">
                                            <i class="fa-solid fa-key mb-1 fs-5"></i>
                                            <span><%= t('listing.type_rent') || 'Kiralık' %></span>
                                        </label>
                                    </div>
                                    <div class="col-4">
                                        <input type="radio" class="btn-check" name="listing_type" id="typeWanted" value="wanted" <%= (listing.listing_type === 'wanted') ? 'checked' : '' %>>
                                        <label class="btn btn-outline-warning w-100 h-100 rounded-3 py-2 px-1 fw-semibold small d-flex flex-column align-items-center justify-content-center wanted-purpose-btn" for="typeWanted">
                                            <i class="fa-solid fa-hand-holding-heart mb-1 fs-5 wanted-icon"></i>
                                            <span><%= t('listing.type_wanted') || 'Arıyorum' %></span>
                                        </label>
                                    </div>
                                <% } else { %>
                                    <div class="col-4">
                                        <input type="radio" class="btn-check" name="listing_type" id="typeSale" value="sale" <%= (!listing.listing_type || listing.listing_type === 'sale') ? 'checked' : '' %>>
                                        <label class="btn btn-outline-primary w-100 h-100 rounded-3 py-2 px-1 fw-semibold small d-flex flex-column align-items-center justify-content-center" for="typeSale">
                                            <i class="fa-solid fa-tag mb-1 fs-5"></i>
                                            <span><%= t('listing.type_sale') || 'Satılık' %></span>
                                        </label>
                                    </div>
                                    <div class="col-4">
                                        <input type="radio" class="btn-check" name="listing_type" id="typeRent" value="rent" <%= (listing.listing_type === 'rent') ? 'checked' : '' %>>
                                        <label class="btn btn-outline-primary w-100 h-100 rounded-3 py-2 px-1 fw-semibold small d-flex flex-column align-items-center justify-content-center" for="typeRent">
                                            <i class="fa-solid fa-key mb-1 fs-5"></i>
                                            <span><%= t('listing.type_rent') || 'Kiralık' %></span>
                                        </label>
                                    </div>
                                    <div class="col-4">
                                        <input type="radio" class="btn-check" name="listing_type" id="typeWanted" value="wanted" <%= (listing.listing_type === 'wanted') ? 'checked' : '' %>>
                                        <label class="btn btn-outline-warning w-100 h-100 rounded-3 py-2 px-1 fw-semibold small d-flex flex-column align-items-center justify-content-center wanted-purpose-btn" for="typeWanted">
                                            <i class="fa-solid fa-hand-holding-heart mb-1 fs-5 wanted-icon"></i>
                                            <span><%= t('listing.type_wanted') || 'Arıyorum' %></span>
                                        </label>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted"><%= t('listing.title') %> <span class="text-danger">*</span></label>
                            <input type="text" name="title" id="titleInput" class="form-control form-control-lg bg-light border-0 shadow-none focus-ring-primary"
                                   value="<%= listing.title %>" required maxlength="150">
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">
                                    <%= t('listing.price') %> <% if (requiresPrice) { %><span class="text-danger">*</span><% } %>
                                </label>
                                <div class="input-group">
                                    <input type="number" name="price" class="form-control form-control-lg bg-light border-0 shadow-none focus-ring-primary"
                                           value="<%= listing.price == null ? '' : listing.price %>" min="0" step="any" <%= requiresPrice ? 'required' : '' %>>
                                    <select name="currency" class="form-select bg-light border-0 shadow-none" style="max-width: 100px;">
                                        <option value="TRY" <%= listing.currency === 'TRY' ? 'selected' : '' %>>₺ TRY</option>
                                        <option value="GBP" <%= listing.currency === 'GBP' ? 'selected' : '' %>>£ GBP</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted"><%= t('listing.status') %></label>
                                <select name="status" class="form-select form-select-lg bg-light border-0 shadow-none">
                                    <% ownerStatuses.forEach(function (value) { %>
                                        <option value="<%= value %>" <%= listing.status === value ? 'selected' : '' %>><%= t('listing.status_' + value) %></option>
                                    <% }); %>
                                </select>
                            </div>
                        </div>

                        <div class="mb-0">
                            <label class="form-label fw-bold small text-muted"><%= t('listing.description') %> <span class="text-danger">*</span></label>
                            <textarea name="description" class="form-control bg-light border-0 shadow-none focus-ring-primary" rows="6" required minlength="20"><%= listing.description || '' %></textarea>
                        </div>
                    </div>
                </div>

                <%
                    const attrs = (listing && listing.attributes) || {};
                    const isEmlak = listing.category_id && (listing.category_id === 1 || (listing.category_id >= 101 && listing.category_id <= 109));
                    const isVasita = listing.category_id && (listing.category_id === 2 || (listing.category_id >= 201 && listing.category_id <= 205));
                %>

                <% if (isEmlak || isVasita) { %>
                    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                            <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-layer-group text-primary me-2"></i><%= t('listing.attributes') %></h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <% if (isEmlak) { %>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label small fw-semibold text-muted mb-1"><%= t('draft.field_rooms') %></label>
                                        <input type="text" class="form-control bg-light border-0 shadow-none" name="rooms" value="<%= attrs.rooms || '' %>" placeholder="3+1">
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label small fw-semibold text-muted mb-1"><%= t('draft.field_size') %> (m²)</label>
                                        <input type="text" class="form-control bg-light border-0 shadow-none" name="size" value="<%= attrs.size || '' %>" placeholder="120">
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label small fw-semibold text-muted mb-1"><%= t('draft.field_floor') %></label>
                                        <input type="text" class="form-control bg-light border-0 shadow-none" name="floor" value="<%= attrs.floor || '' %>" placeholder="2">
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label small fw-semibold text-muted mb-1"><%= t('draft.field_build_year') %></label>
                                        <input type="text" class="form-control bg-light border-0 shadow-none" name="build_year" value="<%= attrs.build_year || attrs.buildYear || '' %>" placeholder="2018">
                                    </div>
                                <% } else if (isVasita) { %>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label small fw-semibold text-muted mb-1"><%= t('draft.field_brand') %></label>
                                        <input type="text" class="form-control bg-light border-0 shadow-none" name="brand" value="<%= attrs.brand || '' %>" placeholder="BMW">
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label small fw-semibold text-muted mb-1"><%= t('draft.field_model') %></label>
                                        <input type="text" class="form-control bg-light border-0 shadow-none" name="model" value="<%= attrs.model || '' %>" placeholder="320i">
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label small fw-semibold text-muted mb-1"><%= t('draft.field_year') %></label>
                                        <input type="text" class="form-control bg-light border-0 shadow-none" name="year" value="<%= attrs.year || '' %>" placeholder="2020">
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label small fw-semibold text-muted mb-1"><%= t('draft.field_km') %></label>
                                        <input type="text" class="form-control bg-light border-0 shadow-none" name="km" value="<%= attrs.km || '' %>" placeholder="85000">
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-3">
                                        <label class="form-label small fw-semibold text-muted mb-1"><%= t('draft.field_fuel') %></label>
                                        <select class="form-select form-select-sm bg-light border-0 shadow-none" name="fuel">
                                            <option value="">Seçiniz</option>
                                            <% ['Benzin', 'Dizel', 'Hibrit', 'Elektrik', 'LPG'].forEach(function(f) { %>
                                                <option value="<%= f %>" <%= (attrs.fuel === f) ? 'selected' : '' %>><%= f %></option>
                                            <% }); %>
                                        </select>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-3">
                                        <label class="form-label small fw-semibold text-muted mb-1"><%= t('draft.field_gear') %></label>
                                        <select class="form-select form-select-sm bg-light border-0 shadow-none" name="gear">
                                            <option value="">Seçiniz</option>
                                            <% ['Otomatik', 'Manuel', 'Yarı Otomatik'].forEach(function(g) { %>
                                                <option value="<%= g %>" <%= (attrs.gear === g) ? 'selected' : '' %>><%= g %></option>
                                            <% }); %>
                                        </select>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-3">
                                        <label class="form-label small fw-semibold text-muted mb-1"><%= t('draft.field_body_type') %></label>
                                        <select class="form-select form-select-sm bg-light border-0 shadow-none" name="body_type">
                                            <option value="">Seçiniz</option>
                                            <% ['Sedan', 'Hatchback', 'SUV', 'Coupe', 'Cabrio', 'Station Wagon', 'Pick-up', 'Minivan'].forEach(function(bt) { %>
                                                <option value="<%= bt %>" <%= (attrs.body_type === bt) ? 'selected' : '' %>><%= bt %></option>
                                            <% }); %>
                                        </select>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label small fw-semibold text-muted mb-1"><%= t('draft.field_engine_power') %></label>
                                        <input type="text" class="form-control bg-light border-0 shadow-none" name="engine_power" value="<%= attrs.engine_power || '' %>" placeholder="150 HP">
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label small fw-semibold text-muted mb-1"><%= t('draft.field_engine_size') %></label>
                                        <input type="text" class="form-control bg-light border-0 shadow-none" name="engine_size" value="<%= attrs.engine_size || '' %>" placeholder="1600 cc">
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-3">
                                        <label class="form-label small fw-semibold text-muted mb-1"><%= t('draft.field_drivetrain') %></label>
                                        <select class="form-select form-select-sm bg-light border-0 shadow-none" name="drivetrain">
                                            <option value="">Seçiniz</option>
                                            <% ['Önden Çekiş', 'Arkadan İtiş', '4x4 / AWD (Dört Çeker)'].forEach(function(dt) { %>
                                                <option value="<%= dt %>" <%= (attrs.drivetrain === dt) ? 'selected' : '' %>><%= dt %></option>
                                            <% }); %>
                                        </select>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label small fw-semibold text-muted mb-1"><%= t('draft.field_color') %></label>
                                        <input type="text" class="form-control bg-light border-0 shadow-none" name="color" value="<%= attrs.color || '' %>" placeholder="Beyaz">
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-3">
                                        <label class="form-label small fw-semibold text-muted mb-1"><%= t('draft.field_vehicle_status') %></label>
                                        <select class="form-select form-select-sm bg-light border-0 shadow-none" name="vehicle_status">
                                            <option value="">Seçiniz</option>
                                            <% ['İkinci El', 'Sıfır (0 KM)', 'Hasarsız / Boyasız', 'Boyalı / Değişenli', 'Ağır Hasar Kayıtlı'].forEach(function(vs) { %>
                                                <option value="<%= vs %>" <%= (attrs.vehicle_status === vs) ? 'selected' : '' %>><%= vs %></option>
                                            <% }); %>
                                        </select>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-3">
                                        <label class="form-label small fw-semibold text-muted mb-1"><%= t('draft.field_swap') %></label>
                                        <select class="form-select form-select-sm bg-light border-0 shadow-none" name="swap">
                                            <option value="">Seçiniz</option>
                                            <% ['Hayır (Takas Yok)', 'Evet (Takasa Uygun)', 'Sadece Araçla Takas', 'Düşük Model Araçla Takas'].forEach(function(sw) { %>
                                                <option value="<%= sw %>" <%= (attrs.swap === sw) ? 'selected' : '' %>><%= sw %></option>
                                            <% }); %>
                                        </select>
                                    </div>
                                <% } %>
                            </div>

                            <%
                                const featMap = typeof draftFeatureMap !== 'undefined' ? draftFeatureMap : {};
                                const featLabels = typeof draftFeatureLabels !== 'undefined' ? draftFeatureLabels : {};
                                const categoryRoot = isEmlak ? 'emlak' : 'vasita';
                                const availableFeats = featMap[categoryRoot] || [];
                                const selectedFeats = attrs.features ? (Array.isArray(attrs.features) ? attrs.features : String(attrs.features).split(',')).map(s => s.trim()) : [];
                            %>
                            <% if (availableFeats.length > 0) { %>
                                <div class="pt-3 border-top mt-3">
                                    <label class="form-label small fw-bold text-muted d-block mb-2">Öne Çıkan Özellikler &amp; Donanım</label>
                                    <div class="d-flex flex-wrap gap-2">
                                        <% availableFeats.forEach(function (feature) { %>
                                            <div class="form-check form-check-inline bg-light px-3 py-1 rounded-pill border">
                                                <input class="form-check-input cursor-pointer" type="checkbox" name="features[]" value="<%= feature %>"
                                                       id="edit_feat_<%= feature %>" <%= selectedFeats.includes(feature) ? 'checked' : '' %>>
                                                <label class="form-check-label small cursor-pointer ms-1" for="edit_feat_<%= feature %>">
                                                    <%= featLabels[feature] || feature %>
                                                </label>
                                            </div>
                                        <% }); %>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% } %>

                <% const hideBadgesInEdit = (activeRoot === 'is-ilanlari' || activeRoot === 'usta-hizmetler' || activeRoot === 'ustalar' || listing.listing_type === 'job' || listing.listing_type === 'service'); %>
                <% if (!hideBadgesInEdit) { %>
                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" id="badgePickerCard">
                    <div class="card-body p-4">
                        <%- include('../partials/badgePicker', {
                            current: listing,
                            idPrefix: 'edit_',
                            categoryRoot: isEmlak ? 'emlak' : (isVasita ? 'vasita' : (listing.category_slug || ''))
                        }) %>
                    </div>
                </div>
                <% } %>

                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold text-dark mb-0"><%= t('listing.location') %></h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted"><%= t('listing.city') %> <span class="text-danger">*</span></label>
                                <%- include('../partials/citySelect', { selectedCity: listing.location_city, required: true, selectClass: 'form-select bg-light border-0 shadow-none focus-ring-primary' }) %>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted"><%= t('listing.district') %></label>
                                <input type="text" name="district" class="form-control bg-light border-0 shadow-none focus-ring-primary"
                                       value="<%= listing.location_district || '' %>">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-5 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold text-dark mb-0"><%= t('listing.images') %></h5>
                    </div>
                    <div class="card-body p-4">

                        <% if (images && images.length > 0) { %>
                            <div class="mb-4">
                                <div class="fw-bold small text-muted mb-2"><%= t('listing.current_images') %></div>
                                <div class="row g-3">
                                    <% images.forEach(function (img) { %>
                                        <div class="col-6 col-sm-4 col-md-3">
                                            <div class="position-relative rounded-4 overflow-hidden bg-light" style="padding-top: 75%;">
                                                <img src="<%= img %>" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover" alt="">
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                            </div>
                        <% } %>

                        <div class="alert alert-light border small">
                            <i class="fa-solid fa-circle-info text-primary me-1"></i>
                            <%= t('listing.images_replace_help') %>
                        </div>

                        <label for="fileInput" class="w-100 border-2 border-dashed border-primary rounded-4 p-4 text-center bg-light cursor-pointer d-block position-relative mb-0" id="dropArea">
                            <div class="mb-2 d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle pointer-events-none" style="width: 56px; height: 56px;">
                                <i class="fa-solid fa-camera fs-3"></i>
                            </div>
                            <h6 class="fw-bold text-dark pointer-events-none mb-1"><%= t('listing.drag_images') %></h6>
                            <p class="text-muted small mb-0 pointer-events-none"><%= t('listing.max_images') %> (Maks. 15 MB)</p>
                            <input type="file" name="images" id="fileInput" multiple accept="image/jpeg,image/jpg,image/png,image/webp" class="position-absolute" style="opacity: 0; width: 0.1px; height: 0.1px; overflow: hidden; z-index: -1;">
                        </label>

                        <div class="row g-3 mt-3" id="imagePreviewContainer"></div>
                    </div>
                </div>

                <div class="d-flex gap-3 justify-content-between align-items-center mb-5 flex-wrap">
                    <button type="button" class="btn btn-outline-danger rounded-pill fw-medium px-4" data-bs-toggle="modal" data-bs-target="#deleteListingModal">
                        <i class="fa-regular fa-trash-can me-2"></i><%= t('listing.delete_ad') %>
                    </button>

                    <div class="d-flex flex-column-reverse flex-sm-row gap-2 flex-grow-1 justify-content-sm-end">
                        <a href="/listings/<%= listing.slug %>" class="btn btn-light btn-lg rounded-pill fw-medium px-4"><%= t('common.cancel') %></a>
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold px-5 shadow-sm"><%= t('listing.save_changes') %></button>
                    </div>
                </div>

            </form>

        </div>
    </div>
</div>

<div class="modal fade" id="deleteListingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold"><%= t('listing.delete_ad') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0"><%= t('common.confirm_delete') %></p>
                <p class="text-muted small mb-0 mt-2"><strong><%= listing.title %></strong></p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
                <form action="/listings/<%= listing.slug %>" method="POST" class="d-inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="_method" value="DELETE">
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold"><%= t('common.delete') %></button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .border-dashed { border-style: dashed !important; }
    .pointer-events-none { pointer-events: none !important; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const fileInput = document.getElementById('fileInput');
    const previewContainer = document.getElementById('imagePreviewContainer');
    const dropArea = document.getElementById('dropArea');
    const form = document.getElementById('editListingForm');

    if (!fileInput || !previewContainer || !dropArea) return;

    let selectedFiles = [];

    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(function (eventName) {
        window.addEventListener(eventName, function (e) {
            e.preventDefault();
            e.stopPropagation();
        }, false);
    });

    dropArea.addEventListener('drop', function (e) {
        if (e.dataTransfer && e.dataTransfer.files) handleNewFiles(e.dataTransfer.files);
    }, false);

    dropArea.addEventListener('click', function() {
        fileInput.value = '';
    });

    fileInput.addEventListener('change', function () {
        if (this.files && this.files.length > 0) handleNewFiles(this.files);
    });

    function handleNewFiles(files) {
        const MAX_BYTES = 15 * 1024 * 1024;
        Array.from(files).forEach(function (file) {
            if (selectedFiles.length >= 20) return;
            const isImage = (file.type && file.type.startsWith('image/')) || /\.(jpe?g|png|webp)$/i.test(file.name);
            if (!isImage) {
                alert('Desteklenmeyen dosya formatı: ' + file.name);
                return;
            }
            if (file.size > MAX_BYTES) {
                alert('Dosya boyutu 15 MB sınırını aşıyor: ' + file.name);
                return;
            }
            if (selectedFiles.some(function (f) { return f.name === file.name && f.size === file.size; })) return;
            selectedFiles.push(file);
        });
        syncInputAndRender();
    }

    function syncInputAndRender() {
        try {
            if (window.DataTransfer) {
                const dt = new DataTransfer();
                selectedFiles.forEach(function (file) { dt.items.add(file); });
                fileInput.files = dt.files;
            }
        } catch (err) {
            console.warn('DataTransfer sync notice:', err);
        }
        renderPreviews();
    }

    function renderPreviews() {
        previewContainer.innerHTML = '';
        selectedFiles.forEach(function (file, index) {
            const objectUrl = URL.createObjectURL(file);
            const col = document.createElement('div');
            col.className = 'col-6 col-sm-4 col-md-3';
            col.innerHTML = '<div class="card border-0 shadow-sm rounded-4 overflow-hidden position-relative" style="padding-top: 75%;">'
                + '<img src="' + objectUrl + '" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover" alt="">'
                + '<button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2 rounded-circle d-flex align-items-center justify-content-center p-0 remove-btn" style="width: 28px; height: 28px; z-index: 10;">'
                + '<i class="fa-solid fa-xmark fs-6"></i></button></div>';
            previewContainer.appendChild(col);

            col.querySelector('.remove-btn').addEventListener('click', function (e) {
                e.preventDefault();
                URL.revokeObjectURL(objectUrl);
                selectedFiles.splice(index, 1);
                syncInputAndRender();
            });
        });
    }

    if (form) {
        form.addEventListener('submit', function() {
            try {
                if (window.DataTransfer && selectedFiles.length > 0) {
                    const dt = new DataTransfer();
                    selectedFiles.forEach(file => dt.items.add(file));
                    fileInput.files = dt.files;
                }
            } catch (err) {
                console.warn('Submit sync notice:', err);
            }
        });
    }
});
</script>

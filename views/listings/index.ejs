<div class="container py-4 py-md-5">

    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted hover-text-primary"><i class="fa-solid fa-house small"></i> <%= t('nav.home') %></a></li>
            <% if (currentCategoryName) { %>
                <li class="breadcrumb-item"><a href="/listings" class="text-decoration-none text-muted hover-text-primary"><%= t('listing.all_categories') %></a></li>
                <li class="breadcrumb-item active fw-bold text-primary" aria-current="page"><%= currentCategoryName %></li>
            <% } else { %>
                <li class="breadcrumb-item active fw-medium" aria-current="page"><%= t('listing.all_categories') %></li>
            <% } %>
        </ol>
    </nav>

    <% if (typeof smartQuery !== 'undefined' && smartQuery && smartParsed) { %>
        <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-primary">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <i class="fa-solid fa-wand-magic-sparkles text-primary"></i>
                    <span class="fw-bold"><%= t('smart.understood') %></span>
                    <span class="text-muted small">"<%= smartQuery %>"</span>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <% if (smartParsed.filters.city) { %>
                        <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis border border-primary-subtle">
                            <i class="fa-solid fa-location-dot me-1"></i><%= helpers.getCityName(smartParsed.filters.city, lang) %>
                        </span>
                    <% } %>
                    <% if (smartParsed.filters.rooms) { %>
                        <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis border border-primary-subtle">
                            <i class="fa-solid fa-door-open me-1"></i><%= smartParsed.filters.rooms %>
                        </span>
                    <% } %>
                    <% if (smartParsed.filters.maxPrice) { %>
                        <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis border border-primary-subtle">
                            <i class="fa-solid fa-wallet me-1"></i><%= t('smart.up_to') %>
                            <%= helpers.formatPrice(smartParsed.filters.maxPrice, smartParsed.filters.currency || 'TRY', currency) %>
                        </span>
                    <% } %>
                    <% if (smartParsed.filters.minPrice) { %>
                        <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis border border-primary-subtle">
                            <i class="fa-solid fa-arrow-up me-1"></i><%= t('smart.from') %>
                            <%= helpers.formatPrice(smartParsed.filters.minPrice, smartParsed.filters.currency || 'TRY', currency) %>
                        </span>
                    <% } %>
                    <% if (smartParsed.leftover) { %>
                        <span class="badge rounded-pill bg-light text-muted border">
                            <i class="fa-solid fa-magnifying-glass me-1"></i><%= smartParsed.leftover %>
                        </span>
                    <% } %>
                </div>

                <a href="/listings?q=<%= encodeURIComponent(smartParsed.leftover || smartQuery) %>"
                   class="small text-decoration-none d-inline-block mt-2">
                    <%= t('smart.plain_search') %>
                </a>
            </div>
        </div>
    <% } %>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                <h1 class="fs-3 fw-bold mb-0"><%= typeof currentCategoryName !== 'undefined' && currentCategoryName ? currentCategoryName : t('listing.all_categories') %></h1>
                <% if (currentCategoryName) { %>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 small fw-bold">
                        <i class="fa-solid fa-folder-open me-1"></i><%= currentCategoryName %>
                    </span>
                    <a href="/listings" class="badge bg-light text-muted border rounded-pill px-2 py-1 text-decoration-none hover-text-danger" title="<%= t('listing.clear_filters') %>">
                        <i class="fa-solid fa-xmark me-1"></i>Kategoriyi Temizle
                    </a>
                <% } %>
            </div>
            <p class="text-muted small mb-0"><%= t('common.all') %> <span class="fw-bold text-primary"><%= pagination.totalItems || (listings ? listings.length : 0) %></span> <%= t('listing.total_found') %></p>
        </div>
        <div class="d-flex gap-2">
            <%# Harita ayri bir kategori degil, emlagin bir gorunumu. Bu yuzden
                menude kendi basligi yok; buradan, emlak listesinin ustunden
                giriliyor ve haritadaki "Liste gorunumu" dugmesi buraya donuyor. %>
            <% if (typeof currentRootSlug !== 'undefined' && currentRootSlug === 'emlak') { %>
                <a href="/listings/harita" class="btn btn-outline-primary d-flex align-items-center gap-2">
                    <i class="fa-solid fa-map-location-dot"></i>
                    <span class="d-none d-sm-inline"><%= t('map.view_map') %></span>
                </a>
            <% } %>
            <button class="btn btn-outline-primary d-lg-none flex-fill" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas">
                <i class="fa-solid fa-filter me-2"></i> <%= t('listing.filters') %>
            </button>
            <div class="dropdown">
                <button class="btn btn-light border dropdown-toggle bg-white shadow-sm" type="button" data-bs-toggle="dropdown">
                    <i class="fa-solid fa-arrow-down-short-wide text-muted me-2"></i> <%= t('listing.sort_by') %>
                </button>
                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg">
                    <li><a class="dropdown-item" href="?sort=newest"><%= t('listing.newest') %></a></li>
                    <li><a class="dropdown-item" href="?sort=price_asc"><%= t('listing.price_asc') %></a></li>
                    <li><a class="dropdown-item" href="?sort=price_desc"><%= t('listing.price_desc') %></a></li>
                </ul>
            </div>
        </div>
    </div>

    <%
        const currentType = filters.type || filters.listing_type || '';
        const rootCategory = typeof currentRootSlug !== 'undefined' ? currentRootSlug : (filters.category ? filters.category : null);
        function buildTypeUrl(tVal) {
            const params = new URLSearchParams();
            if (filters.q) params.set('q', filters.q);
            if (filters.category) params.set('category', filters.category);
            if (filters.city) params.set('city', filters.city);
            if (filters.minPrice) params.set('minPrice', filters.minPrice);
            if (filters.maxPrice) params.set('maxPrice', filters.maxPrice);
            if (filters.currency) params.set('currency', filters.currency);
            if (filters.sort) params.set('sort', filters.sort);
            if (filters.badge) params.set('badge', filters.badge);
            if (tVal) params.set('type', tVal);
            const qs = params.toString();
            return qs ? '/listings?' + qs : '/listings';
        }
    %>
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a href="<%= buildTypeUrl('') %>" class="btn btn-sm cyp-type-pill rounded-pill px-3 py-2 <%= !currentType ? 'active' : '' %>">
            <i class="fa-solid fa-list-ul me-1"></i> <%= t('common.all') || 'Tümü' %>
        </a>

        <% if (rootCategory === 'emlak') { %>
            <a href="<%= buildTypeUrl('sale') %>" class="btn btn-sm cyp-type-pill rounded-pill px-3 py-2 <%= currentType === 'sale' ? 'active' : '' %>">
                <i class="fa-solid fa-tag me-1 <%= currentType === 'sale' ? 'text-white' : 'text-primary' %>"></i> <%= t('listing.type_sale') || 'Satılık' %>
            </a>
            <a href="<%= buildTypeUrl('rent') %>" class="btn btn-sm cyp-type-pill rounded-pill px-3 py-2 <%= currentType === 'rent' ? 'active' : '' %>">
                <i class="fa-solid fa-key me-1 <%= currentType === 'rent' ? 'text-white' : 'text-primary' %>"></i> <%= t('listing.type_rent') || 'Kiralık' %>
            </a>
            <a href="<%= buildTypeUrl('wanted') %>" class="btn btn-sm cyp-type-pill pill-wanted rounded-pill px-3 py-2 <%= currentType === 'wanted' ? 'active' : '' %>">
                <i class="fa-solid fa-hand-holding-heart me-1 text-warning"></i> <%= t('listing.type_wanted') || '📢 Arıyorum (Talepler)' %>
            </a>
        <% } else if (rootCategory === 'vasita') { %>
            <a href="<%= buildTypeUrl('sale') %>" class="btn btn-sm cyp-type-pill rounded-pill px-3 py-2 <%= currentType === 'sale' ? 'active' : '' %>">
                <i class="fa-solid fa-car me-1 <%= currentType === 'sale' ? 'text-white' : 'text-primary' %>"></i> <%= t('listing.type_sale') || 'Satılık' %>
            </a>
            <a href="<%= buildTypeUrl('rent') %>" class="btn btn-sm cyp-type-pill rounded-pill px-3 py-2 <%= currentType === 'rent' ? 'active' : '' %>">
                <i class="fa-solid fa-key me-1 <%= currentType === 'rent' ? 'text-white' : 'text-primary' %>"></i> <%= t('listing.type_rent') || 'Kiralık (Rent a Car)' %>
            </a>
        <% } else if (rootCategory === 'is-ilanlari') { %>
            <a href="<%= buildTypeUrl('job') %>" class="btn btn-sm cyp-type-pill rounded-pill px-3 py-2 <%= (currentType === 'job' || currentType === 'sale') ? 'active' : '' %>">
                <i class="fa-solid fa-briefcase me-1 <%= (currentType === 'job' || currentType === 'sale') ? 'text-white' : 'text-primary' %>"></i> <%= t('listing.type_job_employer') || 'Eleman Arayanlar' %>
            </a>
            <a href="<%= buildTypeUrl('wanted') %>" class="btn btn-sm cyp-type-pill pill-wanted rounded-pill px-3 py-2 <%= currentType === 'wanted' ? 'active' : '' %>">
                <i class="fa-solid fa-user-tie me-1 text-warning"></i> <%= t('listing.type_job_seeker') || 'İş Arayanlar' %>
            </a>
        <% } else if (rootCategory === 'usta-hizmetler' || rootCategory === 'ustalar') { %>
            <a href="<%= buildTypeUrl('service') %>" class="btn btn-sm cyp-type-pill rounded-pill px-3 py-2 <%= (currentType === 'service' || currentType === 'sale') ? 'active' : '' %>">
                <i class="fa-solid fa-screwdriver-wrench me-1 <%= (currentType === 'service' || currentType === 'sale') ? 'text-white' : 'text-primary' %>"></i> <%= t('listing.type_service_provider') || 'Hizmet Verenler' %>
            </a>
            <a href="<%= buildTypeUrl('wanted') %>" class="btn btn-sm cyp-type-pill pill-wanted rounded-pill px-3 py-2 <%= currentType === 'wanted' ? 'active' : '' %>">
                <i class="fa-solid fa-hand-holding-heart me-1 text-warning"></i> <%= t('listing.type_service_seeker') || 'Hizmet Arayanlar' %>
            </a>
        <% } else if (rootCategory === 'ikinci-el') { %>
            <a href="<%= buildTypeUrl('sale') %>" class="btn btn-sm cyp-type-pill rounded-pill px-3 py-2 <%= currentType === 'sale' ? 'active' : '' %>">
                <i class="fa-solid fa-tag me-1 <%= currentType === 'sale' ? 'text-white' : 'text-primary' %>"></i> <%= t('listing.type_sale') || 'Satılık' %>
            </a>
            <a href="<%= buildTypeUrl('rent') %>" class="btn btn-sm cyp-type-pill rounded-pill px-3 py-2 <%= currentType === 'rent' ? 'active' : '' %>">
                <i class="fa-solid fa-key me-1 <%= currentType === 'rent' ? 'text-white' : 'text-primary' %>"></i> <%= t('listing.type_rent') || 'Kiralık' %>
            </a>
            <a href="<%= buildTypeUrl('wanted') %>" class="btn btn-sm cyp-type-pill pill-wanted rounded-pill px-3 py-2 <%= currentType === 'wanted' ? 'active' : '' %>">
                <i class="fa-solid fa-hand-holding-heart me-1 text-warning"></i> <%= t('listing.type_wanted') || '📢 Arıyorum (Talepler)' %>
            </a>
        <% } else if (rootCategory === 'kurumsal-tedarikci') { %>
            <a href="<%= buildTypeUrl('service') %>" class="btn btn-sm cyp-type-pill rounded-pill px-3 py-2 <%= (currentType === 'service' || currentType === 'sale') ? 'active' : '' %>">
                <i class="fa-solid fa-truck-field me-1 <%= (currentType === 'service' || currentType === 'sale') ? 'text-white' : 'text-primary' %>"></i> <%= t('listing.type_supplier') || 'Tedarikçiler' %>
            </a>
            <a href="<%= buildTypeUrl('wanted') %>" class="btn btn-sm cyp-type-pill pill-wanted rounded-pill px-3 py-2 <%= currentType === 'wanted' ? 'active' : '' %>">
                <i class="fa-solid fa-hand-holding-heart me-1 text-warning"></i> <%= t('listing.type_supply_request') || 'Alım Talepleri' %>
            </a>
        <% } else { %>
            <a href="<%= buildTypeUrl('sale') %>" class="btn btn-sm cyp-type-pill rounded-pill px-3 py-2 <%= currentType === 'sale' ? 'active' : '' %>">
                <i class="fa-solid fa-tag me-1 <%= currentType === 'sale' ? 'text-white' : 'text-primary' %>"></i> <%= t('listing.type_sale') || 'Satılık' %>
            </a>
            <a href="<%= buildTypeUrl('rent') %>" class="btn btn-sm cyp-type-pill rounded-pill px-3 py-2 <%= currentType === 'rent' ? 'active' : '' %>">
                <i class="fa-solid fa-key me-1 <%= currentType === 'rent' ? 'text-white' : 'text-primary' %>"></i> <%= t('listing.type_rent') || 'Kiralık' %>
            </a>
            <a href="<%= buildTypeUrl('wanted') %>" class="btn btn-sm cyp-type-pill pill-wanted rounded-pill px-3 py-2 <%= currentType === 'wanted' ? 'active' : '' %>">
                <i class="fa-solid fa-hand-holding-heart me-1 text-warning"></i> <%= t('listing.type_wanted') || '📢 Arıyorum (Talepler)' %>
            </a>
        <% } %>
    </div>

    <div class="row g-4">
        <aside class="col-lg-3 d-none d-lg-block">
            <div class="card border-0 shadow-sm rounded-4 sticky-below-header">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 d-flex align-items-center">
                        <i class="fa-solid fa-sliders text-primary me-2"></i> <%= t('listing.filters') %>
                    </h5>
                    
                    <form action="/listings" method="GET">
                        <% if (filters.type) { %>
                            <input type="hidden" name="type" value="<%= filters.type %>">
                        <% } %>
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted text-uppercase letter-spacing-1"><%= t('common.search') %></label>
                            <div class="input-group">
                                <input type="text" name="q" class="form-control bg-light border-0 shadow-none" placeholder="<%= t('home.search_placeholder') %>" value="<%= filters.q || '' %>">
                                <% if (filters.q) { %>
                                    <a href="/listings" class="btn btn-light border-0 text-muted" title="Temizle"><i class="fa-solid fa-xmark"></i></a>
                                <% } %>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-bold small text-muted text-uppercase letter-spacing-1 mb-0"><%= t('listing.category') %></label>
                                <% if (filters.category) { %>
                                    <a href="<%= buildTypeUrl('') %>" class="small text-primary text-decoration-none fw-semibold">Tümü</a>
                                <% } %>
                            </div>
                            <div class="cyp-category-list">
                                <%
                                    function makeCatUrl(cSlug) {
                                        const p = new URLSearchParams();
                                        if (filters.q) p.set('q', filters.q);
                                        if (cSlug) p.set('category', cSlug);
                                        if (filters.city) p.set('city', filters.city);
                                        if (filters.minPrice) p.set('minPrice', filters.minPrice);
                                        if (filters.maxPrice) p.set('maxPrice', filters.maxPrice);
                                        if (filters.currency) p.set('currency', filters.currency);
                                        if (filters.sort) p.set('sort', filters.sort);
                                        if (filters.badge) p.set('badge', filters.badge);
                                        if (filters.type) p.set('type', filters.type);
                                        return '/listings?' + p.toString();
                                    }
                                %>
                                <a href="<%= makeCatUrl('') %>" class="cyp-category-item <%= !filters.category ? 'active' : '' %>">
                                    <span class="d-flex align-items-center"><i class="fa-solid fa-border-all me-2"></i><%= t('listing.all_categories') %></span>
                                </a>
                                <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                                    <% categories.forEach(function(cat) { %>
                                        <%
                                            const isCatActive = (filters.category === cat.slug || (cat.slug === 'usta-hizmetler' && filters.category === 'ustalar'));
                                            const catName = cat['name_' + (typeof lang !== 'undefined' ? lang : 'tr')] || cat.name_tr;
                                        %>
                                        <a href="<%= makeCatUrl(cat.slug) %>" class="cyp-category-item <%= isCatActive ? 'active' : '' %>">
                                            <span class="text-truncate me-2 d-flex align-items-center">
                                                <i class="fa-solid fa-chevron-right small me-2 <%= isCatActive ? 'text-primary' : 'text-muted opacity-50' %>"></i>
                                                <%= catName %>
                                            </span>
                                            <span class="badge rounded-pill <%= isCatActive ? 'bg-primary text-white' : 'bg-light text-muted' %> badge-count px-2 py-1 small"><%= cat.listing_count || 0 %></span>
                                        </a>
                                    <% }); %>
                                <% } %>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted text-uppercase letter-spacing-1"><%= t('listing.city') %></label>
                            <%- include('../partials/citySelect', { selectedCity: filters.city }) %>
                        </div>

                        <% const isExcludedBadgeCat = (typeof currentRootSlug !== 'undefined' && ['is-ilanlari', 'usta-hizmetler', 'ustalar'].includes(currentRootSlug)) || (typeof rootCategory !== 'undefined' && ['is-ilanlari', 'usta-hizmetler', 'ustalar'].includes(rootCategory)); %>
                        <% if (!isExcludedBadgeCat) { %>
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted text-uppercase letter-spacing-1"><%= t('listing.badge_filter_label') %></label>
                            <%- include('../partials/badgeFilter', { selectedBadge: filters.badge || '', idPrefix: 'd_' }) %>
                        </div>
                        <% } %>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold hover-lift"><%= t('listing.apply_filters') %></button>
                        <a href="/listings" class="btn btn-link w-100 text-muted small text-decoration-none mt-2"><%= t('listing.clear_filters') %></a>
                    </form>
                </div>
            </div>
        </aside>

        <main class="col-12 col-lg-9">

            <div class="row row-cols-2 row-cols-md-3 g-3 g-md-4 mb-5">
                <% if (listings && listings.length > 0) { %>
                    <% listings.forEach(function(listing) { %>
                        <div class="col">
                            <%- include('../partials/listingCard', { listing: listing }) %>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="col-12 text-center py-5 bg-white rounded-4 shadow-sm my-3">
                        <i class="fa-solid fa-folder-open fs-1 text-muted mb-3 opacity-50 d-block"></i>
                        <h5 class="fw-bold text-dark mb-2"><%= t('listing.no_listings') %></h5>
                        <p class="text-muted small mb-4"><%= t('listing.no_listings_desc') %></p>
                        <a href="/listings/create" class="btn btn-accent rounded-pill px-4 text-white fw-bold shadow-sm">
                            <i class="fa-solid fa-plus me-2"></i><%= t('listing.first_ad_button') %>
                        </a>
                    </div>
                <% } %>
            </div>

            <% if (pagination.totalPages > 1) { %>
                <%
                    // Every filter the controller reads has to survive the jump to the
                    // next page. Dropping sort or the price range reset them silently,
                    // and a link without smart=1 sent the whole sentence to the database
                    // as literal text, which matches nothing.
                    const pageParams = [];
                    const addPageParam = function (key, value) {
                        if (value) pageParams.push(encodeURIComponent(key) + '=' + encodeURIComponent(value));
                    };

                    addPageParam('category', filters.category);
                    addPageParam('city', filters.city);
                    addPageParam('type', filters.type);
                    addPageParam('badge', filters.badge);
                    addPageParam('minPrice', filters.minPrice);
                    addPageParam('maxPrice', filters.maxPrice);
                    // 'newest' is the controller's own default, so it stays out of the URL.
                    if (filters.sort !== 'newest') addPageParam('sort', filters.sort);

                    // In smart mode filters.q holds only the words left over after parsing;
                    // the box showed the whole sentence and the next page has to search for
                    // the same thing.
                    if (smartQuery) {
                        addPageParam('q', smartQuery);
                        addPageParam('smart', '1');
                    } else {
                        addPageParam('q', filters.q);
                    }

                    const pageQuery = pageParams.length ? '&' + pageParams.join('&') : '';

                    // A category with 40 pages used to render 40 circles, which is
                    // three screens wide on a phone. Five around the current page
                    // fits every viewport down to 320px.
                    const windowSize = 5;
                    let firstPage = Math.max(1, pagination.page - Math.floor(windowSize / 2));
                    const lastPage = Math.min(pagination.totalPages, firstPage + windowSize - 1);
                    firstPage = Math.max(1, lastPage - windowSize + 1);
                %>
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
                            <a class="page-link page-circle border-0 shadow-sm rounded-circle mx-1 d-flex align-items-center justify-content-center" href="?page=<%= pagination.page - 1 %><%= pageQuery %>" aria-label="<%= t('common.previous') %>"><i class="fa-solid fa-chevron-left"></i></a>
                        </li>

                        <% if (firstPage > 1) { %>
                            <li class="page-item">
                                <a class="page-link page-circle border-0 shadow-sm rounded-circle mx-1 d-flex align-items-center justify-content-center bg-white text-dark" href="?page=1<%= pageQuery %>">1</a>
                            </li>
                            <% if (firstPage > 2) { %>
                                <li class="page-item disabled"><span class="page-link page-circle border-0 bg-transparent shadow-none d-flex align-items-center justify-content-center">…</span></li>
                            <% } %>
                        <% } %>

                        <% for (let p = firstPage; p <= lastPage; p++) { %>
                            <li class="page-item <%= pagination.page === p ? 'active' : '' %>">
                                <a class="page-link page-circle border-0 shadow-sm rounded-circle mx-1 d-flex align-items-center justify-content-center <%= pagination.page === p ? 'bg-primary text-white' : 'bg-white text-dark hover-bg-primary hover-text-white' %>" href="?page=<%= p %><%= pageQuery %>" <%= pagination.page === p ? 'aria-current="page"' : '' %>><%= p %></a>
                            </li>
                        <% } %>

                        <% if (lastPage < pagination.totalPages) { %>
                            <% if (lastPage < pagination.totalPages - 1) { %>
                                <li class="page-item disabled"><span class="page-link page-circle border-0 bg-transparent shadow-none d-flex align-items-center justify-content-center">…</span></li>
                            <% } %>
                            <li class="page-item">
                                <a class="page-link page-circle border-0 shadow-sm rounded-circle mx-1 d-flex align-items-center justify-content-center bg-white text-dark" href="?page=<%= pagination.totalPages %><%= pageQuery %>"><%= pagination.totalPages %></a>
                            </li>
                        <% } %>

                        <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
                            <a class="page-link page-circle border-0 shadow-sm rounded-circle mx-1 d-flex align-items-center justify-content-center bg-white text-dark hover-bg-primary hover-text-white" href="?page=<%= pagination.page + 1 %><%= pageQuery %>" aria-label="<%= t('common.next') %>"><i class="fa-solid fa-chevron-right"></i></a>
                        </li>
                    </ul>
                </nav>
            <% } %>

            <%- include('../partials/seoGuideBlock', { seoBlock: (typeof seoBlock !== 'undefined' ? seoBlock : null) }) %>

        </main>
    </div>
</div>

<div class="offcanvas offcanvas-start" tabindex="-1" id="filterOffcanvas">
    <div class="offcanvas-header bg-light">
        <h5 class="offcanvas-title fw-bold"><i class="fa-solid fa-sliders text-primary me-2"></i> <%= t('listing.filters') %></h5>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form action="/listings" method="GET">
            <% if (filters.type) { %>
                <input type="hidden" name="type" value="<%= filters.type %>">
            <% } %>
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label fw-bold small text-muted text-uppercase letter-spacing-1 mb-0"><%= t('listing.category') %></label>
                    <% if (filters.category) { %>
                        <a href="<%= makeCatUrl('') %>" class="small text-primary text-decoration-none fw-semibold">Tümü</a>
                    <% } %>
                </div>
                <div class="cyp-category-list">
                    <a href="<%= makeCatUrl('') %>" class="cyp-category-item <%= !filters.category ? 'active' : '' %>">
                        <span class="d-flex align-items-center"><i class="fa-solid fa-border-all me-2"></i><%= t('listing.all_categories') %></span>
                    </a>
                    <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                        <% categories.forEach(function(cat) { %>
                            <%
                                const isCatActive = (filters.category === cat.slug || (cat.slug === 'usta-hizmetler' && filters.category === 'ustalar'));
                                const catName = cat['name_' + (typeof lang !== 'undefined' ? lang : 'tr')] || cat.name_tr;
                            %>
                            <a href="<%= makeCatUrl(cat.slug) %>" class="cyp-category-item <%= isCatActive ? 'active' : '' %>">
                                <span class="text-truncate me-2 d-flex align-items-center">
                                    <i class="fa-solid fa-chevron-right small me-2 <%= isCatActive ? 'text-primary' : 'text-muted opacity-50' %>"></i>
                                    <%= catName %>
                                </span>
                                <span class="badge rounded-pill <%= isCatActive ? 'bg-primary text-white' : 'bg-light text-muted' %> badge-count px-2 py-1 small"><%= cat.listing_count || 0 %></span>
                            </a>
                        <% }); %>
                    <% } %>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold small text-muted text-uppercase letter-spacing-1"><%= t('listing.city') %></label>
                <%- include('../partials/citySelect', { selectedCity: filters.city }) %>
            </div>

            <% if (!isExcludedBadgeCat) { %>
            <div class="mb-4">
                <label class="form-label fw-bold small text-muted text-uppercase letter-spacing-1"><%= t('listing.badge_filter_label') %></label>
                <%- include('../partials/badgeFilter', { selectedBadge: filters.badge || '', idPrefix: 'm_' }) %>
            </div>
            <% } %>

            <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold hover-lift"><%= t('listing.apply_filters') %></button>
            <a href="/listings" class="btn btn-link w-100 text-muted small text-decoration-none mt-2"><%= t('listing.clear_filters') %></a>
        </form>
    </div>
</div>

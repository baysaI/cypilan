          <div class="position-relative shadow-lg rounded-4 overflow-hidden border border-secondary" style="width: min(260px, 65vw); max-height: 46vh; aspect-ratio: 9/16; background: #0f172a;">
            <canvas id="storyCanvas" width="1080" height="1920" style="width: 100%; height: 100%; display: block; object-fit: contain;"></canvas>

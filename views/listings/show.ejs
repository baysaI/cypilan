<% const currentSiteUrl = typeof siteUrl !== 'undefined' ? siteUrl : ''; %>
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": listing.title,

                <button type="button" class="btn btn-outline-secondary rounded-pill flex-fill fw-medium d-flex align-items-center justify-content-center gap-1 compare-toggle-btn" data-id="<%= listing.id %>" data-title="<%= listing.title %>" data-image="<%= imgs[0] || '' %>" data-price="<%= listing.price || 0 %>" data-currency="<%= listing.currency || 'TRY' %>" data-city="<%= helpers.getCityName(listing.location_city, lang) || '' %>">

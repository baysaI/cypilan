        <div class="modal-header border-bottom px-4 py-3 bg-light rounded-top-4">
          <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="quickOfferModalLabel">
            <i class="fa-solid fa-handshake text-success"></i>
            <span><%= t('bids.quick_offer_title') || 'Hızlı Pazarlık Teklifi Ver' %></span>
          </h5>
          <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <div class="alert alert-light border rounded-3 p-3 mb-3">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <small class="text-muted d-block">İlan Fiyatı:</small>
                <strong class="fs-5 text-primary"><%= fmt(listing.price, listing.currency) %></strong>
              </div>
              <div class="text-end">
                <small class="text-muted d-block">Satıcı:</small>
                <strong class="text-dark"><%= listing.seller_company || listing.seller_name %></strong>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-bold small text-muted">
              <i class="fa-solid fa-calculator text-primary me-1"></i>Hızlı İndirim Seçin:
            </label>
            <div class="d-flex gap-2" id="quickOfferPresets">
              <% const curPrice = Number(listing.price) || 0; %>
              <button type="button" class="btn btn-outline-primary btn-sm rounded-pill flex-fill cyp-offer-preset-btn" data-percent="5" data-val="<%= Math.round(curPrice * 0.95) %>">
                -%5 (<%= Math.round(curPrice * 0.95).toLocaleString('tr-TR') %>)
              </button>
              <button type="button" class="btn btn-outline-primary btn-sm rounded-pill flex-fill cyp-offer-preset-btn" data-percent="10" data-val="<%= Math.round(curPrice * 0.90) %>">
                -%10 (<%= Math.round(curPrice * 0.90).toLocaleString('tr-TR') %>)
              </button>
              <button type="button" class="btn btn-outline-primary btn-sm rounded-pill flex-fill cyp-offer-preset-btn" data-percent="15" data-val="<%= Math.round(curPrice * 0.85) %>">
                -%15 (<%= Math.round(curPrice * 0.85).toLocaleString('tr-TR') %>)
              </button>
            </div>
          </div>

          <div class="mb-3">
            <label for="offerAmountInput" class="form-label fw-semibold small text-dark">Teklif Ettiğiniz Tutar (<%= listing.currency || 'TRY' %>) <span class="text-danger">*</span></label>
            <div class="input-group">

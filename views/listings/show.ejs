                        <% } %>
                        <% if (listing.price && Number(listing.price) > 0 && (!authUser || authUser.id !== listing.user_id)) { %>
                            <button type="button" class="btn btn-outline-success rounded-pill fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2" data-bs-toggle="modal" data-bs-target="#quickOfferModal">
                                <i class="fa-solid fa-handshake"></i> <%= t('bids.quick_offer_btn') || 'Pazarlık Teklifi Ver' %>
                            </button>

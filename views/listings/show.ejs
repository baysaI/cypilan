                            <a href="/messages/<%= listing.user_id %>?listing=<%= listing.id %>" class="btn <%= messageBtnClass %> rounded-pill fw-medium">
                                <i class="fa-regular fa-comment-dots me-2"></i> Mesaj Gönder

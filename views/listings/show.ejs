<% const fmt = (amt, curr) => helpers.formatPrice(amt, curr, typeof currency !== 'undefined' ? currency : 'TRY'); %>
<% const imgs = (listing.images && listing.images.length > 0) ? listing.images : []; %>

<div class="bg-light py-3 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted"><i class="fa-solid fa-house"></i></a></li>
                <% if (listing.category_slug) { %>
                    <li class="breadcrumb-item"><a href="/listings?category=<%= listing.category_id %>" class="text-decoration-none text-muted"><%= listing.category_name %></a></li>
                <% } %>
                <li class="breadcrumb-item active fw-medium text-dark text-truncate truncate-md" aria-current="page"><%= listing.title %></li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-4 py-md-5">
    <div class="row g-4 g-xl-5">

        <div class="col-12 col-lg-8">

            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div class="min-w-0">
                    <h1 class="fs-3 fw-bold mb-2 text-break-anywhere"><%= listing.title %></h1>
                    <div class="d-flex align-items-center text-muted small fw-medium gap-3 flex-wrap">
                        <span><i class="fa-solid fa-location-dot text-primary me-1"></i> <%= helpers.getCityName(listing.location_city, lang) || '-' %><%= listing.location_district ? ', ' + listing.location_district : '' %></span>
                        <span><i class="fa-regular fa-clock me-1"></i> <%= helpers.timeAgo(listing.created_at, lang) %></span>
                        <span><i class="fa-regular fa-eye me-1"></i> <%= listing.views_count || 0 %></span>
                        <span><%= t('listing.ad_no') %> <strong class="text-dark">#<%= listing.id %></strong></span>
                    </div>
                </div>
                <div class="text-end d-none d-md-block flex-shrink-0">
                    <% if (listing.price && Number(listing.price) > 0) { %>
                        <h2 class="text-primary fw-bolder mb-0"><%= fmt(listing.price, listing.currency) %></h2>
                    <% } else { %>
                        <h2 class="text-primary fw-bolder mb-0 fs-4"><%= (listing.listing_type === 'job' || listing.category_slug === 'is-ilanlari') ? t('career.salary_unspecified') : t('listing.price_unspecified') %></h2>
                    <% } %>
                </div>
            </div>

            <% const isFav = typeof isFavorited !== 'undefined' && isFavorited; %>
            <div class="d-md-none mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <% if (listing.price && Number(listing.price) > 0) { %>
                    <h2 class="text-primary fw-bolder mb-0 fs-1"><%= fmt(listing.price, listing.currency) %></h2>
                <% } else { %>
                    <h2 class="text-primary fw-bolder mb-0 fs-4"><%= (listing.listing_type === 'job' || listing.category_slug === 'is-ilanlari') ? t('career.salary_unspecified') : t('listing.price_unspecified') %></h2>
                <% } %>
                <div class="d-flex gap-2">
                    <button class="btn <%= isFav ? 'btn-danger text-white' : 'btn-outline-primary' %> btn-sm rounded-pill fw-medium d-flex align-items-center gap-1 favorite-btn" data-id="<%= listing.id %>">
                        <i class="<%= isFav ? 'fa-solid fa-heart' : 'fa-regular fa-heart' %>"></i> <%= t('listing.add_favorite') %>
                    </button>
                    <button class="btn btn-outline-secondary btn-sm rounded-pill fw-medium d-flex align-items-center gap-1 share-btn" data-title="<%= listing.title %>">
                        <i class="fa-solid fa-share-nodes"></i> <%= t('common.share') %>
                    </button>
                </div>
            </div>

            <div class="card border-0 rounded-4 overflow-hidden mb-4 shadow-sm">
                <% if (imgs.length > 0) { %>
                    <div id="listingCarousel" class="carousel slide">
                        <div class="carousel-inner bg-dark listing-gallery">
                            <% imgs.forEach(function(img, i) { %>
                                <div class="carousel-item h-100 <%= i === 0 ? 'active' : '' %>">
                                    <img src="<%= img %>" class="d-block w-100 h-100 object-fit-contain" alt="<%= listing.title %>">
                                </div>
                            <% }); %>
                        </div>
                        <% if (imgs.length > 1) { %>
                            <button class="carousel-control-prev" type="button" data-bs-target="#listingCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon bg-dark bg-opacity-50 rounded-circle p-3" aria-hidden="true"></span>
                                <span class="visually-hidden"><%= t('common.previous') %></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#listingCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon bg-dark bg-opacity-50 rounded-circle p-3" aria-hidden="true"></span>
                                <span class="visually-hidden"><%= t('common.next') %></span>
                            </button>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="bg-light listing-gallery d-flex flex-column align-items-center justify-content-center text-muted">
                        <i class="fa-regular fa-image fs-1 mb-2 opacity-50"></i>
                        <span class="small"><%= t('listing.no_images') %></span>
                    </div>
                <% } %>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 border-bottom pb-2"><%= t('listing.attributes') %></h5>
                    <div class="row row-cols-2 row-cols-md-3 g-4">
                        <div class="col">
                            <div class="text-muted small mb-1"><%= t('listing.category') %></div>
                            <div class="fw-bold text-dark"><%= listing['category_name_' + lang] || listing.category_name || '-' %></div>
                        </div>
                        <div class="col">
                            <div class="text-muted small mb-1"><%= t('listing.city') %></div>
                            <div class="fw-bold text-dark"><%= helpers.getCityName(listing.location_city, lang) || '-' %></div>
                        </div>
                        <div class="col">
                            <div class="text-muted small mb-1"><%= t('listing.district') %></div>
                            <div class="fw-bold text-dark"><%= listing.location_district || '-' %></div>
                        </div>
                        <div class="col">
                            <div class="text-muted small mb-1"><%= t('listing.date') %></div>
                            <div class="fw-bold text-dark"><%= helpers.formatDate(listing.created_at, lang) %></div>
                        </div>
                        <div class="col">
                            <div class="text-muted small mb-1"><%= t('listing.price') %></div>
                            <div class="fw-bold text-dark"><%= fmt(listing.price, listing.currency) %></div>
                        </div>
                        <div class="col">
                            <div class="text-muted small mb-1"><%= t('listing.views') %></div>
                            <div class="fw-bold text-dark"><%= listing.views_count || 0 %></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 border-bottom pb-2"><%= t('listing.description') %></h5>
                    <div class="lh-lg text-dark" style="white-space: pre-line;"><%= listing.description || '' %></div>
                </div>
            </div>

        </div>

        <div class="col-12 col-lg-4">
            <% if (currentUser && currentUser.id === listing.user_id) { %>
                <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-primary">
                    <div class="card-body p-3">
                        <div class="fw-bold small text-muted mb-2">
                            <i class="fa-regular fa-pen-to-square me-1 text-primary"></i><%= t('nav.my_listings') %>
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <a href="/listings/<%= listing.slug %>/edit" class="btn btn-primary btn-sm rounded-pill fw-medium px-3 flex-fill">
                                <i class="fa-solid fa-pen me-1"></i><%= t('common.edit') %>
                            </a>
                            <a href="/profile/listings" class="btn btn-outline-secondary btn-sm rounded-pill fw-medium px-3 flex-fill">
                                <i class="fa-solid fa-list me-1"></i><%= t('nav.my_listings') %>
                            </a>
                        </div>
                    </div>
                </div>
            <% } %>

            <div class="d-none d-lg-flex gap-2 mb-4">
                <button class="btn <%= isFav ? 'btn-danger text-white' : 'btn-outline-primary' %> rounded-pill flex-fill fw-medium d-flex align-items-center justify-content-center gap-2 favorite-btn" data-id="<%= listing.id %>">
                    <i class="<%= isFav ? 'fa-solid fa-heart' : 'fa-regular fa-heart' %>"></i> <%= t('listing.add_favorite') %>
                </button>
                <button class="btn btn-outline-secondary rounded-pill flex-fill fw-medium d-flex align-items-center justify-content-center gap-2 share-btn" data-title="<%= listing.title %>">
                    <i class="fa-solid fa-share-nodes"></i> <%= t('common.share') %>
                </button>
            </div>

            <div class="card border-0 shadow-sm rounded-4 sticky-below-header">
                <div class="card-body p-4 text-center">
                    <div class="position-relative d-inline-block mb-3">
                        <img src="<%= listing.seller_avatar || '/img/logo.png' %>" class="rounded-circle border border-3 border-white shadow-sm object-fit-cover bg-light" width="90" height="90" alt="<%= listing.seller_name %>">
                    </div>

                    <h5 class="fw-bold mb-1"><%= listing.seller_company || listing.seller_name || t('user.member') %></h5>
                    <p class="text-muted small mb-2"><%= listing.seller_role === 'business' ? t('user.business_member') : (listing.seller_role === 'agent' ? t('user.agent_member') : t('user.individual_member')) %></p>

                    <% if (typeof user !== 'undefined' && user && user.id === listing.user_id) { %>
                        <div class="border rounded-4 p-3 mb-3 text-start bg-light">
                            <h6 class="fw-bold mb-2"><i class="fa-solid fa-headset text-primary me-1"></i><%= t('service.owner_box_title') %></h6>
                            <p class="text-muted small mb-3"><%= t('service.owner_box_body') %></p>

                            <% offeredServices.forEach(function (serviceType) { %>
                                <% const open = openServiceRequests[serviceType]; %>
                                <div class="mb-2">
                                    <% if (open) { %>
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis border border-primary-subtle">
                                                <%= t('service.type_' + serviceType) %>: <%= t('service.status_' + open.status) %>
                                            </span>
                                            <a href="/profile/taleplerim" class="small fw-semibold text-decoration-none"><%= t('service.my_requests') %></a>
                                        </div>
                                    <% } else { %>
                                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3 w-100" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#svcForm<%= serviceType %>">
                                            <i class="fa-solid <%= serviceType === 'assurance' ? 'fa-handshake' : 'fa-crown' %> me-1"></i>
                                            <%= t('service.request_' + serviceType) %>
                                        </button>

                                        <div class="collapse mt-2" id="svcForm<%= serviceType %>">
                                            <form action="/hizmet/<%= serviceType %>/<%= listing.id %>" method="POST">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <textarea name="note" class="form-control form-control-sm mb-2" rows="2" maxlength="800"
                                                          placeholder="<%= t('service.note_placeholder') %>"></textarea>
                                                <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 w-100">
                                                    <%= t('service.send_request') %>
                                                </button>
                                            </form>
                                        </div>
                                    <% } %>
                                </div>
                            <% }); %>

                            <p class="text-muted small mb-0 mt-2"><%= t('service.manual_note') %></p>
                        </div>
                    <% } %>

                    <% if (listing.listing_type === 'bid_request') { %>
                        <div class="alert alert-primary py-2 px-3 small mb-3 text-start">
                            <i class="fa-solid fa-gavel me-1"></i>
                            <strong><%= t('bids.collecting_offers') %></strong>
                            <div class="mt-1"><%= t('bids.competing', { count: bidSummary.total }) %></div>
                            <% if (typeof user !== 'undefined' && user && user.id === listing.user_id) { %>
                                <a href="/profile/teklifler" class="fw-semibold d-inline-block mt-1"><%= t('bids.received') %> <i class="fa-solid fa-arrow-right ms-1"></i></a>
                            <% } %>
                        </div>
                    <% } %>

                    <p class="small mb-3">
                        <% if (sellerRating.total > 0) { %>
                            <a href="/profile/<%= listing.user_id %>#reviews" class="text-decoration-none">
                                <span class="text-warning">
                                    <% for (let star = 1; star <= 5; star++) { %>
                                        <i class="fa-<%= star <= Math.round(sellerRating.average) ? 'solid' : 'regular' %> fa-star"></i>
                                    <% } %>
                                </span>
                                <span class="fw-semibold ms-1"><%= sellerRating.average.toFixed(1) %></span>
                                <span class="text-muted">(<%= t('reviews.count', { count: sellerRating.total }) %>)</span>
                            </a>
                        <% } else { %>
                            <span class="text-muted"><i class="fa-regular fa-star me-1"></i><%= t('reviews.not_rated_yet') %></span>
                        <% } %>
                    </p>

                    <% if (listing.seller_since) { %>
                        <p class="small text-muted mb-4"><i class="fa-regular fa-calendar me-1"></i> <%= helpers.formatDate(listing.seller_since, lang) %> (<%= t('user.member_since') %>)</p>
                    <% } %>

                    <div class="d-grid gap-3">
                        <% if (listing.has_phone) { %>
                            <div id="phoneReveal"
                                 data-listing-id="<%= listing.id %>"
                                 data-authenticated="<%= currentUser ? '1' : '0' %>"
                                 data-login-url="/auth/login">
                                <button type="button" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm w-100 d-flex align-items-center justify-content-center gap-2" id="revealPhoneBtn">
                                    <i class="fa-solid fa-phone"></i>
                                    <span id="phoneText"><%= listing.seller_phone_masked %></span>
                                </button>
                                <div class="form-text text-center mt-1" id="phoneHint">
                                    <% if (currentUser) { %>
                                        <%= t('listing.click_to_see_phone') %>
                                    <% } else { %>
                                        <%= t('listing.login_to_see_phone') %>
                                    <% } %>
                                </div>
                            </div>
                        <% } else if (listing.phone_hidden) { %>
                            <div class="alert alert-light border small mb-0">
                                <i class="fa-solid fa-comment-dots me-1 text-primary"></i>
                                Satıcı yalnızca mesajla iletişim kuruyor.
                            </div>
                        <% } else { %>
                            <div class="alert alert-light border small mb-0"><%= t('listing.no_phone_provided') %></div>
                        <% } %>
                        <% const messageBtnClass = listing.has_phone ? 'btn-outline-primary' : 'btn-primary btn-lg fw-bold shadow-sm'; %>
                        <% if (!currentUser) { %>
                            <a href="/auth/login" class="btn <%= messageBtnClass %> rounded-pill fw-medium">
                                <i class="fa-regular fa-comment-dots me-2"></i> Mesaj Gönder
                            </a>
                        <% } else if (currentUser.id !== listing.user_id) { %>
                            <a href="/messages/<%= listing.user_id %>?listing=<%= listing.id %>" class="btn <%= messageBtnClass %> rounded-pill fw-medium">
                                <i class="fa-regular fa-comment-dots me-2"></i> Mesaj Gönder
                            </a>
                        <% } %>
                        <a href="/profile/<%= listing.user_id %>" class="btn btn-outline-dark rounded-pill fw-medium">
                            <i class="fa-regular fa-user me-2"></i> <%= t('user.seller_profile') %>
                        </a>
                    </div>
                </div>

                <% if (!currentUser || currentUser.id !== listing.user_id) { %>
                    <div class="card-footer bg-white border-top text-center py-2">
                        <% if (currentUser) { %>
                            <button type="button" class="btn btn-link btn-sm text-muted text-decoration-none"
                                    data-bs-toggle="modal" data-bs-target="#reportListingModal">
                                <i class="fa-regular fa-flag me-1"></i> Bu ilanı şikayet et
                            </button>
                        <% } else { %>
                            <a href="/auth/login" class="btn btn-link btn-sm text-muted text-decoration-none">
                                <i class="fa-regular fa-flag me-1"></i> Bu ilanı şikayet et
                            </a>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>

    </div>
</div>

<% if (currentUser && currentUser.id !== listing.user_id) { %>
    <%- include('../partials/reportModal', {
        modalId: 'reportListingModal',
        action: `/report/listings/${listing.id}`,
        modalTitle: 'İlanı Şikayet Et',
        modalIntro: 'Bu ilanla ilgili sorunu bize bildirin. Şikayetiniz yöneticiler tarafından incelenecek.',
        reasons: ['wrong_category', 'misleading_price', 'missing_photos', 'spam', 'fraud', 'inappropriate', 'other']
    }) %>
<% } %>

<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": listing.title,
  "image": imgs.length > 0 ? siteUrl + imgs[0] : undefined,
  "description": listing.description || undefined,
  "offers": {
    "@type": "Offer",
    "url": siteUrl + '/listings/' + listing.slug,
    "priceCurrency": listing.currency || 'TRY',
    "price": String(listing.price == null ? '' : listing.price),
    "availability": "https://schema.org/InStock",
    "seller": { "@type": "Person", "name": listing.seller_name || '' }
  }
}) %>
</script>

<script>
(function () {
    var wrapper = document.getElementById('phoneReveal');
    if (!wrapper) return;

    var btn = document.getElementById('revealPhoneBtn');
    var text = document.getElementById('phoneText');
    var hint = document.getElementById('phoneHint');
    var listingId = wrapper.getAttribute('data-listing-id');
    var authenticated = wrapper.getAttribute('data-authenticated') === '1';

    btn.addEventListener('click', function () {
        if (!authenticated) {
            window.location.href = wrapper.getAttribute('data-login-url');
            return;
        }

        btn.disabled = true;
        var previous = text.textContent;
        text.textContent = 'Yükleniyor...';

        fetch('/listings/' + listingId + '/phone', {
            headers: { 'Accept': 'application/json' },
            credentials: 'same-origin'
        })
            .then(function (res) {
                return res.json().then(function (data) {
                    return { ok: res.ok, data: data };
                });
            })
            .then(function (result) {
                if (!result.ok) {
                    text.textContent = previous;
                    btn.disabled = false;
                    if (hint) {
                        hint.textContent = result.data.error || 'Numara alınamadı.';
                        hint.className = 'form-text text-center mt-1 text-danger';
                    }
                    return;
                }

                text.textContent = result.data.phone;
                btn.classList.remove('btn-primary');
                btn.classList.add('btn-success');
                if (hint) hint.remove();

                var call = document.createElement('a');
                call.href = 'tel:' + result.data.phone;
                call.className = 'btn btn-primary btn-lg rounded-pill fw-bold shadow-sm w-100 mt-2 d-flex align-items-center justify-content-center gap-2';
                call.innerHTML = '<i class="fa-solid fa-phone"></i> Ara';
                wrapper.appendChild(call);

                var wa = document.createElement('a');
                wa.href = 'https://wa.me/' + result.data.whatsapp;
                wa.target = '_blank';
                wa.rel = 'noopener';
                wa.className = 'btn btn-lg rounded-pill fw-bold shadow-sm w-100 mt-2 text-white d-flex align-items-center justify-content-center gap-2 border-0';
                wa.style.background = 'linear-gradient(135deg, #25D366 0%, #128C7E 100%)';
                wa.innerHTML = '<i class="fa-brands fa-whatsapp fs-5"></i> WhatsApp';
                wrapper.appendChild(wa);

                btn.disabled = true;
            })
            .catch(function () {
                text.textContent = previous;
                btn.disabled = false;
                if (hint) {
                    hint.textContent = 'Bağlantı hatası. Tekrar deneyin.';
                    hint.className = 'form-text text-center mt-1 text-danger';
                }
            });
    });
})();
</script>

<div class="modal fade" id="shareModal" tabindex="-1" aria-labelledby="shareModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold" id="shareModalLabel"><i class="fa-solid fa-share-nodes text-primary me-2"></i><%= t('common.share') %></h5>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4 text-center">
        <p class="text-muted small mb-4 fw-medium"><%= listing.title %></p>
        <div class="d-flex justify-content-center gap-3 mb-4 flex-wrap">
            <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(listing.title + ' ') %>" id="shareWhatsapp" target="_blank" rel="noopener" class="btn rounded-circle shadow-sm p-3 d-flex align-items-center justify-content-center text-white" style="width: 54px; height: 54px; background: #25D366;" title="WhatsApp">
                <i class="fa-brands fa-whatsapp fs-4"></i>
            </a>
            <a href="https://www.facebook.com/sharer/sharer.php" id="shareFacebook" target="_blank" rel="noopener" class="btn rounded-circle shadow-sm p-3 d-flex align-items-center justify-content-center text-white" style="width: 54px; height: 54px; background: #1877F2;" title="Facebook">
                <i class="fa-brands fa-facebook-f fs-4"></i>
            </a>
            <a href="https://t.me/share/url" id="shareTelegram" target="_blank" rel="noopener" class="btn rounded-circle shadow-sm p-3 d-flex align-items-center justify-content-center text-white" style="width: 54px; height: 54px; background: #0088cc;" title="Telegram">
                <i class="fa-brands fa-telegram fs-4"></i>
            </a>
            <a href="https://twitter.com/intent/tweet" id="shareTwitter" target="_blank" rel="noopener" class="btn rounded-circle shadow-sm p-3 d-flex align-items-center justify-content-center text-white" style="width: 54px; height: 54px; background: #000000;" title="X / Twitter">
                <i class="fa-brands fa-x-twitter fs-4"></i>
            </a>
        </div>
        <div class="input-group">
            <input type="text" class="form-control bg-light border-end-0 shadow-none small" id="shareUrlInput" readonly>
            <button class="btn btn-primary px-3 fw-bold" type="button" id="copyShareLinkBtn">
                <i class="fa-regular fa-copy me-1"></i> Kopyala
            </button>
        </div>
      </div>
    </div>
  </div>
</div>

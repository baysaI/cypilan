<% const fmt = (amt, curr) => helpers.formatPrice(amt, curr, typeof currency !== 'undefined' ? currency : 'TRY'); %>
<% const imgs = (listing.images && listing.images.length > 0) ? listing.images : []; %>
<% const authUser = typeof currentUser !== 'undefined' ? currentUser : null; %>

<div class="bg-light py-3 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted"><i class="fa-solid fa-house"></i></a></li>
                <% if (listing.category_slug) { %>
                    <li class="breadcrumb-item"><a href="/listings?category=<%= listing.category_id %>" class="text-decoration-none text-muted"><%= listing.category_name %></a></li>
                <% } %>
                <li class="breadcrumb-item active fw-medium text-dark text-truncate truncate-md" aria-current="page"><%= listing.title %></li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-4 py-md-5">
    <div class="row g-4 g-xl-5">

        <div class="col-12 col-lg-8">

            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div class="min-w-0">
                    <h1 class="fs-3 fw-bold mb-2 text-break-anywhere"><%= listing.title %></h1>

                    <%# Each badge doubles as the way into the rest of them: a visitor who
                        came for the bargains can go straight from one to the whole list. %>
                    <% const detailBadges = (typeof listingBadges !== 'undefined' && listingBadges) ? listingBadges.activeFor(listing) : []; %>
                    <% if (detailBadges.length > 0) { %>
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <% detailBadges.forEach(function (badge) { %>
                                <a href="/listings?badge=<%= badge.key %>"
                                   class="badge bg-<%= badge.variant %> text-white rounded-pill px-3 py-2 text-decoration-none"
                                   title="<%= t('listing.badge_filter_hint') %>">
                                    <i class="fa-solid <%= badge.icon %> me-1"></i><%= t('listing.badge_' + badge.key) %>
                                </a>
                            <% }); %>
                        </div>
                    <% } %>

                    <div class="d-flex align-items-center text-muted small fw-medium gap-3 flex-wrap">
                        <span class="d-inline-flex align-items-center">
                            <i class="fa-solid fa-location-dot text-danger me-1"></i> <%= helpers.getCityName(listing.location_city, lang) || '-' %><%= listing.location_district ? ', ' + listing.location_district : '' %>
                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1 ms-2 fw-semibold shadow-xs" data-bs-toggle="modal" data-bs-target="#listingMapModal">
                                <i class="fa-solid fa-map-location-dot me-1"></i><%= t('map.view_on_map') || 'Haritada Gör' %>
                            </button>
                        </span>
                        <span><i class="fa-regular fa-clock me-1"></i> <%= helpers.timeAgo(listing.created_at, lang) %></span>
                        <span><i class="fa-regular fa-eye me-1"></i> <%= listing.views_count || 0 %></span>
                        <span><%= t('listing.ad_no') %> <strong class="text-dark">#<%= listing.id %></strong></span>
                    </div>
                </div>
                <div class="text-end d-none d-md-block flex-shrink-0">
                    <% if (listing.price && Number(listing.price) > 0) { %>
                        <h2 class="text-primary fw-bolder mb-0"><%= fmt(listing.price, listing.currency) %></h2>
                    <% } else { %>
                        <h2 class="text-primary fw-bolder mb-0 fs-4"><%= (listing.listing_type === 'job' || listing.category_slug === 'is-ilanlari') ? t('career.salary_unspecified') : t('listing.price_unspecified') %></h2>
                    <% } %>
                </div>
            </div>

            <% const isFav = typeof isFavorited !== 'undefined' && isFavorited; %>
            <div class="d-md-none mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <% if (listing.price && Number(listing.price) > 0) { %>
                    <h2 class="text-primary fw-bolder mb-0 fs-1"><%= fmt(listing.price, listing.currency) %></h2>
                <% } else { %>
                    <h2 class="text-primary fw-bolder mb-0 fs-4"><%= (listing.listing_type === 'job' || listing.category_slug === 'is-ilanlari') ? t('career.salary_unspecified') : t('listing.price_unspecified') %></h2>
                <% } %>
                <div class="d-flex gap-2 flex-wrap">
                    <button type="button" class="btn <%= isFav ? 'btn-danger text-white' : 'btn-outline-primary' %> btn-sm rounded-pill fw-medium d-flex align-items-center gap-1 favorite-btn" data-id="<%= listing.id %>">
                        <i class="<%= isFav ? 'fa-solid fa-heart' : 'fa-regular fa-heart' %>"></i> <%= t('listing.add_favorite') %>
                    </button>
                    <button type="button" class="btn <%= (typeof isPriceAlertActive !== 'undefined' && isPriceAlertActive) ? 'btn-warning text-dark active' : 'btn-outline-warning' %> btn-sm rounded-pill fw-medium d-flex align-items-center gap-1 price-alert-btn" data-id="<%= listing.id %>" data-title="<%= listing.title %>" title="<%= t('alerts.price_alert') || 'Fiyat Alarmı' %>">
                        <i class="fa-solid fa-bell"></i> <%= t('alerts.price_alert') || 'Fiyat Alarmı' %>
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill fw-medium d-flex align-items-center gap-1 compare-toggle-btn" data-id="<%= listing.id %>" data-title="<%= listing.title %>" data-image="<%= imgs[0] || '' %>" data-price="<%= listing.price || 0 %>" data-currency="<%= listing.currency || 'TRY' %>" data-city="<%= helpers.getCityName(listing.location_city, lang) || '' %>">
                        <i class="fa-solid fa-code-compare"></i> <%= t('compare.button') || 'Karşılaştır' %>
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill fw-medium d-flex align-items-center gap-1 share-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#shareModal"
                            data-id="<%= listing.id %>"
                            data-title="<%= listing.title %>"
                            data-price="<%= listing.price ? helpers.formatPrice(listing.price, listing.currency) : '' %>"
                            data-city="<%= helpers.getCityName(listing.location_city, lang) || '' %>"
                            data-category="<%= listing.category_name || '' %>"
                            data-image="<%= imgs[0] || '/img/logo.svg' %>"
                            data-slug="<%= listing.slug %>">
                        <i class="fa-solid fa-share-nodes"></i> <%= t('common.share') %>
                    </button>
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill fw-medium d-flex align-items-center gap-1 direct-story-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#storyMakerModal"
                            data-id="<%= listing.id %>"
                            data-title="<%= listing.title %>"
                            data-price="<%= listing.price ? helpers.formatPrice(listing.price, listing.currency) : '' %>"
                            data-city="<%= helpers.getCityName(listing.location_city, lang) || '' %>"
                            data-category="<%= listing.category_name || '' %>"
                            data-image="<%= imgs[0] || '/img/logo.svg' %>"
                            data-slug="<%= listing.slug %>"
                            title="Instagram & WhatsApp Story Görseli Oluştur">
                        <i class="fa-brands fa-instagram"></i> Story
                    </button>
                </div>
            </div>

            <div class="card border-0 rounded-4 overflow-hidden mb-4 shadow-sm">
                <% if (imgs.length > 0) { %>
                    <div id="listingCarousel" class="carousel slide">
                        <div class="carousel-inner bg-dark listing-gallery">
                            <% imgs.forEach(function(img, i) { %>
                                <div class="carousel-item h-100 <%= i === 0 ? 'active' : '' %>">
                                    <img src="<%= img %>" class="d-block w-100 h-100 object-fit-contain" alt="<%= listing.title %>" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800';">
                                </div>
                            <% }); %>
                        </div>
                        <% if (imgs.length > 1) { %>
                            <button class="carousel-control-prev" type="button" data-bs-target="#listingCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon bg-dark bg-opacity-50 rounded-circle p-3" aria-hidden="true"></span>
                                <span class="visually-hidden"><%= t('common.previous') %></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#listingCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon bg-dark bg-opacity-50 rounded-circle p-3" aria-hidden="true"></span>
                                <span class="visually-hidden"><%= t('common.next') %></span>
                            </button>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="bg-light listing-gallery d-flex flex-column align-items-center justify-content-center text-muted">
                        <i class="fa-regular fa-image fs-1 mb-2 opacity-50"></i>
                        <span class="small"><%= t('listing.no_images') %></span>
                    </div>
                <% } %>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 border-bottom pb-2 d-flex align-items-center justify-content-between">
                        <span><%= t('listing.attributes') %></span>
                        <span class="badge bg-light text-primary border small fw-normal">
                            <i class="fa-solid fa-hashtag me-1"></i><%= listing.id %>
                        </span>
                    </h5>

                    <% const attrs = (listing && listing.attributes) || {}; %>

                    <div class="row row-cols-2 row-cols-md-3 g-4 mb-3">
                        <div class="col">
                            <div class="text-muted small mb-1"><%= t('listing.category') %></div>
                            <div class="fw-bold text-dark"><%= listing['category_name_' + lang] || listing.category_name || '-' %></div>
                        </div>
                        <div class="col">
                            <div class="text-muted small mb-1"><%= t('listing.city') %></div>
                            <div class="fw-bold text-dark"><%= helpers.getCityName(listing.location_city, lang) || '-' %></div>
                        </div>
                        <div class="col">
                            <div class="text-muted small mb-1"><%= t('listing.district') %></div>
                            <div class="fw-bold text-dark"><%= listing.location_district || '-' %></div>
                        </div>
                        <div class="col">
                            <div class="text-muted small mb-1"><%= t('listing.date') %></div>
                            <div class="fw-bold text-dark"><%= helpers.formatDate(listing.created_at, lang) %></div>
                        </div>
                        <div class="col">
                            <div class="text-muted small mb-1"><%= t('listing.price') %></div>
                            <div class="fw-bold text-dark"><%= fmt(listing.price, listing.currency) %></div>
                        </div>
                        <div class="col">
                            <div class="text-muted small mb-1"><%= t('listing.views') %></div>
                            <div class="fw-bold text-dark"><%= listing.views_count || 0 %></div>
                        </div>

                        <%# Module Specific Attributes %>
                        <% if (attrs.rooms) { %>
                            <div class="col">
                                <div class="text-muted small mb-1"><%= t('draft.field_rooms') %></div>
                                <div class="fw-bold text-dark"><%= attrs.rooms %></div>
                            </div>
                        <% } %>

                        <% if (attrs.size) { %>
                            <div class="col">
                                <div class="text-muted small mb-1"><%= t('draft.field_size') %></div>
                                <div class="fw-bold text-dark"><%= attrs.size %> m²</div>
                            </div>
                        <% } %>

                        <% if (attrs.floor) { %>
                            <div class="col">
                                <div class="text-muted small mb-1"><%= t('draft.field_floor') %></div>
                                <div class="fw-bold text-dark"><%= attrs.floor %></div>
                            </div>
                        <% } %>

                        <% if (attrs.build_year || attrs.buildYear) { %>
                            <div class="col">
                                <div class="text-muted small mb-1"><%= t('draft.field_build_year') %></div>
                                <div class="fw-bold text-dark"><%= attrs.build_year || attrs.buildYear %></div>
                            </div>
                        <% } %>

                        <% if (attrs.brand) { %>
                            <div class="col">
                                <div class="text-muted small mb-1"><%= t('draft.field_brand') %></div>
                                <div class="fw-bold text-dark"><%= attrs.brand %></div>
                            </div>
                        <% } %>

                        <% if (attrs.model) { %>
                            <div class="col">
                                <div class="text-muted small mb-1"><%= t('draft.field_model') %></div>
                                <div class="fw-bold text-dark"><%= attrs.model %></div>
                            </div>
                        <% } %>

                        <% if (attrs.year) { %>
                            <div class="col">
                                <div class="text-muted small mb-1"><%= t('draft.field_year') %></div>
                                <div class="fw-bold text-dark"><%= attrs.year %></div>
                            </div>
                        <% } %>

                        <% if (attrs.km) { %>
                            <div class="col">
                                <div class="text-muted small mb-1"><%= t('draft.field_km') %></div>
                                <div class="fw-bold text-dark"><%= Number(attrs.km) ? Number(attrs.km).toLocaleString('tr-TR') : attrs.km %> km</div>
                            </div>
                        <% } %>

                        <% if (attrs.fuel) { %>
                            <div class="col">
                                <div class="text-muted small mb-1"><%= t('draft.field_fuel') %></div>
                                <div class="fw-bold text-dark"><%= attrs.fuel %></div>
                            </div>
                        <% } %>

                        <% if (attrs.gear) { %>
                            <div class="col">
                                <div class="text-muted small mb-1"><%= t('draft.field_gear') %></div>
                                <div class="fw-bold text-dark"><%= attrs.gear %></div>
                            </div>
                        <% } %>

                        <% if (attrs.body_type) { %>
                            <div class="col">
                                <div class="text-muted small mb-1"><%= t('draft.field_body_type') %></div>
                                <div class="fw-bold text-dark"><%= attrs.body_type %></div>
                            </div>
                        <% } %>

                        <% if (attrs.engine_power) { %>
                            <div class="col">
                                <div class="text-muted small mb-1"><%= t('draft.field_engine_power') %></div>
                                <div class="fw-bold text-dark"><%= attrs.engine_power %></div>
                            </div>
                        <% } %>

                        <% if (attrs.engine_size) { %>
                            <div class="col">
                                <div class="text-muted small mb-1"><%= t('draft.field_engine_size') %></div>
                                <div class="fw-bold text-dark"><%= attrs.engine_size %></div>
                            </div>
                        <% } %>

                        <% if (attrs.drivetrain) { %>
                            <div class="col">
                                <div class="text-muted small mb-1"><%= t('draft.field_drivetrain') %></div>
                                <div class="fw-bold text-dark"><%= attrs.drivetrain %></div>
                            </div>
                        <% } %>

                        <% if (attrs.color) { %>
                            <div class="col">
                                <div class="text-muted small mb-1"><%= t('draft.field_color') %></div>
                                <div class="fw-bold text-dark"><%= attrs.color %></div>
                            </div>
                        <% } %>

                        <% if (attrs.vehicle_status) { %>
                            <div class="col">
                                <div class="text-muted small mb-1"><%= t('draft.field_vehicle_status') %></div>
                                <div class="fw-bold text-dark"><%= attrs.vehicle_status %></div>
                            </div>
                        <% } %>

                        <% if (attrs.condition) { %>
                            <div class="col">
                                <div class="text-muted small mb-1"><%= t('draft.field_condition') %></div>
                                <div class="fw-bold text-dark"><%= attrs.condition %></div>
                            </div>
                        <% } %>

                        <% if (attrs.swap) { %>
                            <%
                                const swapStr = String(attrs.swap).trim().toLowerCase();
                                const isNoSwap = swapStr.startsWith('hayır') || swapStr.includes('yok') || swapStr === 'no' || swapStr === '0';
                            %>
                            <div class="col">
                                <div class="text-muted small mb-1"><%= t('draft.field_swap') %></div>
                                <div class="fw-bold text-dark">
                                    <% if (isNoSwap) { %>
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1"><i class="fa-solid fa-xmark me-1"></i><%= attrs.swap %></span>
                                    <% } else { %>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1"><i class="fa-solid fa-arrows-rotate me-1"></i><%= attrs.swap %></span>
                                    <% } %>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <%# Feature Badges %>
                    <%
                        const featuresList = attrs.features
                            ? (Array.isArray(attrs.features) ? attrs.features : String(attrs.features).split(',')).filter(Boolean)
                            : [];
                    %>
                    <% if (featuresList.length > 0) { %>
                        <div class="pt-3 border-top mt-3">
                            <h6 class="fw-bold small text-muted mb-3"><i class="fa-solid fa-list-check text-primary me-2"></i>Öne Çıkan Özellikler &amp; Donanım</h6>
                            <div class="d-flex flex-wrap gap-2">
                                <% featuresList.forEach(function(feat) { %>
                                    <% const featKey = 'draft.features.' + feat.trim(); %>
                                    <% const label = t(featKey) !== featKey ? t(featKey) : feat.trim(); %>
                                    <span class="badge bg-light text-dark border px-3 py-2 fw-medium rounded-pill d-inline-flex align-items-center">
                                        <i class="fa-solid fa-circle-check text-success me-2"></i><%= label %>
                                    </span>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>

                    <%# Job Details if applicable %>
                    <% if (listing.job_details) { %>
                        <% const jd = listing.job_details; %>
                        <div class="pt-3 border-top mt-3">
                            <h6 class="fw-bold small text-muted mb-3"><i class="fa-solid fa-briefcase text-primary me-2"></i><%= t('career.job_details') %></h6>
                            <div class="row row-cols-2 row-cols-md-3 g-3 mb-3">
                                <% if (jd.work_type) { %>
                                    <div class="col">
                                        <div class="text-muted small mb-1"><%= t('career.work_type') %></div>
                                        <div class="fw-bold text-dark"><%= t('career.work_type_' + jd.work_type) %></div>
                                    </div>
                                <% } %>
                                <% if (jd.experience_required !== null && jd.experience_required !== undefined) { %>
                                    <div class="col">
                                        <div class="text-muted small mb-1"><%= t('career.experience_required') %></div>
                                        <div class="fw-bold text-dark"><%= jd.experience_required > 0 ? jd.experience_required + ' ' + (t('career.years') || 'Yıl') : (t('career.no_experience') || 'Deneyimsiz') %></div>
                                    </div>
                                <% } %>
                                <% if (jd.salary_min || jd.salary_max) { %>
                                    <div class="col">
                                        <div class="text-muted small mb-1"><%= t('career.salary') %></div>
                                        <div class="fw-bold text-dark">
                                            <%= jd.salary_min ? fmt(jd.salary_min, jd.salary_currency || listing.currency) : '' %>
                                            <%= (jd.salary_min && jd.salary_max) ? ' - ' : '' %>
                                            <%= jd.salary_max ? fmt(jd.salary_max, jd.salary_currency || listing.currency) : '' %>
                                            <% if (jd.salary_period) { %> (<%= t('career.period_' + jd.salary_period) %>)<% } %>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                            <% if (jd.required_skills) { %>
                                <div class="mb-2">
                                    <div class="text-muted small mb-1"><%= t('career.required_skills') %></div>
                                    <div class="d-flex flex-wrap gap-1">
                                        <% jd.required_skills.split(',').map(s => s.trim()).filter(Boolean).forEach(function(skill) { %>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1"><%= skill %></span>
                                        <% }); %>
                                    </div>
                                </div>
                            <% } %>
                            <% if (jd.required_languages) { %>
                                <div class="mb-2">
                                    <div class="text-muted small mb-1"><%= t('career.required_languages') %></div>
                                    <div class="d-flex flex-wrap gap-1">
                                        <% jd.required_languages.split(',').map(s => s.trim()).filter(Boolean).forEach(function(langName) { %>
                                            <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-2 py-1"><%= langName %></span>
                                        <% }); %>
                                    </div>
                                </div>
                            <% } %>
                            <% if (jd.benefits) { %>
                                <div>
                                    <div class="text-muted small mb-1"><%= t('career.benefits') %></div>
                                    <div class="small text-dark"><%= jd.benefits %></div>
                                </div>
                            <% } %>
                        </div>
                    <% } %>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 border-bottom pb-2"><%= t('listing.description') %></h5>
                    <div class="lh-lg text-dark" style="white-space: pre-line;"><%= listing.description || '' %></div>
                </div>
            </div>

            <%# Prominent Location & Map Section %>
            <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0 d-flex align-items-center gap-2">
                            <i class="fa-solid fa-map-location-dot text-primary"></i>
                            <span><%= t('map.modal_title') || 'İlan Konumu & Harita' %></span>
                        </h5>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 fw-medium">
                            <i class="fa-solid fa-location-dot me-1"></i><%= helpers.getCityName(listing.location_city, lang) || '-' %><%= listing.location_district ? ' / ' + listing.location_district : '' %>
                        </span>
                    </div>
                    <p class="text-muted small mb-3">
                        <%= listing.title %> &mdash; <strong><%= helpers.getCityName(listing.location_city, lang) || '-' %></strong> <%= listing.location_district ? '(' + listing.location_district + ')' : '' %> bölgesindedir.
                    </p>
                    <div class="p-3 bg-light rounded-4 border d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-white rounded-circle shadow-sm d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                                <i class="fa-solid fa-map-pin text-danger fs-4"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark mb-0">İlanın Konumunu Haritada İnceleyin</div>
                                <div class="text-muted small">İnteraktif harita, çevre detayları ve Google Maps yol tarifi.</div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-2 shadow-sm flex-shrink-0" data-bs-toggle="modal" data-bs-target="#listingMapModal">
                            <i class="fa-solid fa-map-location-dot"></i>
                            <%= t('map.view_on_map') || 'Haritada Gör' %>
                        </button>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-12 col-lg-4">
            <% if (authUser && authUser.id === listing.user_id) { %>
                <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-primary">
                    <div class="card-body p-3">
                        <div class="fw-bold small text-muted mb-2">
                            <i class="fa-regular fa-pen-to-square me-1 text-primary"></i><%= t('nav.my_listings') %>
                        </div>
                        <div class="d-flex gap-2 flex-wrap">

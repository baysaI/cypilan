<script>
(function () {
    var wrapper = document.getElementById('phoneReveal');
    if (!wrapper) return;

    var btn = document.getElementById('revealPhoneBtn');
    var text = document.getElementById('phoneText');
    var hint = document.getElementById('phoneHint');
    var listingId = wrapper.getAttribute('data-listing-id');
    var authenticated = wrapper.getAttribute('data-authenticated') === '1';

    btn.addEventListener('click', function () {
        if (!authenticated) {
            window.location.href = wrapper.getAttribute('data-login-url');
            return;
        }

        btn.disabled = true;
        var previous = text.textContent;
        text.textContent = 'Yükleniyor...';

        fetch('/listings/' + listingId + '/phone', {
            headers: { 'Accept': 'application/json' },
            credentials: 'same-origin'
        })
            .then(function (res) {
                return res.json().then(function (data) {
                    return { ok: res.ok, data: data };
                });
            })
            .then(function (result) {
                if (!result.ok) {
                    text.textContent = previous;
                    btn.disabled = false;
                    if (hint) {
                        hint.textContent = result.data.error || 'Numara alınamadı.';
                        hint.className = 'form-text text-center mt-1 text-danger';
                    }
                    return;
                }

                text.textContent = result.data.phone;
                btn.classList.remove('btn-primary');
                btn.classList.add('btn-success');
                if (hint) hint.remove();

                var call = document.createElement('a');
                call.href = 'tel:' + result.data.phone;
                call.className = 'btn btn-primary btn-lg rounded-pill fw-bold shadow-sm w-100 mt-2 d-flex align-items-center justify-content-center gap-2';
                call.innerHTML = '<i class="fa-solid fa-phone"></i> Ara';
                wrapper.appendChild(call);

                var wa = document.createElement('a');
                wa.href = 'https://wa.me/' + result.data.whatsapp;
                wa.target = '_blank';
                wa.rel = 'noopener';
                wa.className = 'btn btn-lg rounded-pill fw-bold shadow-sm w-100 mt-2 text-white d-flex align-items-center justify-content-center gap-2 border-0';
                wa.style.background = 'linear-gradient(135deg, #25D366 0%, #128C7E 100%)';
                wa.innerHTML = '<i class="fa-brands fa-whatsapp fs-5"></i> WhatsApp';
                wrapper.appendChild(wa);

                btn.disabled = true;
            })
            .catch(function () {
                text.textContent = previous;
                btn.disabled = false;
                if (hint) {
                    hint.textContent = 'Bağlantı hatası. Tekrar deneyin.';
                    hint.className = 'form-text text-center mt-1 text-danger';
                }
            });
    });
})();
</script>

<div class="modal fade" id="listingMapModal" tabindex="-1" aria-labelledby="listingMapModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
      <div class="modal-header border-bottom px-4 py-3 bg-light">
        <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="listingMapModalLabel">
          <i class="fa-solid fa-map-location-dot text-primary"></i>
          <span><%= t('map.modal_title') || 'İlan Konumu & Harita' %></span>
        </h5>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-0 position-relative">
        <%# `coordinates ? …` alone throws when the local was never passed at all —
            an absent EJS local is an undeclared identifier, not an undefined one.
            Guarded with typeof, the same way isPriceAlertActive is above. %>
        <% const mapPoint = (typeof coordinates !== 'undefined' && coordinates) ? coordinates : null; %>
        <div id="listingMapContainer" style="height: 380px; width: 100%;"
             data-lat="<%= mapPoint ? mapPoint.lat : 35.1856 %>"
             data-lng="<%= mapPoint ? mapPoint.lng : 33.3823 %>"
             data-zoom="<%= mapPoint ? mapPoint.zoom : 13 %>"
             data-title="<%= listing.title %>"
             data-city="<%= helpers.getCityName(listing.location_city, lang) %>"
             data-district="<%= listing.location_district || '' %>"
             data-exact="<%= mapPoint && mapPoint.isExact ? '1' : '0' %>">
        </div>
      </div>
      <div class="modal-footer border-top px-4 py-3 bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="small text-muted d-flex align-items-center gap-2">
          <i class="fa-solid fa-location-dot text-primary"></i>
          <span><%= helpers.getCityName(listing.location_city, lang) %><%= listing.location_district ? ' / ' + listing.location_district : '' %></span>
          <% if (!mapPoint || !mapPoint.isExact) { %>
            <span class="badge bg-secondary-subtle text-secondary border rounded-pill" style="font-size: 0.72rem;"><%= t('map.approximate') || 'Yaklaşık Şehir Merkezi' %></span>
          <% } %>
        </div>
        <div class="d-flex gap-2">
          <a href="https://www.google.com/maps/search/?api=1&query=<%= mapPoint ? mapPoint.lat : '' %>,<%= mapPoint ? mapPoint.lng : '' %>" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm rounded-pill fw-medium d-flex align-items-center gap-1">
            <i class="fa-brands fa-google"></i> Google Maps'te Aç
          </a>
          <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Kapat</button>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="quickOfferModal" tabindex="-1" aria-labelledby="quickOfferModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">

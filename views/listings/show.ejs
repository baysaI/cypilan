<% const fmt = (amt, curr) => helpers.formatPrice(amt, curr, typeof currency !== 'undefined' ? currency : 'TRY'); %>
<% const imgs = (listing.images && listing.images.length > 0) ? listing.images : []; %>

<div class="bg-light py-3 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted"><i class="fa-solid fa-house"></i></a></li>
                <% if (listing.category_slug) { %>
                    <li class="breadcrumb-item"><a href="/listings?category=<%= listing.category_id %>" class="text-decoration-none text-muted"><%= listing.category_name %></a></li>
                <% } %>
                <li class="breadcrumb-item active fw-medium text-dark text-truncate" style="max-width: 260px;" aria-current="page"><%= listing.title %></li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-4 py-md-5">
    <div class="row g-4 g-xl-5">

        <div class="col-12 col-lg-8">

            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h1 class="fs-3 fw-bold mb-2"><%= listing.title %></h1>
                    <div class="d-flex align-items-center text-muted small fw-medium gap-3 flex-wrap">
                        <span><i class="fa-solid fa-location-dot text-primary me-1"></i> <%= helpers.getCityName(listing.location_city, lang) || '-' %><%= listing.location_district ? ', ' + listing.location_district : '' %></span>
                        <span><i class="fa-regular fa-clock me-1"></i> <%= helpers.timeAgo(listing.created_at, lang) %></span>
                        <span><i class="fa-regular fa-eye me-1"></i> <%= listing.views_count || 0 %></span>
                        <span><%= t('listing.ad_no') %> <strong class="text-dark">#<%= listing.id %></strong></span>
                    </div>
                </div>
                <div class="text-end d-none d-md-block">
                    <h2 class="text-primary fw-bolder mb-0"><%= fmt(listing.price, listing.currency) %></h2>
                </div>
            </div>

            <div class="d-md-none mb-3">
                <h2 class="text-primary fw-bolder mb-0 fs-1"><%= fmt(listing.price, listing.currency) %></h2>
            </div>

            <div class="card border-0 rounded-4 overflow-hidden mb-4 shadow-sm">
                <% if (imgs.length > 0) { %>
                    <div id="listingCarousel" class="carousel slide">
                        <div class="carousel-inner bg-dark" style="aspect-ratio: 16/10;">
                            <% imgs.forEach(function(img, i) { %>
                                <div class="carousel-item h-100 <%= i === 0 ? 'active' : '' %>">
                                    <img src="<%= img %>" class="d-block w-100 h-100 object-fit-contain" alt="<%= listing.title %>">
                                </div>
                            <% }); %>
                        </div>
                        <% if (imgs.length > 1) { %>
                            <button class="carousel-control-prev" type="button" data-bs-target="#listingCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon bg-dark bg-opacity-50 rounded-circle p-3" aria-hidden="true"></span>
                                <span class="visually-hidden"><%= t('common.previous') %></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#listingCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon bg-dark bg-opacity-50 rounded-circle p-3" aria-hidden="true"></span>
                                <span class="visually-hidden"><%= t('common.next') %></span>
                            </button>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="bg-light d-flex flex-column align-items-center justify-content-center text-muted" style="aspect-ratio: 16/10;">
                        <i class="fa-regular fa-image fs-1 mb-2 opacity-50"></i>
                        <span class="small"><%= t('listing.no_images') %></span>
                    </div>
                <% } %>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 border-bottom pb-2"><%= t('listing.attributes') %></h5>
                    <div class="row row-cols-2 row-cols-md-3 g-4">
                        <div class="col">
                            <div class="text-muted small mb-1"><%= t('listing.category') %></div>
                            <div class="fw-bold text-dark"><%= listing['category_name_' + lang] || listing.category_name || '-' %></div>
                        </div>
                        <div class="col">
                            <div class="text-muted small mb-1"><%= t('listing.city') %></div>
                            <div class="fw-bold text-dark"><%= helpers.getCityName(listing.location_city, lang) || '-' %></div>
                        </div>
                        <div class="col">
                            <div class="text-muted small mb-1"><%= t('listing.district') %></div>
                            <div class="fw-bold text-dark"><%= listing.location_district || '-' %></div>
                        </div>
                        <div class="col">
                            <div class="text-muted small mb-1"><%= t('listing.date') %></div>
                            <div class="fw-bold text-dark"><%= helpers.formatDate(listing.created_at, lang) %></div>
                        </div>
                        <div class="col">
                            <div class="text-muted small mb-1"><%= t('listing.price') %></div>
                            <div class="fw-bold text-dark"><%= fmt(listing.price, listing.currency) %></div>
                        </div>
                        <div class="col">
                            <div class="text-muted small mb-1"><%= t('listing.views') %></div>
                            <div class="fw-bold text-dark"><%= listing.views_count || 0 %></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 border-bottom pb-2"><%= t('listing.description') %></h5>
                    <div class="lh-lg text-dark" style="white-space: pre-line;"><%= listing.description || '' %></div>
                </div>
            </div>

        </div>

        <div class="col-12 col-lg-4">
            <div class="d-none d-lg-flex gap-2 mb-4">
                <button class="btn btn-outline-primary rounded-pill flex-fill fw-medium d-flex align-items-center justify-content-center gap-2 favorite-btn" data-id="<%= listing.id %>">
                    <i class="fa-regular fa-heart"></i> <%= t('listing.add_favorite') %>
                </button>
                <button class="btn btn-outline-secondary rounded-pill flex-fill fw-medium d-flex align-items-center justify-content-center gap-2">
                    <i class="fa-solid fa-share-nodes"></i> <%= t('common.share') %>
                </button>
            </div>

            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 100px;">
                <div class="card-body p-4 text-center">
                    <div class="position-relative d-inline-block mb-3">
                        <img src="<%= listing.seller_avatar || '/img/logo.png' %>" class="rounded-circle border border-3 border-white shadow-sm object-fit-cover bg-light" width="90" height="90" alt="<%= listing.seller_name %>">
                    </div>

                    <h5 class="fw-bold mb-1"><%= listing.seller_company || listing.seller_name || t('user.member') %></h5>
                    <p class="text-muted small mb-3"><%= listing.seller_role === 'business' ? t('user.business_member') : (listing.seller_role === 'agent' ? t('user.agent_member') : t('user.individual_member')) %></p>

                    <% if (listing.seller_since) { %>
                        <p class="small text-muted mb-4"><i class="fa-regular fa-calendar me-1"></i> <%= helpers.formatDate(listing.seller_since, lang) %> (<%= t('user.member_since') %>)</p>
                    <% } %>

                    <div class="d-grid gap-3">
                        <% if (listing.has_phone) { %>
                            <div id="phoneReveal"
                                 data-listing-id="<%= listing.id %>"
                                 data-authenticated="<%= currentUser ? '1' : '0' %>"
                                 data-login-url="/auth/login">
                                <button type="button" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm w-100 d-flex align-items-center justify-content-center gap-2" id="revealPhoneBtn">
                                    <i class="fa-solid fa-phone"></i>
                                    <span id="phoneText"><%= listing.seller_phone_masked %></span>
                                </button>
                                <div class="form-text text-center mt-1" id="phoneHint">
                                    <% if (currentUser) { %>
                                        <%= t('listing.click_to_see_phone') %>
                                    <% } else { %>
                                        <%= t('listing.login_to_see_phone') %>
                                    <% } %>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="alert alert-light border small mb-0"><%= t('listing.no_phone_provided') %></div>
                        <% } %>
                        <% if (!currentUser) { %>
                            <a href="/auth/login" class="btn btn-outline-primary rounded-pill fw-medium">
                                <i class="fa-regular fa-comment-dots me-2"></i> Mesaj Gönder
                            </a>
                        <% } else if (currentUser.id !== listing.user_id) { %>
                            <a href="/messages/<%= listing.user_id %>?listing=<%= listing.id %>" class="btn btn-outline-primary rounded-pill fw-medium">
                                <i class="fa-regular fa-comment-dots me-2"></i> Mesaj Gönder
                            </a>
                        <% } %>
                        <a href="/profile/<%= listing.user_id %>" class="btn btn-outline-dark rounded-pill fw-medium">
                            <i class="fa-regular fa-user me-2"></i> <%= t('user.seller_profile') %>
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": listing.title,
  "image": imgs.length > 0 ? siteUrl + imgs[0] : undefined,
  "description": listing.description || undefined,
  "offers": {
    "@type": "Offer",
    "url": siteUrl + '/listings/' + listing.slug,
    "priceCurrency": listing.currency || 'TRY',
    "price": String(listing.price == null ? '' : listing.price),
    "availability": "https://schema.org/InStock",
    "seller": { "@type": "Person", "name": listing.seller_name || '' }
  }
}) %>
</script>

<script>
(function () {
    var wrapper = document.getElementById('phoneReveal');
    if (!wrapper) return;

    var btn = document.getElementById('revealPhoneBtn');
    var text = document.getElementById('phoneText');
    var hint = document.getElementById('phoneHint');
    var listingId = wrapper.getAttribute('data-listing-id');
    var authenticated = wrapper.getAttribute('data-authenticated') === '1';

    btn.addEventListener('click', function () {
        if (!authenticated) {
            window.location.href = wrapper.getAttribute('data-login-url');
            return;
        }

        btn.disabled = true;
        var previous = text.textContent;
        text.textContent = 'Yükleniyor...';

        fetch('/listings/' + listingId + '/phone', {
            headers: { 'Accept': 'application/json' },
            credentials: 'same-origin'
        })
            .then(function (res) {
                return res.json().then(function (data) {
                    return { ok: res.ok, data: data };
                });
            })
            .then(function (result) {
                if (!result.ok) {
                    text.textContent = previous;
                    btn.disabled = false;
                    if (hint) {
                        hint.textContent = result.data.error || 'Numara alınamadı.';
                        hint.className = 'form-text text-center mt-1 text-danger';
                    }
                    return;
                }

                text.textContent = result.data.phone;
                btn.classList.remove('btn-primary');
                btn.classList.add('btn-success');
                if (hint) hint.remove();

                var call = document.createElement('a');
                call.href = 'tel:' + result.data.phone;
                call.className = 'btn btn-primary btn-lg rounded-pill fw-bold shadow-sm w-100 mt-2 d-flex align-items-center justify-content-center gap-2';
                call.innerHTML = '<i class="fa-solid fa-phone"></i> Ara';
                wrapper.appendChild(call);

                var wa = document.createElement('a');
                wa.href = 'https://wa.me/' + result.data.whatsapp;
                wa.target = '_blank';
                wa.rel = 'noopener';
                wa.className = 'btn btn-lg rounded-pill fw-bold shadow-sm w-100 mt-2 text-white d-flex align-items-center justify-content-center gap-2 border-0';
                wa.style.background = 'linear-gradient(135deg, #25D366 0%, #128C7E 100%)';
                wa.innerHTML = '<i class="fa-brands fa-whatsapp fs-5"></i> WhatsApp';
                wrapper.appendChild(wa);

                btn.disabled = true;
            })
            .catch(function () {
                text.textContent = previous;
                btn.disabled = false;
                if (hint) {
                    hint.textContent = 'Bağlantı hatası. Tekrar deneyin.';
                    hint.className = 'form-text text-center mt-1 text-danger';
                }
            });
    });
})();
</script>

                                <span class="text-muted">(<%= t('reviews.count', { count: sellerRating.total }) %>)</span>
                            </a>
                        <% } else { %>
                            <span class="text-muted"><i class="fa-regular fa-star me-1"></i><%= t('reviews.not_rated_yet') %></span>

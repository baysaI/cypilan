<script>
document.addEventListener('DOMContentLoaded', () => {
    const presetBtns = document.querySelectorAll('.cyp-notice-preset-btn');
    const titleInput = document.getElementById('adminNoticeTitle');
    const msgInput = document.getElementById('adminNoticeMessage');

    presetBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            presetBtns.forEach(b => {
                b.classList.remove('btn-warning', 'text-dark', 'fw-bold');
                b.classList.add('btn-outline-secondary');
            });
            this.classList.remove('btn-outline-secondary');
            this.classList.add('btn-warning', 'text-dark', 'fw-bold');

            if (titleInput) titleInput.value = this.getAttribute('data-title') || '';
            if (msgInput) {
                msgInput.value = this.getAttribute('data-msg') || '';
                msgInput.focus();
            }
        });
    });
});
</script>

<script>
(function() {
    function initCypilanStoryMaker() {
        const canvas = document.getElementById('storyCanvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        const W = 1080;
        const H = 1920;
        canvas.width = W;
        canvas.height = H;

        let activeData = {
            title: <%- JSON.stringify(listing.title || '') %>,
            price: <%- JSON.stringify(listing.price ? helpers.formatPrice(listing.price, listing.currency) : '') %>,
            city: <%- JSON.stringify(helpers.getCityName(listing.location_city, lang) || '') %>,
            category: <%- JSON.stringify(listing.category_name || '') %>,
            image: <%- JSON.stringify(imgs && imgs[0] ? imgs[0] : '/img/logo.svg') %>,
            url: window.location.href
        };

        let cachedBlob = null;

        function roundRect(ctx, x, y, w, h, radius) {
            ctx.beginPath();
            ctx.moveTo(x + radius, y);
            ctx.lineTo(x + w - radius, y);
            ctx.arcTo(x + w, y, x + w, y + radius, radius);
            ctx.lineTo(x + w, y + h - radius);
            ctx.arcTo(x + w, y + h, x + w - radius, y + h, radius);
            ctx.lineTo(x + radius, y + h);
            ctx.arcTo(x, y + h, x, y + h - radius, radius);
            ctx.lineTo(x, y + radius);
            ctx.arcTo(x, y, x + radius, y, radius);
            ctx.closePath();
        }

        // Vector Tag Icon for Category Badge
        function drawVectorTag(ctx, x, y, size, color) {
            ctx.save();
            ctx.translate(x, y);
            ctx.fillStyle = color;
            const w = size * 1.15;
            const h = size * 0.76;
            const cut = size * 0.28;
            ctx.beginPath();
            ctx.moveTo(cut, 0);
            ctx.lineTo(w - 2, 0);
            ctx.arcTo(w, 0, w, 2, 3);
            ctx.lineTo(w, h - 2);
            ctx.arcTo(w, h, w - 2, h, 3);
            ctx.lineTo(cut, h);
            ctx.lineTo(0, h / 2);
            ctx.closePath();
            ctx.fill();
            // Hole
            ctx.fillStyle = '#0f172a';
            ctx.beginPath();
            ctx.arc(size * 0.76, h / 2, size * 0.13, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
        }

        // Vector Pin Icon for Location Badge
        function drawVectorPin(ctx, x, y, size, color) {
            ctx.save();
            ctx.translate(x, y);
            ctx.fillStyle = color;
            const r = size * 0.42;
            ctx.beginPath();
            ctx.arc(0, -size * 0.12, r, Math.PI * 0.78, Math.PI * 2.22, false);
            ctx.lineTo(0, size * 0.46);
            ctx.closePath();
            ctx.fill();
            // Inner cutout
            ctx.fillStyle = '#0f172a';
            ctx.beginPath();
            ctx.arc(0, -size * 0.12, r * 0.46, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
        }

        // Vector Sparkle Star
        function drawVectorSparkle(ctx, x, y, size, color) {
            ctx.save();
            ctx.translate(x, y);
            ctx.fillStyle = color;
            ctx.beginPath();
            const r1 = size / 2;
            const r2 = size / 6;
            for (let i = 0; i < 8; i++) {
                const r = (i % 2 === 0) ? r1 : r2;
                const a = (i * Math.PI) / 4;
                const px = Math.cos(a) * r;
                const py = Math.sin(a) * r;
                if (i === 0) ctx.moveTo(px, py);
                else ctx.lineTo(px, py);
            }
            ctx.closePath();
            ctx.fill();
            ctx.restore();
        }

        const FONT_FAMILY = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", "Helvetica Neue", Arial, sans-serif';

        function drawStory(imgObj) {
            ctx.save();
            ctx.clearRect(0, 0, W, H);

            // 1. Background Gradient
            const bg = ctx.createLinearGradient(0, 0, W, H);
            bg.addColorStop(0, '#0a0f1d');
            bg.addColorStop(0.5, '#0f172a');
            bg.addColorStop(1, '#030712');
            ctx.fillStyle = bg;
            ctx.fillRect(0, 0, W, H);

            // Ambient Glows
            const orb1 = ctx.createRadialGradient(250, 200, 30, 250, 200, 450);
            orb1.addColorStop(0, 'rgba(14, 165, 233, 0.25)');
            orb1.addColorStop(1, 'rgba(14, 165, 233, 0)');
            ctx.fillStyle = orb1;
            ctx.fillRect(0, 0, W, H);

            const orb2 = ctx.createRadialGradient(850, 1300, 30, 850, 1300, 500);
            orb2.addColorStop(0, 'rgba(234, 179, 8, 0.18)');
            orb2.addColorStop(1, 'rgba(234, 179, 8, 0)');
            ctx.fillStyle = orb2;
            ctx.fillRect(0, 0, W, H);

            // 2. Header Brand
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillStyle = '#ffffff';
            ctx.font = '900 64px ' + FONT_FAMILY;
            ctx.fillText('CYPILAN', W / 2, 110);

            ctx.fillStyle = '#94a3b8';
            ctx.font = '700 24px ' + FONT_FAMILY;
            ctx.fillText("KIBRIS'IN İLAN PAZARYERİ • cypilan.com", W / 2, 165);

            // 3. Photo Card
            const photoX = 80;
            const photoY = 210;
            const photoW = 920;
            const photoH = 820;

            ctx.save();
            roundRect(ctx, photoX, photoY, photoW, photoH, 36);
            ctx.clip();

            if (imgObj && imgObj.width > 0 && imgObj.height > 0) {
                const imgAspect = imgObj.width / imgObj.height;
                const boxAspect = photoW / photoH;
                let dw, dh, dx, dy;

                if (imgAspect > boxAspect) {
                    dh = photoH;
                    dw = photoH * imgAspect;
                    dx = photoX - (dw - photoW) / 2;
                    dy = photoY;
                } else {
                    dw = photoW;
                    dh = photoW / imgAspect;
                    dx = photoX;
                    dy = photoY - (dh - photoH) / 2;
                }
                ctx.drawImage(imgObj, dx, dy, dw, dh);

                const vig = ctx.createLinearGradient(0, photoY + photoH - 240, 0, photoY + photoH);
                vig.addColorStop(0, 'rgba(0,0,0,0)');
                vig.addColorStop(1, 'rgba(0,0,0,0.75)');
                ctx.fillStyle = vig;
                ctx.fillRect(photoX, photoY + photoH - 240, photoW, 240);
            } else {
                ctx.fillStyle = '#1e293b';
                ctx.fillRect(photoX, photoY, photoW, photoH);
                ctx.fillStyle = '#64748b';
                ctx.font = '600 34px ' + FONT_FAMILY;
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText('📷 CYPILAN İLAN GÖRSELİ', W / 2, photoY + photoH / 2);
            }
            ctx.restore();

            // Photo Border
            ctx.save();
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.18)';
            ctx.lineWidth = 3;
            roundRect(ctx, photoX, photoY, photoW, photoH, 36);
            ctx.stroke();
            ctx.restore();

            // Top-left Tag on Photo
            ctx.save();
            ctx.fillStyle = '#0284c7';
            const tagBadgeW = 220;
            const tagBadgeH = 52;
            roundRect(ctx, photoX + 24, photoY + 24, tagBadgeW, tagBadgeH, 26);
            ctx.fill();
            drawVectorSparkle(ctx, photoX + 48, photoY + 24 + tagBadgeH / 2, 18, '#ffffff');
            ctx.fillStyle = '#ffffff';
            ctx.font = '700 23px ' + FONT_FAMILY;
            ctx.textAlign = 'left';
            ctx.textBaseline = 'middle';
            ctx.fillText('GÜNCEL İLAN', photoX + 66, photoY + 24 + tagBadgeH / 2);
            ctx.restore();

            // 4. Details Section (Row 1: Price + Category)
            const row1Y = photoY + photoH + 40; // 1070
            const row1H = 84;

            let pW = 0;
            if (activeData.price) {
                ctx.save();
                ctx.font = '900 52px ' + FONT_FAMILY;
                const pText = String(activeData.price).trim();
                pW = ctx.measureText(pText).width + 60;

                const pGrad = ctx.createLinearGradient(photoX, row1Y, photoX + pW, row1Y + row1H);
                pGrad.addColorStop(0, '#f59e0b');
                pGrad.addColorStop(1, '#d97706');
                ctx.fillStyle = pGrad;
                roundRect(ctx, photoX, row1Y, pW, row1H, 22);
                ctx.fill();

                ctx.fillStyle = '#0f172a';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(pText, photoX + pW / 2, row1Y + row1H / 2);
                ctx.restore();
            }

            if (activeData.category) {
                ctx.save();
                ctx.font = '700 28px ' + FONT_FAMILY;
                const catName = String(activeData.category).trim();
                const iconSize = 22;
                const iconGap = 12;
                const padX = 24;
                const textW = ctx.measureText(catName).width;

                let catX = photoX;
                if (pW > 0) {
                    catX = photoX + pW + 16;
                }

                const maxCatW = (photoX + photoW) - catX;
                let catW = padX * 2 + iconSize + iconGap + textW;
                if (catW > maxCatW) {
                    catW = maxCatW;
                }

                if (catW >= 120) {
                    // Pill background
                    ctx.fillStyle = 'rgba(255, 255, 255, 0.12)';
                    ctx.strokeStyle = 'rgba(255, 255, 255, 0.20)';
                    ctx.lineWidth = 1.5;
                    roundRect(ctx, catX, row1Y, catW, row1H, 22);
                    ctx.fill();
                    ctx.stroke();

                    // Vector Tag Icon
                    const iconX = catX + padX;
                    const iconY = row1Y + (row1H - iconSize * 0.76) / 2;
                    drawVectorTag(ctx, iconX, iconY, iconSize, '#fbbf24');

                    // Category Text
                    ctx.fillStyle = '#f8fafc';
                    ctx.textAlign = 'left';
                    ctx.textBaseline = 'middle';
                    const textStartX = iconX + iconSize + iconGap;
                    const availTextW = catW - (padX * 2 + iconSize + iconGap);

                    let displayText = catName;
                    if (ctx.measureText(displayText).width > availTextW && availTextW > 30) {
                        while (displayText.length > 2 && ctx.measureText(displayText + '...').width > availTextW) {
                            displayText = displayText.slice(0, -1);
                        }
                        displayText += '...';
                    }
                    ctx.fillText(displayText, textStartX, row1Y + row1H / 2);
                }
                ctx.restore();
            }

            // Row 2: Location
            const row2Y = row1Y + row1H + 20; // 1174
            const row2H = 64;

            if (activeData.city) {
                ctx.save();
                ctx.font = '600 28px ' + FONT_FAMILY;
                const cityLabel = String(activeData.city).trim() + ', KKTC';
                const iconSize = 20;
                const iconGap = 12;
                const padX = 22;
                const textW = ctx.measureText(cityLabel).width;
                const cityW = padX * 2 + iconSize + iconGap + textW;

                ctx.fillStyle = 'rgba(56, 189, 248, 0.14)';
                ctx.strokeStyle = 'rgba(56, 189, 248, 0.35)';
                ctx.lineWidth = 1.5;
                roundRect(ctx, photoX, row2Y, cityW, row2H, 20);
                ctx.fill();
                ctx.stroke();

                // Vector Pin Icon
                const pinX = photoX + padX + iconSize / 2;
                const pinY = row2Y + row2H / 2;
                drawVectorPin(ctx, pinX, pinY, iconSize, '#38bdf8');

                // Location Text
                ctx.fillStyle = '#38bdf8';
                ctx.textAlign = 'left';
                ctx.textBaseline = 'middle';
                ctx.fillText(cityLabel, photoX + padX + iconSize + iconGap, row2Y + row2H / 2);
                ctx.restore();
            }

            // Row 3: Listing Title
            const titleY = row2Y + row2H + 35; // 1273
            ctx.save();
            ctx.fillStyle = '#ffffff';
            ctx.font = '800 48px ' + FONT_FAMILY;
            ctx.textAlign = 'left';
            ctx.textBaseline = 'top';

            const maxTitleW = photoW;
            const words = (activeData.title || '').split(' ');
            let line = '';
            let curY = titleY;
            let linesCount = 0;

            for (let i = 0; i < words.length; i++) {
                const testLine = line + words[i] + ' ';
                const testWidth = ctx.measureText(testLine).width;
                if (testWidth > maxTitleW && i > 0) {
                    ctx.fillText(line.trim(), photoX, curY);
                    line = words[i] + ' ';
                    curY += 66;
                    linesCount++;
                    if (linesCount >= 3 && i < words.length - 1) {
                        line = line + '...';
                        break;
                    }
                } else {
                    line = testLine;
                }
            }
            if (line) ctx.fillText(line.trim(), photoX, curY);
            ctx.restore();

            // Footer CTA Button
            const footY = H - 180;
            ctx.save();
            ctx.fillStyle = 'rgba(255, 255, 255, 0.08)';
            ctx.strokeStyle = 'rgba(56, 189, 248, 0.4)';
            ctx.lineWidth = 2.5;
            roundRect(ctx, photoX, footY, photoW, 110, 30);
            ctx.fill();
            ctx.stroke();

            ctx.fillStyle = '#38bdf8';
            ctx.font = '700 32px ' + FONT_FAMILY;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('Detaylar & İletişim İçin: cypilan.com  →', W / 2, footY + 55);
            ctx.restore();

            ctx.restore();

            try {
                canvas.toBlob((blob) => {
                    cachedBlob = blob;
                }, 'image/png');
            } catch(e) {}
        }

        function triggerRender() {
            drawStory(null);
            if (activeData.image) {
                const img = new Image();
                if (activeData.image.startsWith('http://') || activeData.image.startsWith('https://')) {
                    try {
                        const parsed = new URL(activeData.image);
                        if (parsed.host !== window.location.host) {
                            img.crossOrigin = 'anonymous';
                        }
                    } catch(e) {
                        img.crossOrigin = 'anonymous';
                    }
                }
                img.onload = () => drawStory(img);
                img.onerror = () => {
                    if (img.crossOrigin) {
                        const fallback = new Image();
                        fallback.onload = () => drawStory(fallback);
                        fallback.onerror = () => drawStory(null);
                        fallback.src = activeData.image;
                    } else {
                        drawStory(null);
                    }
                };
                img.src = activeData.image;
            }
        }

        // Direct Story Buttons
        document.querySelectorAll('.direct-story-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                activeData = {
                    title: btn.getAttribute('data-title') || activeData.title,
                    price: btn.getAttribute('data-price') || activeData.price,
                    city: btn.getAttribute('data-city') || activeData.city,
                    category: btn.getAttribute('data-category') || activeData.category,
                    image: btn.getAttribute('data-image') || activeData.image,
                    url: btn.getAttribute('data-url') || activeData.url
                };
                triggerRender();
            });
        });

        const openBtn = document.getElementById('openStoryMakerBtn');
        if (openBtn) {
            openBtn.addEventListener('click', () => {
                triggerRender();
            });
        }

        const modalEl = document.getElementById('storyMakerModal');
        if (modalEl) {
            modalEl.addEventListener('show.bs.modal', triggerRender);
            modalEl.addEventListener('shown.bs.modal', triggerRender);
        }

        // Download Button
        const dlBtn = document.getElementById('downloadStoryBtn');
        if (dlBtn) {
            dlBtn.addEventListener('click', () => {
                try {
                    const dataUrl = canvas.toDataURL('image/png');
                    const link = document.createElement('a');
                    link.download = (activeData.title || 'cypilan-ilan').substring(0, 30).toLowerCase().replace(/[^a-z0-9]/g, '-') + '-story.png';
                    link.href = dataUrl;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                } catch(e) {
                    if (cachedBlob) {
                        const url = URL.createObjectURL(cachedBlob);
                        const link = document.createElement('a');
                        link.download = 'cypilan-story.png';
                        link.href = url;
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                        setTimeout(() => URL.revokeObjectURL(url), 1000);
                    }
                }
            });
        }

        // Share Native Button
        const shareNativeBtn = document.getElementById('shareStoryNativeBtn');
        if (shareNativeBtn) {
            shareNativeBtn.addEventListener('click', async () => {
                if (navigator.share) {
                    try {
                        if (cachedBlob && navigator.canShare && navigator.canShare({ files: [new File([cachedBlob], 'cypilan-story.png', { type: 'image/png' })] })) {
                            const file = new File([cachedBlob], 'cypilan-story.png', { type: 'image/png' });
                            await navigator.share({
                                title: activeData.title,
                                text: (activeData.title || '') + ' - Cypilan.com',
                                files: [file]
                            });
                            return;
                        }
                        await navigator.share({
                            title: activeData.title,
                            text: (activeData.title || '') + ' • Cypilan.com',
                            url: activeData.url
                        });
                    } catch(err) {}
                } else if (dlBtn) {
                    dlBtn.click();
                }
            });
        }

        // Initial Render
        triggerRender();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCypilanStoryMaker);
    } else {
        initCypilanStoryMaker();
    }
})();
</script>


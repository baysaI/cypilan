<div class="bg-primary text-white py-4 py-md-5">
    <div class="container text-center">
        <h1 class="fw-bold mb-2 d-flex align-items-center justify-content-center gap-2">
            <i class="fa-regular fa-bell"></i>
            <%= t('notifications.title') || 'Bildirimler' %>
        </h1>
        <p class="text-white-50 mb-0"><%= t('notifications.subtitle') || 'İlanlarınız ve hesabınızla ilgili tüm anlık güncellemeler' %></p>
    </div>
</div>

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-8">

            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-2 border-bottom">
                <ul class="nav nav-pills gap-2">
                    <li class="nav-item">
                        <a class="nav-link rounded-pill <%= filter !== 'unread' ? 'active fw-bold' : 'text-muted bg-light' %> px-3 py-2" href="/notifications">
                            <%= t('notifications.all') || 'Tümü' %>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link rounded-pill <%= filter === 'unread' ? 'active fw-bold' : 'text-muted bg-light' %> px-3 py-2 d-flex align-items-center gap-2" href="/notifications?filter=unread">
                            <%= t('notifications.unread') || 'Okunmamış' %>
                            <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
                                <span class="badge rounded-pill <%= filter === 'unread' ? 'bg-white text-primary' : 'bg-danger text-white' %>"><%= unreadCount %></span>
                            <% } %>
                        </a>
                    </li>
                </ul>

                <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
                    <form action="/notifications/mark-all-read" method="POST" class="m-0">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-none fw-medium">
                            <i class="fa-solid fa-check-double me-1"></i><%= t('notifications.mark_all_read') || 'Tümünü Okundu İşaretle' %>
                        </button>
                    </form>
                <% } %>
            </div>

            <% if (notifications && notifications.length > 0) { %>
                <div class="d-flex flex-column gap-3">
                    <% notifications.forEach(function(item) { %>
                        <%
                            let iconClass = 'fa-solid fa-bell text-primary';
                            let iconBg = 'bg-primary-subtle';
                            if (item.type === 'favorite') {
                                iconClass = 'fa-solid fa-heart text-danger';
                                iconBg = 'bg-danger-subtle';
                            } else if (item.type === 'warning') {
                                iconClass = 'fa-solid fa-triangle-exclamation text-warning';
                                iconBg = 'bg-warning-subtle';
                            } else if (item.type === 'bid') {
                                iconClass = 'fa-solid fa-gavel text-success';
                                iconBg = 'bg-success-subtle';
                            } else if (item.type === 'application') {
                                iconClass = 'fa-solid fa-briefcase text-info';
                                iconBg = 'bg-info-subtle';
                            } else if (item.type === 'service') {
                                iconClass = 'fa-solid fa-handshake text-purple';
                                iconBg = 'bg-light';
                            }
                        %>
                        <div class="card border-0 shadow-sm rounded-4 position-relative overflow-hidden transition-all <%= !item.is_read ? 'border-start border-4 border-primary bg-light' : 'bg-white' %>">
                            <div class="card-body p-3 p-md-4">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="rounded-circle <%= iconBg %> d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px;">
                                        <i class="<%= iconClass %> fs-5"></i>
                                    </div>

                                    <div class="flex-grow-1 min-w-0">
                                        <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                                            <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                                                <%= item.title %>
                                                <% if (!item.is_read) { %>
                                                    <span class="badge bg-primary rounded-pill p-1" style="width: 8px; height: 8px;" title="Okunmadı"></span>
                                                <% } %>
                                            </h6>
                                            <small class="text-muted flex-shrink-0">
                                                <i class="fa-regular fa-clock me-1"></i><%= helpers.formatDate(item.created_at, lang) %>
                                            </small>
                                        </div>

                                        <p class="text-secondary small mb-2 lh-base text-break-anywhere">
                                            <%= item.message %>
                                        </p>

                                        <div class="d-flex align-items-center justify-content-between pt-1">
                                            <% if (item.link_url) { %>
                                                <a href="/notifications/<%= item.id %>/read" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-medium position-relative" style="z-index: 2;">
                                                    <%= t('notifications.view_details') || 'Detayları Gör' %> <i class="fa-solid fa-arrow-right ms-1"></i>
                                                </a>
                                            <% } else { %>
                                                <div></div>
                                            <% } %>

                                            <form action="/notifications/<%= item.id %>/delete" method="POST" class="m-0 position-relative" style="z-index: 2;">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-sm btn-link text-muted p-1 text-decoration-none" title="<%= t('common.delete') || 'Sil' %>">
                                                    <i class="fa-regular fa-trash-can"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% if (item.link_url) { %>
                                <a href="/notifications/<%= item.id %>/read" class="stretched-link" aria-label="<%= item.title %>"></a>
                            <% } %>
                        </div>
                    <% }); %>
                </div>

                <% if (pagination.totalPages > 1) { %>
                    <nav class="mt-4 d-flex justify-content-center" aria-label="Sayfalar">
                        <ul class="pagination">
                            <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                                <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                                    <a class="page-link rounded-pill mx-1 px-3" href="/notifications?page=<%= i %><%= filter === 'unread' ? '&filter=unread' : '' %>"><%= i %></a>
                                </li>
                            <% } %>
                        </ul>
                    </nav>
                <% } %>

            <% } else { %>
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                    <div class="text-muted mb-3">
                        <i class="fa-regular fa-bell-slash fs-1 text-secondary opacity-50"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">
                        <%= filter === 'unread' ? (t('notifications.no_unread') || 'Okunmamış bildiriminiz yok') : (t('notifications.no_notifications') || 'Henüz bildiriminiz bulunmuyor') %>
                    </h5>
                    <p class="text-muted small mb-4">
                        <%= t('notifications.empty_desc') || 'İlanlarınız favoriye eklendiğinde veya önemli sistem bildirimleri geldiğinde burada görüntülenecektir.' %>
                    </p>
                    <div>
                        <a href="/listings" class="btn btn-primary rounded-pill px-4 fw-medium">
                            <i class="fa-solid fa-compass me-1"></i><%= t('nav.browse_listings') || 'İlanları Keşfet' %>
                        </a>
                    </div>
                </div>
            <% } %>

        </div>
    </div>
</div>

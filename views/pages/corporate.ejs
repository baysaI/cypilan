<div class="container py-4 py-md-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted"><i class="fa-solid fa-house"></i> <%= t('nav.home') %></a></li>
            <li class="breadcrumb-item active fw-medium" aria-current="page"><%= t('footer.corporate_membership') %></li>
        </ol>
    </nav>

    <div class="text-center max-w-700 mx-auto mb-5">
        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fw-semibold mb-2"><%= t('pages.corporate.badge') %></span>
        <h1 class="display-6 fw-bold mb-3"><%= t('footer.corporate_membership') %></h1>
        <p class="text-muted lead fs-6"><%= t('pages.corporate.subtitle') %></p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center">
                <div class="icon-wrapper mb-3 text-primary"><i class="fa-solid fa-store fs-1"></i></div>
                <h5 class="fw-bold mb-2"><%= t('pages.corporate.feature1_title') %></h5>
                <p class="text-muted small"><%= t('pages.corporate.feature1_body') %></p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center">
                <div class="icon-wrapper mb-3 text-accent"><i class="fa-solid fa-layer-group fs-1"></i></div>
                <h5 class="fw-bold mb-2"><%= t('pages.corporate.feature2_title') %></h5>
                <p class="text-muted small"><%= t('pages.corporate.feature2_body') %></p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center">
                <div class="icon-wrapper mb-3 text-warning"><i class="fa-solid fa-headset fs-1"></i></div>
                <h5 class="fw-bold mb-2"><%= t('pages.corporate.feature3_title') %></h5>
                <p class="text-muted small"><%= t('pages.corporate.feature3_body') %></p>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4 mb-md-5">
        <div class="card-body p-4 p-md-5">
            <h2 class="fs-4 fw-bold mb-2"><%= t('pages.standards.title') %></h2>
            <p class="text-muted mb-4"><%= t('pages.standards.intro') %></p>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="border rounded-4 p-3 h-100">
                        <div class="d-flex gap-3">
                            <i class="fa-solid fa-globe text-primary mt-1"></i>
                            <div>
                                <h6 class="fw-bold mb-1"><%= t('pages.standards.languages_title') %></h6>
                                <p class="text-muted small mb-0"><%= t('pages.standards.languages_body') %></p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded-4 p-3 h-100">
                        <div class="d-flex gap-3">
                            <i class="fa-solid fa-coins text-primary mt-1"></i>
                            <div>
                                <h6 class="fw-bold mb-1"><%= t('pages.standards.currency_title') %></h6>
                                <p class="text-muted small mb-0"><%= t('pages.standards.currency_body') %></p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded-4 p-3 h-100">
                        <div class="d-flex gap-3">
                            <i class="fa-solid fa-layer-group text-primary mt-1"></i>
                            <div>
                                <h6 class="fw-bold mb-1"><%= t('pages.standards.categories_title') %></h6>
                                <p class="text-muted small mb-0"><%= t('pages.standards.categories_body') %></p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded-4 p-3 h-100">
                        <div class="d-flex gap-3">
                            <i class="fa-solid fa-map-location-dot text-primary mt-1"></i>
                            <div>
                                <h6 class="fw-bold mb-1"><%= t('pages.standards.region_title') %></h6>
                                <p class="text-muted small mb-0"><%= t('pages.standards.region_body') %></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <a href="/yakinda" class="btn btn-outline-primary rounded-pill px-4 fw-medium mt-4">
                <%= t('pages.soon.see_roadmap') %>
            </a>
        </div>
    </div>

    <div class="bg-light rounded-4 p-4 p-md-5 text-center">
        <h3 class="fw-bold mb-2"><%= t('pages.corporate.apply_title') %></h3>
        <p class="text-muted mb-4"><%= t('pages.corporate.apply_body') %></p>
        <a href="mailto:kurumsal@cypilan.com" class="btn btn-primary btn-lg rounded-pill px-4 px-sm-5 fw-bold mw-100 text-break-anywhere"><i class="fa-solid fa-envelope me-2"></i>kurumsal@cypilan.com</a>
    </div>
</div>

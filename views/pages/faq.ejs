                            <i class="fa-solid fa-phone-volume text-primary me-3 fs-5"></i> <%= t('pages.faq.q5') %>
                        </button>
                    </h2>
                    <div id="collapse5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">

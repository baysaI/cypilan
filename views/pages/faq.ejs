                        <button class="accordion-button collapsed fw-bold py-3 px-4 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#collapse6" aria-expanded="false" aria-controls="collapse6">
                            <i class="fa-solid fa-star text-warning me-3 fs-5"></i> <%= t('pages.faq.q6') %>
                        </button>
                    </h2>
                    <div id="collapse6" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body px-4 pb-4 text-muted lh-lg">
                            <%- t('pages.faq.a6') %>
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header" id="faq7">
                        <button class="accordion-button collapsed fw-bold py-3 px-4 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#collapse7" aria-expanded="false" aria-controls="collapse7">
                            <i class="fa-regular fa-clock text-secondary me-3 fs-5"></i> <%= t('pages.faq.q7') %>
                        </button>
                    </h2>
                    <div id="collapse7" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body px-4 pb-4 text-muted lh-lg">
                            <%- t('pages.faq.a7') %>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

                            <i class="fa-solid fa-shield-halved text-primary me-3 fs-5"></i> <%= t('pages.faq.q3') %>
                        </button>
                    </h2>
                    <div id="collapse3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body px-4 pb-4 text-muted lh-lg">
                            <%- t('pages.faq.a3') %>
                        </div>
                    </div>
                </div>

                <div class="accordion-item border-bottom">
                    <h2 class="accordion-header" id="faq4">
                        <button class="accordion-button collapsed fw-bold py-3 px-4 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#collapse4" aria-expanded="false" aria-controls="collapse4">
                            <i class="fa-solid fa-building text-primary me-3 fs-5"></i> <%= t('pages.faq.q4') %>
                        </button>
                    </h2>
                    <div id="collapse4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body px-4 pb-4 text-muted lh-lg">
                            <%- t('pages.faq.a4') %>
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header" id="faq5">

<div class="container py-4 py-md-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted"><i class="fa-solid fa-house"></i> <%= t('nav.home') %></a></li>
            <li class="breadcrumb-item active fw-medium" aria-current="page"><%= t('footer.how_to_post') %></li>
        </ol>
    </nav>

    <div class="text-center max-w-700 mx-auto mb-5">
        <h1 class="display-6 fw-bold mb-3"><%= t('footer.how_to_post') %></h1>
        <p class="text-muted lead fs-6"><%= t('pages.how_to_post.subtitle') %></p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center hover-lift transition-all">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 72px; height: 72px;">
                    <i class="fa-solid fa-user-plus fs-3"></i>
                </div>
                <h5 class="fw-bold mb-2"><%= t('pages.how_to_post.step1_title') %></h5>
                <p class="text-muted small mb-0"><%= t('pages.how_to_post.step1_body') %></p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center hover-lift transition-all">
                <div class="rounded-circle bg-accent bg-opacity-10 text-accent mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 72px; height: 72px;">
                    <i class="fa-solid fa-plus fs-3"></i>
                </div>
                <h5 class="fw-bold mb-2"><%= t('pages.how_to_post.step2_title') %></h5>
                <p class="text-muted small mb-0"><%= t('pages.how_to_post.step2_body') %></p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center hover-lift transition-all">
                <div class="rounded-circle bg-success bg-opacity-10 text-success mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 72px; height: 72px;">
                    <i class="fa-solid fa-camera-retro fs-3"></i>
                </div>
                <h5 class="fw-bold mb-2"><%= t('pages.how_to_post.step3_title') %></h5>
                <p class="text-muted small mb-0"><%= t('pages.how_to_post.step3_body') %></p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center hover-lift transition-all">
                <div class="rounded-circle bg-warning bg-opacity-10 text-warning mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 72px; height: 72px;">
                    <i class="fa-solid fa-rocket fs-3"></i>
                </div>
                <h5 class="fw-bold mb-2"><%= t('pages.how_to_post.step4_title') %></h5>
                <p class="text-muted small mb-0"><%= t('pages.how_to_post.step4_body') %></p>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4 p-md-5">
            <h2 class="fs-4 fw-bold mb-2"><%= t('pages.how_to_post.pricing_title') %></h2>
            <p class="text-muted mb-4"><%= t('pages.how_to_post.pricing_intro') %></p>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="border rounded-4 p-3 h-100">
                        <div class="d-flex align-items-center gap-2 mb-2 text-primary">
                            <i class="fa-solid fa-house"></i>
                            <i class="fa-solid fa-car"></i>
                            <i class="fa-solid fa-couch"></i>
                        </div>
                        <h6 class="fw-bold mb-1"><%= t('pages.how_to_post.goods_title') %></h6>
                        <p class="text-muted small mb-0"><%- t('pages.how_to_post.goods_body') %></p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border border-success rounded-4 p-3 h-100">
                        <div class="mb-2"><i class="fa-solid fa-screwdriver-wrench text-success"></i></div>
                        <h6 class="fw-bold mb-1"><%= t('nav.services') %></h6>
                        <p class="text-muted small mb-0"><%- t('pages.how_to_post.trades_body') %></p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border border-success rounded-4 p-3 h-100">
                        <div class="mb-2"><i class="fa-solid fa-briefcase text-success"></i></div>
                        <h6 class="fw-bold mb-1"><%= t('pages.how_to_post.jobseekers_title') %></h6>
                        <p class="text-muted small mb-0"><%- t('pages.how_to_post.jobseekers_body') %></p>
                    </div>
                </div>
            </div>

            <a href="/ilan-paketleri" class="btn btn-outline-primary rounded-pill px-4 fw-medium">
                <%= t('pages.how_to_post.see_all_packages') %>
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4 p-md-5">
            <h2 class="fs-4 fw-bold mb-2"><%= t('pages.how_to_post.rules_title') %></h2>
            <p class="text-muted mb-4">
                <%= t('pages.how_to_post.rules_intro') %>
            </p>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="fa-solid fa-camera text-danger mt-1"></i>
                        <div>
                            <h6 class="fw-bold mb-1"><%= t('pages.how_to_post.rule_photo_title') %></h6>
                            <p class="text-muted small mb-0"><%= t('pages.how_to_post.rule_photo_body') %></p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="fa-solid fa-folder-tree text-danger mt-1"></i>
                        <div>
                            <h6 class="fw-bold mb-1"><%= t('pages.how_to_post.rule_category_title') %></h6>
                            <p class="text-muted small mb-0"><%= t('pages.how_to_post.rule_category_body') %></p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="fa-solid fa-tag text-danger mt-1"></i>
                        <div>
                            <h6 class="fw-bold mb-1"><%= t('pages.how_to_post.rule_price_title') %></h6>
                            <p class="text-muted small mb-0"><%= t('pages.how_to_post.rule_price_body') %></p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="fa-solid fa-align-left text-danger mt-1"></i>
                        <div>
                            <h6 class="fw-bold mb-1"><%= t('pages.how_to_post.rule_missing_title') %></h6>
                            <p class="text-muted small mb-0"><%= t('pages.how_to_post.rule_missing_body') %></p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="fa-solid fa-money-bill-wave text-primary mt-1"></i>
                        <div>
                            <h6 class="fw-bold mb-1"><%= t('pages.how_to_post.rule_currency_title') %></h6>
                            <p class="text-muted small mb-0"><%= t('pages.how_to_post.rule_currency_body') %></p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="fa-solid fa-flag text-primary mt-1"></i>
                        <div>
                            <h6 class="fw-bold mb-1"><%= t('pages.how_to_post.rule_report_title') %></h6>
                            <p class="text-muted small mb-0"><%= t('pages.how_to_post.rule_report_body') %></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4 p-md-5">
            <h2 class="fs-4 fw-bold mb-2"><%= t('pages.golden.title') %></h2>
            <p class="text-muted mb-4"><%= t('pages.golden.intro') %></p>

            <div class="d-flex flex-column gap-3">
                <% ['photo', 'reply', 'price', 'description', 'onsite'].forEach(function (rule, index) { %>
                    <div class="d-flex gap-3 align-items-start border rounded-4 p-3">
                        <span class="badge rounded-circle bg-primary d-flex align-items-center justify-content-center flex-shrink-0 fs-6"
                              style="width: 40px; height: 40px;"><%= index + 1 %></span>
                        <div>
                            <h6 class="fw-bold mb-1"><%= t('pages.golden.' + rule + '_title') %></h6>
                            <p class="text-muted small mb-0"><%= t('pages.golden.' + rule + '_body') %></p>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </div>

    <div class="card border-0 bg-primary text-white rounded-4 p-4 p-md-5 text-center shadow-lg">
        <h3 class="fw-bold mb-2"><%= t('pages.how_to_post.cta_title') %></h3>
        <p class="text-white-50 mb-4"><%= t('pages.how_to_post.cta_body') %></p>
        <div>
            <a href="/listings/create" class="btn btn-accent btn-lg rounded-pill px-5 fw-bold text-white shadow"><i class="fa-solid fa-plus me-2"></i><%= t('nav.post_ad') %></a>
        </div>
    </div>
</div>

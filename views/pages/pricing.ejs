<div class="container py-4 py-md-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted"><i class="fa-solid fa-house"></i> <%= t('nav.home') %></a></li>
            <li class="breadcrumb-item active fw-medium" aria-current="page"><%= t('footer.pricing') %></li>
        </ol>
    </nav>

    <div class="text-center mx-auto mb-5" style="max-width: 720px;">
        <span class="badge bg-accent rounded-pill px-3 py-2 mb-3"><%= t('pages.pricing.badge') %></span>
        <h1 class="display-6 fw-bold mb-3"><%= t('pages.pricing.title') %></h1>
        <p class="text-muted lead fs-6"><%= t('pages.pricing.subtitle') %></p>
    </div>

    <div class="row g-4 mb-5">
        <% packages.forEach(function(p) { %>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center <%= p.highlighted ? 'bg-accent' : '' %>">
                    <h3 class="fw-bold mb-3"><%= p.name %></h3>
                    <div class="mb-3">
                        <% for (let i = 0; i < p.stars; i++) { %>
                            <i class="fa-solid fa-star <%= p.highlighted ? 'text-dark' : 'text-warning' %>"></i>
                        <% } %>
                    </div>
                    <p class="<%= p.highlighted ? '' : 'text-muted' %> small mb-0"><%= t('pages.pricing.pkg_' + p.key) %></p>
                </div>
            </div>
        <% }); %>
    </div>

    <div class="row g-3 mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="rounded-circle bg-accent d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="fw-bold mb-1"><%= t('pages.pricing.trades_title') %></h6>
                        <p class="text-muted small mb-0"><%= t('pages.pricing.trades_body') %></p>
                    </div>
                    <span class="badge bg-success rounded-pill px-3 py-2 flex-shrink-0"><%= t('pages.pricing.free_badge') %></span>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="rounded-circle bg-accent d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                        <i class="fa-solid fa-briefcase"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="fw-bold mb-1"><%= t('pages.pricing.jobseeker_title') %></h6>
                        <p class="text-muted small mb-0"><%= t('pages.pricing.jobseeker_body') %></p>
                    </div>
                    <span class="badge bg-success rounded-pill px-3 py-2 flex-shrink-0"><%= t('pages.pricing.free_badge') %></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4 p-md-5">
            <h2 class="fs-5 fw-bold mb-4"><%= t('pages.pricing.table_title') %></h2>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="table-light small text-muted">
                        <tr>
                            <th><%= t('pages.pricing.col_user') %></th>
                            <th><%= t('listing.category') %></th>
                            <th><%= t('pages.pricing.col_pricing') %></th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        <tr>
                            <td class="fw-medium"><%= t('pages.pricing.row_individual') %></td>
                            <td><%= t('pages.pricing.row_individual_cats') %></td>
                            <td><%- isUnlimited ? ('<span class="text-success fw-bold">' + t('pages.pricing.unlimited_free') + '</span>') : t('pages.pricing.row_individual_price', { quota: freeQuota }) %></td>
                        </tr>
                        <tr>
                            <td class="fw-medium"><%= t('pages.pricing.row_jobseeker') %></td>
                            <td><%= t('pages.pricing.row_jobseeker_cats') %></td>
                            <td><span class="text-success fw-medium"><%= t('pages.pricing.row_jobseeker_price') %></span></td>
                        </tr>
                        <tr>
                            <td class="fw-medium"><%= t('pages.pricing.row_trades') %></td>
                            <td><%= t('nav.services') %></td>
                            <td><%- t('pages.pricing.row_trades_price') %></td>
                        </tr>
                        <tr>
                            <td class="fw-medium"><%= t('pages.pricing.row_agency') %></td>
                            <td><%= t('pages.pricing.row_agency_cats') %></td>
                            <td><%= t('pages.pricing.row_agency_price') %></td>
                        </tr>
                        <tr>
                            <td class="fw-medium"><%= t('pages.pricing.row_company') %></td>
                            <td><%= t('nav.jobs') %></td>
                            <td><%= t('pages.pricing.row_company_price') %></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <p class="text-muted small mb-0 mt-3"><%= t('pages.pricing.currency_note') %></p>
        </div>
    </div>

    <% const quotaExhausted = !isUnlimited && quota && quota.remaining === 0; %>

    <% if (isUnlimited) { %>
        <div class="card border-0 bg-primary text-white rounded-4 p-4 p-md-5 text-center shadow-lg">
            <h3 class="fw-bold mb-2"><i class="fa-solid fa-gift me-2 text-warning"></i><%= t('pages.pricing.unlimited_banner_title') %></h3>
            <p class="text-white-50 mb-4">
                <%= t('pages.pricing.unlimited_banner_body') %>
            </p>
            <div>
                <a href="/listings/create" class="btn btn-accent btn-lg rounded-pill px-5 fw-bold shadow">
                    <i class="fa-solid fa-plus me-2"></i><%= t('listing.post_ad') %>
                </a>
            </div>
        </div>
    <% } else if (quotaExhausted && !paidTiersLive) { %>
        <div class="card border-0 bg-primary text-white rounded-4 p-4 p-md-5 shadow-lg">
            <h3 class="fw-bold mb-2 text-center"><%= t('pages.pricing.quota_done_title') %></h3>
            <p class="text-white-50 mb-4 text-center"><%= t('pages.pricing.quota_done_body', { limit: quota.limit }) %></p>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="bg-white bg-opacity-10 rounded-4 p-3 h-100">
                        <i class="fa-solid fa-screwdriver-wrench mb-2 fs-5"></i>
                        <h6 class="fw-bold mb-1"><%= t('pages.pricing.opt_free_title') %></h6>
                        <p class="small text-white-50 mb-2"><%= t('pages.pricing.opt_free_body') %></p>
                        <a href="/listings/create" class="small text-white fw-medium"><%= t('pages.pricing.opt_free_link') %> &rarr;</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="bg-white bg-opacity-10 rounded-4 p-3 h-100">
                        <i class="fa-regular fa-rectangle-list mb-2 fs-5"></i>
                        <h6 class="fw-bold mb-1"><%= t('pages.pricing.opt_space_title') %></h6>
                        <p class="small text-white-50 mb-2"><%= t('pages.pricing.opt_space_body') %></p>
                        <a href="/profile/listings" class="small text-white fw-medium"><%= t('nav.my_listings') %> &rarr;</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="bg-white bg-opacity-10 rounded-4 p-3 h-100">
                        <i class="fa-regular fa-envelope mb-2 fs-5"></i>
                        <h6 class="fw-bold mb-1"><%= t('pages.pricing.opt_news_title') %></h6>
                        <p class="small text-white-50 mb-2"><%= t('pages.pricing.opt_news_body') %></p>
                        <a href="mailto:<%= supportEmail %>" class="small text-white fw-medium"><%= supportEmail %> &rarr;</a>
                    </div>
                </div>
            </div>
        </div>
    <% } else { %>
        <div class="card border-0 bg-primary text-white rounded-4 p-4 p-md-5 text-center shadow-lg">
            <h3 class="fw-bold mb-2"><%= t('pages.pricing.soon_title') %></h3>
            <p class="text-white-50 mb-4">
                <%= t('pages.pricing.soon_body') %>
                <% if (quota) { %>
                    <br><span class="text-white fw-medium"><%= t('pages.pricing.remaining', { remaining: quota.remaining, limit: quota.limit }) %></span>
                <% } %>
            </p>
            <div>
                <a href="/listings/create" class="btn btn-accent btn-lg rounded-pill px-5 fw-bold shadow">
                    <i class="fa-solid fa-plus me-2"></i><%= t('listing.post_ad') %>
                </a>
            </div>
        </div>
    <% } %>
</div>

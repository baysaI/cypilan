<%# Bolumler sirali bir listeden basiliyor: onceden bes bolume sabitlenmis
    bir sablondu ve metne bir bolum eklemek sablonu da degistirmeyi
    gerektiriyordu. Bolum metinleri HTML iceriyor (liste, kalin etiket,
    baglanti); kaynaklari depodaki dil dosyalari, kullanici girdisi degil. %>
<% const sections = ['controller', 'data', 'purposes', 'sharing', 'transfer', 'retention', 'messages', 'rights', 'security', 'children', 'changes']; %>
<div class="container py-4 py-md-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted"><i class="fa-solid fa-house"></i> <%= t('nav.home') %></a></li>
            <li class="breadcrumb-item active fw-medium" aria-current="page"><%= t('footer.privacy') %></li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        <h1 class="fs-3 fw-bold mb-2"><%= t('footer.privacy') %></h1>
        <p class="small text-muted mb-4 border-bottom pb-3"><%= t('pages.privacy.updated') %></p>

        <div class="lh-lg text-muted policy-text">
            <p><%= t('pages.privacy.intro') %></p>

            <% sections.forEach(function (id, index) { %>
                <h2 class="fs-5 fw-bold text-dark mt-4 mb-2"><%= index + 1 %>. <%= t('pages.privacy.' + id + '_title') %></h2>
                <%- t('pages.privacy.' + id + '_body', { age: minimumAge }) %>
            <% }); %>
        </div>
    </div>
</div>

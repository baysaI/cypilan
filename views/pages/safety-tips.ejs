<div class="container py-4 py-md-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted"><i class="fa-solid fa-house"></i> <%= t('nav.home') %></a></li>
            <li class="breadcrumb-item active fw-medium" aria-current="page"><%= t('footer.safety_tips') %></li>
        </ol>
    </nav>

    <div class="text-center max-w-700 mx-auto mb-5">
        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2 fw-semibold mb-2"><i class="fa-solid fa-shield-cat me-1"></i> <%= t('pages.safety.badge') %></span>
        <h1 class="display-6 fw-bold mb-3"><%= t('footer.safety_tips') %></h1>
        <p class="text-muted lead fs-6"><%= t('pages.safety.subtitle') %></p>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 border-start border-4 border-primary">
                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 flex-shrink-0">
                        <i class="fa-solid fa-handshake fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-2"><%= t('pages.safety.tip1_title') %></h5>
                        <p class="text-muted small mb-0"><%= t('pages.safety.tip1_body') %></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 border-start border-4 border-accent">
                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-circle bg-accent bg-opacity-10 text-accent p-3 flex-shrink-0">
                        <i class="fa-solid fa-location-dot fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-2"><%= t('pages.safety.tip2_title') %></h5>
                        <p class="text-muted small mb-0"><%= t('pages.safety.tip2_body') %></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 border-start border-4 border-warning">
                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3 flex-shrink-0">
                        <i class="fa-solid fa-lock fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-2"><%= t('pages.safety.tip3_title') %></h5>
                        <p class="text-muted small mb-0"><%= t('pages.safety.tip3_body') %></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 border-start border-4 border-danger">
                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-3 flex-shrink-0">
                        <i class="fa-solid fa-triangle-exclamation fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-2"><%= t('pages.safety.tip4_title') %></h5>
                        <p class="text-muted small mb-0"><%= t('pages.safety.tip4_body') %></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%
    const statusStyles = {
        active: 'bg-success-subtle text-success-emphasis border-success-subtle',
        sold: 'bg-primary-subtle text-primary-emphasis border-primary-subtle',
        pending: 'bg-warning-subtle text-warning-emphasis border-warning-subtle',
        expired: 'bg-secondary-subtle text-secondary-emphasis border-secondary-subtle',
        rejected: 'bg-danger-subtle text-danger-emphasis border-danger-subtle',
        draft: 'bg-secondary-subtle text-secondary-emphasis border-secondary-subtle'
    };

    const tiles = [
        { key: 'views', value: overview.listings.views, icon: 'fa-eye', accent: 'primary' },
        { key: 'active_listings', value: overview.listings.active, icon: 'fa-list-check', accent: 'success' },
        { key: 'favorites', value: overview.favorites, icon: 'fa-heart', accent: 'danger' },
        { key: 'enquiries', value: overview.conversations, icon: 'fa-comments', accent: 'info' }
    ];
%>

<div class="container py-4 py-md-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fs-3 fw-bold mb-1"><%= t('panel.title') %></h1>
            <p class="text-muted small mb-0"><%= t('panel.subtitle') %></p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/profile/listings" class="btn btn-outline-primary rounded-pill px-4 fw-medium">
                <i class="fa-solid fa-list me-2"></i><%= t('nav.my_listings') %>
            </a>
            <a href="/listings/create" class="btn btn-primary rounded-pill px-4 fw-medium">
                <i class="fa-solid fa-plus me-2"></i><%= t('nav.post_ad') %>
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <% tiles.forEach(function (tile) { %>
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-<%= tile.accent %> bg-opacity-10 text-<%= tile.accent %> d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="width: 48px; height: 48px;">
                                <i class="fa-solid <%= tile.icon %>"></i>
                            </div>
                            <div class="min-w-0">
                                <div class="fs-3 fw-bold lh-1"><%= tile.value %></div>
                                <div class="text-muted small text-truncate"><%= t('panel.' + tile.key) %></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h2 class="fs-5 fw-bold mb-1"><%= t('panel.activity') %></h2>
                    <p class="text-muted small mb-4"><%= t('panel.activity_desc', { days: windowDays }) %></p>

                    <% if (activityPeak > 0) { %>
                        <div class="d-flex align-items-end gap-1" style="height: 90px;">
                            <% activity.forEach(function (point) { %>
                                <div class="flex-fill d-flex align-items-end h-100"
                                     title="<%= point.day %>: <%= point.count %>">
                                    <div class="w-100 rounded-top <%= point.count > 0 ? 'bg-primary' : 'bg-light' %>"
                                         style="height: <%= point.count > 0 ? Math.max(8, Math.round((point.count / activityPeak) * 100)) : 4 %>%"></div>
                                </div>
                            <% }); %>
                        </div>
                        <div class="d-flex justify-content-between text-muted small mt-2">
                            <span><%= t('panel.days_ago', { days: windowDays }) %></span>
                            <span><%= t('panel.today') %></span>
                        </div>
                    <% } else { %>
                        <p class="text-muted small mb-0"><%= t('panel.no_activity') %></p>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h2 class="fs-5 fw-bold mb-3"><%= t('panel.benchmark') %></h2>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-muted"><%= t('panel.your_average') %></span>
                            <strong><%= benchmark.mine %></strong>
                        </div>
                        <div class="d-flex justify-content-between small">
                            <span class="text-muted"><%= t('panel.market_average') %></span>
                            <strong><%= benchmark.market %></strong>
                        </div>
                    </div>

                    <% if (benchmark.difference === null) { %>
                        <p class="text-muted small mb-0"><%= t('panel.no_benchmark') %></p>
                    <% } else if (benchmark.difference >= 0) { %>
                        <div class="alert alert-success py-2 px-3 small mb-0">
                            <i class="fa-solid fa-arrow-trend-up me-1"></i>
                            <%= t('panel.above_market', { percent: benchmark.difference }) %>
                        </div>
                    <% } else { %>
                        <div class="alert alert-warning py-2 px-3 small mb-0">
                            <i class="fa-solid fa-arrow-trend-down me-1"></i>
                            <%= t('panel.below_market', { percent: Math.abs(benchmark.difference) }) %>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <% if (isProfessional || overview.offersMade > 0 || overview.offersReceived > 0 || overview.applications > 0) { %>
        <div class="row g-3 mb-4">
            <% if (overview.offersReceived > 0 || pendingBids > 0) { %>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">
                            <div class="fs-4 fw-bold"><%= overview.offersReceived %></div>
                            <div class="text-muted small mb-2"><%= t('panel.offers_received') %></div>
                            <% if (pendingBids > 0) { %>
                                <a href="/profile/teklifler" class="small fw-semibold text-decoration-none">
                                    <%= t('panel.pending_offers', { count: pendingBids }) %> <i class="fa-solid fa-arrow-right ms-1"></i>
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>

            <% if (isProfessional) { %>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">
                            <div class="fs-4 fw-bold">
                                <%= overview.offersWon %> / <%= overview.offersMade %>
                            </div>
                            <div class="text-muted small mb-2"><%= t('panel.offers_won') %></div>
                            <% if (overview.winRate !== null) { %>
                                <span class="badge rounded-pill bg-success-subtle text-success-emphasis border border-success-subtle">
                                    <%= t('panel.win_rate', { percent: overview.winRate }) %>
                                </span>
                            <% } else { %>
                                <span class="text-muted small"><%= t('panel.win_rate_pending') %></span>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>

            <% if (overview.applications > 0 || pendingApplications > 0) { %>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">
                            <div class="fs-4 fw-bold"><%= overview.applications %></div>
                            <div class="text-muted small mb-2"><%= t('panel.applications') %></div>
                            <% if (pendingApplications > 0) { %>
                                <a href="/kariyer/basvurular" class="small fw-semibold text-decoration-none">
                                    <%= t('panel.pending_applications', { count: pendingApplications }) %> <i class="fa-solid fa-arrow-right ms-1"></i>
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    <% } %>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <h2 class="fs-5 fw-bold mb-1"><%= t('panel.per_listing') %></h2>
            <p class="text-muted small mb-4"><%= t('panel.per_listing_desc') %></p>

            <% if (listings.length > 0) { %>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr class="small text-muted">
                                <th scope="col"><%= t('panel.listing') %></th>
                                <th scope="col" class="text-center"><i class="fa-solid fa-eye" title="<%= t('panel.views') %>"></i></th>
                                <th scope="col" class="text-center"><i class="fa-solid fa-heart" title="<%= t('panel.favorites') %>"></i></th>
                                <th scope="col" class="text-center"><i class="fa-regular fa-comment" title="<%= t('panel.enquiries') %>"></i></th>
                                <th scope="col" class="text-center"><i class="fa-solid fa-gavel" title="<%= t('bids.received') %>"></i></th>
                                <th scope="col" class="text-end"><%= t('listing.status') %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% listings.forEach(function (listing) { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="<%= listing.primary_image || '/img/logo.svg' %>"
                                                 class="rounded-3 object-fit-cover bg-light flex-shrink-0"
                                                 width="40" height="40" alt="">
                                            <div class="min-w-0">
                                                <a href="/listings/<%= listing.slug %>" class="text-decoration-none text-body fw-medium d-block text-truncate truncate-md">
                                                    <%= listing.title %>
                                                </a>
                                                <% if (Number(listing.is_premium) === 1 || Number(listing.is_featured) === 1) { %>
                                                    <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                                        <i class="fa-solid fa-crown me-1"></i><%= t('panel.promoted') %>
                                                    </span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center fw-semibold"><%= listing.views_count %></td>
                                    <td class="text-center"><%= listing.favorite_count %></td>
                                    <td class="text-center"><%= listing.enquiry_count %></td>
                                    <td class="text-center"><%= listing.bid_count + listing.application_count %></td>
                                    <td class="text-end">
                                        <span class="badge rounded-pill border <%= statusStyles[listing.status] || statusStyles.draft %>">
                                            <%= t('listing.status_' + listing.status) %>
                                        </span>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="text-center py-4">
                    <i class="fa-solid fa-chart-simple fs-1 text-muted mb-3 opacity-50 d-block"></i>
                    <p class="text-muted mb-3"><%= t('panel.no_listings') %></p>
                    <a href="/listings/create" class="btn btn-primary rounded-pill px-4 fw-medium">
                        <i class="fa-solid fa-plus me-2"></i><%= t('nav.post_ad') %>
                    </a>
                </div>
            <% } %>
        </div>
    </div>
</div>

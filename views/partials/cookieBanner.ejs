<%# Çerez onayı.

    Karar verilene kadar duruyor; kapatma çarpısı yok, çünkü çarpı ile kapatmak
    ne kabul ne ret olurdu ve sonraki ziyarette yeniden sorulması gerekirdi.
    İki düğme de aynı boyda ve aynı belirginlikte: reddetmek kabul etmek kadar
    kolay olmazsa onay gerçek bir seçim sayılmaz.

    Betik gerektirmiyor - normal bir form gönderimi. Sayfa yeniden yükleniyor,
    o kadar. %>
<% const bannerOpen = typeof consentBannerOpen !== 'undefined' ? consentBannerOpen : !consent.decided; %>
<% const returnTo = typeof consentReturnTo !== 'undefined' ? consentReturnTo : currentUrl; %>
<% if (bannerOpen) { %>
    <div class="position-fixed bottom-0 start-0 end-0 p-2 p-sm-3" style="z-index: 1080;">
        <div class="container">
            <div class="card border-0 shadow-lg rounded-4 mx-auto" style="max-width: 720px;">
                <div class="card-body p-3 p-sm-4">
                    <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3">
                        <div class="d-flex align-items-start gap-3 flex-grow-1">
                            <%# Kurabiye simgesi suslemeden ibaret degil: insanlarin
                                yillardir ogrendigi tanima isareti bu. Onsuz kart, sitedeki
                                diger duyuru seritlerinden ayirt edilemiyor ve okunmadan
                                bir uyari metni saniliyor. %>
                            <div class="flex-shrink-0 d-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle"
                                 style="width: 42px; height: 42px;" aria-hidden="true">
                                <i class="fa-solid fa-cookie-bite fs-5"></i>
                            </div>
                            <div>
                                <h2 class="fs-6 fw-bold mb-1"><%= t('consent.title') %></h2>
                                <p class="small text-muted mb-0">
                                    <%= t('consent.body') %>
                                    <a href="/cerez-politikasi" class="text-decoration-underline"><%= t('footer.cookie_policy') %></a>
                                </p>
                                <%# Tercih yeniden acildiysa, degistirmeden once neyin secili
                                    oldugunu bilmek gerekiyor. %>
                                <% if (consent.decided) { %>
                                    <p class="small fw-semibold mb-0 mt-1">
                                        <%= t('consent.current', { choice: t(consent.analytics ? 'consent.accept' : 'consent.essential_only') }) %>
                                    </p>
                                <% } %>
                            </div>
                        </div>

                        <form method="POST" action="/cerez-tercihi" class="d-flex gap-2 flex-shrink-0">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="returnTo" value="<%= returnTo %>">
                            <button type="submit" name="level" value="essential"
                                    class="btn btn-outline-primary rounded-pill px-3 flex-fill text-nowrap">
                                <%= t('consent.essential_only') %>
                            </button>
                            <button type="submit" name="level" value="all"
                                    class="btn btn-primary rounded-pill px-3 flex-fill text-nowrap">
                                <%= t('consent.accept') %>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
<% } %>

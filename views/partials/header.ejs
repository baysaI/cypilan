<header class="site-header sticky-top bg-white shadow-sm">
    <div class="border-bottom">
        <div class="container py-2">
            <div class="d-flex align-items-center gap-2 gap-md-3">
                <a href="/" class="d-flex align-items-center flex-shrink-0">
                    <img src="/img/logo.png" alt="CypIlan" style="height: 44px; width: auto; object-fit: contain; mix-blend-mode: multiply;">
                </a>

                <form action="/listings" method="GET" class="flex-grow-1 d-none d-sm-block" style="max-width: 640px;">
                    <div class="input-group">
                        <input type="text" name="q" class="form-control" placeholder="<%= t('home.search_placeholder') %>">
                        <button class="btn btn-primary" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                    </div>
                </form>

                <a href="/listings" class="text-decoration-none small fw-medium text-muted d-none d-lg-inline flex-shrink-0"><%= t('common.detailed_search') %></a>

                <div class="ms-auto d-flex align-items-center gap-2 gap-md-3 flex-shrink-0">
                    <div class="dropdown">
                        <button class="btn btn-light border-0" type="button" data-bs-toggle="dropdown">
                            <i class="fa-solid fa-globe text-primary"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item lang-switch" href="#" data-lang="tr">🇹🇷 Türkçe</a></li>
                            <li><a class="dropdown-item lang-switch" href="#" data-lang="en">🇬🇧 English</a></li>
                            <li><a class="dropdown-item lang-switch" href="#" data-lang="el">🇬🇷 Ελληνικά</a></li>
                            <li><a class="dropdown-item lang-switch" href="#" data-lang="ru">🇷🇺 Русский</a></li>
                            <li><a class="dropdown-item lang-switch" href="#" data-lang="fa">🇮🇷 فارسی</a></li>
                        </ul>
                    </div>

                    <div class="dropdown d-none d-md-block">
                        <button class="btn btn-light border-0 fw-bold" type="button" data-bs-toggle="dropdown">
                            <%= (typeof currency !== 'undefined' && currency === 'GBP') ? '£' : '₺' %>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item currency-switch" href="#" data-currency="TRY">₺ TRY</a></li>
                            <li><a class="dropdown-item currency-switch" href="#" data-currency="GBP">£ GBP</a></li>
                        </ul>
                    </div>

                    <% const activeUser = (typeof user !== 'undefined' && user) ? user : ((typeof currentUser !== 'undefined' && currentUser) ? currentUser : null); %>
                    <% if (activeUser) { %>
                        <div class="dropdown">
                            <button class="btn btn-outline-primary dropdown-toggle position-relative" type="button" data-bs-toggle="dropdown">
                                <i class="fa-regular fa-user me-2"></i><%= activeUser.name %>
                                <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"><%= unreadMessages %></span>
                                <% } %>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end mt-2">
                                <% if (activeUser.role === 'admin') { %>
                                    <li><a class="dropdown-item py-2 fw-medium" href="/admin"><i class="fa-solid fa-shield-halved me-3 text-warning"></i>Admin Paneli</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                <% } %>
                                <li><a class="dropdown-item py-2" href="/profile"><i class="fa-solid fa-id-card me-3 text-primary"></i><%= t('nav.my_profile') %></a></li>
                                <li><a class="dropdown-item py-2" href="/listings/my-listings"><i class="fa-solid fa-list me-3 text-primary"></i><%= t('nav.my_listings') %></a></li>
                                <li>
                                    <a class="dropdown-item py-2 d-flex align-items-center" href="/messages">
                                        <i class="fa-regular fa-comments me-3 text-primary"></i>
                                        <span class="flex-grow-1">Mesajlarım</span>
                                        <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
                                            <span class="badge bg-danger rounded-pill ms-2"><%= unreadMessages %></span>
                                        <% } %>
                                    </a>
                                </li>
                                <li><a class="dropdown-item py-2" href="/favorites"><i class="fa-solid fa-heart me-3 text-accent"></i><%= t('nav.my_favorites') %></a></li>
                                <li><a class="dropdown-item py-2" href="/profile/edit"><i class="fa-solid fa-gear me-3 text-muted"></i>Profil Ayarları</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2 text-danger" href="/auth/logout"><i class="fa-solid fa-right-from-bracket me-3"></i><%= t('nav.logout') %></a></li>
                            </ul>
                        </div>
                    <% } else { %>
                        <a href="/auth/login" class="btn btn-outline-primary d-none d-sm-inline-block"><%= t('nav.login') %></a>
                    <% } %>

                    <a href="/listings/create" class="btn btn-accent fw-bold text-white">
                        <i class="fa-solid fa-plus me-1"></i><span class="d-none d-md-inline"><%= t('nav.post_ad') %></span>
                    </a>
                </div>
            </div>

            <form action="/listings" method="GET" class="d-sm-none mt-2">
                <div class="input-group">
                    <input type="text" name="q" class="form-control" placeholder="<%= t('home.search_placeholder') %>">
                    <button class="btn btn-primary" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
            </form>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg navbar-light bg-light py-0">
        <div class="container">
            <button class="navbar-toggler border-0 shadow-none my-2" type="button" data-bs-toggle="collapse" data-bs-target="#categoryNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="categoryNav">
                <ul class="navbar-nav fw-medium small">
                    <li class="nav-item"><a class="nav-link px-3 py-2" href="/"><%= t('nav.home') %></a></li>
                    <li class="nav-item"><a class="nav-link px-3 py-2" href="/listings?category=emlak"><%= t('categories.real_estate') %></a></li>
                    <li class="nav-item"><a class="nav-link px-3 py-2" href="/listings?category=vasita"><%= t('categories.vehicles') %></a></li>
                    <li class="nav-item"><a class="nav-link px-3 py-2" href="/listings?category=is-ilanlari"><%= t('categories.jobs') %></a></li>
                    <li class="nav-item"><a class="nav-link px-3 py-2" href="/listings?category=usta-hizmetler"><%= t('categories.services') %></a></li>
                    <li class="nav-item"><a class="nav-link px-3 py-2" href="/listings?category=ikinci-el"><%= t('categories.second_hand') %></a></li>
                </ul>
            </div>
        </div>
    </nav>
</header>

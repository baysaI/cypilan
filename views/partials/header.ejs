<header class="site-header sticky-top bg-white shadow-sm glassmorphism">
    <nav class="navbar navbar-expand-lg navbar-light py-3">
        <div class="container">
            <!-- Brand Logo -->
            <a class="navbar-brand d-flex align-items-center py-0" href="/">
                <img src="/img/logo.svg" alt="CypIlan - Kıbrıs'ın İlan Sitesi" class="cypilan-logo" style="height: 52px; width: auto;">
            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navbar Links -->
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-medium">
                    <li class="nav-item">
                        <a class="nav-link px-3 hover-lift" href="/"><%= typeof t !== 'undefined' ? t('home') : 'Anasayfa' %></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 hover-lift" href="/listings?category=emlak"><%= typeof t !== 'undefined' ? t('real_estate') : 'Emlak' %></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 hover-lift" href="/listings?category=vasita"><%= typeof t !== 'undefined' ? t('vehicles') : 'Vasıta' %></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 hover-lift" href="/listings?category=is-ilanlari"><%= typeof t !== 'undefined' ? t('jobs') : 'İş İlanları' %></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 hover-lift" href="/listings?category=ustalar"><%= typeof t !== 'undefined' ? t('services') : 'Ustalar' %></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 hover-lift" href="/listings?category=ikinci-el"><%= typeof t !== 'undefined' ? t('second_hand') : 'İkinci El' %></a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0 flex-wrap">
                    <!-- Language Selector -->
                    <div class="dropdown">
                        <button class="btn btn-light dropdown-toggle border-0 shadow-sm rounded-pill" type="button" data-bs-toggle="dropdown">
                            <i class="fa-solid fa-globe text-primary"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4">
                            <li><a class="dropdown-item lang-switch" href="#" data-lang="tr">🇹🇷 Türkçe</a></li>
                            <li><a class="dropdown-item lang-switch" href="#" data-lang="en">🇬🇧 English</a></li>
                            <li><a class="dropdown-item lang-switch" href="#" data-lang="el">🇬🇷 Ελληνικά</a></li>
                            <li><a class="dropdown-item lang-switch" href="#" data-lang="ru">🇷🇺 Русский</a></li>
                            <li><a class="dropdown-item lang-switch" href="#" data-lang="fa">🇮🇷 فارسی</a></li>
                        </ul>
                    </div>

                    <!-- Currency Selector -->
                    <div class="dropdown">
                        <button class="btn btn-light dropdown-toggle border-0 shadow-sm rounded-pill fw-bold" type="button" data-bs-toggle="dropdown">
                            <%= (typeof req !== 'undefined' && req.cookies && req.cookies.currency === 'GBP') ? '£' : '₺' %>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4">
                            <li><a class="dropdown-item currency-switch" href="#" data-currency="TRY">₺ TRY</a></li>
                            <li><a class="dropdown-item currency-switch" href="#" data-currency="GBP">£ GBP</a></li>
                        </ul>
                    </div>

                    <!-- User Actions -->
                    <% if (typeof user !== 'undefined' && user) { %>
                        <div class="dropdown">
                            <button class="btn btn-outline-primary rounded-pill px-4 dropdown-toggle shadow-sm" type="button" data-bs-toggle="dropdown">
                                <i class="fa-regular fa-user me-2"></i><%= user.name %>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 mt-2">
                                <li><a class="dropdown-item py-2" href="/profile"><i class="fa-solid fa-id-card me-3 text-primary"></i><%= typeof t !== 'undefined' ? t('my_profile') : 'Profilim' %></a></li>
                                <li><a class="dropdown-item py-2" href="/listings/my-listings"><i class="fa-solid fa-list me-3 text-primary"></i><%= typeof t !== 'undefined' ? t('my_listings') : 'İlanlarım' %></a></li>
                                <li><a class="dropdown-item py-2" href="/favorites"><i class="fa-solid fa-heart me-3 text-accent"></i><%= typeof t !== 'undefined' ? t('favorites') : 'Favorilerim' %></a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2 text-danger" href="/auth/logout"><i class="fa-solid fa-right-from-bracket me-3"></i><%= typeof t !== 'undefined' ? t('logout') : 'Çıkış Yap' %></a></li>
                            </ul>
                        </div>
                    <% } else { %>
                        <div class="d-flex gap-2">
                            <a href="/auth/login" class="btn btn-outline-primary rounded-pill px-4 fw-bold shadow-sm hover-lift"><%= typeof t !== 'undefined' ? t('login') : 'Giriş Yap' %></a>
                        </div>
                    <% } %>

                    <!-- Post Ad CTA -->
                    <a href="/listings/create" class="btn btn-accent rounded-pill px-4 fw-bold text-white shadow-sm pulse-button hover-lift">
                        <i class="fa-solid fa-plus me-2"></i><%= typeof t !== 'undefined' ? t('post_ad') : 'İlan Ver' %>
                    </a>
                </div>
            </div>
        </div>
    </nav>
</header>

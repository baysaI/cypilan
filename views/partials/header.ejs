<header class="site-header sticky-top bg-white shadow-sm">
    <div class="border-bottom">
        <div class="container py-2">
            <div class="d-flex align-items-center gap-2 gap-md-3">
                <a href="/" class="site-brand d-flex align-items-center flex-shrink-0" aria-label="CypIlan">
                    <img src="/img/logo.png" alt="CypIlan" class="site-logo site-logo-light">
                    <img src="/img/logo-white.png" alt="CypIlan" class="site-logo site-logo-dark">
                </a>

                <%# The inline search shares the row with the account controls, so
                    between sm and lg it was squeezed down to ~145px of typing
                    room. Below lg it moves to its own full-width row instead. %>
                <form action="/search" method="GET" class="flex-grow-1 d-none d-lg-block" style="max-width: 640px;">
                    <%
                        const searchPlaceholders = t('smart.placeholders');
                        const searchPlaceholdersJson = Array.isArray(searchPlaceholders) ? JSON.stringify(searchPlaceholders) : JSON.stringify([t('smart.placeholder')]);
                    %>
                    <div class="input-group">
                        <input type="text" name="q" class="form-control smart-search-input" placeholder="<%= t('smart.placeholder') %>" data-prefix="<%= encodeURIComponent(t('smart.search_prefix')) %>" data-placeholders="<%= encodeURIComponent(searchPlaceholdersJson) %>">
                        <button class="btn btn-primary" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                    </div>
                </form>

                <a href="/listings" class="text-decoration-none small fw-medium text-muted d-none d-lg-inline flex-shrink-0"><%= t('common.detailed_search') %></a>

                <div class="ms-auto d-flex align-items-center gap-1 gap-md-3 flex-shrink-0">
                    <div class="dropdown">
                        <button class="btn btn-light border-0 px-2 px-md-3" type="button" data-bs-toggle="dropdown" aria-label="<%= t('common.language') %>">
                            <i class="fa-solid fa-globe text-primary"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item lang-switch" href="#" data-lang="tr">🇹🇷 Türkçe</a></li>
                            <li><a class="dropdown-item lang-switch" href="#" data-lang="en">🇬🇧 English</a></li>
                            <li><a class="dropdown-item lang-switch" href="#" data-lang="el">🇬🇷 Ελληνικά</a></li>
                            <li><a class="dropdown-item lang-switch" href="#" data-lang="ru">🇷🇺 Русский</a></li>
                            <li><a class="dropdown-item lang-switch" href="#" data-lang="fa">🇮🇷 فارسی</a></li>
                        </ul>
                    </div>

                    <div class="dropdown d-none d-md-block">
                        <button class="btn btn-light border-0 fw-bold" type="button" data-bs-toggle="dropdown" aria-label="<%= t('common.currency') %>">
                            <%= (typeof currency !== 'undefined' && currency === 'GBP') ? '£' : '₺' %>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item currency-switch" href="#" data-currency="TRY">₺ TRY</a></li>
                            <li><a class="dropdown-item currency-switch" href="#" data-currency="GBP">£ GBP</a></li>
                        </ul>
                    </div>

                    <%
                        const activeTheme = (typeof theme !== 'undefined' && theme === 'dark') ? 'dark' : 'light';
                        // The button shows the theme it switches *to*, not the one in use.
                        const themeAction = activeTheme === 'dark'
                            ? { icon: 'fa-sun',  label: t('common.theme_switch_to_light') }
                            : { icon: 'fa-moon', label: t('common.theme_switch_to_dark') };
                    %>
                    <button class="btn btn-light border-0 px-2 px-md-3 theme-toggle" type="button"
                            aria-label="<%= themeAction.label %>" title="<%= themeAction.label %>"
                            data-label-to-dark="<%= t('common.theme_switch_to_dark') %>"
                            data-label-to-light="<%= t('common.theme_switch_to_light') %>">
                        <i class="fa-solid <%= themeAction.icon %> text-primary" id="themeIcon"></i>
                    </button>

                    <% const activeUser = (typeof user !== 'undefined' && user) ? user : ((typeof currentUser !== 'undefined' && currentUser) ? currentUser : null); %>
                    <% if (activeUser) { %>
                        <div class="dropdown">
                            <%# The member's name has no length limit, so below md it is dropped
                                entirely and the button falls back to the avatar icon. %>
                            <button class="btn btn-outline-primary dropdown-toggle position-relative px-2 px-md-3" type="button"
                                    data-bs-toggle="dropdown" aria-label="<%= t('common.account') %>">
                                <i class="fa-regular fa-user me-md-2"></i>
                                <span class="header-user-name d-none d-md-inline-block"><%= activeUser.name %></span>
                                <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"><%= unreadMessages %></span>
                                <% } %>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end mt-2 shadow-sm rounded-3 py-2" style="min-width: 230px;">
                                <% if (activeUser.role === 'admin') { %>
                                    <li>
                                        <a class="dropdown-item py-2 fw-bold text-warning" href="/admin">
                                            <i class="fa-solid fa-shield-halved me-2"></i>Admin Paneli
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                <% } %>

                                <!-- Genel & Hesap -->
                                <li><h6 class="dropdown-header text-uppercase text-muted fw-bold px-3 pt-1 pb-1" style="font-size: 0.68rem; letter-spacing: 0.5px;"><i class="fa-solid fa-user me-1"></i> <%= t('nav.section_account') %></h6></li>
                                <li><a class="dropdown-item py-2" href="/panel"><i class="fa-solid fa-chart-line me-2 text-success"></i><%= t('panel.title') %></a></li>
                                <li><a class="dropdown-item py-2" href="/profile"><i class="fa-solid fa-id-card me-2 text-primary"></i><%= t('nav.my_profile') %></a></li>
                                <li><a class="dropdown-item py-2" href="/profile/listings"><i class="fa-solid fa-list me-2 text-primary"></i><%= t('nav.my_listings') %></a></li>
                                <li>
                                    <a class="dropdown-item py-2 d-flex align-items-center" href="/messages">
                                        <i class="fa-regular fa-comments me-2 text-primary"></i>
                                        <span class="flex-grow-1">Mesajlarım</span>
                                        <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
                                            <span class="badge bg-danger rounded-pill ms-2"><%= unreadMessages %></span>
                                        <% } %>
                                    </a>
                                </li>
                                <li><a class="dropdown-item py-2" href="/favorites"><i class="fa-solid fa-heart me-2 text-danger"></i><%= t('nav.my_favorites') %></a></li>

                                <li><hr class="dropdown-divider my-2"></li>

                                <!-- İş & Kariyer -->
                                <li><h6 class="dropdown-header text-uppercase text-muted fw-bold px-3 pt-1 pb-1" style="font-size: 0.68rem; letter-spacing: 0.5px;"><i class="fa-solid fa-briefcase me-1"></i> <%= t('nav.section_jobs') %></h6></li>
                                <li><a class="dropdown-item py-2" href="/kariyer/cv"><i class="fa-regular fa-file-lines me-2 text-info"></i><%= t('career.my_cv') %></a></li>
                                <li><a class="dropdown-item py-2" href="/kariyer/basvurularim"><i class="fa-regular fa-paper-plane me-2 text-info"></i><%= t('career.my_applications') %></a></li>
                                <li>
                                    <a class="dropdown-item py-2 d-flex align-items-center" href="/kariyer/basvurular">
                                        <i class="fa-solid fa-users me-2 text-info"></i>
                                        <span class="flex-grow-1"><%= t('career.employer_panel') %></span>
                                        <% if (typeof pendingApplicationCount !== 'undefined' && pendingApplicationCount > 0) { %>
                                            <span class="badge bg-info rounded-pill ms-2"><%= pendingApplicationCount %></span>
                                        <% } %>
                                    </a>
                                </li>

                                <li><hr class="dropdown-divider my-2"></li>

                                <!-- Teklifler & İhaleler -->
                                <li><h6 class="dropdown-header text-uppercase text-muted fw-bold px-3 pt-1 pb-1" style="font-size: 0.68rem; letter-spacing: 0.5px;"><i class="fa-solid fa-gavel me-1"></i> <%= t('nav.section_bids') %></h6></li>
                                <li>
                                    <a class="dropdown-item py-2 d-flex align-items-center" href="/profile/teklifler">
                                        <i class="fa-solid fa-inbox me-2 text-success"></i>
                                        <span class="flex-grow-1"><%= t('bids.received') %></span>
                                        <% if (typeof pendingBidCount !== 'undefined' && pendingBidCount > 0) { %>
                                            <span class="badge bg-success rounded-pill ms-2"><%= pendingBidCount %></span>
                                        <% } %>
                                    </a>
                                </li>
                                <% if (['agent', 'business', 'admin'].indexOf(activeUser.role) > -1) { %>
                                    <li><a class="dropdown-item py-2" href="/teklifler"><i class="fa-solid fa-gavel me-2 text-primary"></i><%= t('bids.open_requests') %></a></li>
                                    <li><a class="dropdown-item py-2" href="/teklifler/verdiklerim"><i class="fa-solid fa-hand-holding-dollar me-2 text-primary"></i><%= t('bids.my_bids') %></a></li>
                                <% } %>

                                <li><hr class="dropdown-divider my-2"></li>

                                <!-- Profil Ayarları & Çıkış -->
                                <li><a class="dropdown-item py-2" href="/profile/edit"><i class="fa-solid fa-gear me-2 text-muted"></i>Profil Ayarları</a></li>
                                <li>
                                    <form action="/auth/logout" method="POST" class="m-0">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="dropdown-item py-2 text-danger">
                                            <i class="fa-solid fa-right-from-bracket me-2"></i><%= t('nav.logout') %>
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    <% } else { %>
                        <a href="/auth/login" class="btn btn-outline-primary px-2 px-md-3" aria-label="<%= t('nav.login') %>">
                            <i class="fa-regular fa-user d-sm-none"></i>
                            <span class="d-none d-sm-inline"><%= t('nav.login') %></span>
                        </a>
                    <% } %>

                    <a href="/listings/create" class="btn btn-accent fw-bold text-white px-2 px-md-3" aria-label="<%= t('nav.post_ad') %>">
                        <i class="fa-solid fa-plus me-md-1"></i><span class="d-none d-md-inline"><%= t('nav.post_ad') %></span>
                    </a>
                </div>
            </div>

            <form action="/search" method="GET" class="d-lg-none mt-2">
                <div class="input-group">
                    <input type="text" name="q" class="form-control smart-search-input" placeholder="<%= t('smart.placeholder') %>" data-prefix="<%= encodeURIComponent(t('smart.search_prefix')) %>" data-placeholders="<%= encodeURIComponent(searchPlaceholdersJson) %>">
                    <button class="btn btn-primary" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
            </form>
        </div>
    </div>

    <%# Below lg the category list is a swipeable rail rather than a hamburger:
        one tap to a category instead of two, and the choices stay visible. %>
    <nav class="category-nav navbar navbar-expand-lg navbar-light bg-light py-0" aria-label="<%= t('listing.category') %>">
        <div class="container">
          <div class="category-rail w-100">
            <ul class="navbar-nav fw-medium small no-scrollbar w-100">
                <li class="nav-item"><a class="nav-link px-3 py-2" href="/"><%= t('nav.home') %></a></li>
                <li class="nav-item"><a class="nav-link px-3 py-2" href="/listings?category=emlak"><%= t('categories.real_estate') %></a></li>
                <li class="nav-item"><a class="nav-link px-3 py-2" href="/listings?category=vasita"><%= t('categories.vehicles') %></a></li>
                <li class="nav-item"><a class="nav-link px-3 py-2" href="/listings?category=is-ilanlari"><%= t('categories.jobs') %></a></li>
                <li class="nav-item"><a class="nav-link px-3 py-2" href="/listings?category=usta-hizmetler"><%= t('categories.services') %></a></li>
                <li class="nav-item"><a class="nav-link px-3 py-2" href="/listings?category=ikinci-el"><%= t('categories.second_hand') %></a></li>
                <li class="nav-item"><a class="nav-link px-3 py-2 text-accent fw-bold" href="/ogrenci"><i class="fa-solid fa-graduation-cap me-1"></i><%= t('students.title') %></a></li>
            </ul>

            <%# A fade alone still reads as "the list ends here". This is a real
                position indicator: it only appears when the rail has more to
                show, and its thumb says how much and where. %>
            <div class="category-rail-progress" aria-hidden="true"><span></span></div>
          </div>
        </div>
    </nav>
</header>

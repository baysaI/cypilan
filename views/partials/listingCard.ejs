<div class="listing-card card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative hover-lift transition-all <%= (listing.is_premium || listing.isPremium) ? 'premium-card' : '' %>">
    
    <% const cardBadges = (typeof listingBadges !== 'undefined' && listingBadges) ? listingBadges.activeFor(listing) : []; %>
    
    <%# Top-Left Over Photo: Only high-priority single tier badges (Wanted / Premium) to keep photo clean %>
    <% if (listing.listing_type === 'wanted' || listing.is_premium || listing.isPremium) { %>
        <div class="position-absolute top-0 start-0 m-2 z-2 d-flex flex-column align-items-start gap-1 pe-none" style="max-width: 65%;">
            <% if (listing.listing_type === 'wanted') { %>
                <span class="badge bg-warning text-dark rounded-pill shadow-sm fw-bold px-2 py-1" style="font-size: 0.72rem;">
                    <i class="fa-solid fa-hand-holding-heart me-1"></i><%= t('listing.badge_wanted') || 'TALEP' %>
                </span>
            <% } %>
            <% if (listing.is_premium || listing.isPremium) { %>
                <span class="premium-badge px-2 py-1 rounded-pill shadow-sm fw-bold text-white bg-gradient-golden" style="font-size: 0.72rem;">
                    <i class="fa-solid fa-crown me-1"></i> Premium
                </span>
            <% } %>
        </div>
    <% } %>

    <% const favActive = (typeof isFavorited !== 'undefined' && isFavorited) || (typeof userFavoriteIds !== 'undefined' && Array.isArray(userFavoriteIds) && userFavoriteIds.includes(listing.id)); %>
    <div class="position-absolute top-0 end-0 m-2 z-2 d-flex gap-1">
        <button type="button" class="btn btn-light btn-sm compare-toggle-btn rounded-circle shadow-sm d-flex align-items-center justify-content-center p-0 bg-white hover-bg-light" style="width: 32px; height: 32px;" data-id="<%= listing.id %>" data-title="<%= listing.title %>" data-image="<%= listing.primary_image || listing.image || '' %>" data-price="<%= listing.price || 0 %>" data-currency="<%= listing.currency || 'TRY' %>" data-city="<%= listing.location_city || listing.city || '' %>" title="<%= t('compare.button') || 'Karşılaştır' %>">
            <i class="fa-solid fa-code-compare text-muted fs-6"></i>
        </button>
        <button type="button" class="btn btn-light btn-sm favorite-btn rounded-circle shadow-sm d-flex align-items-center justify-content-center p-0 bg-white hover-bg-light" style="width: 32px; height: 32px;" data-id="<%= listing.id %>" title="<%= t('listing.add_favorite') %>">
            <i class="<%= favActive ? 'fa-solid fa-heart text-danger' : 'fa-regular fa-heart text-muted' %> fs-6"></i>
        </button>
    </div>

    <a href="/listings/<%= listing.slug || listing.id %>" class="text-decoration-none d-block position-relative overflow-hidden bg-light" style="padding-top: 66%;">
        <img src="<%= listing.primary_image || listing.image || 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800' %>" 
             class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover transition-transform duration-500 hover-scale" 
             alt="" 
             loading="lazy"
             onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800';">
        <div class="image-overlay position-absolute bottom-0 start-0 w-100 p-2 bg-gradient-to-t from-black-60 d-flex justify-content-between align-items-end z-1">
            <span class="badge bg-primary text-white rounded-pill px-2 py-1 fw-medium shadow-sm" style="font-size: 0.72rem;"><%= listing['category_name_' + (typeof lang !== 'undefined' ? lang : 'tr')] || listing.category_name || listing.categoryName || t('home.ad_unit') %></span>
            <% const photoCount = Number(listing.image_count ?? listing.imageCount ?? (Array.isArray(listing.images) ? listing.images.length : 0)) || 0; %>
            <% if (photoCount > 0) { %>
                <span class="text-white small fw-medium text-shadow"><i class="fa-solid fa-camera me-1"></i> <%= photoCount %></span>
            <% } %>
        </div>
    </a>

    <div class="card-body d-flex flex-column p-2 p-sm-3">
        <%# Feature Badges placed cleanly in card body %>
        <% if (cardBadges.length > 0) { %>
            <div class="d-flex flex-wrap gap-1 mb-1">
                <% cardBadges.forEach(function (badge) { %>
                    <span class="badge bg-<%= badge.variant %>-subtle text-<%= badge.variant %> border border-<%= badge.variant %>-subtle rounded-pill fw-bold" style="font-size: 0.68rem; padding: 2px 7px;">
                        <i class="fa-solid <%= badge.icon %> me-1"></i><%= t('listing.badge_' + badge.key) %>
                    </span>
                <% }); %>
            </div>
        <% } %>

        <div class="d-flex justify-content-between align-items-start mb-1">
            <h5 class="card-title fs-6 fw-bold mb-0 text-truncate text-dark" style="max-width: 100%;" title="<%= listing.title %>">
                <a href="/listings/<%= listing.slug || listing.id %>" class="text-decoration-none text-dark hover-text-primary"><%= listing.title %></a>
            </h5>
        </div>
        
        <div class="price-tag mb-2">
            <% if (listing.price && Number(listing.price) > 0) { %>
                <span class="fs-5 fw-bold text-primary"><%= helpers.formatPrice(listing.price, listing.currency, typeof currency !== 'undefined' ? currency : 'TRY') %></span>
            <% } else { %>
                <span class="fs-6 fw-semibold text-muted"><%= (listing.listing_type === 'job' || listing.category_slug === 'is-ilanlari') ? t('career.salary_unspecified') : t('listing.price_unspecified') %></span>
            <% } %>
        </div>

        <div class="mt-auto pt-2 border-top border-light d-flex justify-content-between align-items-center text-muted small fw-medium">
            <div class="location d-flex align-items-center text-truncate pe-2">
                <i class="fa-solid fa-location-dot text-accent me-1"></i>
                <span class="text-truncate"><%= listing.location_city || listing.city || 'Kıbrıs' %><%= (listing.location_district || listing.district) ? ', ' + (listing.location_district || listing.district) : '' %></span>
            </div>
            <div class="date whitespace-nowrap d-none d-sm-block">
                <i class="fa-regular fa-clock me-1"></i> <%= listing.created_at ? helpers.timeAgo(listing.created_at, lang) : t('common.today') %>
            </div>
        </div>
    </div>
</div>

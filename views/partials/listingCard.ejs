<div class="listing-card card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative hover-lift transition-all <%= (listing.is_premium || listing.isPremium) ? 'premium-card' : '' %>">
    
    <% if (listing.is_premium || listing.isPremium) { %>
        <div class="premium-badge position-absolute top-0 start-0 m-2 z-2 px-2 py-1 rounded-2 shadow-sm fw-bold small text-white bg-gradient-golden">
            <i class="fa-solid fa-crown me-1"></i> Premium
        </div>
    <% } %>

    <% const favActive = (typeof isFavorited !== 'undefined' && isFavorited) || (typeof userFavoriteIds !== 'undefined' && Array.isArray(userFavoriteIds) && userFavoriteIds.includes(listing.id)); %>
    <button class="btn btn-light btn-sm favorite-btn position-absolute top-0 end-0 m-2 z-2 rounded-circle shadow-sm d-flex align-items-center justify-content-center p-0 bg-white hover-bg-light" style="width: 32px; height: 32px;" data-id="<%= listing.id %>">
        <i class="<%= favActive ? 'fa-solid fa-heart text-danger' : 'fa-regular fa-heart text-muted' %> fs-6"></i>
    </button>

    <a href="/listings/<%= listing.slug || listing.id %>" class="text-decoration-none d-block position-relative overflow-hidden bg-light" style="padding-top: 66%;">
        <img src="<%= listing.primary_image || listing.image || 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800' %>" 
             class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover transition-transform duration-500 hover-scale" 
             alt="" 
             loading="lazy"
             onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800';">
        <div class="image-overlay position-absolute bottom-0 start-0 w-100 p-2 bg-gradient-to-t from-black-60 d-flex justify-content-between align-items-end z-1">
            <span class="badge bg-primary text-white rounded-pill px-2 py-1 fw-medium shadow-sm"><%= listing['category_name_' + (typeof lang !== 'undefined' ? lang : 'tr')] || listing.category_name || listing.categoryName || t('home.ad_unit') %></span>
            <span class="text-white small fw-medium text-shadow"><i class="fa-solid fa-camera me-1"></i> <%= listing.imageCount || 1 %></span>
        </div>
    </a>

    <div class="card-body d-flex flex-column p-3">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h5 class="card-title fs-6 fw-bold mb-0 text-truncate text-dark" style="max-width: 100%;" title="<%= listing.title %>">
                <a href="/listings/<%= listing.slug || listing.id %>" class="text-decoration-none text-dark hover-text-primary"><%= listing.title %></a>
            </h5>
        </div>
        
        <div class="price-tag mb-3">
            <% if (listing.price && Number(listing.price) > 0) { %>
                <span class="fs-5 fw-bold text-primary"><%= helpers.formatPrice(listing.price, listing.currency, typeof currency !== 'undefined' ? currency : 'TRY') %></span>
            <% } else { %>
                <span class="fs-6 fw-semibold text-muted"><%= (listing.listing_type === 'job' || listing.category_slug === 'is-ilanlari') ? t('career.salary_unspecified') : t('listing.price_unspecified') %></span>
            <% } %>
        </div>

        <div class="mt-auto pt-2 border-top border-light d-flex justify-content-between align-items-center text-muted small fw-medium">
            <div class="location d-flex align-items-center text-truncate pe-2">
                <i class="fa-solid fa-location-dot text-accent me-1"></i>
                <span class="text-truncate"><%= listing.location_city || listing.city || 'Kıbrıs' %><%= (listing.location_district || listing.district) ? ', ' + (listing.location_district || listing.district) : '' %></span>
            </div>
            <%# Two cards to a row on a phone leaves ~150px here: the city wins
                that space and the age of the listing waits for a wider screen. %>
            <div class="date whitespace-nowrap d-none d-sm-block">
                <i class="fa-regular fa-clock me-1"></i> <%= listing.created_at ? helpers.timeAgo(listing.created_at, lang) : t('common.today') %>
            </div>
        </div>
    </div>
</div>

<div class="search-bar-wrapper bg-white p-3 p-md-4 rounded-4 shadow-lg glassmorphism-heavy">
    <form action="/listings" method="GET" class="search-form">
        <div class="row g-2">
            <!-- Keyword -->
            <div class="col-12 col-lg-4">
                <div class="input-group input-group-lg border rounded-3 overflow-hidden bg-light shadow-sm-inner focus-within-ring">
                    <span class="input-group-text bg-transparent border-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="q" class="form-control border-0 bg-transparent shadow-none" placeholder="Kelime, ilan no veya mağaza ara...">
                </div>
            </div>
            
            <!-- Category -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="input-group input-group-lg border rounded-3 overflow-hidden bg-light shadow-sm-inner focus-within-ring">
                    <span class="input-group-text bg-transparent border-0 text-muted"><i class="fa-solid fa-layer-group"></i></span>
                    <select name="category" class="form-select border-0 bg-transparent shadow-none cursor-pointer">
                        <option value="">Tüm Kategoriler</option>
                        <option value="emlak">Emlak</option>
                        <option value="vasita">Vasıta</option>
                        <option value="is-ilanlari">İş İlanları</option>
                        <option value="ustalar">Ustalar</option>
                        <option value="ikinci-el">İkinci El</option>
                    </select>
                </div>
            </div>

            <!-- Location -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="input-group input-group-lg border rounded-3 overflow-hidden bg-light shadow-sm-inner focus-within-ring">
                    <span class="input-group-text bg-transparent border-0 text-muted"><i class="fa-solid fa-location-dot"></i></span>
                    <select name="city" class="form-select border-0 bg-transparent shadow-none cursor-pointer">
                        <option value="">Tüm Şehirler</option>
                        <option value="lefkosa">Lefkoşa</option>
                        <option value="girne">Girne</option>
                        <option value="gazimagusa">Gazimağusa</option>
                        <option value="iskele">İskele</option>
                        <option value="guzelyurt">Güzelyurt</option>
                        <option value="lefke">Lefke</option>
                    </select>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="col-12 col-lg-2 d-grid">
                <button type="submit" class="btn btn-primary btn-lg fw-bold rounded-3 shadow-sm hover-lift d-flex align-items-center justify-content-center gap-2">
                    <i class="fa-solid fa-search"></i> Bul
                </button>
            </div>
        </div>
        
        <!-- Advanced Filters Toggle -->
        <div class="text-center mt-3">
            <a href="#advancedFilters" data-bs-toggle="collapse" class="text-decoration-none text-muted fw-medium small hover-text-primary d-inline-flex align-items-center gap-1">
                <i class="fa-solid fa-sliders"></i> Gelişmiş Filtreler
            </a>
        </div>

        <!-- Advanced Filters Collapse -->
        <div class="collapse mt-3" id="advancedFilters">
            <div class="p-3 bg-light rounded-3 border">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-medium small text-muted mb-1">Fiyat Aralığı</label>
                        <div class="input-group">
                            <input type="number" name="minPrice" class="form-control bg-white shadow-none" placeholder="Min">
                            <span class="input-group-text bg-white border-start-0 border-end-0">-</span>
                            <input type="number" name="maxPrice" class="form-control bg-white shadow-none" placeholder="Max">
                            <select name="currency" class="form-select bg-white border-start-0 shadow-none" style="max-width: 80px;">
                                <option value="TRY">₺</option>
                                <option value="GBP">£</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium small text-muted mb-1">Sıralama</label>
                        <select name="sort" class="form-select bg-white shadow-none">
                            <option value="newest">En Yeni</option>
                            <option value="price_asc">Fiyat (Düşükten Yükseğe)</option>
                            <option value="price_desc">Fiyat (Yüksekten Düşüğe)</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

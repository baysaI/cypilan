<% if (typeof seoBlock !== 'undefined' && seoBlock && (seoBlock.category || seoBlock.city)) { %>
    <section class="cyp-seo-guide-section mt-5 pt-4 border-top">
        <% if (seoBlock.category) { %>
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5 mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="fa-solid fa-compass fs-5"></i>
                    </div>
                    <div>
                        <h2 class="h4 fw-bold mb-1 text-dark"><%= seoBlock.category.title %></h2>
                        <p class="text-muted small mb-0"><%= seoBlock.category.subtitle %></p>
                    </div>
                </div>

                <div class="text-secondary small line-height-lg mb-4">
                    <p class="mb-0"><%= seoBlock.category.content %></p>
                </div>

                <% if (seoBlock.category.highlights && seoBlock.category.highlights.length > 0) { %>
                    <div class="row g-3 mb-4">
                        <% seoBlock.category.highlights.forEach(function(item) { %>
                            <div class="col-12 col-md-4">
                                <div class="p-3 rounded-3 bg-light h-100 border border-light-subtle">
                                    <div class="d-flex align-items-center gap-2 mb-2 text-primary fw-bold small">
                                        <i class="fa-solid <%= item.icon %>"></i>
                                        <span><%= item.title %></span>
                                    </div>
                                    <p class="text-muted small mb-0"><%= item.text %></p>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>

                <% if (seoBlock.category.faqs && seoBlock.category.faqs.length > 0) { %>
                    <div class="mt-3">
                        <h3 class="h6 fw-bold text-dark mb-3">
                            <i class="fa-regular fa-circle-question text-primary me-2"></i>Sıkça Sorulan Sorular
                        </h3>
                        <div class="accordion accordion-flush" id="seoFaqAccordion">
                            <% seoBlock.category.faqs.forEach(function(faq, idx) { %>
                                <div class="accordion-item bg-transparent border-bottom border-light-subtle">
                                    <h4 class="accordion-header" id="headingFaq<%= idx %>">
                                        <button class="accordion-button collapsed px-0 py-3 bg-transparent shadow-none fw-semibold text-dark small" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFaq<%= idx %>" aria-expanded="false" aria-controls="collapseFaq<%= idx %>">
                                            <%= faq.q %>
                                        </button>
                                    </h4>
                                    <div id="collapseFaq<%= idx %>" class="accordion-collapse collapse" aria-labelledby="headingFaq<%= idx %>" data-bs-parent="#seoFaqAccordion">
                                        <div class="accordion-body px-0 pt-0 pb-3 text-muted small">
                                            <%= faq.a %>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>

        <% if (seoBlock.city) { %>
            <div class="card border-0 shadow-sm rounded-4 bg-light p-4 mb-4">
                <div class="d-flex align-items-center gap-2 mb-2 text-primary fw-bold">
                    <i class="fa-solid fa-map-location-dot"></i>
                    <span><%= seoBlock.city.title %></span>
                </div>
                <p class="text-muted small mb-0"><%= seoBlock.city.desc %></p>
            </div>
        <% } %>
    </section>
<% } %>

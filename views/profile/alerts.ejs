<div class="container py-4 py-md-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted"><i class="fa-solid fa-house"></i> <%= t('nav.home') %></a></li>
            <li class="breadcrumb-item"><a href="/profile" class="text-decoration-none text-muted"><%= t('nav.my_profile') %></a></li>
            <li class="breadcrumb-item active fw-medium text-dark" aria-current="page"><%= t('alerts.my_alerts') || 'Fiyat Alarmlarım' %></li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fs-3 fw-bold mb-1"><i class="fa-solid fa-bell text-warning me-2"></i><%= t('alerts.my_alerts') || 'Fiyat Alarmlarım' %></h1>
            <p class="text-muted small mb-0"><%= alerts ? alerts.length : 0 %> <%= t('alerts.active_alerts_count') || 'adet aktif fiyat takibi' %></p>
        </div>
    </div>

    <% if (alerts && alerts.length > 0) { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3 g-md-4 mb-5">
            <% alerts.forEach(function(alert) { %>
                <div class="col">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 position-relative hover-lift transition-all">
                        <div class="position-relative" style="height: 160px;">
                            <img src="<%= alert.primary_image || 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800' %>" 
                                 class="w-100 h-100 object-fit-cover" alt="<%= alert.title %>">
                            <span class="position-absolute top-0 start-0 m-2 badge bg-warning text-dark fw-bold rounded-pill px-3 py-1 shadow-sm">
                                <i class="fa-solid fa-bell me-1"></i> Fiyat Takibinde
                            </span>
                            <button type="button" class="btn btn-light btn-sm price-alert-btn position-absolute top-0 end-0 m-2 rounded-circle shadow-sm d-flex align-items-center justify-content-center p-0 bg-white" 
                                    style="width: 32px; height: 32px;" data-id="<%= alert.listing_id %>" title="Alarmı Kaldır">
                                <i class="fa-solid fa-xmark text-danger fs-6"></i>
                            </button>
                        </div>
                        <div class="card-body p-3 d-flex flex-column">
                            <h6 class="fw-bold text-dark mb-2 text-truncate" title="<%= alert.title %>">
                                <a href="/listings/<%= alert.slug %>" class="text-decoration-none text-dark hover-text-primary"><%= alert.title %></a>
                            </h6>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">Güncel Fiyat:</small>
                                    <strong class="text-primary fs-5"><%= helpers.formatPrice(alert.current_price, alert.currency) %></strong>
                                </div>
                                <% if (alert.target_price) { %>
                                    <div class="text-end">
                                        <small class="text-muted d-block" style="font-size: 0.75rem;">Hedef Fiyat:</small>
                                        <strong class="text-success"><%= helpers.formatPrice(alert.target_price, alert.currency) %></strong>
                                    </div>
                                <% } %>
                            </div>
                            <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center small text-muted">
                                <span><i class="fa-solid fa-location-dot text-primary me-1"></i> <%= alert.location_city %></span>
                                <a href="/listings/<%= alert.slug %>" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-medium">
                                    İlana Git <i class="fa-solid fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border my-4">
            <div class="bg-warning-subtle text-warning rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                <i class="fa-solid fa-bell fs-2"></i>
            </div>
            <h5 class="fw-bold text-dark mb-2">Henüz Aktif Fiyat Alarmınız Yok</h5>
            <p class="text-muted small mb-4" style="max-width: 440px; margin: 0 auto;">
                İlgilendiğiniz ilanların detay sayfasındaki <strong>"Fiyat Alarmı"</strong> butonuna basarak fiyatı düştüğünde anında haberdar olabilirsiniz.
            </p>
            <a href="/listings" class="btn btn-primary rounded-pill px-4 fw-bold">
                <i class="fa-solid fa-magnifying-glass me-2"></i> İlanları İncele
            </a>
        </div>
    <% } %>
</div>

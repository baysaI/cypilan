<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="fs-4 fw-bold mb-0"><%= t('profile_edit.title') %></h1>
                <a href="/profile/<%= user.id %>" class="btn btn-light border btn-sm"><%= t('profile_edit.view_profile') %></a>
            </div>

            <form action="/profile" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="_method" value="PUT">

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h2 class="fs-6 fw-bold mb-0"><%= t('profile_edit.account_info') %></h2>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label for="fullName" class="form-label fw-medium small"><%= t('profile_edit.full_name') %></label>
                            <input type="text" class="form-control" id="fullName" name="full_name"
                                   value="<%= user.full_name || '' %>" required maxlength="120">
                        </div>

                        <div class="mb-0">
                            <label for="bio" class="form-label fw-medium small"><%= t('profile_edit.bio') %></label>
                            <textarea class="form-control" id="bio" name="bio" rows="3" maxlength="500"
                                      placeholder="<%= t('profile_edit.bio_placeholder') %>"><%= user.bio || '' %></textarea>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h2 class="fs-6 fw-bold mb-0"><%= t('profile_edit.contact_privacy') %></h2>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label for="phone" class="form-label fw-medium small"><%= t('profile_edit.phone') %></label>
                            <input type="tel" class="form-control" id="phone" name="phone"
                                   value="<%= user.phone || '' %>" placeholder="0533 123 4567">
                            <div class="form-text small"><%= t('profile_edit.phone_help') %></div>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input cursor-pointer" type="checkbox" name="hide_phone" value="1" id="hidePhone"
                                   <%= Number(user.show_phone) === 0 ? 'checked' : '' %>>
                            <label class="form-check-label cursor-pointer fw-medium" for="hidePhone">
                                <%= t('profile_edit.hide_phone') %>
                            </label>
                            <div class="form-text small">
                                <%= t('profile_edit.hide_phone_help') %>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a href="/profile/<%= user.id %>" class="btn btn-light border px-4"><%= t('common.cancel') %></a>
                    <button type="submit" class="btn btn-primary px-4 fw-medium"><%= t('common.save') %></button>
                </div>
            </form>

            <% const hasPassword = Number(user.has_password) !== 0; %>

            <div class="card border-0 shadow-sm mt-4">
                <div class="card-header bg-white py-3">
                    <h2 class="fs-6 fw-bold mb-0"><%= hasPassword ? t('profile_edit.change_password') : t('profile_edit.set_password') %></h2>
                </div>
                <div class="card-body p-4">
                    <% if (!hasPassword) { %>
                        <div class="alert alert-info small">
                            <%= t('profile_edit.google_account_info') %>
                        </div>
                    <% } %>

                    <form action="/profile/password" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <% if (hasPassword) { %>
                            <div class="mb-3">
                                <label for="currentPassword" class="form-label fw-medium small"><%= t('profile_edit.current_password') %></label>
                                <input type="password" class="form-control" id="currentPassword"
                                       name="current_password" required autocomplete="current-password">
                            </div>
                        <% } %>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="newPassword" class="form-label fw-medium small"><%= t('profile_edit.new_password') %></label>
                                <input type="password" class="form-control" id="newPassword"
                                       name="new_password" required autocomplete="new-password">
                                <div class="form-text small"><%= t('profile_edit.new_password_help') %></div>
                            </div>
                            <div class="col-md-6">
                                <label for="confirmPassword" class="form-label fw-medium small"><%= t('profile_edit.confirm_password') %></label>
                                <input type="password" class="form-control" id="confirmPassword"
                                       name="confirm_password" required autocomplete="new-password">
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit" class="btn btn-primary px-4 fw-medium">
                                <%= hasPassword ? t('profile_edit.update_password') : t('profile_edit.create_password') %>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card border-0 shadow-sm mt-4 mb-5">
                <div class="card-header bg-white py-3">
                    <h2 class="fs-6 fw-bold mb-0"><%= t('profile_edit.email_address') %></h2>
                </div>
                <div class="card-body p-4">
                    <% if (!hasPassword) { %>
                        <p class="text-muted small mb-2"><%= t('profile_edit.current_email', { email: user.email }) %></p>
                        <div class="alert alert-warning small mb-0">
                            <%= t('profile_edit.google_email_warning') %>
                        </div>
                    <% } else { %>
                        <form action="/profile/email" method="POST">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="mb-3">
                                <label for="newEmail" class="form-label fw-medium small"><%= t('profile_edit.email_address') %></label>
                                <input type="email" class="form-control" id="newEmail" name="new_email"
                                       value="<%= user.email || '' %>" required>
                                <div class="form-text small"><%= t('profile_edit.email_help') %></div>
                            </div>

                            <div class="mb-0">
                                <label for="emailPassword" class="form-label fw-medium small"><%= t('auth.password') %></label>
                                <input type="password" class="form-control" id="emailPassword"
                                       name="current_password" required autocomplete="current-password">
                                <div class="form-text small"><%= t('profile_edit.verify_password_help') %></div>
                            </div>

                            <div class="d-flex justify-content-end mt-3">
                                <button type="submit" class="btn btn-primary px-4 fw-medium"><%= t('profile_edit.update_email') %></button>
                            </div>
                        </form>
                    <% } %>
                </div>
            </div>

        </div>
    </div>
</div>

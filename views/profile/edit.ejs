<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="fs-4 fw-bold mb-0">Profil Ayarları</h1>
                <a href="/profile/<%= user.id %>" class="btn btn-light border btn-sm">Profilimi Gör</a>
            </div>

            <form action="/profile" method="POST">
                <input type="hidden" name="_method" value="PUT">

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h2 class="fs-6 fw-bold mb-0">Hesap Bilgileri</h2>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label for="fullName" class="form-label fw-medium small">Ad Soyad</label>
                            <input type="text" class="form-control" id="fullName" name="full_name"
                                   value="<%= user.full_name || '' %>" required maxlength="120">
                        </div>

                        <div class="mb-0">
                            <label for="bio" class="form-label fw-medium small">Hakkımda</label>
                            <textarea class="form-control" id="bio" name="bio" rows="3" maxlength="500"
                                      placeholder="Kendinizden kısaca bahsedin (opsiyonel)"><%= user.bio || '' %></textarea>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h2 class="fs-6 fw-bold mb-0">İletişim ve Gizlilik</h2>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label for="phone" class="form-label fw-medium small">Telefon Numarası</label>
                            <input type="tel" class="form-control" id="phone" name="phone"
                                   value="<%= user.phone || '' %>" placeholder="0533 123 4567">
                            <div class="form-text small">İlan verebilmek için geçerli bir numara gerekir.</div>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input cursor-pointer" type="checkbox" name="hide_phone" value="1" id="hidePhone"
                                   <%= Number(user.show_phone) === 0 ? 'checked' : '' %>>
                            <label class="form-check-label cursor-pointer fw-medium" for="hidePhone">
                                Telefonumu ilanlarımda gösterme
                            </label>
                            <div class="form-text small">
                                İşaretlerseniz numaranız hiçbir ilanınızda görünmez ve alıcılar size yalnızca
                                site içi mesajla ulaşabilir. Numaranız kayıtlı kalır, sadece gizlenir.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a href="/profile/<%= user.id %>" class="btn btn-light border px-4">Vazgeç</a>
                    <button type="submit" class="btn btn-primary px-4 fw-medium">Kaydet</button>
                </div>
            </form>

            <% const hasPassword = Number(user.has_password) !== 0; %>

            <div class="card border-0 shadow-sm mt-4">
                <div class="card-header bg-white py-3">
                    <h2 class="fs-6 fw-bold mb-0"><%= hasPassword ? 'Şifre Değiştir' : 'Şifre Belirle' %></h2>
                </div>
                <div class="card-body p-4">
                    <% if (!hasPassword) { %>
                        <div class="alert alert-info small">
                            Hesabınız Google ile oluşturulduğu için bir şifreniz yok.
                            Buradan şifre belirlerseniz e-posta ve şifreyle de giriş yapabilirsiniz.
                        </div>
                    <% } %>

                    <form action="/profile/password" method="POST">
                        <% if (hasPassword) { %>
                            <div class="mb-3">
                                <label for="currentPassword" class="form-label fw-medium small">Mevcut Şifre</label>
                                <input type="password" class="form-control" id="currentPassword"
                                       name="current_password" required autocomplete="current-password">
                            </div>
                        <% } %>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="newPassword" class="form-label fw-medium small">Yeni Şifre</label>
                                <input type="password" class="form-control" id="newPassword"
                                       name="new_password" required autocomplete="new-password">
                                <div class="form-text small">En az 8 karakter, 1 büyük harf ve 1 rakam.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="confirmPassword" class="form-label fw-medium small">Yeni Şifre (Tekrar)</label>
                                <input type="password" class="form-control" id="confirmPassword"
                                       name="confirm_password" required autocomplete="new-password">
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit" class="btn btn-primary px-4 fw-medium">
                                <%= hasPassword ? 'Şifreyi Güncelle' : 'Şifreyi Belirle' %>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card border-0 shadow-sm mt-4 mb-5">
                <div class="card-header bg-white py-3">
                    <h2 class="fs-6 fw-bold mb-0">E-posta Adresi</h2>
                </div>
                <div class="card-body p-4">
                    <% if (!hasPassword) { %>
                        <p class="text-muted small mb-2">Mevcut adres: <strong><%= user.email %></strong></p>
                        <div class="alert alert-warning small mb-0">
                            E-posta adresinizi değiştirebilmek için önce yukarıdan bir şifre belirlemelisiniz.
                        </div>
                    <% } else { %>
                        <form action="/profile/email" method="POST">
                            <div class="mb-3">
                                <label for="newEmail" class="form-label fw-medium small">E-posta Adresi</label>
                                <input type="email" class="form-control" id="newEmail" name="new_email"
                                       value="<%= user.email || '' %>" required>
                                <div class="form-text small">Giriş yaparken bu adresi kullanacaksınız.</div>
                            </div>

                            <div class="mb-0">
                                <label for="emailPassword" class="form-label fw-medium small">Şifreniz</label>
                                <input type="password" class="form-control" id="emailPassword"
                                       name="current_password" required autocomplete="current-password">
                                <div class="form-text small">Güvenlik için şifrenizi doğrulamanız gerekir.</div>
                            </div>

                            <div class="d-flex justify-content-end mt-3">
                                <button type="submit" class="btn btn-primary px-4 fw-medium">E-postayı Güncelle</button>
                            </div>
                        </form>
                    <% } %>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="fs-4 fw-bold mb-0"><%= t('profile_edit.title') %></h1>
                <a href="/profile/<%= user.id %>" class="btn btn-light border btn-sm"><%= t('profile_edit.view_profile') %></a>
            </div>

            <form action="/profile" method="POST" enctype="multipart/form-data" id="profileEditForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="remove_avatar" id="removeAvatarInput" value="0">

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h2 class="fs-6 fw-bold mb-0"><%= t('profile_edit.avatar_title') %></h2>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex flex-column flex-sm-row align-items-center gap-4">
                            <div class="position-relative flex-shrink-0">
                                <img src="<%= user.avatar_url || '/img/logo.png' %>"
                                     id="avatarPreview"
                                     class="rounded-circle border bg-light object-fit-cover shadow-sm"
                                     width="100" height="100"
                                     alt="<%= user.full_name %>"
                                     style="aspect-ratio: 1/1;">
                                <span id="avatarBadge" class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle p-1 d-flex align-items-center justify-content-center shadow-sm" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                    <i class="fa-solid fa-camera"></i>
                                </span>
                            </div>
                            <div class="text-center text-sm-start flex-grow-1">
                                <div class="d-flex flex-wrap justify-content-center justify-content-sm-start gap-2 mb-2">
                                    <label for="avatarInput" class="btn btn-sm btn-outline-primary rounded-pill px-3 cursor-pointer mb-0">
                                        <i class="fa-solid fa-cloud-arrow-up me-1"></i><span id="avatarBtnText"><%= user.avatar_url ? t('profile_edit.change_avatar') : t('profile_edit.upload_avatar') %></span>
                                    </label>
                                    <input type="file" name="avatar" id="avatarInput" class="d-none" accept="image/jpeg,image/png,image/webp">

                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 <%= user.avatar_url ? '' : 'd-none' %>" id="removeAvatarBtn">
                                        <i class="fa-regular fa-trash-can me-1"></i><%= t('profile_edit.remove_avatar') %>
                                    </button>
                                </div>
                                <div class="form-text small mb-0"><%= t('profile_edit.avatar_help') %></div>
                                <div id="avatarFileName" class="small text-success fw-medium mt-1 d-none"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h2 class="fs-6 fw-bold mb-0"><%= t('profile_edit.account_info') %></h2>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label for="fullName" class="form-label fw-medium small"><%= t('profile_edit.full_name') %></label>
                            <input type="text" class="form-control" id="fullName" name="full_name"
                                   value="<%= user.full_name || '' %>" required maxlength="120">
                        </div>

                        <div class="mb-0">
                            <label for="bio" class="form-label fw-medium small"><%= t('profile_edit.bio') %></label>
                            <textarea class="form-control" id="bio" name="bio" rows="3" maxlength="500"
                                      placeholder="<%= t('profile_edit.bio_placeholder') %>"><%= user.bio || '' %></textarea>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h2 class="fs-6 fw-bold mb-0"><%= t('profile_edit.contact_privacy') %></h2>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label for="phone" class="form-label fw-medium small"><%= t('profile_edit.phone') %></label>
                            <input type="tel" class="form-control" id="phone" name="phone"
                                   value="<%= user.phone || '' %>" placeholder="0533 123 4567">
                            <div class="form-text small"><%= t('profile_edit.phone_help') %></div>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input cursor-pointer" type="checkbox" name="hide_phone" value="1" id="hidePhone"
                                   <%= Number(user.show_phone) === 0 ? 'checked' : '' %>>
                            <label class="form-check-label cursor-pointer fw-medium" for="hidePhone">
                                <%= t('profile_edit.hide_phone') %>
                            </label>
                            <div class="form-text small">
                                <%= t('profile_edit.hide_phone_help') %>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a href="/profile/<%= user.id %>" class="btn btn-light border px-4"><%= t('common.cancel') %></a>
                    <button type="submit" class="btn btn-primary px-4 fw-medium"><%= t('common.save') %></button>
                </div>
            </form>

            <% const hasPassword = Number(user.has_password) !== 0; %>

            <div class="card border-0 shadow-sm mt-4">
                <div class="card-header bg-white py-3">
                    <h2 class="fs-6 fw-bold mb-0"><%= hasPassword ? t('profile_edit.change_password') : t('profile_edit.set_password') %></h2>
                </div>
                <div class="card-body p-4">
                    <% if (!hasPassword) { %>
                        <div class="alert alert-info small">
                            <%= t('profile_edit.google_account_info') %>
                        </div>
                    <% } %>

                    <form action="/profile/password" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <% if (hasPassword) { %>
                            <div class="mb-3">
                                <label for="currentPassword" class="form-label fw-medium small"><%= t('profile_edit.current_password') %></label>
                                <input type="password" class="form-control" id="currentPassword"
                                       name="current_password" required autocomplete="current-password">
                            </div>
                        <% } %>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="newPassword" class="form-label fw-medium small"><%= t('profile_edit.new_password') %></label>
                                <input type="password" class="form-control" id="newPassword"
                                       name="new_password" required autocomplete="new-password">
                                <div class="form-text small"><%= t('profile_edit.new_password_help') %></div>
                            </div>
                            <div class="col-md-6">
                                <label for="confirmPassword" class="form-label fw-medium small"><%= t('profile_edit.confirm_password') %></label>
                                <input type="password" class="form-control" id="confirmPassword"
                                       name="confirm_password" required autocomplete="new-password">
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit" class="btn btn-primary px-4 fw-medium">
                                <%= hasPassword ? t('profile_edit.update_password') : t('profile_edit.create_password') %>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card border-0 shadow-sm mt-4 mb-5">
                <div class="card-header bg-white py-3">
                    <h2 class="fs-6 fw-bold mb-0"><%= t('profile_edit.email_address') %></h2>
                </div>
                <div class="card-body p-4">
                    <% if (!hasPassword) { %>
                        <p class="text-muted small mb-2"><%= t('profile_edit.current_email', { email: user.email }) %></p>
                        <div class="alert alert-warning small mb-0">
                            <%= t('profile_edit.google_email_warning') %>
                        </div>
                    <% } else { %>
                        <form action="/profile/email" method="POST">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="mb-3">
                                <label for="newEmail" class="form-label fw-medium small"><%= t('profile_edit.email_address') %></label>
                                <input type="email" class="form-control" id="newEmail" name="new_email"
                                       value="<%= user.email || '' %>" required>
                                <div class="form-text small"><%= t('profile_edit.email_help') %></div>
                            </div>

                            <div class="mb-0">
                                <label for="emailPassword" class="form-label fw-medium small"><%= t('auth.password') %></label>
                                <input type="password" class="form-control" id="emailPassword"
                                       name="current_password" required autocomplete="current-password">
                                <div class="form-text small"><%= t('profile_edit.verify_password_help') %></div>
                            </div>

                            <div class="d-flex justify-content-end mt-3">
                                <button type="submit" class="btn btn-primary px-4 fw-medium"><%= t('profile_edit.update_email') %></button>
                            </div>
                        </form>
                    <% } %>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const avatarInput = document.getElementById('avatarInput');
    const avatarPreview = document.getElementById('avatarPreview');
    const avatarFileName = document.getElementById('avatarFileName');
    const removeAvatarBtn = document.getElementById('removeAvatarBtn');
    const removeAvatarInput = document.getElementById('removeAvatarInput');
    const avatarBtnText = document.getElementById('avatarBtnText');
    const defaultAvatar = '/img/logo.png';

    if (avatarInput && avatarPreview) {
        avatarInput.addEventListener('change', function() {
            if (this.files && this.files[0]) {
                const file = this.files[0];
                if (file.size > 5 * 1024 * 1024) {
                    alert('<%= t("profile_edit.avatar_help") %>');
                    this.value = '';
                    return;
                }
                const reader = new FileReader();
                reader.onload = function(e) {
                    avatarPreview.src = e.target.result;
                };
                reader.readAsDataURL(file);
                if (avatarFileName) {
                    avatarFileName.textContent = file.name;
                    avatarFileName.classList.remove('d-none');
                }
                if (removeAvatarInput) {
                    removeAvatarInput.value = '0';
                }
                if (removeAvatarBtn) {
                    removeAvatarBtn.classList.remove('d-none');
                }
                if (avatarBtnText) {
                    avatarBtnText.textContent = '<%= t("profile_edit.change_avatar") %>';
                }
            }
        });
    }

    if (removeAvatarBtn && removeAvatarInput && avatarPreview) {
        removeAvatarBtn.addEventListener('click', function() {
            removeAvatarInput.value = '1';
            if (avatarInput) avatarInput.value = '';
            avatarPreview.src = defaultAvatar;
            if (avatarFileName) {
                avatarFileName.classList.add('d-none');
            }
            removeAvatarBtn.classList.add('d-none');
            if (avatarBtnText) {
                avatarBtnText.textContent = '<%= t("profile_edit.upload_avatar") %>';
            }
        });
    }
});
</script>

<%
    const statusStyles = {
        active: 'bg-success',
        pending: 'bg-warning text-dark',
        sold: 'bg-primary',
        expired: 'bg-secondary',
        rejected: 'bg-danger',
        draft: 'bg-light text-dark border'
    };
%>

<div class="container py-4 py-md-5">

    <% if (typeof warnings !== 'undefined' && warnings.length > 0) { %>
        <div class="alert <%= warningsRemaining === 0 ? 'alert-danger' : 'alert-warning' %> border-0 shadow-sm rounded-4 mb-4">
            <div class="d-flex gap-3">
                <i class="fa-solid fa-triangle-exclamation fs-4 mt-1"></i>
                <div class="flex-grow-1">
                    <h2 class="fs-6 fw-bold mb-1">
                        <%= t('warnings.title', { count: warnings.length, threshold: suspensionThreshold }) %>
                    </h2>
                    <p class="small mb-2">
                        <%= warningsRemaining === 0
                            ? t('warnings.suspended_body')
                            : t('warnings.remaining_body', { remaining: warningsRemaining }) %>
                    </p>
                    <ul class="small mb-0 ps-3">
                        <% warnings.forEach(function (warning) { %>
                            <li>
                                <strong><%= t('report_modal.reasons.' + warning.reason) %></strong>
                                <span class="text-muted">&middot; <%= helpers.timeAgo(warning.created_at, lang) %></span>
                                <% if (warning.note) { %><div class="text-muted"><%= warning.note %></div><% } %>
                            </li>
                        <% }); %>
                    </ul>
                    <a href="/kullanim-kosullari" class="small fw-semibold d-inline-block mt-2"><%= t('warnings.read_rules') %></a>
                </div>
            </div>
        </div>
    <% } %>
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted"><i class="fa-solid fa-house"></i> <%= t('nav.home') %></a></li>
            <li class="breadcrumb-item"><a href="/profile" class="text-decoration-none text-muted"><%= t('nav.my_profile') %></a></li>
            <li class="breadcrumb-item active fw-medium text-dark" aria-current="page"><%= t('nav.my_listings') %></li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="fs-3 fw-bold mb-1"><%= t('nav.my_listings') %></h1>
            <p class="text-muted small mb-0"><%= listings ? listings.length : 0 %> <%= t('listing.total_found') %></p>
        </div>
        <a href="/listings/create" class="btn btn-primary rounded-pill px-4 fw-bold">
            <i class="fa-solid fa-plus me-2"></i><%= t('nav.post_ad') %>
        </a>
    </div>

    <% if (listings && listings.length > 0) { %>
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-muted">
                            <th class="ps-4"><%= t('listing.title') %></th>
                            <th class="d-none d-md-table-cell"><%= t('listing.price') %></th>
                            <th class="d-none d-lg-table-cell"><%= t('listing.views') %></th>
                            <th><%= t('listing.status') %></th>
                            <th class="text-end pe-4"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% listings.forEach(function (listing) { %>
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-3 overflow-hidden bg-light flex-shrink-0" style="width: 64px; height: 48px;">
                                            <% if (listing.primary_image) { %>
                                                <img src="<%= listing.primary_image %>" class="w-100 h-100 object-fit-cover" alt="" onerror="this.onerror=null; this.src='/img/logo.svg';">
                                            <% } else { %>
                                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                                    <i class="fa-regular fa-image"></i>
                                                </div>
                                            <% } %>
                                        </div>
                                        <div class="min-w-0">
                                            <a href="/listings/<%= listing.slug %>" class="fw-bold text-dark text-decoration-none d-block text-truncate truncate-lg">
                                                <%= listing.title %>
                                            </a>
                                            <span class="small text-muted"><%= helpers.timeAgo(listing.created_at, lang) %></span>
                                        </div>
                                    </div>
                                </td>
                                <td class="d-none d-md-table-cell fw-bold text-primary">
                                    <%= helpers.formatPrice(listing.price, listing.currency, currency) %>
                                </td>
                                <td class="d-none d-lg-table-cell text-muted small">
                                    <i class="fa-regular fa-eye me-1"></i><%= listing.views_count || 0 %>
                                </td>
                                <td>
                                    <span class="badge rounded-pill <%= statusStyles[listing.status] || 'bg-secondary' %>">
                                        <%= t('listing.status_' + listing.status) %>
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a href="/listings/<%= listing.slug %>/edit" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                        <i class="fa-solid fa-pen me-1"></i><%= t('common.edit') %>
                                    </a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } else { %>
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border my-4">
            <i class="fa-regular fa-rectangle-list fs-1 text-muted mb-3 opacity-50 d-block"></i>
            <h5 class="fw-bold text-dark mb-2"><%= t('listing.no_listings') %></h5>
            <p class="text-muted small mb-4"><%= t('listing.my_listings_empty') %></p>
            <a href="/listings/create" class="btn btn-primary rounded-pill px-4 fw-bold">
                <%= t('listing.first_ad_button') %>
            </a>
        </div>
    <% } %>
</div>
